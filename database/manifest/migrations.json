    {
      "category": "destructive_changes",
      "path": "src/Meridian.Storage/Ledger/Migrations/V_ledger_030__journal_immutability.sql",
      "reason": "Deliberate hardening, not data loss: the unnamed on-delete-cascade FK from journal_legs to journal_entries is dropped and immediately re-created as a plain NO ACTION FK in the same transaction, so an entry delete can no longer vaporize legs. No column or data is removed.",
      "review_after": "2027-02-01",
      "rule_id": "migration-drop-table-member"
    },
