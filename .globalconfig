is_global = true

# ============================================================================
# Meridian - Global Analyzer Configuration
# ============================================================================
# This file configures Roslyn analyzers and code style rules globally.
# It works alongside Directory.Build.props which handles MSBuild warnings.
#
# NOTE: Diagnostic suppressions (IL2026, IL2070, CS1587) are handled in
#       Directory.Build.props via NoWarn property for better MSBuild integration.
#       See the MeridianGlobalNoWarn inventory in Directory.Build.props for the
#       canonical suppressions.
# ============================================================================

# ============================================================================
# AnalysisLevel=latest-recommended baseline
# ============================================================================
# Directory.Build.props sets AnalysisLevel=latest-recommended for C# projects. Every rule
# below already had violations when that was turned on, so it is held at 'suggestion'
# (not reported by the build) until its violations are fixed. To ratchet: fix a rule's
# violations, then delete its line so it reports as a warning again. Do not add rules.
# The list is pinned by tests/scripts/test_analysis_level_baseline.py.

dotnet_diagnostic.CA1000.severity = suggestion
