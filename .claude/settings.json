{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-csharp.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "model": "opus",
  "fastMode": false,
  "permissions": {
    "global": [
      "read",
      "edit",
      "write",
      "bash",
      "agent"
    ]
  }
}
