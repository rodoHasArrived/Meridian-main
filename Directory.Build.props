<!--
  ============================================================================
  Meridian - MSBuild Properties
  ============================================================================
  This file defines shared MSBuild properties for all projects in the solution.
  Automatically imported by all .csproj files.
  
  Related Configuration Files:
  - Directory.Packages.props  : Central Package Management (CPM) version definitions
  - .globalconfig             : Roslyn analyzer and code style rules
  ============================================================================
-->
<Project>
  <PropertyGroup>
    <!-- Allow resolving Windows-targeted TFMs on non-Windows CI runners to avoid NETSDK1100 -->
    <EnableWindowsTargeting Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' != 'true'">true</EnableWindowsTargeting>
    <!-- Optional per-run isolation root for automation or concurrent local builds. -->
    <MeridianBuildIsolationKey Condition="'$(MeridianBuildIsolationKey)' == ''"></MeridianBuildIsolationKey>
    <BaseIntermediateOutputPath Condition="'$(MeridianBuildIsolationKey)' != ''">$(MSBuildThisFileDirectory)artifacts/obj/$(MeridianBuildIsolationKey)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(MeridianBuildIsolationKey)' != ''">$(MSBuildThisFileDirectory)artifacts/bin/$(MeridianBuildIsolationKey)/$(MSBuildProjectName)/</BaseOutputPath>
    <!-- Keep generated build output trees out of compilation when local alternate obj/bin paths exist -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**\obj\**;**\obj-*\**;**\bin\**;**\bin-*\**;**\artifacts\codex-obj\**;$(MSBuildThisFileDirectory)artifacts\obj\**;$(MSBuildThisFileDirectory)artifacts\bin\**</DefaultItemExcludes>
    
  </PropertyGroup>
  <ItemGroup Label="Global warning suppression inventory">
    <!-- New entries in this list require explicit PR review with owner + ratchet plan. -->
    <MeridianGlobalNoWarn Include="MSB3277">
      <Owner>Core Team</Owner>
      <Justification>Assembly binding conflict warnings from transitive dependency resolution noise.</Justification>
      <RatchetPlan>Move to project-level suppression after dependency graph alignment for desktop and test lanes.</RatchetPlan>
    </MeridianGlobalNoWarn>
    <MeridianGlobalNoWarn Include="NETSDK1206">
      <Owner>Core Team</Owner>
      <Justification>RID compatibility warnings in cross-platform builds while legacy RID references are phased out.</Justification>
      <RatchetPlan>Move to project-level suppression for retained desktop/publish targets after RID cleanup.</RatchetPlan>
    </MeridianGlobalNoWarn>
    <MeridianGlobalNoWarn Include="NU1608">
      <Owner>Core Team</Owner>
      <Justification>Transitive package constraint mismatch warnings while central package upgrades are sequenced.</Justification>
      <RatchetPlan>Retire by dependency harmonization in Directory.Packages.props and adapter-specific package review.</RatchetPlan>
    </MeridianGlobalNoWarn>
    <MeridianGlobalNoWarn Include="IL2026">
      <Owner>Core Team</Owner>
      <Justification>Trim-analysis warning in JSON-heavy paths where trimming/AOT is not an active deployment mode.</Justification>
      <RatchetPlan>Move to project-level suppression per publish target after trim-readiness audit.</RatchetPlan>
    </MeridianGlobalNoWarn>
    <MeridianGlobalNoWarn Include="IL2070">
      <Owner>Core Team</Owner>
      <Justification>Dynamic member-access trim warning in serializer-driven call paths without trimming enabled.</Justification>
      <RatchetPlan>Move to project-level suppression with source-generation and linker annotation hardening.</RatchetPlan>
    </MeridianGlobalNoWarn>
    <MeridianGlobalNoWarn Include="CS1587">
      <Owner>Core Team</Owner>
      <Justification>XML comment placement warnings in record-heavy source files where docs are not a release gate.</Justification>
      <RatchetPlan>Move to project-level suppression after XML-doc policy is split between SDK/contract and internal projects.</RatchetPlan>
    </MeridianGlobalNoWarn>
    <MeridianGlobalNoWarn Include="CS1591">
      <Owner>Core Team</Owner>
      <Justification>Public-member XML doc warning is currently too broad for repository-wide enforcement.</Justification>
      <RatchetPlan>Move to project-level suppression by enabling strict XML docs only for publishable/API contract projects.</RatchetPlan>
    </MeridianGlobalNoWarn>
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);@(MeridianGlobalNoWarn->'%(Identity)')</NoWarn>
  </PropertyGroup>
  <ItemGroup Label="Runtime integrity defaults">
    <RuntimeHostConfigurationOption Include="System.IO.Compression.UseStrictValidation" Value="true" />
  </ItemGroup>
</Project>
