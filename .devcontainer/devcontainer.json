{
  "name": "Meridian Dev",

  // Use docker-compose so a PostgreSQL service is available automatically.
  // The compose file lives alongside this file in .devcontainer/.
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/meridian",

  // -------------------------------------------------------------------------
  // Lifecycle hooks
  // -------------------------------------------------------------------------

  // Install pinned script dependencies in a venv, restore both npm locks through
  // the same profile-aware command as local development, then restore the solution.
  "onCreateCommand": "python3 -m venv .ai/python-venv && .ai/python-venv/bin/python -m pip install -r build/scripts/ci/requirements.txt && .ai/python-venv/bin/python build/python/cli/buildctl.py environment --profile fixture-only --restore --json-output .ai/environment.json && dotnet restore Meridian.sln /p:EnableWindowsTargeting=true --verbosity minimal",

  // Rebuild and copy sample config when the repo content changes.
  "updateContentCommand": "cp -n config/appsettings.sample.json config/appsettings.json 2>/dev/null || true && mkdir -p data logs && dotnet build Meridian.sln -c Debug --no-restore /p:EnableWindowsTargeting=true --verbosity quiet",

  // Install git hooks and verify the backend profile without optional provider credentials.
  "postCreateCommand": "./build/scripts/hooks/install-hooks.sh && .ai/python-venv/bin/python build/python/cli/buildctl.py environment --profile backend-connected --summary",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.ai/python-venv/bin:${containerEnv:PATH}"
  },

  // -------------------------------------------------------------------------
  // Ports
  // -------------------------------------------------------------------------
  "forwardPorts": [8080, 5432, 5173],
  "portsAttributes": {
    "8080": {
      "label": "Web Dashboard",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Browser Workstation (Vite)",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },

  // -------------------------------------------------------------------------
  // VS Code customisations
  // -------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ionide.ionide-fsharp",
        "ms-python.python",
        "editorconfig.editorconfig",
        "DavidAnson.vscode-markdownlint",
        "eamodio.gitlens",
        "GitHub.copilot",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "dotnet.defaultSolution": "Meridian.sln",
        "omnisharp.enableRoslynAnalyzers": true,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active",
        "editor.stickyScroll.enabled": true,
        "dotnet.server.useOmnisharp": false,
        "testing.automaticallyOpenPeekView": "never"
      }
    }
  }
}
