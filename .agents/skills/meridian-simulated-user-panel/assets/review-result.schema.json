{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/skills/meridian-simulated-user-panel/review-result.schema.json",
  "title": "Meridian Simulated User Panel Review Result",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "artifact_type",
    "simulation_disclaimer",
    "evidence_status",
    "panel",
    "persona_findings",
    "cross_persona_tensions",
    "owner_actions",
    "success_criteria",
    "blockers",
    "recommendation",
    "confidence_notes"
  ],
  "properties": {
    "schema_version": {"const": "2026-07-19"},
    "mode": {"enum": ["design_partner", "release_gate", "usability_lab"]},
    "artifact_type": {
      "enum": ["screen-review", "workflow-walkthrough", "roadmap-review", "ship-readiness", "cross-surface-review"]
    },
    "simulation_disclaimer": {"const": "This is simulated persona feedback, not observed user research."},
    "evidence_status": {"enum": ["sufficient", "partial", "insufficient"]},
    "panel": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["role", "kind", "why_selected"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "kind": {"enum": ["canonical", "advisory", "custom"]},
          "why_selected": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "persona_findings": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/persona_finding"}
    },
    "cross_persona_tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["roles", "tension", "tradeoff"],
        "properties": {
          "roles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "tension": {"type": "string", "minLength": 1},
          "tradeoff": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "owner_actions": {
      "type": "object",
      "required": ["now", "next", "later"],
      "properties": {
        "now": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/owner_action"}},
        "next": {"type": "array", "items": {"$ref": "#/$defs/owner_action"}},
        "later": {"type": "array", "items": {"$ref": "#/$defs/owner_action"}}
      },
      "additionalProperties": false
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "not_verified", "not_applicable"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommendation": {
      "enum": [
        "steer",
        "prototype",
        "defer",
        "ship",
        "ship_with_caveats",
        "hold",
        "advance_to_release_gate",
        "rerun_after_changes"
      ]
    },
    "confidence_notes": {
      "type": "object",
      "required": ["verified", "inferred", "missing_evidence"],
      "properties": {
        "verified": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "inferred": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "design_partner"}}},
      "then": {"properties": {"recommendation": {"enum": ["steer", "prototype", "defer"]}}}
    },
    {
      "if": {"properties": {"mode": {"const": "usability_lab"}}},
      "then": {"properties": {"recommendation": {"enum": ["advance_to_release_gate", "rerun_after_changes", "defer"]}}}
    },
    {
      "if": {"properties": {"mode": {"const": "release_gate"}}},
      "then": {"properties": {"recommendation": {"enum": ["ship", "ship_with_caveats", "hold"]}}}
    },
    {
      "if": {"properties": {"evidence_status": {"const": "insufficient"}}},
      "then": {"properties": {"recommendation": {"const": "hold"}}}
    },
    {
      "if": {"properties": {"recommendation": {"const": "ship"}}},
      "then": {
        "properties": {
          "evidence_status": {"const": "sufficient"},
          "blockers": {"maxItems": 0},
          "success_criteria": {
            "items": {
              "properties": {"status": {"const": "verified"}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "rubric_score": {
      "type": "object",
      "required": ["score", "evidence"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "persona_finding": {
      "type": "object",
      "required": ["role", "liked", "didnt_like", "missing_or_risky", "improvement_ideas", "adoption_verdict", "rubric"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "liked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "didnt_like": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "missing_or_risky": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "improvement_ideas": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "adoption_verdict": {"type": "string", "minLength": 1},
        "rubric": {
          "type": "object",
          "required": ["workflow_fit", "trust_controls", "time_to_value", "data_confidence", "extensibility", "learning_curve"],
          "properties": {
            "workflow_fit": {"$ref": "#/$defs/rubric_score"},
            "trust_controls": {"$ref": "#/$defs/rubric_score"},
            "time_to_value": {"$ref": "#/$defs/rubric_score"},
            "data_confidence": {"$ref": "#/$defs/rubric_score"},
            "extensibility": {"$ref": "#/$defs/rubric_score"},
            "learning_curve": {"$ref": "#/$defs/rubric_score"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "owner_action": {
      "type": "object",
      "required": ["action", "evidence_refs", "personas_affected"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "personas_affected": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}
