<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Assembly Information -->
    <AssemblyName>Meridian</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Meridian Team</Authors>
    <Description>Cross-platform market data collection system for real-time data ingestion</Description>
    <Product>Meridian</Product>
    <Copyright>Copyright © 2024 Meridian Team</Copyright>

    <!-- SelfContained only during publish -->
    <SelfContained Condition="'$(PublishProtocol)' != ''">true</SelfContained>
    <SelfContained Condition="'$(PublishProtocol)' == ''">false</SelfContained>

    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <ApplicationManifest Condition="Exists('app.manifest')">app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <EnableLeanIntegration Condition="'$(EnableLeanIntegration)' == ''">false</EnableLeanIntegration>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableLeanIntegration)' == 'true'">
    <DefineConstants>$(DefineConstants);MERIDIAN_ENABLE_LEAN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier.StartsWith(`win`))' == 'true'">
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="System.Text.Json" />
  </ItemGroup>

  <!-- Host-level dependencies (entry point and desktop-local API host) -->
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />

    <!-- ASP.NET Core - desktop-local API host -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />

  </ItemGroup>

  <!-- QuantConnect Lean Engine integration is optional and excluded from normal workstation builds. -->
  <ItemGroup Condition="'$(EnableLeanIntegration)' == 'true'">
    <PackageReference Include="QuantConnect.Lean" />
    <PackageReference Include="QuantConnect.Lean.Engine" />
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Indicators" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableLeanIntegration)' != 'true'">
    <Compile Remove="Integrations\Lean\**\*.cs" />
    <None Include="Integrations\Lean\**\*.cs" />
  </ItemGroup>

  <!-- Layer Assembly References -->
  <ItemGroup>
    <ProjectReference Include="..\Meridian.Application\Meridian.Application.csproj" />
    <ProjectReference Include="..\Meridian.Infrastructure\Meridian.Infrastructure.csproj" />
    <ProjectReference Include="..\Meridian.Storage\Meridian.Storage.csproj" />
    <ProjectReference Include="..\Meridian.Core\Meridian.Core.csproj" />
    <ProjectReference Include="..\Meridian.Domain\Meridian.Domain.csproj" />
    <ProjectReference Include="..\Meridian.Contracts\Meridian.Contracts.csproj" />
    <ProjectReference Include="..\Meridian.ProviderSdk\Meridian.ProviderSdk.csproj" />
    <ProjectReference Include="..\Meridian.QuantScript\Meridian.QuantScript.csproj" />
    <ProjectReference Include="..\Meridian.Ui.Shared\Meridian.Ui.Shared.csproj" />
    <ProjectReference Include="..\Meridian.Ui.Services\Meridian.Ui.Services.csproj" />
  </ItemGroup>

  <!-- Host static assets -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
