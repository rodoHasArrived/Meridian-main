{
  "name": "@meridian/workstation-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --outDir ../wwwroot/workstation",
    "build": "tsc --noEmit && vite build",
    "screenshots": "node ../../../scripts/dev/capture-web-screenshots.mjs",
    "smoke:workstation": "node scripts/smoke-workstation.mjs",
    "lint": "eslint src",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "test": "node --max-old-space-size=4096 ./scripts/run-vitest-stable.mjs",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:w4": "vitest run src/screens/w4-acceptance-parity.test.ts src/screens/operations-continuity-screen.view-model.test.ts src/screens/reporting-screen.view-model.test.ts"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "meridian-tools": "file:../../..",
    "react": "19.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "25.0.1",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.31",
    "nanoid": "^3.3.18",
    "zod": "^4.6.7"
  }
}
