{
  "name": "@meridian/workstation-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --outDir ../wwwroot/workstation",
    "build": "tsc --noEmit && vite build",
    "screenshots": "node ../../../scripts/dev/capture-web-screenshots.mjs",
    "test": "node --max-old-space-size=4096 ./scripts/run-vitest-stable.mjs",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:w4": "vitest run src/screens/w4-acceptance-parity.test.ts src/screens/operations-continuity-screen.view-model.test.ts src/screens/reporting-screen.view-model.test.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "meridian-tools": "file:../../..",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jest-axe": "^10.0.0",
    "jsdom": "25.0.1",
    "playwright": "1.59.1",
    "postcss": "8.5.12",
    "tailwindcss": "3.4.15",
    "typescript": "5.7.2",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  }
}
