<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Meridian-Setup</AssemblyName>
    <RootNamespace>Meridian.Setup</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      Self-contained only when a runtime identifier is present. The release build always publishes
      with an explicit win-x64 runtime identifier and an explicit self-contained switch, so this
      changes nothing there. It exists so that a runtime-identifier-less build, which is what a
      ProjectReference from Meridian.Setup.Tests performs, does not ask for a self-contained
      application without a runtime identifier.
    -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>
  <!--
    The product payload is NOT an EmbeddedResource. Roslyn serialises resources into the PE
    image's mapped field data and overflows on a payload this size, failing the build with
    ArgumentOutOfRangeException (mappedFieldDataStreamRva). build-consumer-setup.ps1 appends it
    to the published executable instead; see PayloadPackage for the format.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Meridian.Setup.Tests" />
  </ItemGroup>
</Project>
