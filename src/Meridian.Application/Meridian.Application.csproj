<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Meridian.Application</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />

    <!-- Logging -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Settings.Configuration" />

    <!-- Monitoring and Metrics -->
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="prometheus-net.AspNetCore" />

    <!-- Resilience -->
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions" />

    <!-- ASP.NET Core (for web dashboard) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meridian.Modularity\Meridian.Modularity.csproj" />
    <ProjectReference Include="..\Meridian.Infrastructure\Meridian.Infrastructure.csproj" />
    <ProjectReference Include="..\Meridian.Storage\Meridian.Storage.csproj" />
    <ProjectReference Include="..\Meridian.Core\Meridian.Core.csproj" />
    <ProjectReference Include="..\Meridian.Domain\Meridian.Domain.csproj" />
    <ProjectReference Include="..\Meridian.Contracts\Meridian.Contracts.csproj" />
    <ProjectReference Include="..\Meridian.Workflow\Meridian.Workflow.csproj" />
    <ProjectReference Include="..\Meridian.DataIntegration\Meridian.DataIntegration.csproj" />
    <ProjectReference Include="..\Meridian.Entities\Meridian.Entities.csproj" />
    <ProjectReference Include="..\Meridian.Identity\Meridian.Identity.csproj" />
    <ProjectReference Include="..\Meridian.FinancialOperations\Meridian.FinancialOperations.csproj" />
    <ProjectReference Include="..\Meridian.Instruments\Meridian.Instruments.csproj" />
    <ProjectReference Include="..\Meridian.Platform\Meridian.Platform.csproj" />
    <ProjectReference Include="..\Meridian.PortfolioRecords\Meridian.PortfolioRecords.csproj" />
    <ProjectReference Include="..\Meridian.ReferenceData\Meridian.ReferenceData.csproj" />
    <ProjectReference Include="..\Meridian.ProviderSdk\Meridian.ProviderSdk.csproj" />
    <ProjectReference Include="..\Meridian.FSharp\Meridian.FSharp.fsproj" />
    <ProjectReference Include="..\Meridian.FSharp.DirectLending.Aggregates\Meridian.FSharp.DirectLending.Aggregates.fsproj" />
    <ProjectReference Include="..\Meridian.FSharp.Ledger\Meridian.FSharp.Ledger.fsproj" />
    <ProjectReference Include="..\Meridian.Ledger\Meridian.Ledger.csproj" />
  </ItemGroup>
</Project>
