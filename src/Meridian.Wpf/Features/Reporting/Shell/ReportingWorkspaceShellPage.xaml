<views:ReportingWorkspaceShellPageBase x:Class="Meridian.Wpf.Features.Reporting.Shell.ReportingWorkspaceShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="clr-namespace:Meridian.Wpf.Views"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1400"
      Background="{DynamicResource ConsoleBackgroundDarkBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Reporting Workspace"
      AutomationProperties.AutomationId="ReportingWorkspaceShellPage">

    <Grid Margin="20"
          AutomationProperties.AutomationId="WorkspaceHomeReportingCockpitTemplate">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:WorkspaceShellContextStripControl x:Name="ContextStrip"
                                                 ShellContext="{Binding ShellContext}" />

        <views:WorkspaceCommandBarControl x:Name="CommandBar"
                                          Grid.Row="1"
                                          CommandGroup="{Binding CommandGroup}"
                                          CommandInvoked="OnCommandBarCommandInvoked"
                                          Margin="0,16,0,0"
                                          AutomationProperties.AutomationId="WorkspaceCommandSurfaceReporting" />

        <ScrollViewer Grid.Row="2"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{StaticResource PremiumPanelBrush}"
                        BorderBrush="{StaticResource ConsoleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,0,0,12"
                        Padding="14,10"
                        ToolTip="{Binding SummarySnapshotDetailText}"
                        AutomationProperties.AutomationId="ReportingCompactActionChrome"
                        AutomationProperties.Name="Reporting compact action chrome">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="30"
                                Height="30"
                                CornerRadius="8"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                                BorderBrush="{StaticResource InfoColorBrush}"
                                BorderThickness="1">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,20,0"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Daily reporting cockpit"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="Report pack readiness"
                                           FontSize="12"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding SummarySnapshotDetailText}"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="ReportingCompactActionSummaryText" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2"
                                   MaxWidth="520"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Content="Report Pack"
                                    Tag="FundReportPack"
                                    Click="OnNavigateButtonClick"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8" />
                            <Button Content="Run Status"
                                    Tag="ReportRunStatus"
                                    Click="OnNavigateButtonClick"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,8" />
                            <Button Content="Exports"
                                    Tag="AnalysisExport"
                                    Click="OnNavigateButtonClick"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,8" />
                            <Button Content="Presets"
                                    Tag="ExportPresets"
                                    Click="OnNavigateButtonClick"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource WorkspaceWorkbenchCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Reporting Queue"
                                       Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="Keep report production, access approvals, scheduled distribution, custom branding, and export delivery in one review lane."
                                       Margin="0,6,0,12"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <views:WorkspaceDecisionQueueControl ItemsSource="{Binding CockpitDecisionItems}"
                                                                 QueueAutomationId="ReportingCockpitDecisionQueue"
                                                                 DecisionInvoked="OnCockpitDecisionInvoked" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2"
                                AutomationProperties.AutomationId="WorkspaceInspectorHostReporting">
                        <Border Style="{StaticResource WorkspaceInspectorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Summary Snapshot" Style="{StaticResource CardHeaderStyle}" />
                                <UniformGrid Columns="3" Margin="0,12,0,0">
                                    <Border Style="{StaticResource WorkspaceQueueCardStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Writer" FontSize="10" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                            <TextBlock Text="{Binding WriterSummaryText}" Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource WorkspaceQueueCardStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Approvals" FontSize="10" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                            <TextBlock Text="{Binding ApprovalSummaryText}" Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarningColorBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource WorkspaceQueueCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Delivery" FontSize="10" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                            <TextBlock Text="{Binding DeliverySummaryText}" Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SuccessColorBrush}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource WorkspaceInspectorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Decision Links" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="Reporting decisions usually depend on accounting evidence and data-quality state."
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Accounting"
                                            Tag="AccountingShell"
                                            Click="OnNavigateButtonClick"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Data Quality"
                                            Tag="DataQuality"
                                            Click="OnNavigateButtonClick"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,8,8" />
                                    <Button Content="Audit Trail"
                                            Tag="FundAuditTrail"
                                            Click="OnNavigateButtonClick"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <views:MeridianDockingManager x:Name="ReportingDockManager"
                                      Grid.Row="3"
                                      Height="300"
                                      Margin="0,12,0,0"
                                      PaneDropRequested="OnPaneDropRequested"
                                      AutomationProperties.Name="Reporting Dock Manager" />
    </Grid>

</views:ReportingWorkspaceShellPageBase>
