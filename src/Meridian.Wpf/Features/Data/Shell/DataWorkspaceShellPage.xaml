<views:DataWorkspaceShellPageBase x:Class="Meridian.Wpf.Features.Data.Shell.DataWorkspaceShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="clr-namespace:Meridian.Wpf.Models"
      xmlns:views="clr-namespace:Meridian.Wpf.Views"
      xmlns:controls="clr-namespace:Meridian.Wpf.Controls"
      xmlns:services="clr-namespace:Meridian.Wpf.Services"
      xmlns:copy="clr-namespace:Meridian.Wpf.Copy"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1400"
      Background="{DynamicResource ConsoleBackgroundDarkBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="{x:Static copy:WorkspaceCopyCatalog.DataShellTitle}"
      AutomationProperties.AutomationId="DataWorkspaceShellPage">

    <Page.Resources>
        <Style x:Key="DataShellHeroBadgeBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource NeutralBadgeStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Info">
                    <Setter Property="Background" Value="{StaticResource BadgeInfoBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BadgeInfoBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Success">
                    <Setter Property="Background" Value="{StaticResource BadgeSuccessBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BadgeSuccessBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource BadgeWarningBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BadgeWarningBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Danger">
                    <Setter Property="Background" Value="{StaticResource BadgeDangerBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BadgeDangerBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataShellHeroBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleTextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Info">
                    <Setter Property="Foreground" Value="{StaticResource BadgeInfoForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Success">
                    <Setter Property="Foreground" Value="{StaticResource BadgeSuccessForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource BadgeWarningForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Danger">
                    <Setter Property="Foreground" Value="{StaticResource BadgeDangerForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataShellSummaryMetricValueTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Info">
                    <Setter Property="Foreground" Value="{StaticResource InfoColorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Success">
                    <Setter Property="Foreground" Value="{StaticResource SuccessColorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningColorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Danger">
                    <Setter Property="Foreground" Value="{StaticResource ErrorColorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="QueueRegionStateTemplate" DataType="{x:Type models:WorkspaceQueueRegionState}">
            <Border Style="{StaticResource WorkspaceQueueStateCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource WorkspaceQueueStateIconContainerStyle}">
                        <TextBlock Text="{Binding IconGlyph}"
                                   Style="{StaticResource WorkspaceQueueStateIconTextStyle}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource WorkspaceQueueStateTitleTextStyle}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource WorkspaceQueueStateDescriptionTextStyle}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Tag="{Binding PrimaryActionId}"
                                Content="{Binding PrimaryActionLabel}"
                                Click="OnQueueStateActionClick"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrimaryActionLabel}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Tag="{Binding SecondaryActionId}"
                                Content="{Binding SecondaryActionLabel}"
                                Click="OnQueueStateActionClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SecondaryActionLabel}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecentItemTemplate" DataType="{x:Type models:WorkspaceRecentItem}">
            <Border Style="{StaticResource WorkspaceToneInspectorCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}"
                               Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Meta}"
                               Margin="0,6,0,0"
                               FontSize="10"
                               Style="{StaticResource WorkspaceToneBadgeTextStyle}" />
                    <Button Tag="{Binding ActionId}"
                            Content="{Binding ActionLabel}"
                            Click="OnRecentActionClick"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActionLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HeroMetricTemplate" DataType="{x:Type services:DataHeroMetric}">
            <Border Style="{StaticResource WorkspaceToneBadgeStyle}"
                    MinWidth="112"
                    Margin="0,0,8,8"
                    Padding="10,8"
                    ToolTip="{Binding Detail}"
                    AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ConsoleTextMutedBrush}" />
                    <TextBlock Text="{Binding Value}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Style="{StaticResource WorkspaceToneBadgeTextStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <Grid Margin="0"
          Background="{StaticResource ConsoleBackgroundDarkBrush}"
          AutomationProperties.AutomationId="WorkspaceHomeDataTerminalTemplate">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource WorkstationPageBandStyle}"
                AutomationProperties.AutomationId="WorkspaceEvidenceStripData">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Data"
                               FontFamily="{StaticResource MeridianDisplayFontFamily}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                    <TextBlock Text="Provider readiness, queue pressure, storage posture, and export delivery from one operator shell."
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource WorkstationFilterChipStyle}">
                            <TextBlock x:Name="OperationsHeroScopeText"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       Text="{Binding HeroScopeText}" />
                        </Border>
                        <Border Style="{StaticResource WorkstationFilterChipStyle}">
                            <TextBlock Text="{Binding QueueScopeBadgeText}"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource WorkstationFilterChipStyle}">
                            <TextBlock Text="{Binding OperationsSummaryTitleText}"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock x:Name="OperationsHeroSummaryText"
                               Margin="0,8,40,0"
                               FontSize="12"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding HeroSummaryText}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="420"
                        Margin="18,0,0,0"
                        Padding="14,10"
                        CornerRadius="6"
                        Background="{StaticResource ConsoleBackgroundMediumBrush}"
                        BorderBrush="{StaticResource ConsoleBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Next Handoff"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <Border x:Name="OperationsHeroBadgeBorder"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource DataShellHeroBadgeBorderStyle}"
                                    Tag="{Binding HeroState.BadgeTone}">
                                <TextBlock x:Name="OperationsHeroBadgeText"
                                           Style="{StaticResource DataShellHeroBadgeTextStyle}"
                                           Tag="{Binding HeroState.BadgeTone}"
                                           Text="{Binding HeroState.BadgeText}"
                                           AutomationProperties.AutomationId="OperationsHeroBadgeText" />
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="OperationsHeroFocusText"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   Text="{Binding HeroState.FocusText}"
                                   AutomationProperties.AutomationId="OperationsHeroFocusText" />
                        <TextBlock x:Name="OperationsHeroActionSummaryText"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding HeroState.SummaryText}"
                                   AutomationProperties.AutomationId="OperationsHeroActionSummaryText" />
                        <ItemsControl x:Name="OperationsHeroMetricsList"
                                      Margin="0,10,0,0"
                                      ItemsSource="{Binding HeroMetrics}"
                                      ItemTemplate="{StaticResource HeroMetricTemplate}"
                                      AutomationProperties.AutomationId="OperationsHeroMetricsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="OperationsHeroHandoffTitleText"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   Text="{Binding HeroState.HandoffTitleText}"
                                   AutomationProperties.AutomationId="OperationsHeroHandoffTitleText" />
                        <TextBlock x:Name="OperationsHeroHandoffDetailText"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding HeroState.HandoffDetailText}"
                                   AutomationProperties.AutomationId="OperationsHeroHandoffDetailText" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="OperationsHeroPrimaryActionButton"
                                    Content="{Binding HeroState.PrimaryActionLabel}"
                                    Tag="{Binding HeroState.PrimaryActionId}"
                                    Click="OnOperationsHeroPrimaryActionClick"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8"
                                    Visibility="{Binding HeroPrimaryActionVisibility}"
                                    AutomationProperties.AutomationId="OperationsHeroPrimaryActionButton" />
                            <Button x:Name="OperationsHeroSecondaryActionButton"
                                    Content="{Binding HeroState.SecondaryActionLabel}"
                                    Tag="{Binding HeroState.SecondaryActionId}"
                                    Click="OnOperationsHeroSecondaryActionClick"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,8"
                                    Visibility="{Binding HeroSecondaryActionVisibility}"
                                    AutomationProperties.AutomationId="OperationsHeroSecondaryActionButton" />
                        </WrapPanel>
                        <TextBlock x:Name="OperationsHeroTargetText"
                                   Margin="0,10,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Text="{Binding HeroState.TargetText}"
                                   AutomationProperties.AutomationId="OperationsHeroTargetText" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <controls:WorkspaceAttentionRibbon Grid.Row="1"
                                           DataContext="{Binding AttentionRibbon}"
                                           Margin="16,10,16,0" />

        <Border Grid.Row="2"
                Style="{StaticResource WorkstationFilterBarStyle}"
                AutomationProperties.AutomationId="DataWorkspaceFilterBar"
                AutomationProperties.Name="Data Workspace Filter Bar">
            <DockPanel LastChildFill="False">
                <WrapPanel VerticalAlignment="Center">
                    <Border Style="{StaticResource WorkstationFilterChipStyle}">
                        <TextBlock Text="Providers"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource WorkstationFilterChipStyle}">
                        <TextBlock Text="Backfill"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource WorkstationFilterChipStyle}">
                        <TextBlock Text="Storage"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource WorkstationFilterChipStyle}">
                        <TextBlock Text="Collection status"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource WorkstationFilterChipStyle}">
                        <TextBlock Text="File last added"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                    </Border>
                    <Border x:Name="DataIntegrationWorkflowStatusChip"
                            Style="{StaticResource DataShellHeroBadgeBorderStyle}"
                            Tag="{Binding IntegrationWorkflowBadgeTone}"
                            Margin="8,0,0,0"
                            ToolTip="{Binding IntegrationWorkflowStateDetail}"
                            AutomationProperties.AutomationId="DataIntegrationWorkflowStatusChip">
                        <TextBlock x:Name="DataIntegrationWorkflowStatusText"
                                   Text="{Binding IntegrationWorkflowStateText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource DataShellHeroBadgeTextStyle}"
                                   Tag="{Binding IntegrationWorkflowBadgeTone}" />
                    </Border>
                </WrapPanel>

                <views:WorkspaceShellContextStripControl x:Name="ContextStrip"
                                                         DockPanel.Dock="Right"
                                                         Width="420"
                                                         Margin="12,0,0,0"
                                                         Visibility="Collapsed"
                                                         ShellContext="{Binding ShellContext}" />
            </DockPanel>
        </Border>

        <views:WorkspaceCommandBarControl x:Name="CommandBar"
                                          Grid.Row="3"
                                          CommandGroup="{Binding CommandGroup}"
                                          CommandInvoked="OnCommandBarCommandInvoked"
                                          Margin="16,10,16,10"
                                          AutomationProperties.AutomationId="WorkspaceCommandSurfaceData" />

        <Grid Grid.Row="4"
              Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.25*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource WorkstationTablePanelStyle}"
                    AutomationProperties.AutomationId="DataWorkspaceQueuePanel"
                    AutomationProperties.Name="Data Workspace Queue Panel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource WorkstationPanelHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Operational Queues"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                <TextBlock x:Name="QueueSummaryText"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                           Text="{Binding QueueSummaryText}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Style="{StaticResource WorkstationFilterChipStyle}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="QueueScopeBadgeText"
                                           FontSize="11"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                           Text="{Binding QueueScopeBadgeText}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource WorkstationPanelBodyStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Providers"
                                           Style="{StaticResource ShellSectionLabelStyle}"
                                           Margin="0,0,0,8" />
                                <Grid>
                                    <views:WorkspaceDecisionQueueControl x:Name="ProviderQueueList"
                                                                         Columns="1"
                                                                         ItemsSource="{Binding ProviderQueueItems}"
                                                                         Visibility="{Binding ProviderQueueListVisibility}"
                                                                         QueueAutomationId="DataProviderDecisionQueue"
                                                                         DecisionInvoked="OnDataDecisionInvoked" />
                                    <ContentControl x:Name="ProviderQueueStateContainer"
                                                    Content="{Binding ProviderQueueState}"
                                                    ContentTemplate="{StaticResource QueueRegionStateTemplate}"
                                                    Visibility="{Binding ProviderQueueStateVisibility}" />
                                </Grid>

                                <TextBlock Text="Backfill"
                                           Style="{StaticResource ShellSectionLabelStyle}"
                                           Margin="0,12,0,8" />
                                <Grid>
                                    <views:WorkspaceDecisionQueueControl x:Name="BackfillQueueList"
                                                                         Columns="1"
                                                                         ItemsSource="{Binding BackfillQueueItems}"
                                                                         Visibility="{Binding BackfillQueueListVisibility}"
                                                                         QueueAutomationId="DataBackfillDecisionQueue"
                                                                         DecisionInvoked="OnDataDecisionInvoked" />
                                    <ContentControl x:Name="BackfillQueueStateContainer"
                                                    Content="{Binding BackfillQueueState}"
                                                    ContentTemplate="{StaticResource QueueRegionStateTemplate}"
                                                    Visibility="{Binding BackfillQueueStateVisibility}" />
                                </Grid>

                                <TextBlock Text="Storage"
                                           Style="{StaticResource ShellSectionLabelStyle}"
                                           Margin="0,12,0,8" />
                                <Grid>
                                    <views:WorkspaceDecisionQueueControl x:Name="StorageQueueList"
                                                                         Columns="1"
                                                                         ItemsSource="{Binding StorageQueueItems}"
                                                                         Visibility="{Binding StorageQueueListVisibility}"
                                                                         QueueAutomationId="DataStorageDecisionQueue"
                                                                         DecisionInvoked="OnDataDecisionInvoked" />
                                    <ContentControl x:Name="StorageQueueStateContainer"
                                                    Content="{Binding StorageQueueState}"
                                                    ContentTemplate="{StaticResource QueueRegionStateTemplate}"
                                                    Visibility="{Binding StorageQueueStateVisibility}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource WorkstationInspectorRailStyle}"
                    AutomationProperties.AutomationId="WorkspaceInspectorHostData"
                    AutomationProperties.Name="Data Workspace Inspector Rail">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10">
                    <StackPanel>
                    <Border Style="{StaticResource WorkspaceInspectorCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Operations Summary"
                                       Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock x:Name="OperationsSummaryTitleText"
                                       Margin="0,10,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Text="{Binding OperationsSummaryTitleText}" />
                            <TextBlock x:Name="OperationsSummaryDetailText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       Text="{Binding OperationsSummaryDetailText}" />
                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <Border Style="{StaticResource WorkspaceQueueCardStyle}" Margin="0,0,8,0">
                                    <StackPanel Style="{StaticResource WorkspaceSummaryTileContentStyle}">
                                        <TextBlock Text="Providers"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                        <TextBlock x:Name="SummaryProvidersText"
                                                   Style="{StaticResource DataShellSummaryMetricValueTextStyle}"
                                                   Tag="{Binding SummaryProvidersTone}"
                                                   Text="{Binding SummaryProvidersText}" />
                                        <TextBlock Text="Connectivity posture"
                                                   Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource WorkspaceQueueCardStyle}" Margin="0,0,8,0">
                                    <StackPanel Style="{StaticResource WorkspaceSummaryTileContentStyle}">
                                        <TextBlock Text="Backfill"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                        <TextBlock x:Name="SummaryBackfillText"
                                                   Style="{StaticResource DataShellSummaryMetricValueTextStyle}"
                                                   Tag="{Binding SummaryBackfillTone}"
                                                   Text="{Binding SummaryBackfillText}" />
                                        <TextBlock Text="Historical coverage"
                                                   Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource WorkspaceQueueCardStyle}">
                                    <StackPanel Style="{StaticResource WorkspaceSummaryTileContentStyle}">
                                        <TextBlock Text="Storage"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                        <TextBlock x:Name="SummaryStorageText"
                                                   Style="{StaticResource DataShellSummaryMetricValueTextStyle}"
                                                   Tag="{Binding SummaryStorageTone}"
                                                   Text="{Binding SummaryStorageText}" />
                                        <TextBlock Text="Durability health"
                                                   Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Grid x:Name="DataIntegrationWorkflowInlineState"
                                  Margin="0,14,0,0"
                                  AutomationProperties.AutomationId="DataIntegrationWorkflowInlineState">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Workflow checkpoint"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                    <TextBlock x:Name="DataIntegrationWorkflowInlineText"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               Text="{Binding IntegrationWorkflowStateText}" />
                                    <TextBlock x:Name="DataIntegrationWorkflowInlineDetailText"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding IntegrationWorkflowStateDetail}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource DataShellHeroBadgeBorderStyle}"
                                        Tag="{Binding IntegrationWorkflowBadgeTone}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CurrentIntegrationWorkflowStep.StatusLabel}"
                                               FontSize="10"
                                               Style="{StaticResource DataShellHeroBadgeTextStyle}"
                                               Tag="{Binding IntegrationWorkflowBadgeTone}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WorkspaceInspectorCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource WorkspaceCardHeaderGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Recent Operations"
                                           Style="{StaticResource CardHeaderStyle}" />
                                <Button Grid.Column="1"
                                        Content="All Sessions"
                                        Click="OpenCollectionSessions_Click"
                                        Style="{StaticResource LinkButtonStyle}" />
                            </Grid>
                            <ItemsControl x:Name="RecentOperationsList"
                                          ItemsSource="{Binding RecentOperations}"
                                          ItemTemplate="{StaticResource RecentItemTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WorkspaceInspectorCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Support Surfaces"
                                       Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="Jump into storage, packages, or collection sessions without leaving the shell."
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Style="{StaticResource WorkspaceCardFooterPanelStyle}">
                                <Button Content="Storage"
                                        Click="OpenStorage_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8" />
                                <Button Content="Sessions"
                                        Click="OpenCollectionSessions_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,8,8" />
                                <Button Content="Data Export"
                                        Click="OpenDataExport_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,8,8" />
                                <Button Content="Schedules"
                                        Click="OpenSchedules_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,8,8" />
                                <Button Content="Packages"
                                        Click="OpenPackageManager_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="5"
                Style="{StaticResource WorkstationDockStripStyle}"
                AutomationProperties.AutomationId="DataWorkspaceDockStrip"
                AutomationProperties.Name="Data Workspace Dock Strip">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Operations Dock"
                           DockPanel.Dock="Left"
                           Width="150"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                           VerticalAlignment="Top"
                           Margin="0,2,14,0" />
                <views:MeridianDockingManager x:Name="DataDockManager"
                                              MinHeight="176"
                                              MaxHeight="240"
                                              Height="196"
                                              PaneDropRequested="OnPaneDropRequested"
                                              AutomationProperties.Name="Data Dock Manager" />
            </DockPanel>
        </Border>
    </Grid>
</views:DataWorkspaceShellPageBase>
