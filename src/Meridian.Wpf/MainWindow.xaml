<Window x:Class="Meridian.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Meridian.Wpf"
        xmlns:views="clr-namespace:Meridian.Wpf.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Meridian"
        Height="900" Width="1400"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellWindowBackgroundBrush}"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        KeyDown="OnWindowKeyDown"
        AutomationProperties.Name="Meridian">

    <Window.InputBindings>
        <!-- Navigation shortcuts -->
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="StrategyShell" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding StartCollectorCommand}" />
        <KeyBinding Key="Q" Modifiers="Control+Shift" Command="{Binding StopCollectorCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Fixture/Offline Mode Banner (P0: Hard visual distinction for non-live modes) -->
            <Border x:Name="FixtureModeBanner"
                    Visibility="{Binding FixtureModeBannerVisibility}"
                    Padding="8,6"
                    CornerRadius="0"
                    Background="{Binding FixtureModeBannerBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="16"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="FixtureModeText"
                               Grid.Column="1"
                               Text="{Binding FixtureModeText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="&#xE8BB;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>
            </Border>

            <Border x:Name="StartupExperienceBanner"
                    Visibility="{Binding StartupBannerVisibility}"
                    Padding="18,14"
                    Background="{StaticResource PremiumPanelBrush}"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    AutomationProperties.Name="Startup briefing">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52"
                            Height="52"
                            CornerRadius="16"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1"
                            Margin="0,0,14,0">
                        <TextBlock Text="{StaticResource IconHome}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="26"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Meridian Workstation"
                                       FontFamily="{StaticResource MeridianDisplayFontFamily}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Margin="12,0,0,0"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                    BorderBrush="{StaticResource InfoColorBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StartupBannerStatusText}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoColorBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding StartupBannerMessage}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource CardDescriptionStyle}"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StartupBannerDetail}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource CardDescriptionStyle}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Button Content="Start Demo / Sample Tour"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartDemoTourCommand}"
                                AutomationProperties.AutomationId="StartupStartDemoTourButton"
                                Margin="0,0,8,0" />
                        <Button Content="Open Welcome"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Welcome"
                                Margin="0,0,8,0" />
                        <Button Content="Dismiss"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DismissStartupBannerCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="DemoTourBanner"
                    Visibility="{Binding DemoTourVisibility}"
                    Padding="14,10"
                    Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                    BorderBrush="{StaticResource InfoColorBrush}"
                    BorderThickness="0,0,0,1"
                    AutomationProperties.Name="Demo sample mode guided tour"
                    AutomationProperties.AutomationId="DemoTourBanner">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DemoTourStepText}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                        <TextBlock Text="{Binding DemoTourDetail}"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="DEMO / SAMPLE DATA ONLY — not provider-backed operational records."
                                   Margin="0,5,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InfoColorBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Next"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding NextDemoTourStepCommand}"
                                AutomationProperties.AutomationId="DemoTourNextButton"
                                Margin="0,0,8,0" />
                        <Button Content="End Tour"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding EndDemoTourCommand}"
                                AutomationProperties.AutomationId="DemoTourEndButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="DesktopAuthenticationBanner"
                    Visibility="{Binding AuthenticatedSessionVisibility}"
                    Padding="14,8"
                    Background="{StaticResource ConsoleBackgroundMediumBrush}"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    AutomationProperties.Name="Desktop authentication session"
                    AutomationProperties.AutomationId="DesktopAuthenticationSessionBanner">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{StaticResource ConsoleBackgroundLightBrush}"
                            BorderBrush="{StaticResource ConsoleBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <TextBlock Text="{StaticResource IconLock}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="15"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Signed in as"
                                   FontSize="12"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AuthenticatedOperatorText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Padding="8,3"
                                Margin="10,0"
                                CornerRadius="999"
                                Background="{StaticResource ConsoleBackgroundLightBrush}"
                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AuthenticatedRoleText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="160" />
                        </Border>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding AuthenticatedSessionDetail}"
                                   FontSize="12"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Button Grid.Column="2"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="10,6"
                            AutomationProperties.Name="Log out"
                            AutomationProperties.AutomationId="DesktopLogoutButton"
                            ToolTip="Log out and return to the Meridian startup screen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconBack}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Log out"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <Frame x:Name="RootFrame"
               Grid.Row="1"
               AllowDrop="True"
               Background="{DynamicResource ShellWindowBackgroundBrush}"
               NavigationUIVisibility="Hidden"
               Navigated="OnRootFrameNavigated"
               DragEnter="OnRootFrameDragEnter"
               DragOver="OnRootFrameDragOver"
               DragLeave="OnRootFrameDragLeave"
               Drop="OnRootFrameDrop" />

        <!-- Drop overlay: shown while a file drag is in progress over the window -->
        <Grid x:Name="DropOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Panel.ZIndex="100">
            <Rectangle Fill="{StaticResource DropOverlayFillBrush}" />
            <Border BorderBrush="{StaticResource DropOverlayBorderBrush}" BorderThickness="3" Margin="24" CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="DropOverlayIcon"
                               Text="&#xE896;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="48" Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropOverlayTitle"
                               Text="Drop to Import"
                               FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock x:Name="DropOverlaySubtitle"
                               Text="CSV · JSON · JSONL · Parquet"
                               FontSize="14" Foreground="{StaticResource DropOverlaySubtitleBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Clipboard symbol detection banner: light theme, Marquee-style -->
        <Border x:Name="ClipboardSymbolBanner"
                Grid.Row="1"
                VerticalAlignment="Top"
                Visibility="{Binding ClipboardBannerVisibility}"
                Padding="16,8"
                Panel.ZIndex="50"
                Background="{StaticResource ConsoleBackgroundLightBrush}"
                BorderBrush="{StaticResource InfoColorBrush}" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="&#xE72D;"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           Foreground="{StaticResource InfoColorBrush}" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ClipboardBannerText"
                           Grid.Column="1"
                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" VerticalAlignment="Center" FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ClipboardBannerText}"/>
                <Button x:Name="ClipboardAddButton"
                        Grid.Column="2"
                        Content="Add to Watchlist"
                        Margin="12,0,8,0" Padding="10,4"
                        Command="{Binding AddClipboardSymbolsCommand}"/>
                <Button x:Name="ClipboardDismissButton"
                        Grid.Column="3"
                        Content="Dismiss"
                        Padding="10,4"
                        Command="{Binding DismissClipboardBannerCommand}"/>
            </Grid>
        </Border>

        <!-- Persistent status bar: pinned to bottom, 32px height -->
        <views:StatusBarControl Grid.Row="2" DataContext="{Binding StatusBar}" />
    </Grid>
</Window>
