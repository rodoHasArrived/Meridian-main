<UserControl x:Class="Meridian.Wpf.Controls.EvidenceLinkChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d"
             MinHeight="42"
             d:DesignHeight="72" d:DesignWidth="360"
             AutomationProperties.AutomationId="{Binding ElementName=Root, Path=ChipAutomationId}"
             AutomationProperties.Name="{Binding ElementName=Root, Path=Label}">
    <Border x:Name="ChipBorder"
            DataContext="{Binding ElementName=Root}"
            Style="{StaticResource WorkstationSignifierEvidenceChipStyle}"
            AutomationProperties.AutomationId="{Binding ChipAutomationId}"
            AutomationProperties.Name="{Binding Label}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="LabelText"
                           Text="{Binding Label}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding LabelAutomationId}" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock x:Name="SourceText"
                               Text="{Binding Source}"
                               FontSize="10"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               AutomationProperties.AutomationId="{Binding SourceAutomationId}" />
                    <TextBlock Text="  "
                               FontSize="10" />
                    <TextBlock x:Name="TimestampTextBlock"
                               Text="{Binding TimestampText}"
                               FontSize="10"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               AutomationProperties.AutomationId="{Binding TimestampAutomationId}" />
                </WrapPanel>
                <TextBlock x:Name="TargetText"
                           Text="{Binding Target}"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding TargetAutomationId}" />
                <TextBlock x:Name="DetailText"
                           Text="{Binding Detail}"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding DetailAutomationId}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button x:Name="OpenButton"
                    Grid.Column="1"
                    Content="{Binding ActionText}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{Binding CommandParameter}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="{Binding ActionButtonAutomationId}"
                    AutomationProperties.Name="{Binding ActionText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NavigateCommand}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActionText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
