<UserControl x:Class="Meridian.Wpf.Controls.PreparerDraftCheckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Retained non-postable calculation preparer check">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" /></UserControl.Resources>
    <Border BorderThickness="1" BorderBrush="{DynamicResource ConsoleBorderBrush}" Padding="12" Margin="0,10,0,10">
        <StackPanel>
            <TextBlock Text="Retained calculation preparer check" FontWeight="SemiBold" />
            <TextBlock Text="Attested by preparer — not independently reviewed. This checks an exact retained non-postable run only; it does not recalculate, approve, post, close or earn Verified Coverage."
                       TextWrapping="Wrap" Margin="0,6,0,8" />
            <TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" />
            <Button Content="Inspect exact retained draft and authority" Command="{Binding InspectCommand}" HorizontalAlignment="Left" Margin="0,8,0,8" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding SnapshotText}" TextWrapping="Wrap" Margin="0,6,0,6" />
            <ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding PendingCommandText}" TextWrapping="Wrap" Margin="0,6,0,6"
                       Visibility="{Binding HasPendingCommand, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Retry the same uncertain draft-check command" Command="{Binding RetryCommand}" HorizontalAlignment="Left"
                    Visibility="{Binding HasPendingCommand, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Label Content="Draft-check reason" Target="{Binding ElementName=DraftCheckReason}" />
            <TextBox x:Name="DraftCheckReason" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="4000" />
            <CheckBox IsChecked="{Binding IsConfirmed}" IsEnabled="{Binding CanEdit}" Margin="0,8,0,8">
                <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" />
            </CheckBox>
            <Button Content="Record my preparer draft check" Command="{Binding RecordCommand}" HorizontalAlignment="Left" />
            <Button Content="Open non-posting declaration and audit history" Command="{Binding OpenDeclarationCommand}" HorizontalAlignment="Left" Margin="0,8,0,8" />
            <ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Label Content="My retained draft check to revoke" Target="{Binding ElementName=DraftReceipt}" />
            <ComboBox x:Name="DraftReceipt" ItemsSource="{Binding RevocableReceipts}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedReceipt}" IsEnabled="{Binding CanEdit}" />
            <Label Content="Corrective revocation reason" Target="{Binding ElementName=DraftRevocationReason}" />
            <TextBox x:Name="DraftRevocationReason" Text="{Binding RevocationReason, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="4000" />
            <Button Content="Revoke my selected preparer draft check" Command="{Binding RevokeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
