<UserControl x:Class="Meridian.Wpf.Controls.WorkspaceAttentionRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Meridian.Wpf.Controls"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="72"
             d:DesignWidth="1100"
             AutomationProperties.AutomationId="{Binding PanelAutomationId}"
             AutomationProperties.Name="{Binding SummaryText}">
    <controls:InlineAlertPanel Title="{Binding SeverityLabel}"
                               Message="{Binding SummaryWithTimestamp}"
                               Tone="{Binding Tone}"
                               IconGlyph="{Binding IconGlyph}"
                               ActionText="{Binding PrimaryActionLabel}"
                               ActionCommand="{Binding PrimaryActionCommand}"
                               PanelAutomationId="{Binding PanelAutomationId}"
                               IconContainerAutomationId="{Binding IconContainerAutomationId}"
                               IconAutomationId="{Binding IconAutomationId}"
                               TitleAutomationId="{Binding SeverityAutomationId}"
                               MessageAutomationId="{Binding SummaryAutomationId}"
                               ActionButtonAutomationId="{Binding PrimaryActionAutomationId}" />
</UserControl>
