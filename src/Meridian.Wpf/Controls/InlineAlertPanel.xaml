<UserControl x:Class="Meridian.Wpf.Controls.InlineAlertPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d"
             MinHeight="56"
             d:DesignHeight="88" d:DesignWidth="520"
             AutomationProperties.AutomationId="{Binding ElementName=Root, Path=PanelAutomationId}"
             AutomationProperties.Name="{Binding ElementName=Root, Path=Title}">
    <Border x:Name="PanelBorder"
            DataContext="{Binding ElementName=Root}"
            AutomationProperties.AutomationId="{Binding PanelAutomationId}"
            AutomationProperties.Name="{Binding Title}">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource WorkspaceToneInspectorCardStyle}">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconContainer"
                    Grid.Column="0"
                    Width="34"
                    Height="34"
                    CornerRadius="6"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="{Binding IconContainerAutomationId}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource WorkspaceQueueStateIconContainerStyle}">
                        <Setter Property="Width" Value="34" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IconGlyph}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IconGlyph}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource ConsoleAccentGreenAlpha10Brush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessColorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Danger">
                                <Setter Property="Background" Value="{StaticResource ConsoleAccentRedAlpha10Brush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource ErrorColorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                <Setter Property="Background" Value="{StaticResource ConsoleAccentOrangeAlpha10Brush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningColorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="IconText"
                           Text="{Binding IconGlyph}"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="{Binding IconAutomationId}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WorkspaceToneBadgeTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Neutral">
                                    <Setter Property="Foreground" Value="{StaticResource InfoColorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding TitleAutomationId}" />
                <TextBlock x:Name="MessageText"
                           Text="{Binding Message}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding MessageAutomationId}" />
            </StackPanel>

            <Button x:Name="ActionButton"
                    Grid.Column="2"
                    Content="{Binding ActionText}"
                    Command="{Binding ActionCommand}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="{Binding ActionButtonAutomationId}"
                    AutomationProperties.Name="{Binding ActionText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionCommand}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActionText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
