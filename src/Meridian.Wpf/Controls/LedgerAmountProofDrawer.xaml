<UserControl x:Class="Meridian.Wpf.Controls.LedgerAmountProofDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="LedgerAmountProofDrawer"
             AutomationProperties.Name="Retained amount proof">
    <Border Padding="14" BorderThickness="1" BorderBrush="{DynamicResource ConsoleBorderBrush}"
            Background="{DynamicResource ConsoleBackgroundLightBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Close proof" Command="{Binding CloseCommand}"
                            AutomationProperties.AutomationId="LedgerAmountProofClose" Margin="8,0,0,0" />
                    <TextBlock Text="Amount proof" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="LedgerAmountProofStatus" />
                <TextBlock Text="{Binding SubjectId}" TextWrapping="Wrap" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="LedgerAmountProofSubject" />
                <TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource ConsoleTextSecondaryBrush}"
                           AutomationProperties.AutomationId="LedgerAmountProofScope" />
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0"
                              AutomationProperties.AutomationId="LedgerAmountProofWarnings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Retained supporting evidence" FontWeight="SemiBold" Margin="0,10,0,8" />
                <ItemsControl ItemsSource="{Binding Evidence}"
                              AutomationProperties.AutomationId="LedgerAmountProofEvidence">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,0,0,8" BorderThickness="1"
                                    BorderBrush="{DynamicResource ConsoleBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EvidenceId}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Kind}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourceSystem}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RetainedAt, StringFormat='Retained: {0:u}'}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ContentHash}" TextWrapping="Wrap" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                    <Button Content="Open retained manifest" Margin="0,6,0,0"
                                            Command="{Binding DataContext.OpenManifestCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="LedgerAmountProofOpenManifest" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding ManifestText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                         AutomationProperties.AutomationId="LedgerAmountProofManifest" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
