<UserControl x:Class="Meridian.Wpf.Controls.FilterChipBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d"
             MinHeight="42"
             d:DesignHeight="64" d:DesignWidth="640"
             AutomationProperties.AutomationId="{Binding ElementName=Root, Path=BarAutomationId}"
             AutomationProperties.Name="{Binding ElementName=Root, Path=ResultSummary}">
    <Border x:Name="BarBorder"
            DataContext="{Binding ElementName=Root}"
            Style="{StaticResource WorkstationFilterBarStyle}"
            AutomationProperties.AutomationId="{Binding BarAutomationId}"
            AutomationProperties.Name="{Binding ResultSummary}">
        <DockPanel LastChildFill="True">
            <Button x:Name="ClearAllButton"
                    DockPanel.Dock="Right"
                    Content="{Binding ClearAllText}"
                    Command="{Binding ClearAllCommand}"
                    Margin="12,0,0,0"
                    AutomationProperties.AutomationId="{Binding ClearAllButtonAutomationId}"
                    AutomationProperties.Name="{Binding ClearAllText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClearAllCommand}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ClearAllText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="ResultSummaryText"
                           Text="{Binding ResultSummary}"
                           Margin="0,0,12,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="{Binding ResultSummaryAutomationId}" />
                <ItemsControl x:Name="FilterItems"
                              ItemsSource="{Binding ItemsSource}"
                              Tag="{Binding ElementName=Root}"
                              AutomationProperties.AutomationId="{Binding ItemsAutomationId}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WorkstationFilterChipStyle}"
                                    AutomationProperties.Name="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Content="X"
                                            Command="{Binding Tag.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="6,0,0,0"
                                            Padding="2,0"
                                            MinWidth="16"
                                            AutomationProperties.Name="Remove filter">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </DockPanel>
    </Border>
</UserControl>
