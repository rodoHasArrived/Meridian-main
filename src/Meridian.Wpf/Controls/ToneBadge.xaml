<UserControl x:Class="Meridian.Wpf.Controls.ToneBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d"
             MinHeight="24"
             d:DesignHeight="30" d:DesignWidth="120"
             AutomationProperties.AutomationId="{Binding ElementName=Root, Path=BadgeAutomationId}"
             AutomationProperties.Name="{Binding ElementName=Root, Path=Text}">
    <Border x:Name="BadgeBorder"
            Style="{StaticResource WorkspaceToneBadgeStyle}"
            DataContext="{Binding ElementName=Root}"
            AutomationProperties.AutomationId="{Binding BadgeAutomationId}"
            AutomationProperties.Name="{Binding Text}">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText"
                       Text="{Binding IconGlyph}"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       Margin="0,0,5,0"
                       AutomationProperties.AutomationId="{Binding IconAutomationId}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource WorkspaceToneBadgeTextStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IconGlyph}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IconGlyph}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="BadgeText"
                       Text="{Binding Text}"
                       Style="{StaticResource WorkspaceToneBadgeTextStyle}"
                       AutomationProperties.AutomationId="{Binding TextAutomationId}" />
        </StackPanel>
    </Border>
</UserControl>
