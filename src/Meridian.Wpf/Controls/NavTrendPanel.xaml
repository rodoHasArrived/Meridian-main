<UserControl x:Class="Meridian.Wpf.Controls.NavTrendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Meridian.Wpf.Behaviors"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
             AutomationProperties.Name="NAV trend">
    <!-- DataContext: Meridian.Wpf.ViewModels.Comparisons.NavTrendSectionViewModel -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="NAV, last 12 month-ends" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Ledger NAV rebuilt as of each month-end, ending with NAV now, and the securities held long and short at the same dates."
                       Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" />

            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsMessageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="NavTrendMessage">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Retry NAV trend"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="NavTrendRetry" />
            </StackPanel>

            <scottplot:WpfPlot Height="240"
                               Margin="0,12,0,0"
                               behaviors:PlotRenderBehavior.Request="{Binding NavPlot}"
                               Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibilityConverter}}"
                               AutomationProperties.AutomationId="NavTrendChart"
                               AutomationProperties.Name="Ledger NAV by month-end" />

            <TextBlock Text="Exposure, last 12 month-ends" Style="{StaticResource CardHeaderStyle}" Margin="0,16,0,4"
                       Visibility="{Binding HasExposure, Converter={StaticResource BoolToVisibilityConverter}}" />
            <scottplot:WpfPlot Height="220"
                               behaviors:PlotRenderBehavior.Request="{Binding ExposurePlot}"
                               Visibility="{Binding HasExposure, Converter={StaticResource BoolToVisibilityConverter}}"
                               AutomationProperties.AutomationId="NavExposureChart"
                               AutomationProperties.Name="Securities exposure by month-end" />

            <workstation:DenseDataGridControl Table="{Binding Table}"
                                              Height="260"
                                              Margin="0,12,0,0"
                                              GridAutomationId="NavTrendGrid"
                                              EmptyAutomationId="NavTrendGridEmptyState"
                                              Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="NAV and exposure by month-end table" />

            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0" AutomationProperties.AutomationId="NavTrendNotes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
