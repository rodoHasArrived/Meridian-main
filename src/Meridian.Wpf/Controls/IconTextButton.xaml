<UserControl x:Class="Meridian.Wpf.Controls.IconTextButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d"
             MinHeight="32"
             d:DesignHeight="50" d:DesignWidth="150"
             AutomationProperties.AutomationId="{Binding ElementName=Root, Path=ButtonAutomationId}"
             AutomationProperties.Name="{Binding ElementName=Root, Path=Text}">
    <Button x:Name="InternalButton"
            Command="{Binding ElementName=Root, Path=Command}"
            CommandParameter="{Binding ElementName=Root, Path=CommandParameter}"
            Style="{Binding ElementName=Root, Path=ButtonStyle, TargetNullValue={StaticResource SecondaryButtonStyle}}"
            Click="OnInternalButtonClick"
            AutomationProperties.AutomationId="{Binding ElementName=Root, Path=ButtonAutomationId}"
            AutomationProperties.Name="{Binding ElementName=Root, Path=Text}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="IconText"
                       Text="{Binding ElementName=Root, Path=IconGlyph}"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       AutomationProperties.AutomationId="{Binding ElementName=Root, Path=IconAutomationId}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=IconGlyph}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=IconGlyph}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="LabelText"
                       Text="{Binding ElementName=Root, Path=Text}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="{Binding ElementName=Root, Path=TextAutomationId}" />
        </StackPanel>
    </Button>
</UserControl>
