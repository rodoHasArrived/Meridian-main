<UserControl x:Class="Meridian.Wpf.Workstation.Controls.WorkstationCommandBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource WorkspaceCommandBarSurfaceStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding ElementName=Root, Path=CommandGroup.PrimaryCommands}"
                          AutomationProperties.Name="Workstation command bar">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- DisabledReason renders inline below the label, so no tooltip is bound
                             here: WPF suppresses tooltips on disabled controls by default, which is
                             the only state where DisabledReason is populated. -->
                        <Button Tag="{Binding}"
                                Click="OnPrimaryCommandClick"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding IsEnabled}"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding Description}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Padding" Value="14,10" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <!-- Primary commands use the graphite primary action (Design System 4.3.0). -->
                                        <DataTrigger Binding="{Binding Tone}" Value="Primary">
                                            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ConsoleActionPrimaryBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource ConsoleActionPrimaryTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Danger">
                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorColorBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorColorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <!-- Secondary lines switch to light tokens on the graphite primary fill. -->
                                    <TextBlock Text="{Binding EvidenceSourceText}"
                                               FontSize="10"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ConsoleTextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Primary">
                                                        <Setter Property="Foreground" Value="{StaticResource ConsoleActionPrimaryMutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TargetText}"
                                               FontSize="10"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ConsoleTextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Primary">
                                                        <Setter Property="Foreground" Value="{StaticResource ConsoleActionPrimaryMutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DisabledReason}"
                                               FontSize="10"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WarningColorBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Primary">
                                                        <Setter Property="Foreground" Value="{StaticResource ConsoleActionPrimaryWarningTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="MoreButton"
                    Grid.Column="1"
                    Margin="8,0,0,8"
                    Click="OnMoreButtonClick"
                    AutomationProperties.Name="More Workstation Commands"
                    Style="{StaticResource GhostButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE712;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="More"
                               Margin="8,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
