<UserControl x:Class="Meridian.Wpf.Workstation.Controls.MetricTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="170"
             MinHeight="96">
    <Border Padding="12"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{Binding ElementName=Root, Path=Metric.AccentBrush}"
            Background="{StaticResource PremiumPanelBrush}"
            AutomationProperties.Name="{Binding ElementName=Root, Path=Metric.Label}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding ElementName=Root, Path=Metric.Label}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ElementName=Root, Path=Metric.Value}"
                           Margin="0,6,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{Binding ElementName=Root, Path=Metric.AccentBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ElementName=Root, Path=Metric.Detail}"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding ElementName=Root, Path=Metric.Glyph}"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       FontSize="20"
                       Foreground="{Binding ElementName=Root, Path=Metric.AccentBrush}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Top" />
        </Grid>
    </Border>
</UserControl>
