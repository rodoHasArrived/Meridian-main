<UserControl x:Class="Meridian.Wpf.Workstation.Controls.HealthBadgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border x:Name="BadgeBorder"
            CornerRadius="10"
            Padding="8,4"
            BorderThickness="1"
            BorderBrush="{StaticResource ConsoleBorderBrush}"
            Background="{StaticResource PremiumPanelBrush}"
            AutomationProperties.Name="{Binding ElementName=Root, Path=Badge.Label}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ElementName=Root, Path=Badge.Glyph}"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ElementName=Root, Path=Badge.Label}"
                       Margin="6,0,0,0"
                       FontSize="11"
                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ElementName=Root, Path=Badge.Value}"
                       Margin="6,0,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
