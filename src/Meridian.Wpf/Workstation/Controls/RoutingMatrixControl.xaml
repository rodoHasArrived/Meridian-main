<UserControl x:Class="Meridian.Wpf.Workstation.Controls.RoutingMatrixControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel AutomationProperties.Name="{Binding ElementName=Root, Path=Matrix.Title}">
        <TextBlock Text="{Binding ElementName=Root, Path=Matrix.Title}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
        <TextBlock Text="{Binding ElementName=Root, Path=Matrix.Detail}"
                   Margin="0,4,0,8"
                   Style="{StaticResource CardDescriptionStyle}"
                   TextWrapping="Wrap" />
        <ListView ItemsSource="{Binding ElementName=Root, Path=Matrix.Rows}"
                  MinHeight="120"
                  AutomationProperties.Name="Routing matrix">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Workflow" Width="120" DisplayMemberBinding="{Binding Workflow}" />
                    <GridViewColumn Header="Route" Width="120" DisplayMemberBinding="{Binding Route}" />
                    <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="Detail" Width="230" DisplayMemberBinding="{Binding Detail}" />
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>
