<UserControl x:Class="Meridian.Wpf.Workstation.Controls.DiagnosticsChecklistControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel AutomationProperties.Name="{Binding ElementName=Root, Path=Checklist.Title}">
        <TextBlock Text="{Binding ElementName=Root, Path=Checklist.Title}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
        <TextBlock Text="{Binding ElementName=Root, Path=Checklist.Detail}"
                   Margin="0,4,0,8"
                   Style="{StaticResource CardDescriptionStyle}"
                   TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding ElementName=Root, Path=Checklist.Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource ConsoleBorderBrush}"
                            Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="12"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource InfoColorBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
