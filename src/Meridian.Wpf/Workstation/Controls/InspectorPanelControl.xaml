<UserControl x:Class="Meridian.Wpf.Workstation.Controls.InspectorPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Meridian.Wpf.Workstation.Controls"
             x:Name="Root">
    <Border Style="{StaticResource CardStyle}"
            Padding="16"
            AutomationProperties.Name="{Binding ElementName=Root, Path=Panel.Title}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ElementName=Root, Path=Panel.Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ElementName=Root, Path=Panel.Subtitle}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <controls:HealthBadgeControl Grid.Column="1"
                                             Badge="{Binding ElementName=Root, Path=Panel.Badge}"
                                             Margin="12,0,0,0" />
            </Grid>

            <TextBlock Text="{Binding ElementName=Root, Path=Panel.Detail}"
                       Margin="0,12,0,0"
                       Style="{StaticResource CardDescriptionStyle}"
                       TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding ElementName=Root, Path=Panel.Facts}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding Value}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
