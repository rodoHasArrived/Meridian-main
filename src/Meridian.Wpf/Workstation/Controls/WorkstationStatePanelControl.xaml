<UserControl x:Class="Meridian.Wpf.Workstation.Controls.WorkstationStatePanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border CornerRadius="8"
            Padding="14"
            BorderThickness="1"
            BorderBrush="{StaticResource ConsoleBorderBrush}"
            Background="{StaticResource PremiumPanelBrush}"
            AutomationProperties.Name="{Binding ElementName=Root, Path=State.Title}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding ElementName=Root, Path=State.Glyph}"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       FontSize="20"
                       Foreground="{StaticResource InfoColorBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding ElementName=Root, Path=State.Title}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding ElementName=Root, Path=TitleAutomationId}" />
                <TextBlock Text="{Binding ElementName=Root, Path=State.Detail}"
                           Margin="0,4,0,0"
                           Style="{StaticResource CardDescriptionStyle}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding ElementName=Root, Path=DetailAutomationId}" />
                <TextBlock Text="{Binding ElementName=Root, Path=State.EvidenceText}"
                           Margin="0,7,0,0"
                           FontSize="12"
                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="{Binding ElementName=Root, Path=EvidenceAutomationId}" />
                <Border Margin="0,10,0,0"
                        Style="{StaticResource WorkstationSignifierEvidenceChipStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ElementName=Root, Path=State.ActionPosture.Owner}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ElementName=Root, Path=State.ActionPosture.Detail}"
                                   FontSize="12"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Grid.Column="2"
                    Style="{StaticResource WorkstationSignifierActionPanelStyle}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ElementName=Root, Path=State.ActionText}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InfoColorBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ElementName=Root, Path=State.TargetText}"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,8,0,0"
                            Style="{StaticResource WorkstationSignifierSignoffChipStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ElementName=Root, Path=State.SignoffRequirement.Role}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningColorBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ElementName=Root, Path=State.SignoffRequirement.Status}"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ElementName=Root, Path=State.SignoffRequirement.Detail}"
                                       FontSize="10"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding ElementName=Root, Path=State.VisibleEvidenceLinks}"
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WorkstationSignifierEvidenceChipStyle}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ConsoleTextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Target}" FontSize="10" Foreground="{StaticResource ConsoleTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ElementName=Root, Path=State.VisibleRecoveryActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WorkstationSignifierRecoveryChipStyle}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoColorBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource ConsoleTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
