<UserControl x:Class="Meridian.Wpf.Workstation.Controls.WorkstationTableInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Meridian.Wpf.Workstation.Controls"
             x:Name="Root"
             AutomationProperties.AutomationId="{Binding ElementName=Root, Path=ControlAutomationId}"
             AutomationProperties.Name="{Binding ElementName=Root, Path=HeaderText}">
    <UserControl.Resources>
        <Style x:Key="OptionalContentPresenterStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource WorkstationTablePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource WorkstationPanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="{Binding ElementName=Root, Path=HeaderText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ElementName=Root, Path=DetailText}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   VerticalAlignment="Top">
                            <Border Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource WorkstationFilterChipStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=Root, Path=ScopeText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=Root, Path=ScopeText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ElementName=Root, Path=ScopeText}"
                                           FontSize="11"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                            </Border>

                            <ContentPresenter Content="{Binding ElementName=Root, Path=ToolbarContent}"
                                              Style="{StaticResource OptionalContentPresenterStyle}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource WorkstationPanelBodyStyle}">
                    <controls:DenseDataGridControl x:Name="TableGrid"
                                                   Table="{Binding ElementName=Root, Path=Table}"
                                                   SelectedItem="{Binding ElementName=Root, Path=SelectedItem, Mode=TwoWay}"
                                                   SelectedItems="{Binding ElementName=Root, Path=SelectedItems}"
                                                   SelectionMode="{Binding ElementName=Root, Path=SelectionMode}"
                                                   GridAutomationId="{Binding ElementName=Root, Path=GridAutomationId}"
                                                   EmptyAutomationId="{Binding ElementName=Root, Path=EmptyAutomationId}" />
                </Border>

                <Border Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource WorkstationDockStripStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=Root, Path=FooterContent}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentPresenter Content="{Binding ElementName=Root, Path=FooterContent}"
                                      Style="{StaticResource OptionalContentPresenterStyle}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource WorkstationInspectorRailStyle}"
                AutomationProperties.AutomationId="{Binding ElementName=Root, Path=InspectorAutomationId}"
                AutomationProperties.Name="{Binding ElementName=Root, Path=Inspector.Title}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10">
                <StackPanel>
                    <controls:InspectorPanelControl x:Name="DefaultInspector"
                                                    Panel="{Binding ElementName=Root, Path=Inspector}"
                                                    AutomationProperties.AutomationId="{Binding ElementName=Root, Path=InspectorAutomationId}" />
                    <ContentPresenter Content="{Binding ElementName=Root, Path=InspectorContent}"
                                      Margin="0,12,0,0"
                                      Style="{StaticResource OptionalContentPresenterStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
