<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:views="clr-namespace:Meridian.Wpf.Views">

    <!-- Programmed Institutionalism 4.3.0 palette (Meridian Design System tokens/): paper canvas, graphite chrome and primary action, terracotta brand signal, blue focus/selection. -->

    <!-- Backgrounds: paper canvas, panel, hover, and active states -->
    <Color x:Key="ConsoleBackgroundDark">#F2F0EB</Color>
    <Color x:Key="ConsoleBackgroundMedium">#EBE8E1</Color>
    <Color x:Key="ConsoleBackgroundLight">#F8F7F3</Color>
    <Color x:Key="ConsoleBackgroundHover">#EDEFF0</Color>
    <Color x:Key="ConsoleBackgroundActive">#E7EDF2</Color>
    <!-- Elevated card surface: white paper for dense tables and inspector panels -->
    <Color x:Key="ConsoleCardSurface">#F8F7F3</Color>
    <Color x:Key="ConsoleCardSurfaceRaised">#FCFBF8</Color>

    <!-- Borders: refined hairline separators -->
    <Color x:Key="ConsoleBorderColor">#D2CDC3</Color>
    <Color x:Key="ConsoleBorderHover">#BEB8AD</Color>
    <Color x:Key="ConsoleBorderFocus">#2D6FB3</Color>
    <Color x:Key="ConsoleBorderStrong">#AAA49A</Color>

    <!-- Text: high-contrast primary, balanced secondaries -->
    <Color x:Key="ConsoleTextPrimary">#20252B</Color>
    <Color x:Key="ConsoleTextSecondary">#535C65</Color>
    <Color x:Key="ConsoleTextMuted">#606870</Color>
    <Color x:Key="ConsoleTextDisabled">#A4ABB2</Color>

    <!-- Accents: premium institutional palette -->
    <Color x:Key="ConsoleAccentGreen">#2E7655</Color>
    <Color x:Key="ConsoleAccentGreenDim">#255E44</Color>
    <Color x:Key="ConsoleAccentGreenLight">#65A983</Color>
    <Color x:Key="ConsoleAccentBlue">#2D6FB3</Color>
    <Color x:Key="ConsoleAccentBlueDim">#24598F</Color>
    <Color x:Key="ConsoleAccentBlueVibrant">#3A7BBF</Color>
    <Color x:Key="ConsoleAccentPurple">#2F648A</Color>
    <Color x:Key="ConsoleAccentPurpleDim">#26506E</Color>
    <Color x:Key="ConsoleAccentRed">#B54B42</Color>
    <Color x:Key="ConsoleAccentRedDim">#913C35</Color>
    <Color x:Key="ConsoleAccentOrange">#986717</Color>
    <Color x:Key="ConsoleAccentOrangeDim">#7A5212</Color>
    <Color x:Key="ConsoleAccentCyan">#C56343</Color>
    <Color x:Key="ConsoleAccentCyanDim">#A9512F</Color>
    <Color x:Key="ConsoleAccentPink">#A2506F</Color>
    <Color x:Key="ConsoleAccentYellow">#C69B4D</Color>

    <!-- Alpha overlays for active/badge backgrounds -->
    <Color x:Key="ConsoleAccentGreenAlpha10">#1A2E7655</Color>
    <Color x:Key="ConsoleAccentGreenAlpha20">#332E7655</Color>
    <Color x:Key="ConsoleAccentBlueAlpha10">#1A2D6FB3</Color>
    <Color x:Key="ConsoleAccentBlueAlpha20">#332D6FB3</Color>
    <Color x:Key="ConsoleAccentRedAlpha10">#1AB54B42</Color>
    <Color x:Key="ConsoleAccentRedAlpha20">#33B54B42</Color>
    <Color x:Key="ConsoleAccentOrangeAlpha10">#1A986717</Color>
    <Color x:Key="ConsoleAccentOrangeAlpha20">#33986717</Color>
    <Color x:Key="ConsoleAccentPurpleAlpha10">#1A2F648A</Color>

    <!-- Chart preview tokens from the Meridian design-system bundle -->
    <Color x:Key="ChartSurfaceColor">#F8F7F3</Color>
    <Color x:Key="ChartPlotAreaColor">#FCFBF8</Color>
    <Color x:Key="ChartGridLineColor">#E2DED5</Color>
    <Color x:Key="ChartAxisLabelColor">#606870</Color>
    <Color x:Key="ChartBorderColor">#D2CDC3</Color>
    <Color x:Key="ChartCrosshairColor">#C56343</Color>
    <Color x:Key="ChartPrimaryLineColor">#29323A</Color>
    <Color x:Key="ChartSecondaryLineColor">#8C918F</Color>
    <Color x:Key="ChartEquityColor">#2E7655</Color>
    <Color x:Key="ChartEquityAlpha20Color">#332E7655</Color>
    <Color x:Key="ChartDrawdownColor">#B54B42</Color>
    <Color x:Key="ChartDrawdownAlpha20Color">#33B54B42</Color>
    <Color x:Key="ChartWarningLineColor">#986717</Color>

    <!-- Environment roles: live red, simulated paper slate, fixture warning amber. -->
    <Color x:Key="ModeLiveColor">#B54B42</Color>
    <Color x:Key="ModePaperColor">#5D7286</Color>
    <Color x:Key="ModeFixtureColor">#986717</Color>
    <Color x:Key="ModeHealthyColor">#2E7655</Color>
    <Color x:Key="ModeCriticalColor">#B54B42</Color>

    <!-- Primary action: graphite fill with an inverse label (Design System 4.3.0). Terracotta is
         the brand signal only; focus and selection use the interaction blue (ConsoleAccentBlue). -->
    <Color x:Key="ConsoleActionPrimary">#29323A</Color>
    <Color x:Key="ConsoleActionPrimaryHover">#424A50</Color>
    <Color x:Key="ConsoleActionPrimaryPressed">#575D63</Color>
    <Color x:Key="ConsoleActionPrimaryText">#F5F3EE</Color>

    <!-- Top bar colors: graphite chrome bar -->
    <Color x:Key="TopBarBackground">#29323A</Color>
    <Color x:Key="TopBarText">#F1EFEA</Color>
    <Color x:Key="TopBarBorder">#474E54</Color>
    <Color x:Key="TopBarIconAccent">#F1EFEA</Color>

    <!-- ── Solid brushes ── -->
    <SolidColorBrush x:Key="ConsoleActionPrimaryBrush"        Color="{StaticResource ConsoleActionPrimary}" />
    <SolidColorBrush x:Key="ConsoleActionPrimaryHoverBrush"   Color="{StaticResource ConsoleActionPrimaryHover}" />
    <SolidColorBrush x:Key="ConsoleActionPrimaryPressedBrush" Color="{StaticResource ConsoleActionPrimaryPressed}" />
    <SolidColorBrush x:Key="ConsoleActionPrimaryTextBrush"    Color="{StaticResource ConsoleActionPrimaryText}" />
    <SolidColorBrush x:Key="ConsoleBackgroundDarkBrush"    Color="{StaticResource ConsoleBackgroundDark}" />
    <SolidColorBrush x:Key="ConsoleBackgroundMediumBrush"  Color="{StaticResource ConsoleBackgroundMedium}" />
    <SolidColorBrush x:Key="ConsoleBackgroundLightBrush"   Color="{StaticResource ConsoleBackgroundLight}" />
    <SolidColorBrush x:Key="ConsoleBackgroundHoverBrush"   Color="{StaticResource ConsoleBackgroundHover}" />
    <SolidColorBrush x:Key="ConsoleBackgroundActiveBrush"  Color="{StaticResource ConsoleBackgroundActive}" />
    <SolidColorBrush x:Key="ConsoleCardSurfaceBrush"       Color="{StaticResource ConsoleCardSurface}" />
    <SolidColorBrush x:Key="ConsoleCardSurfaceRaisedBrush" Color="{StaticResource ConsoleCardSurfaceRaised}" />
    <SolidColorBrush x:Key="ConsoleBorderBrush"            Color="{StaticResource ConsoleBorderColor}" />
    <SolidColorBrush x:Key="ConsoleBorderHoverBrush"       Color="{StaticResource ConsoleBorderHover}" />
    <SolidColorBrush x:Key="ConsoleBorderFocusBrush"       Color="{StaticResource ConsoleBorderFocus}" />
    <SolidColorBrush x:Key="ConsoleBorderStrongBrush"      Color="{StaticResource ConsoleBorderStrong}" />
    <SolidColorBrush x:Key="BorderSubtleBrush"             Color="{StaticResource ConsoleBorderColor}" />
    <SolidColorBrush x:Key="ConsoleTextPrimaryBrush"       Color="{StaticResource ConsoleTextPrimary}" />
    <SolidColorBrush x:Key="ConsoleTextSecondaryBrush"     Color="{StaticResource ConsoleTextSecondary}" />
    <SolidColorBrush x:Key="ConsoleTextMutedBrush"         Color="{StaticResource ConsoleTextMuted}" />
    <SolidColorBrush x:Key="ConsoleTextDisabledBrush"      Color="{StaticResource ConsoleTextDisabled}" />
    <!-- Legacy aliases retained for older page XAML -->
    <SolidColorBrush x:Key="ConsoleTextBrush"              Color="{StaticResource ConsoleTextPrimary}" />
    <SolidColorBrush x:Key="ConsoleBackgroundBrush"        Color="{StaticResource ConsoleBackgroundLight}" />
    <SolidColorBrush x:Key="ConsoleWindowBackgroundBrush"  Color="{StaticResource ConsoleBackgroundDark}" />
    <SolidColorBrush x:Key="ConsoleWindowBorderBrush"      Color="{StaticResource ConsoleBorderColor}" />
    <SolidColorBrush x:Key="ConsoleAccentBlueAlpha80Brush" Color="#CC2D6FB3" />
    <SolidColorBrush x:Key="SuccessColorBrush"             Color="{StaticResource ConsoleAccentGreen}" />
    <SolidColorBrush x:Key="WarningColorBrush"             Color="{StaticResource ConsoleAccentOrange}" />
    <SolidColorBrush x:Key="ErrorColorBrush"               Color="{StaticResource ConsoleAccentRed}" />
    <SolidColorBrush x:Key="InfoColorBrush"                Color="{StaticResource ConsoleAccentBlue}" />
    <SolidColorBrush x:Key="ConsoleAccentBlueBrush"        Color="{StaticResource ConsoleAccentBlue}" />
    <!-- Opaque interaction hover fill; primary actions use the separate graphite family. -->
    <SolidColorBrush x:Key="ConsoleAccentBlueHoverBrush"   Color="{StaticResource ConsoleAccentBlueVibrant}" />
    <SolidColorBrush x:Key="ConsoleAccentBlueDimBrush"     Color="{StaticResource ConsoleAccentBlueDim}" />
    <SolidColorBrush x:Key="AccentCyanBrush"               Color="{StaticResource ConsoleAccentCyan}" />
    <SolidColorBrush x:Key="AccentPurpleBrush"             Color="{StaticResource ConsoleAccentPurple}" />
    <SolidColorBrush x:Key="ConsoleAccentGreenDimBrush"    Color="{StaticResource ConsoleAccentGreenDim}" />
    <SolidColorBrush x:Key="ConsoleAccentGreenLightBrush"  Color="{StaticResource ConsoleAccentGreenLight}" />
    <SolidColorBrush x:Key="ConsoleAccentGreenAlpha10Brush"  Color="{StaticResource ConsoleAccentGreenAlpha10}" />
    <SolidColorBrush x:Key="ConsoleAccentGreenAlpha20Brush"  Color="{StaticResource ConsoleAccentGreenAlpha20}" />
    <SolidColorBrush x:Key="SuccessColorAlpha20Brush"        Color="{StaticResource ConsoleAccentGreenAlpha20}" />
    <SolidColorBrush x:Key="ConsoleAccentBlueAlpha10Brush"   Color="{StaticResource ConsoleAccentBlueAlpha10}" />
    <SolidColorBrush x:Key="ConsoleAccentBlueAlpha20Brush"   Color="{StaticResource ConsoleAccentBlueAlpha20}" />
    <SolidColorBrush x:Key="ConsoleAccentRedAlpha10Brush"    Color="{StaticResource ConsoleAccentRedAlpha10}" />
    <SolidColorBrush x:Key="ConsoleAccentRedAlpha20Brush"    Color="{StaticResource ConsoleAccentRedAlpha20}" />
    <SolidColorBrush x:Key="ConsoleAccentOrangeAlpha10Brush" Color="{StaticResource ConsoleAccentOrangeAlpha10}" />
    <SolidColorBrush x:Key="ConsoleAccentOrangeAlpha20Brush" Color="{StaticResource ConsoleAccentOrangeAlpha20}" />
    <SolidColorBrush x:Key="ConsoleAccentPurpleAlpha10Brush" Color="{StaticResource ConsoleAccentPurpleAlpha10}" />

    <SolidColorBrush x:Key="ChartSurfaceBrush" Color="{StaticResource ChartSurfaceColor}" />
    <SolidColorBrush x:Key="ChartPlotAreaBrush" Color="{StaticResource ChartPlotAreaColor}" />
    <SolidColorBrush x:Key="ChartGridLineBrush" Color="{StaticResource ChartGridLineColor}" />
    <SolidColorBrush x:Key="ChartAxisLabelBrush" Color="{StaticResource ChartAxisLabelColor}" />
    <SolidColorBrush x:Key="ChartBorderBrush" Color="{StaticResource ChartBorderColor}" />
    <SolidColorBrush x:Key="ChartCrosshairBrush" Color="{StaticResource ChartCrosshairColor}" />
    <SolidColorBrush x:Key="ChartPrimaryLineBrush" Color="{StaticResource ChartPrimaryLineColor}" />
    <SolidColorBrush x:Key="ChartSecondaryLineBrush" Color="{StaticResource ChartSecondaryLineColor}" />
    <SolidColorBrush x:Key="ChartEquityBrush" Color="{StaticResource ChartEquityColor}" />
    <SolidColorBrush x:Key="ChartEquityAlpha20Brush" Color="{StaticResource ChartEquityAlpha20Color}" />
    <SolidColorBrush x:Key="ChartDrawdownBrush" Color="{StaticResource ChartDrawdownColor}" />
    <SolidColorBrush x:Key="ChartDrawdownAlpha20Brush" Color="{StaticResource ChartDrawdownAlpha20Color}" />
    <SolidColorBrush x:Key="ChartWarningLineBrush" Color="{StaticResource ChartWarningLineColor}" />
    <SolidColorBrush x:Key="ChartLoadingOverlayBrush" Color="#D914120F" />

    <DrawingBrush x:Key="ChartCanvasGridBrush"
                  TileMode="Tile"
                  Viewbox="0,0,40,40"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,40,40"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource ChartPlotAreaBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,40,40" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource ChartGridLineBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="ModeLiveBrush"     Color="{StaticResource ModeLiveColor}" />
    <SolidColorBrush x:Key="ModePaperBrush"    Color="{StaticResource ModePaperColor}" />
    <SolidColorBrush x:Key="ModeFixtureBrush"  Color="{StaticResource ModeFixtureColor}" />
    <SolidColorBrush x:Key="ModeHealthyBrush"  Color="{StaticResource ModeHealthyColor}" />
    <SolidColorBrush x:Key="ModeCriticalBrush" Color="{StaticResource ModeCriticalColor}" />

    <SolidColorBrush x:Key="WorkstationSignifierReadyBrush" Color="{StaticResource ConsoleAccentGreenAlpha10}" />
    <SolidColorBrush x:Key="WorkstationSignifierReadyBorderBrush" Color="{StaticResource ConsoleAccentGreen}" />
    <SolidColorBrush x:Key="WorkstationSignifierWarningBrush" Color="{StaticResource ConsoleAccentOrangeAlpha10}" />
    <SolidColorBrush x:Key="WorkstationSignifierWarningBorderBrush" Color="{StaticResource ConsoleAccentOrange}" />
    <SolidColorBrush x:Key="WorkstationSignifierBlockedBrush" Color="{StaticResource ConsoleAccentRedAlpha10}" />
    <SolidColorBrush x:Key="WorkstationSignifierBlockedBorderBrush" Color="{StaticResource ConsoleAccentRed}" />
    <SolidColorBrush x:Key="WorkstationSignifierStaleBrush" Color="{StaticResource ConsoleAccentPurpleAlpha10}" />
    <SolidColorBrush x:Key="WorkstationSignifierStaleBorderBrush" Color="{StaticResource ConsoleAccentPurple}" />
    <SolidColorBrush x:Key="WorkstationSignifierSignoffBrush" Color="{StaticResource ConsoleAccentOrangeAlpha10}" />
    <SolidColorBrush x:Key="WorkstationSignifierSignoffBorderBrush" Color="{StaticResource ConsoleAccentOrange}" />
    <SolidColorBrush x:Key="WorkstationSignifierRecoveryBrush" Color="{StaticResource ConsoleAccentBlueAlpha10}" />
    <SolidColorBrush x:Key="WorkstationSignifierRecoveryBorderBrush" Color="{StaticResource ConsoleAccentBlue}" />
    <SolidColorBrush x:Key="WorkstationSignifierEvidenceBrush" Color="{StaticResource ConsoleAccentBlueAlpha10}" />
    <SolidColorBrush x:Key="WorkstationSignifierEvidenceBorderBrush" Color="{StaticResource ConsoleBorderStrong}" />

    <!-- Compatibility brush retained; stops are intentionally near-solid to avoid glow-heavy chrome. -->
    <LinearGradientBrush x:Key="GlowGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource ConsoleAccentBlue}" Offset="0" />
        <GradientStop Color="{StaticResource ConsoleAccentBlue}" Offset="1" />
    </LinearGradientBrush>

    <!-- Compatibility brush retained; top bars render as a quiet solid surface. -->
    <LinearGradientBrush x:Key="TopBarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource TopBarBackground}" Offset="0" />
        <GradientStop Color="{StaticResource TopBarBackground}" Offset="1" />
    </LinearGradientBrush>

    <!-- Compatibility brush retained; sidebar depth comes from borders, not gradients. -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F6F8" Offset="0" />
        <GradientStop Color="#F4F6F8" Offset="1" />
    </LinearGradientBrush>

    <!-- Sidebar background is needed by shell surface brushes below, so declare it before use. -->
    <Color x:Key="SidebarBackground">#EBE8E1</Color>

    <!-- Shell surfaces: clean, elevated canvas -->
    <SolidColorBrush x:Key="ShellWindowBackgroundBrush" Color="{StaticResource ConsoleBackgroundDark}" />
    <SolidColorBrush x:Key="ShellRailBackgroundBrush"   Color="{StaticResource SidebarBackground}" />

    <!-- Top bar: near-black, Marquee brand bar -->
    <SolidColorBrush x:Key="TopBarBackgroundBrush"      Color="{StaticResource TopBarBackground}" />
    <SolidColorBrush x:Key="TopBarTextBrush"            Color="{StaticResource TopBarText}" />
    <SolidColorBrush x:Key="TopBarBorderBrush"          Color="{StaticResource TopBarBorder}" />
    <SolidColorBrush x:Key="TopBarIconAccentBrush"      Color="{StaticResource TopBarIconAccent}" />

    <!-- HeaderBandBackgroundBrush retained for compatibility; maps to top bar gradient -->
    <SolidColorBrush x:Key="HeaderBandBackgroundBrush"  Color="{StaticResource TopBarBackground}" />

    <!-- PremiumPanelBrush: primary paper panel surface -->
    <SolidColorBrush x:Key="PremiumPanelBrush"          Color="{StaticResource ConsoleBackgroundLight}" />

    <SolidColorBrush x:Key="ProgressSuccessBrush"       Color="{StaticResource ConsoleAccentGreen}" />
    <SolidColorBrush x:Key="ProgressWarningBrush"       Color="{StaticResource ConsoleAccentOrange}" />
    <SolidColorBrush x:Key="ProgressErrorBrush"         Color="{StaticResource ConsoleAccentRed}" />
    <SolidColorBrush x:Key="ProgressInfoBrush"          Color="{StaticResource ConsoleAccentBlue}" />
    <SolidColorBrush x:Key="SkeletonBackgroundBrush"    Color="{StaticResource ConsoleBackgroundHover}" />
    <SolidColorBrush x:Key="SkeletonHighlightBrush"     Color="{StaticResource ConsoleBorderColor}" />
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush"    Color="{StaticResource ConsoleAccentBlue}" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush"  Color="{StaticResource ConsoleBackgroundLight}" />

    <!-- Surface alias keys for components that use MD3-style resource names -->
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource ConsoleBackgroundLight}" />
    <SolidColorBrush x:Key="OnSurfaceBrush"        Color="{StaticResource ConsoleTextPrimary}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush"   Color="{StaticResource ConsoleBackgroundHover}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource ConsoleTextSecondary}" />
    <SolidColorBrush x:Key="OutlineDimBrush"       Color="{StaticResource ConsoleBorderColor}" />

    <!-- Nav active state: light sidebar selection -->
    <SolidColorBrush x:Key="NavActiveBackgroundBrush"   Color="{StaticResource ConsoleBackgroundActive}" />
    <SolidColorBrush x:Key="NavActiveBorderBrush"       Color="{StaticResource ConsoleAccentBlue}" />

    <!-- ── Light institutional sidebar palette ── -->
    <Color x:Key="SidebarBorderColor">#D2CDC3</Color>
    <Color x:Key="SidebarHoverColor">#EDEFF0</Color>
    <Color x:Key="SidebarActiveColor">#E7EDF2</Color>
    <Color x:Key="SidebarActiveIndicatorColor">#496C8F</Color>
    <Color x:Key="SidebarTileColor">#F8F7F3</Color>
    <Color x:Key="SidebarTileHoverColor">#EDEFF0</Color>
    <Color x:Key="NavItemText">#535C65</Color>
    <Color x:Key="NavItemTextHover">#20252B</Color>
    <Color x:Key="NavItemTextActive">#20252B</Color>
    <Color x:Key="NavSectionLabel">#606870</Color>

    <SolidColorBrush x:Key="SidebarBackgroundBrush"          Color="{StaticResource SidebarBackground}" />
    <SolidColorBrush x:Key="SidebarBorderBrush"              Color="{StaticResource SidebarBorderColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush"               Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush"              Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="SidebarActiveIndicatorBrush"     Color="{StaticResource SidebarActiveIndicatorColor}" />
    <SolidColorBrush x:Key="SidebarTileBrush"                Color="{StaticResource SidebarTileColor}" />
    <SolidColorBrush x:Key="SidebarTileHoverBrush"           Color="{StaticResource SidebarTileHoverColor}" />
    <SolidColorBrush x:Key="NavItemForegroundBrush"          Color="{StaticResource NavItemText}" />
    <SolidColorBrush x:Key="NavItemForegroundHoverBrush"     Color="{StaticResource NavItemTextHover}" />
    <SolidColorBrush x:Key="NavItemForegroundActiveBrush"    Color="{StaticResource NavItemTextActive}" />
    <SolidColorBrush x:Key="NavSectionLabelBrush"            Color="{StaticResource NavSectionLabel}" />

    <!-- ── Workstation status bar palette ── -->
    <Color x:Key="StatusBarBackground">#29323A</Color>
    <Color x:Key="StatusBarTextColor">#C9CFD4</Color>
    <Color x:Key="StatusBarBorderColor">#474E54</Color>

    <SolidColorBrush x:Key="StatusBarBackgroundBrush"  Color="{StaticResource StatusBarBackground}" />
    <SolidColorBrush x:Key="StatusBarTextBrush"        Color="{StaticResource StatusBarTextColor}" />
    <SolidColorBrush x:Key="StatusBarBorderBrush"      Color="{StaticResource StatusBarBorderColor}" />

    <!-- ── Command bar (split-pane toolbar) ── -->
    <SolidColorBrush x:Key="CommandBarBackground"    Color="{StaticResource ConsoleBackgroundMedium}" />
    <SolidColorBrush x:Key="CommandBarBorderBrush"   Color="{StaticResource ConsoleBorderColor}" />

    <!-- ── Layout rhythm tokens ── -->
    <sys:Double x:Key="WorkspaceSectionGap">24</sys:Double>
    <sys:Double x:Key="WorkspaceCardInternalGap">16</sys:Double>
    <sys:Double x:Key="WorkspaceCompactGap">12</sys:Double>
    <sys:Double x:Key="WorkspaceTightGap">8</sys:Double>
    <Thickness x:Key="WorkspaceCardPaddingStandard">20</Thickness>
    <Thickness x:Key="WorkspaceCardPaddingCompact">16</Thickness>
    <Thickness x:Key="WorkspaceSectionCardMargin">0,0,0,24</Thickness>
    <Thickness x:Key="WorkspaceCardHeaderToBodyMargin">0,0,0,16</Thickness>
    <Thickness x:Key="WorkspaceCardBodyToFooterMargin">0,16,0,0</Thickness>
    <Thickness x:Key="WorkspaceSectionDividerMargin">0,16,0,14</Thickness>

    <!-- ── Semantic badge tokens ── -->
    <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="{StaticResource ConsoleAccentBlueAlpha10}" />
    <SolidColorBrush x:Key="BadgeInfoBorderBrush"     Color="{StaticResource ConsoleAccentBlue}" />
    <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="{StaticResource ConsoleAccentBlueDim}" />
    <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{StaticResource ConsoleAccentGreenAlpha10}" />
    <SolidColorBrush x:Key="BadgeSuccessBorderBrush"     Color="{StaticResource ConsoleAccentGreen}" />
    <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{StaticResource ConsoleAccentGreenDim}" />
    <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="{StaticResource ConsoleAccentOrangeAlpha10}" />
    <SolidColorBrush x:Key="BadgeWarningBorderBrush"     Color="{StaticResource ConsoleAccentOrange}" />
    <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="{StaticResource ConsoleAccentOrangeDim}" />
    <SolidColorBrush x:Key="BadgeDangerBackgroundBrush" Color="{StaticResource ConsoleAccentRedAlpha10}" />
    <SolidColorBrush x:Key="BadgeDangerBorderBrush"     Color="{StaticResource ConsoleAccentRed}" />
    <SolidColorBrush x:Key="BadgeDangerForegroundBrush" Color="{StaticResource ConsoleAccentRedDim}" />
    <SolidColorBrush x:Key="DangerColorBrush"           Color="{StaticResource ConsoleAccentRedDim}" />

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- Tokens hoisted from inline page/control markup.                      -->
    <!-- Exact legacy values are preserved; these centralize colors that      -->
    <!-- were previously hardcoded in View XAML so future theming, dark-mode,  -->
    <!-- and rebrand work has a single source of truth.                       -->
    <!-- ══════════════════════════════════════════════════════════════════ -->

    <!-- Bright status/metric signal palette (health, diagnostics, analytics) -->
    <Color x:Key="SignalPositiveColor">#48BB78</Color>
    <Color x:Key="SignalPositiveVividColor">#3AD16A</Color>
    <Color x:Key="SignalWarningColor">#ED8936</Color>
    <Color x:Key="SignalNegativeColor">#F56565</Color>
    <Color x:Key="SignalNegativeVividColor">#F85149</Color>
    <SolidColorBrush x:Key="SignalPositiveBrush"      Color="{StaticResource SignalPositiveColor}" />
    <SolidColorBrush x:Key="SignalPositiveVividBrush" Color="{StaticResource SignalPositiveVividColor}" />
    <SolidColorBrush x:Key="SignalWarningBrush"       Color="{StaticResource SignalWarningColor}" />
    <SolidColorBrush x:Key="SignalNegativeBrush"      Color="{StaticResource SignalNegativeColor}" />
    <SolidColorBrush x:Key="SignalNegativeVividBrush" Color="{StaticResource SignalNegativeVividColor}" />

    <!-- Notification severity badges -->
    <Color x:Key="SeverityCriticalColor">#F44336</Color>
    <Color x:Key="SeverityErrorColor">#FF5722</Color>
    <Color x:Key="SeverityWarningColor">#FFC107</Color>
    <Color x:Key="NotificationDangerSurfaceColor">#2D1B1B</Color>
    <SolidColorBrush x:Key="SeverityCriticalBrush" Color="{StaticResource SeverityCriticalColor}" />
    <SolidColorBrush x:Key="SeverityErrorBrush"    Color="{StaticResource SeverityErrorColor}" />
    <SolidColorBrush x:Key="SeverityWarningBrush"  Color="{StaticResource SeverityWarningColor}" />
    <SolidColorBrush x:Key="NotificationDangerSurfaceBrush" Color="{StaticResource NotificationDangerSurfaceColor}" />

    <!-- Dark neutral ink for text on light/amber badges -->
    <Color x:Key="BadgeDarkTextColor">#333333</Color>
    <SolidColorBrush x:Key="BadgeDarkTextBrush" Color="{StaticResource BadgeDarkTextColor}" />

    <!-- On-accent text: dark ink over the terracotta signal fill (4.7:1; white is 4.0:1) -->
    <Color x:Key="OnAccentTextColor">#0D1217</Color>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="{StaticResource OnAccentTextColor}" />

    <!-- Muted text on dark chrome surfaces (float windows, metric tiles) -->
    <Color x:Key="DarkSurfaceMutedTextColor">#888888</Color>
    <SolidColorBrush x:Key="DarkSurfaceMutedTextBrush" Color="{StaticResource DarkSurfaceMutedTextColor}" />

    <!-- Top bar / masthead text and accents (over the near-black brand bar) -->
    <Color x:Key="TopBarTextSecondaryColor">#BEC4CA</Color>
    <Color x:Key="TopBarTextMutedColor">#929CA6</Color>
    <Color x:Key="TopBarAccentBlueColor">#D88466</Color>
    <Color x:Key="TopBarAlertAmberColor">#C69B4D</Color>
    <SolidColorBrush x:Key="TopBarTextSecondaryBrush" Color="{StaticResource TopBarTextSecondaryColor}" />
    <SolidColorBrush x:Key="TopBarTextMutedBrush"     Color="{StaticResource TopBarTextMutedColor}" />
    <SolidColorBrush x:Key="TopBarAccentBlueBrush"    Color="{StaticResource TopBarAccentBlueColor}" />
    <SolidColorBrush x:Key="TopBarAlertAmberBrush"    Color="{StaticResource TopBarAlertAmberColor}" />

    <!-- Startup window text (over the dark brand panel) -->
    <Color x:Key="StartupSubtitleTextColor">#C9CFD4</Color>
    <Color x:Key="StartupBodyTextColor">#AAA49A</Color>
    <Color x:Key="StartupFootnoteTextColor">#929CA6</Color>
    <SolidColorBrush x:Key="StartupSubtitleTextBrush" Color="{StaticResource StartupSubtitleTextColor}" />
    <SolidColorBrush x:Key="StartupBodyTextBrush"     Color="{StaticResource StartupBodyTextColor}" />
    <SolidColorBrush x:Key="StartupFootnoteTextBrush" Color="{StaticResource StartupFootnoteTextColor}" />

    <!-- Floating quote / page windows (dark detached surfaces) -->
    <Color x:Key="FloatWindowBackgroundColor">#0A0A12</Color>
    <Color x:Key="FloatWindowChromeColor">#1A2A4A</Color>
    <Color x:Key="QuoteBidColor">#44CC44</Color>
