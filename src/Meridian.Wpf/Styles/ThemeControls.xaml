<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Meridian.Wpf.Views">

    <!-- Style for WorkspaceDialogChromeControl layout chrome -->
    <Style TargetType="{x:Type views:WorkspaceDialogChromeControl}">
        <Setter Property="Background" Value="{StaticResource ConsoleBackgroundLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:WorkspaceDialogChromeControl}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            AutomationProperties.AutomationId="{TemplateBinding DialogAutomationId}"
                            AutomationProperties.Name="{TemplateBinding TitleText}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock x:Name="DialogTitleText"
                                           Text="{TemplateBinding TitleText}"
                                           Style="{StaticResource CardHeaderStyle}"
                                           AutomationProperties.AutomationId="{TemplateBinding TitleAutomationId}" />
                                <TextBlock x:Name="DialogSubtitleText"
                                           Text="{TemplateBinding SubtitleText}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CardDescriptionStyle}"
                                           AutomationProperties.AutomationId="{TemplateBinding SubtitleAutomationId}" />
                            </StackPanel>

                            <ContentPresenter x:Name="DialogBodyPresenter"
                                              Content="{TemplateBinding Content}"
                                              AutomationProperties.AutomationId="{TemplateBinding BodyAutomationId}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared button template: 6px radius, premium transitions -->
    <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
        <Border x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Focusable="False" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource ConsoleBackgroundHoverBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ConsoleBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource ConsoleBackgroundActiveBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ConsoleBorderFocusBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ConsoleBorderFocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Sidebar button template: light rail surfaces, refined hover palette -->
    <ControlTemplate x:Key="SidebarButtonTemplate" TargetType="Button">
        <Border x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Focusable="False" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SidebarActiveIndicatorBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarActiveBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Primary button template: restrained solid fill, no glow-heavy chrome. -->
    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Border x:Name="border"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True"
                Background="{StaticResource ConsoleAccentBlueBrush}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Focusable="False" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource ConsoleAccentBlueAlpha80Brush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ConsoleBorderFocusBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource ConsoleAccentBlueDimBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ConsoleBorderFocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Primary: solid institutional action, one per screen. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleAccentBlueBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Padding" Value="22,9" />
    </Style>

    <!-- Ghost: paper panel background with refined border, secondary action -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource ConsoleBackgroundLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource InfoColorBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextBlock.TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="WorkspaceQueueStateCardStyle" TargetType="Border" BasedOn="{StaticResource WorkspaceEmptyStateCardStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="WorkspaceQueueStateIconContainerStyle" TargetType="Border">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource ConsoleAccentBlueAlpha10Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoColorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="WorkspaceQueueStateIconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource InfoColorBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkspaceQueueStateTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
    </Style>

    <Style x:Key="WorkspaceQueueStateDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="WorkstationSignifierActionPanelStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource WorkstationSignifierEvidenceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource ConsoleBackgroundDarkBrush}" />
    </Style>

    <Style x:Key="WorkstationSignifierEvidenceChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource WorkstationSignifierEvidenceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource WorkstationSignifierEvidenceBrush}" />
    </Style>

    <Style x:Key="WorkstationSignifierSignoffChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource WorkstationSignifierSignoffBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource WorkstationSignifierSignoffBrush}" />
    </Style>

    <Style x:Key="WorkstationSignifierRecoveryChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource WorkstationSignifierRecoveryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource WorkstationSignifierRecoveryBrush}" />
    </Style>

</ResourceDictionary>
