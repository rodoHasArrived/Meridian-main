<Page x:Class="Meridian.Wpf.Views.ProviderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Provider">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="ProviderBackfillActionStrip"
                    AutomationProperties.Name="Backfill Provider Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE8B9;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Backfill Operator Workflow"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding ProviderScopeText}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding BackfillActionStateDetail}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="ProviderBackfillActionStateDetail" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                MaxWidth="520"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ProviderBackfillActionStatePanel"
                                AutomationProperties.Name="{Binding BackfillActionStateTitle}">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Validate"
                                    Command="{Binding ValidateConfigCommand}"
                                    ToolTip="{Binding ValidateConfigTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="ProviderValidateConfigButton"
                                    Margin="0,0,8,8" />
                            <Button Content="Refresh"
                                    Command="{Binding RefreshProvidersCommand}"
                                    ToolTip="{Binding RefreshProvidersTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="ProviderRefreshProvidersButton"
                                    Margin="0,0,8,8" />
                            <Button Content="Test Connections"
                                    Command="{Binding TestAllConnectionsCommand}"
                                    ToolTip="{Binding TestConnectionsTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="ProviderTestConnectionsButton"
                                    Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding BackfillActionStateTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ProviderBackfillActionStateTitle" />
                    </StackPanel>
                </Grid>
            </Border>

            <workstation:WorkstationStatePanelControl Grid.Row="1"
                                                       State="{Binding BackfillPostureState}"
                                                       Margin="0,0,0,14"
                                                       AutomationProperties.AutomationId="ProviderBackfillPostureCard"
                                                       TitleAutomationId="ProviderBackfillPostureTitle"
                                                       DetailAutomationId="ProviderBackfillPostureDetail"
                                                       EvidenceAutomationId="ProviderBackfillPostureEvidence" />

            <TabControl Grid.Row="2"
                        AutomationProperties.AutomationId="ProviderBackfillWorkbench"
                        AutomationProperties.Name="Provider Backfill Workbench">
                <TabItem Header="Backfill Provider Settings"
                         AutomationProperties.AutomationId="ProviderSettingsTab">
                    <workstation:WorkstationTableInspectorControl Margin="0,14,0,0"
                                                                  MinHeight="520"
                                                                  Table="{Binding ProviderSettingsTable}"
                                                                  SelectedItem="{Binding SelectedProviderSetting, Mode=TwoWay}"
                                                                  Inspector="{Binding SelectedProviderInspector}"
                                                                  HeaderText="Backfill Provider Settings"
                                                                  DetailText="Select a retained provider to edit enabled state, priority, and rate limits."
                                                                  ScopeText="{Binding ProviderScopeText}"
                                                                  GridAutomationId="ProviderBackfillSettingsGrid"
                                                                  EmptyAutomationId="ProviderBackfillSettingsEmptyState"
                                                                  InspectorAutomationId="ProviderBackfillSettingsInspector"
                                                                  ControlAutomationId="ProviderBackfillSettingsWorkbench">
                        <workstation:WorkstationTableInspectorControl.InspectorContent>
                            <StackPanel>
                                <workstation:InspectorPanelControl Panel="{Binding ProviderActionInspector}"
                                                                   AutomationProperties.AutomationId="ProviderBackfillActionInspector" />

                                <Border Style="{StaticResource CardStyle}"
                                        Padding="14"
                                        Margin="0,12,0,0"
                                        AutomationProperties.AutomationId="ProviderSelectedEditPanel"
                                        AutomationProperties.Name="Selected backfill provider editor">
                                    <StackPanel>
                                        <TextBlock Text="Selected Provider Edit"
                                                   Style="{StaticResource CardHeaderStyle}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SaveSelectedProviderTooltip}"
                                                   Style="{StaticResource CardDescriptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />

                                        <CheckBox Content="Enabled for backfill"
                                                  IsChecked="{Binding SelectedProviderSetting.IsEnabled, Mode=TwoWay}"
                                                  Margin="0,0,0,10"
                                                  AutomationProperties.AutomationId="ProviderSelectedEnabledToggle" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="Priority" Style="{StaticResource FormLabelStyle}" />
                                                <TextBox Text="{Binding SelectedProviderSetting.Priority, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource FormTextBoxStyle}"
                                                         AutomationProperties.AutomationId="ProviderSelectedPriorityBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="Rate/min" Style="{StaticResource FormLabelStyle}" />
                                                <TextBox Text="{Binding SelectedProviderSetting.RateLimitPerMinute, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource FormTextBoxStyle}"
                                                         AutomationProperties.AutomationId="ProviderSelectedRateMinuteBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="Rate/hr" Style="{StaticResource FormLabelStyle}" />
                                                <TextBox Text="{Binding SelectedProviderSetting.RateLimitPerHour, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource FormTextBoxStyle}"
                                                         AutomationProperties.AutomationId="ProviderSelectedRateHourBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Text="Source" Style="{StaticResource FormLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedProviderSetting.ConfigSource, TargetNullValue=-}"
                                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding SelectedProviderSetting.InlineWarning}"
                                                   Foreground="{StaticResource WarningColorBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"
                                                   Visibility="{Binding HasSelectedProviderInlineWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="ProviderSelectedInlineWarning" />

                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="Save Selected"
                                                    Command="{Binding SaveSelectedProviderCommand}"
                                                    ToolTip="{Binding SaveSelectedProviderTooltip}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    AutomationProperties.AutomationId="ProviderSaveSelectedButton"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Reset Selected"
                                                    Command="{Binding ResetSelectedProviderCommand}"
                                                    ToolTip="{Binding ResetSelectedProviderTooltip}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    AutomationProperties.AutomationId="ProviderResetSelectedButton"
                                                    Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </workstation:WorkstationTableInspectorControl.InspectorContent>
                    </workstation:WorkstationTableInspectorControl>
                </TabItem>

                <TabItem Header="Runtime Accounting"
                         AutomationProperties.AutomationId="ProviderRuntimeAccountingTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,14,0,0">
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="14"
                                    AutomationProperties.AutomationId="ProviderRuntimeAccountingStatus"
                                    AutomationProperties.Name="Provider runtime accounting status">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Provider Registration and Rate Limits"
                                                   Style="{StaticResource CardHeaderStyle}" />
                                        <TextBlock Text="{Binding ProviderAccounting.StatusMessage}"
                                                   Style="{StaticResource CardDescriptionStyle}"
                                                   Margin="0,4,0,0"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Text="{Binding ProviderAccounting.ErrorMessage}"
                                                   Foreground="{StaticResource ErrorColorBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding ProviderAccounting.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="ProviderRuntimeAccountingError" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Refresh Evidence"
                                            Command="{Binding ProviderAccounting.RefreshCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.AutomationId="ProviderRuntimeAccountingRefreshButton"
                                            Margin="16,0,0,0" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}"
                                    Padding="14"
                                    Margin="0,12,0,0"
                                    AutomationProperties.AutomationId="ProviderRegistrationReportCard"
                                    AutomationProperties.Name="{Binding ProviderAccounting.RegistrationTitle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProviderAccounting.RegistrationTitle}"
                                               Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding ProviderAccounting.RegistrationSummary}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{Binding ProviderAccounting.RegistrationFailures}"
                                                  Margin="0,10,0,0"
                                                  AutomationProperties.AutomationId="ProviderRegistrationFailureList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource ErrorColorBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Stage}"
                                                                   Foreground="{StaticResource ErrorColorBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Module, StringFormat='Module: {0}'}"
                                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Subject}"
                                                                   FontFamily="{StaticResource MeridianDataFontFamily}"
                                                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Error}"
                                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}"
                                    Padding="14"
                                    Margin="0,12,0,0"
                                    AutomationProperties.AutomationId="ProviderRateLimitCurrentStateCard"
                                    AutomationProperties.Name="Current provider rate limits">
                                <StackPanel>
                                    <TextBlock Text="Current Request Windows"
                                               Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding ProviderAccounting.RateLimitSummary}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />
                                    <ListView ItemsSource="{Binding ProviderAccounting.RateLimits}"
                                              MinHeight="180"
                                              AutomationProperties.AutomationId="ProviderRateLimitCurrentStateList"
                                              AutomationProperties.Name="Current provider request windows">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Provider" DisplayMemberBinding="{Binding Provider}" Width="130" />
                                                <GridViewColumn Header="Surface" DisplayMemberBinding="{Binding Surface}" Width="90" />
                                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100" />
                                                <GridViewColumn Header="Connection / reachability" DisplayMemberBinding="{Binding ConnectionPosture}" Width="260" />
                                                <GridViewColumn Header="Requests" DisplayMemberBinding="{Binding RequestUsage}" Width="100" />
                                                <GridViewColumn Header="Remaining" DisplayMemberBinding="{Binding Remaining}" Width="90" />
                                                <GridViewColumn Header="Reset countdown" DisplayMemberBinding="{Binding ResetCountdown}" Width="120" />
                                                <GridViewColumn Header="Failure / reason" DisplayMemberBinding="{Binding FailureReason}" Width="260" />
                                                <GridViewColumn Header="Retry posture" DisplayMemberBinding="{Binding RetryPosture}" Width="260" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Text="{Binding ProviderAccounting.HistoryPosture, StringFormat=History: {0}}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               AutomationProperties.AutomationId="ProviderRateLimitHistoryPosture" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Fallback Chain Preview"
                         AutomationProperties.AutomationId="ProviderFallbackTab">
                    <workstation:WorkstationTableInspectorControl Margin="0,14,0,0"
                                                                  MinHeight="480"
                                                                  Table="{Binding FallbackChainTable}"
                                                                  SelectedItem="{Binding SelectedFallbackProvider, Mode=TwoWay}"
                                                                  Inspector="{Binding SelectedFallbackInspector}"
                                                                  HeaderText="Fallback Chain Preview"
                                                                  DetailText="Effective provider order used during backfill operations."
                                                                  ScopeText="{Binding ProviderScopeText}"
                                                                  GridAutomationId="ProviderFallbackChainGrid"
                                                                  EmptyAutomationId="ProviderFallbackChainEmptyState"
                                                                  InspectorAutomationId="ProviderFallbackChainInspector"
                                                                  ControlAutomationId="ProviderFallbackChainWorkbench" />
                </TabItem>

                <TabItem Header="Dry-Run Backfill Plan"
                         AutomationProperties.AutomationId="ProviderDryRunTab">
                    <workstation:WorkstationTableInspectorControl Margin="0,14,0,0"
                                                                  MinHeight="480"
                                                                  Table="{Binding DryRunPlanTable}"
                                                                  SelectedItem="{Binding SelectedDryRunResult, Mode=TwoWay}"
                                                                  Inspector="{Binding SelectedDryRunInspector}"
                                                                  HeaderText="Dry-Run Backfill Plan"
                                                                  DetailText="Preview provider selection per symbol without executing a backfill."
                                                                  ScopeText="{Binding ProviderScopeText}"
                                                                  GridAutomationId="ProviderDryRunPlanGrid"
                                                                  EmptyAutomationId="ProviderDryRunPlanEmptyState"
                                                                  InspectorAutomationId="ProviderDryRunPlanInspector"
                                                                  ControlAutomationId="ProviderDryRunPlanWorkbench">
                        <workstation:WorkstationTableInspectorControl.ToolbarContent>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="220"
                                         Text="{Binding DryRunSymbolsInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         AutomationProperties.AutomationId="ProviderDryRunSymbolsBox"
                                         Margin="0,0,8,0" />
                                <Button Content="Preview Plan"
                                        Command="{Binding DryRunCommand}"
                                        ToolTip="{Binding DryRunTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="ProviderPreviewPlanButton" />
                            </StackPanel>
                        </workstation:WorkstationTableInspectorControl.ToolbarContent>
                        <workstation:WorkstationTableInspectorControl.FooterContent>
                            <TextBlock Text="{Binding DryRunWarningsText}"
                                       Foreground="{StaticResource WarningColorBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsDryRunWarningsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="ProviderDryRunWarningsText" />
                        </workstation:WorkstationTableInspectorControl.FooterContent>
                    </workstation:WorkstationTableInspectorControl>
                </TabItem>

                <TabItem Header="Audit Trail"
                         AutomationProperties.AutomationId="ProviderAuditTab">
                    <workstation:WorkstationTableInspectorControl Margin="0,14,0,0"
                                                                  MinHeight="480"
                                                                  Table="{Binding AuditLogTable}"
                                                                  SelectedItem="{Binding SelectedAuditLog, Mode=TwoWay}"
                                                                  Inspector="{Binding SelectedAuditInspector}"
                                                                  HeaderText="Audit Trail"
                                                                  DetailText="Retained provider configuration changes made from the desktop application."
                                                                  ScopeText="{Binding ProviderScopeText}"
                                                                  GridAutomationId="ProviderAuditTrailGrid"
                                                                  EmptyAutomationId="ProviderAuditTrailEmptyState"
                                                                  InspectorAutomationId="ProviderAuditTrailInspector"
                                                                  ControlAutomationId="ProviderAuditTrailWorkbench" />
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</Page>
