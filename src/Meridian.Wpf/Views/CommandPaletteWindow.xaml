<Window x:Class="Meridian.Wpf.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Meridian.Wpf.Converters"
        mc:Ignorable="d"
        Title="Command Palette"
        Width="600" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="OnWindowDeactivated"
        KeyDown="OnWindowKeyDown"
        AutomationProperties.AutomationId="CommandPaletteWindow"
        AutomationProperties.Name="Command Palette">

    <Border x:Name="CommandPaletteShell"
            Background="{StaticResource ConsoleCardSurfaceRaisedBrush}"
            CornerRadius="6"
            BorderBrush="{StaticResource ConsoleBorderBrush}"
            BorderThickness="1"
            Margin="16"
            AutomationProperties.AutomationId="CommandPaletteWindowChrome"
            AutomationProperties.Name="Command Palette Chrome">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search box -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,12,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{StaticResource ConsoleAccentBlueBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             FontSize="16"
                             Background="Transparent"
                             Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                             CaretBrush="{StaticResource ConsoleAccentBlueBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchTextChanged"
                             AutomationProperties.AutomationId="CommandPaletteWindowInput"
                             AutomationProperties.Name="Command Palette Search" />
                    <TextBlock Grid.Column="1"
                               x:Name="PlaceholderText"
                               Text="Type a command or search..."
                               FontSize="16"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="4,0,0,0"
                               AutomationProperties.AutomationId="CommandPaletteWindowPlaceholder" />
                </Grid>
            </Border>

            <!-- Category label -->
            <TextBlock Grid.Row="1"
                       x:Name="CategoryLabel"
                       Text="RECENT"
                       FontSize="11"
                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                       FontWeight="SemiBold"
                       Margin="16,8,16,4"
                       AutomationProperties.AutomationId="CommandPaletteWindowCategory"
                       />

            <!-- Results list -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     MouseDoubleClick="OnResultDoubleClick"
                     KeyDown="OnResultsKeyDown"
                     AutomationProperties.AutomationId="CommandPaletteWindowResults"
                     AutomationProperties.Name="Command Palette Results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="{TemplateBinding Margin}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ConsoleBackgroundHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ConsoleBackgroundActiveBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource ConsoleAccentBlueBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,0,0" />

                            <!-- Title and Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="4,0,8,0">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Category and Shortcut -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Vertical"
                                        VerticalAlignment="Top"
                                        Margin="8,0,0,0">
                                <!-- Category Badge -->
                                <TextBlock Text="{Binding Category}"
                                           FontSize="10"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                           Margin="0,0,0,4"
                                           Visibility="{Binding Category, Converter={StaticResource NullToCollapsedConverter}}" />
                                
                                <!-- Shortcut Chip -->
                                <Border Background="{StaticResource ConsoleAccentBlueAlpha10Brush}"
                                        CornerRadius="3"
                                        Padding="4,2"
                                        Visibility="{Binding Shortcut, Converter={StaticResource NullToCollapsedConverter}}">
                                    <TextBlock Text="{Binding Shortcut}"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource ConsoleAccentBlueBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,8"
                    AutomationProperties.AutomationId="CommandPaletteWindowFooter">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2191;&#x2193;" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" Margin="0,0,4,0" />
                    <TextBlock Text="navigate" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" Margin="0,0,12,0" />
                    <TextBlock Text="&#x23CE;" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" Margin="0,0,4,0" />
                    <TextBlock Text="select" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" Margin="0,0,12,0" />
                    <TextBlock Text="esc" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" Margin="0,0,4,0" />
                    <TextBlock Text="close" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <Window.Resources>
        <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    </Window.Resources>
</Window>
