<UserControl x:Class="Meridian.Wpf.Views.WorkspaceCommandSurfaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             AutomationProperties.AutomationId="{Binding SurfaceAutomationId, RelativeSource={RelativeSource Self}}"
             AutomationProperties.Name="Workspace Command Surface">
    <StackPanel>
        <Border x:Name="FixtureModeBanner"
                Margin="0"
                Padding="16,10"
                CornerRadius="0"
                Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                BorderBrush="{StaticResource InfoColorBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding FixtureModeBannerVisibility}"
                AutomationProperties.AutomationId="{Binding ElementName=Root, Path=FixtureBannerAutomationId}"
                AutomationProperties.Name="Demo Data Banner"
                Panel.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource InfoColorBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="FixtureModeLabel"
                               Text="{Binding FixtureModeBannerText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                               AutomationProperties.AutomationId="FixtureModeLabel"
                               AutomationProperties.Name="Demo Data Label"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="FixtureModeDismissButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding DismissFixtureModeBannerCommand}"
                        AutomationProperties.AutomationId="FixtureModeDismissButton"
                        AutomationProperties.Name="Dismiss Demo Data Banner"
                        ToolTip="Dismiss banner">
                    <TextBlock Text="&#x2715;"
                               FontSize="12"
                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="WorkspacePageHeader"
                Background="{StaticResource ConsoleBackgroundLightBrush}"
                BorderBrush="{StaticResource ConsoleBorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="0"
                Padding="24,12"
                Margin="0,0,0,0"
                Visibility="{Binding DataWorkspaceHomeChromeVisibility}"
                AutomationProperties.AutomationId="{Binding ElementName=Root, Path=PageHeaderAutomationId}"
                AutomationProperties.Name="Workspace Page Header">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Style="{StaticResource IconButtonStyle}"
                                Visibility="{Binding BackButtonVisibility}"
                                Command="{Binding GoBackCommand}"
                                AutomationProperties.AutomationId="ShellBackButton"
                                AutomationProperties.Name="Shell Back Button"
                                ToolTip="Go Back">
                            <TextBlock Text="{StaticResource IconBack}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16" />
                        </Button>
                        <TextBlock Text="{Binding WorkspaceHeading}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ShellSectionLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="PageTitleTextBlock"
                               Text="{Binding CurrentPageTitle}"
                               Margin="0,6,0,0"
                               FontFamily="{StaticResource MeridianDisplayFontFamily}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PageTitleText"
                               AutomationProperties.Name="{Binding CurrentPageTitle}" />
                    <TextBlock x:Name="PageSubtitleText"
                               Margin="0,8,0,0"
                               Text="{Binding CurrentPageSubtitle}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PageSubtitleText"
                               AutomationProperties.Name="Current Page Subtitle">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardDescriptionStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactShellDensity}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border x:Name="ContextSelectionHint"
                            Margin="0,12,0,0"
                            Padding="12,10"
                            Visibility="{Binding ContextSelectionHintVisibility}"
                            Style="{StaticResource WarningBadgeInlineStyle}"
                            AutomationProperties.AutomationId="ContextSelectionHint"
                            AutomationProperties.Name="Context Selection Hint">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource WarningColorBrush}" />
                                <TextBlock x:Name="ContextSelectionHintTextBlock"
                                           Margin="8,0,0,0"
                                           Text="{Binding ContextSelectionHintText}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                           AutomationProperties.AutomationId="ContextSelectionHintText" />
                            </StackPanel>
                            <Button x:Name="ContextSelectionHintButton"
                                    DockPanel.Dock="Right"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding SwitchFundCommand}"
                                    AutomationProperties.AutomationId="ContextSelectionHintButton"
                                    AutomationProperties.Name="Choose Operating Context">
                                <TextBlock Text="Choose Context" />
                            </Button>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Border x:Name="ConnectionStatusBadge"
                                Margin="0,0,10,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource NeutralBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShellStatusTone}" Value="Success">
                                            <Setter Property="Background" Value="{StaticResource ConsoleAccentGreenAlpha10Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShellStatusTone}" Value="Warning">
                                            <Setter Property="Background" Value="{StaticResource ConsoleAccentOrangeAlpha10Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShellStatusTone}" Value="Danger">
                                            <Setter Property="Background" Value="{StaticResource ConsoleAccentRedAlpha10Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShellStatusTone}" Value="Info">
                                            <Setter Property="Background" Value="{StaticResource ConsoleAccentBlueAlpha10Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoColorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionStatusDot"
                                         Width="8"
                                         Height="8"
                                         Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessColorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShellStatusTone}" Value="Warning">
                                                    <Setter Property="Fill" Value="{StaticResource WarningColorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShellStatusTone}" Value="Danger">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorColorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShellStatusTone}" Value="Info">
                                                    <Setter Property="Fill" Value="{StaticResource InfoColorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock x:Name="ConnectionStatusText"
                                           Text="{Binding ShellStatusText}"
                                           FontSize="12"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NeutralBadgeStyle}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                <TextBlock Text="{Binding ShellLastRefreshText}"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Choose operating context"
                                Margin="0,0,8,0"
                                Command="{Binding SwitchFundCommand}"
                                AutomationProperties.AutomationId="SwitchContextButton"
                                AutomationProperties.Name="Switch Operating Context">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SwitchContextActionText}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="Refresh (F5)"
                                Command="{Binding RefreshPageCommand}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="{Binding ElementName=Root, Path=RefreshButtonAutomationId}"
                                AutomationProperties.Name="Refresh Current Page">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconRefresh}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Refresh"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ShellDensityToggleButton"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="{Binding ShellDensityToggleTooltip}"
                                Command="{Binding ToggleShellDensityCommand}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="ShellDensityToggleButton"
                                AutomationProperties.Name="Toggle Shell Density">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconGrid}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="ShellDensityButtonLabelText"
                                           Text="{Binding ShellDensityButtonText}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="ShellDensityButtonLabelText" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="OperatorInboxButton"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="{Binding OperatorInboxSummary}"
                                Command="{Binding OpenOperatorInboxCommand}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="OperatorInboxButton"
                                AutomationProperties.Name="Operator Queue">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ConsoleTextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OperatorInboxTone}" Value="Danger">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorColorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OperatorInboxTone}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningColorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OperatorInboxTone}" Value="Info">
                                                    <Setter Property="Foreground" Value="{StaticResource InfoColorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OperatorInboxTone}" Value="Success">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessColorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="OperatorInboxButtonLabelText"
                                           Text="{Binding OperatorInboxButtonText}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="OperatorInboxButtonLabelText" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NotificationsButton"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="Notifications"
                                Margin="0,0,8,0"
                                Command="{Binding OpenNotificationsCommand}"
                                AutomationProperties.AutomationId="{Binding ElementName=Root, Path=NotificationsButtonAutomationId}"
                                AutomationProperties.Name="Open Notifications">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconBell}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Alerts"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CommandPaletteButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Command Palette (Ctrl+K)"
                                Command="{Binding ShowCommandPaletteCommand}"
                                AutomationProperties.AutomationId="{Binding ElementName=Root, Path=CommandPaletteButtonAutomationId}"
                                AutomationProperties.Name="Open Command Palette">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconSearch}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Command Palette"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
