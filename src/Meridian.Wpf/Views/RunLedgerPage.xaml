<Page x:Class="Meridian.Wpf.Views.RunLedgerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      AutomationProperties.Name="Run Ledger">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="RunLedgerActionStrip"
                    AutomationProperties.Name="Run Ledger Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE8D4;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AsOfText, StringFormat=As of {0}}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2"
                               MaxWidth="520"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button Content="Run Browser"
                                Command="{Binding OpenBrowserCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                AutomationProperties.AutomationId="RunLedgerOpenBrowserButton"
                                Margin="0,0,8,8" />
                        <Button Content="Run Detail"
                                Command="{Binding OpenRunDetailCommand}"
                                ToolTip="{Binding RunDrillInTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="RunLedgerOpenDetailButton"
                                Margin="0,0,8,8" />
                        <Button Content="Portfolio"
                                Command="{Binding OpenPortfolioCommand}"
                                ToolTip="{Binding RunDrillInTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="RunLedgerOpenPortfolioButton"
                                Margin="0,0,8,8" />
                        <Button Content="Security Master"
                                Command="{Binding OpenSelectedSecurityCommand}"
                                ToolTip="{Binding SelectedSecurityTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="RunLedgerOpenSelectedSecurityButton"
                                Margin="0,0,8,8" />
                        <Button Content="Cash Flow"
                                Command="{Binding OpenCashFlowCommand}"
                                ToolTip="{Binding RunDrillInTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="RunLedgerOpenCashFlowButton"
                                Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="As Of" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding AsOfText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Journal Entries" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding JournalEntriesText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Ledger Entries" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding LedgerEntriesText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Assets" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding AssetBalanceText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Equity" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding EquityBalanceText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Revenue" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding RevenueBalanceText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Expense" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding ExpenseBalanceText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Security Resolved" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding SecurityResolvedText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Security Missing" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding SecurityMissingText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}"
                        Padding="12,8"
                        AutomationProperties.AutomationId="RunLedgerSelectionGuidance">
                    <TextBlock Text="Trial-balance rows drive the ledger inspector and Security Master action; journal rows stay read-only evidence for the retained run."
                               Style="{StaticResource CardDescriptionStyle}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid Grid.Row="2"
                  AutomationProperties.AutomationId="RunLedgerWorkbench"
                  AutomationProperties.Name="Run Ledger Workbench">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <TabControl AutomationProperties.AutomationId="RunLedgerTablesTabs">
                        <TabItem Header="Trial Balance"
                                 AutomationProperties.AutomationId="RunLedgerTrialBalanceTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Trial Balance"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Select a line to inspect Security Master coverage, fund scope, and entry count."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding TrialBalanceTable}"
                                                                  SelectedItem="{Binding SelectedTrialBalanceLine, Mode=TwoWay}"
                                                                  Height="420"
                                                                  GridAutomationId="RunLedgerTrialBalanceGrid"
                                                                  EmptyAutomationId="RunLedgerTrialBalanceEmptyState"
                                                                  AutomationProperties.Name="Run ledger trial balance table" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Journal"
                                 AutomationProperties.AutomationId="RunLedgerJournalTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Journal"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Read-only posted entries for the selected run."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding JournalTable}"
                                                                  Height="420"
                                                                  GridAutomationId="RunLedgerJournalGrid"
                                                                  EmptyAutomationId="RunLedgerJournalEmptyState"
                                                                  AutomationProperties.Name="Run ledger journal table" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <StackPanel Grid.Column="2">
                    <workstation:InspectorPanelControl Panel="{Binding SelectedTrialBalanceInspector}"
                                                       AutomationProperties.AutomationId="RunLedgerSelectionInspector" />

                    <Border Style="{StaticResource CardStyle}"
                            Padding="16"
                            Margin="0,12,0,0"
                            AutomationProperties.AutomationId="RunLedgerActionInspector"
                            AutomationProperties.Name="Run Ledger Selected Actions">
                        <StackPanel>
                            <TextBlock Text="Selected Actions"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Security Master opens only for selected trial-balance lines with a retained security or symbol."
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Security Master"
                                        Command="{Binding OpenSelectedSecurityCommand}"
                                        ToolTip="{Binding SelectedSecurityTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="RunLedgerInspectorOpenSecurityButton"
                                        Margin="0,0,8,8" />
                                <Button Content="Run Detail"
                                        Command="{Binding OpenRunDetailCommand}"
                                        ToolTip="{Binding RunDrillInTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="RunLedgerInspectorOpenDetailButton"
                                        Margin="0,0,8,8" />
                                <Button Content="Portfolio"
                                        Command="{Binding OpenPortfolioCommand}"
                                        ToolTip="{Binding RunDrillInTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource GhostButtonStyle}"
                                        AutomationProperties.AutomationId="RunLedgerInspectorOpenPortfolioButton"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
