<UserControl x:Class="Meridian.Wpf.Views.IntercompanyAgreementsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Intercompany agreements">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="AgreementBooleanVisibility" />
        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0,3,12,10" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="Margin" Value="0,8,0,12" />
        </Style>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Intercompany agreements" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Approved terms and evidence shared with the browser workstation. Dates use yyyy-MM-dd; approval never posts a journal."
                       Margin="0,5,0,12" TextWrapping="Wrap" />
            <WrapPanel>
                <StackPanel><TextBlock Text="Entity ID (optional filter)" /><TextBox Text="{Binding EntityFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement entity filter" /></StackPanel>
                <StackPanel><TextBlock Text="As-of date" /><TextBox Text="{Binding AsOf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement as-of date" /></StackPanel>
                <Button Content="Load" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
                <Button Content="More" Command="{Binding MoreCommand}" VerticalAlignment="Center" />
                <Button Content="New agreement" Command="{Binding NewCommand}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding MigrationWarnings}" TextWrapping="Wrap"
                       AutomationProperties.Name="Legal agreement lifecycle migration warnings" />
            <DataGrid ItemsSource="{Binding Agreements}" SelectedItem="{Binding SelectedRow}" MinHeight="130" MaxHeight="260" AutomationProperties.Name="Agreement list">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Type" Binding="{Binding AgreementType}" Width="120" />
                    <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding EffectiveStatus}" Width="100" />
                    <DataGridTextColumn Header="Approved version" Binding="{Binding LatestApprovedVersion}" Width="110" />
                    <DataGridTextColumn Header="First party" Binding="{Binding PartyOneId}" Width="240" />
                    <DataGridTextColumn Header="Second party" Binding="{Binding PartyTwoId}" Width="240" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel>
                <Button Content="Open selected" Command="{Binding OpenCommand}" />
                <Button Content="Compare latest retained" Command="{Binding CompareLatestCommand}" />
                <Button Content="Amend" Command="{Binding AmendCommand}" />
                <Button Content="Replace activation proposal" Command="{Binding ReplaceProposalCommand}" />
                <Button Content="Terminate" Command="{Binding TerminateCommand}" />
                <Button Content="Save draft" Command="{Binding SaveCommand}" />
                <Button Content="Discard local edits" Command="{Binding DiscardCommand}" />
            </WrapPanel>
            <Expander Header="Latest retained comparison (local edits are preserved)">
                <TextBox Text="{Binding ConflictSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Latest retained agreement comparison" />
            </Expander>
            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource AgreementBooleanVisibility}}">
                <TextBlock Text="{Binding EditorAction, StringFormat='Proposal: {0}'}" FontWeight="SemiBold" Margin="0,10" />
                <TextBlock Text="Party identities, roles, type and currency are fixed after activation. Retrospective changes require a rationale; posted references remain unchanged." TextWrapping="Wrap" />
                <WrapPanel>
                    <StackPanel><TextBlock Text="Code" /><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement code" /></StackPanel>
                    <StackPanel><TextBlock Text="Name" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement name" /></StackPanel>
                    <StackPanel><TextBlock Text="Type" /><ComboBox ItemsSource="{Binding AgreementTypes}" SelectedItem="{Binding AgreementType}" MinWidth="160" Margin="0,3,12,10" AutomationProperties.Name="Agreement type" /></StackPanel>
                    <StackPanel><TextBlock Text="Currency" /><TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement currency" /></StackPanel>
                    <StackPanel><TextBlock Text="First legal entity ID" /><TextBox Text="{Binding PartyOne, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="First agreement party" MinWidth="300" /></StackPanel>
                    <StackPanel><TextBlock Text="First party role" /><TextBox Text="{Binding PartyOneRole, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="First agreement party role" /></StackPanel>
                    <StackPanel><TextBlock Text="Second legal entity ID" /><TextBox Text="{Binding PartyTwo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Second agreement party" MinWidth="300" /></StackPanel>
                    <StackPanel><TextBlock Text="Second party role" /><TextBox Text="{Binding PartyTwoRole, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Second agreement party role" /></StackPanel>
                    <StackPanel><TextBlock Text="Effective start" /><TextBox Text="{Binding EffectiveFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement effective start" /></StackPanel>
                    <StackPanel><TextBlock Text="Exclusive end (optional)" /><TextBox Text="{Binding EffectiveTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement exclusive end" /></StackPanel>
                    <StackPanel><TextBlock Text="Termination cutoff (termination only)" /><TextBox Text="{Binding TerminationDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement termination date" /></StackPanel>
                    <StackPanel><TextBlock Text="Annual rate fraction (0.05 = 5%)" /><TextBox Text="{Binding FixedAnnualRate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement annual rate fraction" /></StackPanel>
                    <StackPanel><TextBlock Text="Rate terms" /><TextBox Text="{Binding RateDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement rate description" /></StackPanel>
                    <StackPanel><TextBlock Text="Schedule" /><TextBox Text="{Binding Schedule, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement schedule" /></StackPanel>
                    <StackPanel><TextBlock Text="Cost allocation" /><TextBox Text="{Binding Allocation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement allocation" /></StackPanel>
                    <StackPanel><TextBlock Text="Settlement calendar days" /><TextBox Text="{Binding SettlementDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement settlement days" /></StackPanel>
                    <StackPanel><TextBlock Text="Purpose" /><TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement purpose" /></StackPanel>
                    <StackPanel><TextBlock Text="Evidence Vault reference" /><TextBox Text="{Binding EvidenceReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement evidence reference" MinWidth="300" /></StackPanel>
                    <StackPanel><TextBlock Text="Retained artifact ID" /><TextBox Text="{Binding EvidenceArtifact, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement evidence artifact" /></StackPanel>
                </WrapPanel>
<Expander Header="Structured legal terms" IsExpanded="True" Margin="0,12,0,8"><StackPanel>
<CheckBox Content="Declare structured terms for this revision" IsChecked="{Binding UseStructuredTerms}" AutomationProperties.Name="Declare structured legal terms"/>
<TextBlock Text="{Binding TermsFormatLabel}" TextWrapping="Wrap" Margin="0,5,0,10"/>
<StackPanel IsEnabled="{Binding UseStructuredTerms}"><TextBlock Text="Loan, fee and cost-share schedules require an explicit business calendar. Guarantees use the disclosure fields below." TextWrapping="Wrap"/><WrapPanel><StackPanel Width="225"><TextBlock Text="Schedule start (yyyy-MM-dd)"/><TextBox Text="{Binding ScheduleStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Schedule start (yyyy-MM-dd)"/></StackPanel><StackPanel Width="225"><TextBlock Text="Schedule end (yyyy-MM-dd)"/><TextBox Text="{Binding ScheduleEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Schedule end (yyyy-MM-dd)"/></StackPanel><StackPanel Width="225" Margin="0,0,12,10"><TextBlock Text="Payment cadence"/><ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" AutomationProperties.Name="Payment cadence"/></StackPanel><StackPanel Width="225"><TextBlock Text="Explicit calendar ID"/><TextBox Text="{Binding CalendarId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Explicit calendar ID"/></StackPanel><StackPanel Width="225" Margin="0,0,12,10"><TextBlock Text="Business-day convention"/><ComboBox ItemsSource="{Binding BusinessDayConventions}" SelectedItem="{Binding BusinessDayConvention}" AutomationProperties.Name="Business-day convention"/></StackPanel><StackPanel Width="225"><TextBlock Text="Settlement business days"/><TextBox Text="{Binding SettlementBusinessDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Settlement business days"/></StackPanel></WrapPanel><TextBlock Text="Loan: annual fixed rate uses the existing rate field above (0.05 = 5%). Floating rates retain declared references only." TextWrapping="Wrap"/><WrapPanel><StackPanel Width="225" Margin="0,0,12,10"><TextBlock Text="Rate basis"/><ComboBox ItemsSource="{Binding RateBases}" SelectedItem="{Binding RateBasis}" AutomationProperties.Name="Rate basis"/></StackPanel><StackPanel Width="225"><TextBlock Text="Floating index reference"/><TextBox Text="{Binding FloatingIndexReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Floating index reference"/></StackPanel><StackPanel Width="225"><TextBlock Text="Spread (basis points)"/><TextBox Text="{Binding SpreadBps, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Spread (basis points)"/></StackPanel><StackPanel Width="225" Margin="0,0,12,10"><TextBlock Text="Day count"/><ComboBox ItemsSource="{Binding DayCounts}" SelectedItem="{Binding DayCount}" AutomationProperties.Name="Day count"/></StackPanel><StackPanel Width="225" Margin="0,0,12,10"><TextBlock Text="Compounding"/><ComboBox ItemsSource="{Binding CompoundingChoices}" SelectedItem="{Binding Compounding}" AutomationProperties.Name="Compounding"/></StackPanel></WrapPanel><TextBlock Text="Management fee — fixed amount, or annual percentage plus calculation base" FontWeight="SemiBold"/><WrapPanel><StackPanel Width="225"><TextBlock Text="Fixed fee amount"/><TextBox Text="{Binding FixedFeeAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fixed fee amount"/></StackPanel><StackPanel Width="225"><TextBlock Text="Annual fee fraction (0.01 = 1%)"/><TextBox Text="{Binding AnnualFeeRate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Annual fee fraction (0.01 = 1%)"/></StackPanel><StackPanel Width="360"><TextBlock Text="Calculation base reference"/><TextBox Text="{Binding CalculationBaseReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Calculation base reference"/></StackPanel></WrapPanel><TextBlock Text="Cost share — percentages for the two legal parties totaling 100%, or a declared driver" FontWeight="SemiBold"/><WrapPanel><StackPanel Width="360"><TextBlock Text="Allocation driver reference"/><TextBox Text="{Binding AllocationDriverReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Allocation driver reference"/></StackPanel><Button Content="Add recipient" Command="{Binding AddStructuredAllocationCommand}"/><Button Content="Remove selected recipient" Command="{Binding RemoveStructuredAllocationCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding StructuredAllocations}" SelectedItem="{Binding SelectedStructuredAllocation}" IsReadOnly="False" MaxHeight="150" AutomationProperties.Name="Structured cost allocation recipients"><DataGrid.Columns><DataGridTextColumn Header="First or second legal party ID" Binding="{Binding EntityId, UpdateSourceTrigger=PropertyChanged}" Width="350"/><DataGridTextColumn Header="Percent (0–100)" Binding="{Binding Percent, UpdateSourceTrigger=PropertyChanged}" Width="180"/></DataGrid.Columns></DataGrid><TextBlock Text="Guarantee disclosure — never covers ordinary receivable/payable balances" FontWeight="SemiBold"/><WrapPanel><StackPanel Width="400"><TextBlock Text="Beneficiary reference"/><TextBox Text="{Binding BeneficiaryReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Beneficiary reference"/></StackPanel><StackPanel Width="330"><TextBlock Text="Declared limit (blank = unspecified)"/><TextBox Text="{Binding GuaranteeLimit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Declared limit (blank = unspecified)"/></StackPanel></WrapPanel></StackPanel></StackPanel></Expander>
                <TextBlock Text="Terms / notes" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement terms notes" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
            </StackPanel>
<Expander Header="External legal review attestation (optional)" IsExpanded="True" Margin="0,12,0,8"><StackPanel>
<CheckBox Content="Attest external legal review of the exact submitted content" IsChecked="{Binding UseExternalReview}" AutomationProperties.Name="Use external review attestation"/>
<TextBlock Text="The signed-in operator records the attestation. The external reviewer is evidence, not an impersonated Meridian user. Leave unchecked to retain independent Meridian approval." TextWrapping="Wrap" Margin="0,5,0,8"/>
<WrapPanel IsEnabled="{Binding UseExternalReview}"><StackPanel Width="300"><TextBlock Text="External reviewer"/><TextBox Text="{Binding ExternalReviewer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="External reviewer"/></StackPanel><StackPanel Width="300"><TextBlock Text="Reviewer reference"/><TextBox Text="{Binding ReviewerReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reviewer reference"/></StackPanel><StackPanel Width="225"><TextBlock Text="Reviewed on (yyyy-MM-dd)"/><TextBox Text="{Binding ReviewedOn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reviewed on (yyyy-MM-dd)"/></StackPanel><StackPanel Width="400"><TextBlock Text="Evidence Vault reference"/><TextBox Text="{Binding ReviewEvidenceReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Evidence Vault reference"/></StackPanel><StackPanel Width="300"><TextBlock Text="Retained artifact ID"/><TextBox Text="{Binding ReviewEvidenceArtifact, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retained artifact ID"/></StackPanel><StackPanel Width="500"><TextBlock Text="Retained content SHA-256"/><TextBox Text="{Binding ReviewEvidenceHash, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retained content SHA-256"/></StackPanel></WrapPanel></StackPanel></Expander>
            <Expander Header="Current retained structured terms for review" IsExpanded="True" Margin="0,10,0,6">
                <TextBox Text="{Binding RetainedStructuredTermsSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         AutomationProperties.Name="Retained structured legal terms for review" />
            </Expander>
            <TextBlock Text="Review rationale" Margin="0,10,0,0" />
            <TextBox Text="{Binding Rationale, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Agreement review rationale" TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="Submit" Command="{Binding SubmitCommand}" />
                <Button Content="Approve" Command="{Binding ApproveCommand}" />
                <Button Content="Reject" Command="{Binding RejectCommand}" />
                <Button Content="Withdraw" Command="{Binding WithdrawCommand}" />
            </WrapPanel>
            <TextBlock Text="Proposals — inspect frozen terms and evidence before review" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding Detail.Proposals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding State}" Margin="0,6" IsExpanded="True">
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding Action, StringFormat='Action: {0}'}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BaseAgreementVersion, StringFormat='Base approved version: {0}'}" />
                                <TextBlock Text="{Binding SubmittedAtUtc, StringFormat='Submitted UTC: {0}'}" />
                                <TextBlock Text="{Binding SubmittedHash, StringFormat='Submitted payload hash: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Draft.Name}" />
                                <TextBlock Text="{Binding Draft.PartyOneId, StringFormat='First party: {0}'}" />
                                <TextBlock Text="{Binding Draft.PartyOneRole}" />
                                <TextBlock Text="{Binding Draft.PartyTwoId, StringFormat='Second party: {0}'}" />
                                <TextBlock Text="{Binding Draft.PartyTwoRole}" />
                                <TextBlock Text="{Binding Draft.Currency, StringFormat='Currency: {0}'}" />
                                <TextBlock Text="{Binding Draft.EffectiveFrom, StringFormat='Effective start: {0}'}" />
                                <TextBlock Text="{Binding Draft.EffectiveTo, StringFormat='Exclusive end: {0}'}" />
                                <TextBlock Text="{Binding Draft.TerminationEffectiveDate, StringFormat='Termination cutoff: {0}'}" />
                                <TextBlock Text="{Binding Draft.Terms.FixedAnnualRate, StringFormat='Annual rate fraction: {0}'}" />
                                <TextBlock Text="{Binding Draft.Terms.RateDescription}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Draft.Terms.ScheduleDescription, StringFormat='Schedule: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Draft.Terms.AllocationDescription, StringFormat='Allocation: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Draft.Terms.SettlementDays, StringFormat='Settlement calendar days: {0}'}" />
                                <TextBlock Text="{Binding Draft.Terms.Notes, StringFormat='Terms: {0}'}" TextWrapping="Wrap" />
                                <Expander Header="Exact structured declarations" Margin="0,6,0,6"><StackPanel>
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.SchemaVersion, StringFormat='Structured schema: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.RateBasis, StringFormat='Rate basis: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.FixedAnnualRate, StringFormat='Fixed annual fraction: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.FloatingIndexReference, StringFormat='Floating index: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.SpreadBps, StringFormat='Spread bps: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.DayCount, StringFormat='Day count: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Compounding, StringFormat='Compounding: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Schedule.StartDate, StringFormat='Schedule start: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Schedule.EndDate, StringFormat='Schedule end: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Schedule.Frequency, StringFormat='Cadence: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Schedule.CalendarId, StringFormat='Calendar: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Schedule.BusinessDayConvention, StringFormat='Business-day convention: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Schedule.SettlementBusinessDays, StringFormat='Settlement business days: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.FixedFeeAmount, StringFormat='Fixed fee amount: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.AnnualFeeRate, StringFormat='Annual fee fraction: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.CalculationBaseReference, StringFormat='Fee base: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.AllocationDriverReference, StringFormat='Allocation driver: {0}'}" />
                                    <ItemsControl ItemsSource="{Binding Draft.Terms.StructuredTerms.Allocations}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding EntityId}"/><TextBlock Text="{Binding Percent, StringFormat=': {0}%'}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Guarantee.BeneficiaryReference, StringFormat='Guarantee beneficiary: {0}'}" />
                                    <TextBlock Text="{Binding Draft.Terms.StructuredTerms.Guarantee.LimitAmount, StringFormat='Declared guarantee limit: {0}'}" />
                                </StackPanel></Expander>
                                <TextBlock Text="{Binding Draft.Purpose, StringFormat='Purpose: {0}'}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Rationale, StringFormat='Proposal rationale: {0}'}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Draft.Evidence}">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Reference}" TextWrapping="Wrap" /><TextBlock Text="{Binding ArtifactId}" /><TextBlock Text="{Binding ContentHash}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Retained versions — effective dates and approval times are separate" FontWeight="SemiBold" Margin="0,12,0,0" />
            <DataGrid ItemsSource="{Binding Detail.Revisions}" SelectedItem="{Binding SelectedRevision}" MaxHeight="220" AutomationProperties.Name="Agreement approved versions">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Version" Binding="{Binding AgreementVersion}" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                    <DataGridTextColumn Header="Effective start" Binding="{Binding Terms.EffectiveFrom}" />
                    <DataGridTextColumn Header="Exclusive end" Binding="{Binding Terms.EffectiveTo}" />
                    <DataGridTextColumn Header="Termination cutoff" Binding="{Binding Terms.TerminationEffectiveDate}" />
                    <DataGridTextColumn Header="Approved UTC" Binding="{Binding ApprovedAtUtc}" Width="180" />
                    <DataGridTextColumn Header="Approver" Binding="{Binding Approver}" Width="140" />
                    <DataGridTextColumn Header="Reviewed payload hash" Binding="{Binding PayloadHash}" Width="300" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Selected version" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedRevisionSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Selected agreement version terms" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Predecessor approval" FontWeight="SemiBold" /><TextBox Text="{Binding PreviousRevisionSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Predecessor agreement version terms" /></StackPanel>
            </Grid>
<Expander Header="Retained structured-term date preview" IsExpanded="True" Margin="0,12,0,8"><StackPanel><WrapPanel><Button Content="Preview retained proposal dates" Command="{Binding PreviewProposalDatesCommand}"/><Button Content="Preview selected approved version dates" Command="{Binding PreviewRevisionDatesCommand}"/></WrapPanel>
<TextBlock Text="{Binding DatePreviewStatus}" TextWrapping="Wrap"/>
<DataGrid ItemsSource="{Binding DatePreviewPeriods}" MaxHeight="200" AutomationProperties.Name="Declared agreement date preview"><DataGrid.Columns>
<DataGridTextColumn Header="Period" Binding="{Binding Sequence}"/><DataGridTextColumn Header="Accrual start" Binding="{Binding AccrualStart}" Width="160"/><DataGridTextColumn Header="Accrual end" Binding="{Binding AccrualEnd}" Width="160"/><DataGridTextColumn Header="Payment / settlement date" Binding="{Binding PaymentDate}" Width="220"/>
</DataGrid.Columns></DataGrid></StackPanel></Expander>
            <TextBlock Text="Proposal and decision history" FontWeight="SemiBold" />
            <DataGrid ItemsSource="{Binding Detail.History}" MaxHeight="250" AutomationProperties.Name="Agreement decision history">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="140" />
                    <DataGridTextColumn Header="Recorded UTC" Binding="{Binding RecordedAtUtc}" Width="180" />
                    <DataGridTextColumn Header="Rationale" Binding="{Binding Rationale}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Reviewed evidence" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Detail.ApplicableRevision.Terms.Evidence}">
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Reference}" /><TextBlock Text="{Binding ArtifactId}" /><TextBlock Text="{Binding ContentHash}" FontFamily="{DynamicResource MeridianDataFontFamily}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Source journal lines and advisory agreement coverage" FontWeight="SemiBold" Margin="0,12,0,0" />
            <WrapPanel>
                <StackPanel><TextBlock Text="Ledger book ID" /><TextBox Text="{Binding LedgerBook, UpdateSourceTrigger=PropertyChanged}" MinWidth="300" AutomationProperties.Name="Agreement journal ledger book" /></StackPanel>
                <Button Content="Load journal lines" Command="{Binding LoadJournalLinesCommand}" />
                <Button Content="More journal lines" Command="{Binding MoreJournalLinesCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding JournalStatus}" TextWrapping="Wrap" />
            <DataGrid ItemsSource="{Binding JournalLines}" MaxHeight="260" AutomationProperties.Name="Agreement source journal lines">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Accounting date" Binding="{Binding AccountingDate}" Width="110" />
                    <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="180" />
                    <DataGridTextColumn Header="Currency" Binding="{Binding TransactionCurrency}" Width="80" />
                    <DataGridTextColumn Header="Transaction debit" Binding="{Binding TransactionDebit}" Width="140" />
                    <DataGridTextColumn Header="Transaction credit" Binding="{Binding TransactionCredit}" Width="140" />
                    <DataGridTextColumn Header="Coverage" Binding="{Binding CoverageState}" Width="140" />
                    <DataGridTextColumn Header="Pinned version" Binding="{Binding IntercompanyAgreementVersion}" Width="100" />
                    <DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="260" />
                    <DataGridTextColumn Header="Journal" Binding="{Binding JournalEntryId}" Width="240" />
                    <DataGridTextColumn Header="Line" Binding="{Binding LineId}" Width="240" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceReference}" Width="240" />
                </DataGrid.Columns>
            </DataGrid>
<Expander Header="Contract coverage and obligation monitor — advisory only" IsExpanded="True" Margin="0,16,0,8"><StackPanel><TextBlock Text="Uses the ledger book and as-of date above. The server resolves its owning profile; no financial amounts are calculated on this workstation." TextWrapping="Wrap"/>
<WrapPanel><StackPanel Width="225"><TextBlock Text="Expiry horizon (calendar days)"/><TextBox Text="{Binding ExpiryHorizonDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expiry horizon (calendar days)"/></StackPanel><Button Content="Evaluate obligation monitor" Command="{Binding EvaluateObligationsCommand}"/></WrapPanel>
<TextBlock Text="{Binding ObligationStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
<Button Content="Inspect selected finding agreement" Command="{Binding InspectObligationAgreementCommand}" HorizontalAlignment="Left"/>
<DataGrid ItemsSource="{Binding ObligationFindings}" SelectedItem="{Binding SelectedObligationFinding}" MaxHeight="260" AutomationProperties.Name="Nonblocking intercompany obligation findings"><DataGrid.Columns>
<DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="260"/><DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="500"/><DataGridTextColumn Header="Source" Binding="{Binding DrillThrough}" Width="450"/>
</DataGrid.Columns></DataGrid><TextBlock Text="Posted balances — currencies, directions and source agreement pins remain separate" FontWeight="SemiBold"/>
<DataGrid ItemsSource="{Binding ObligationBalances}" MaxHeight="220" AutomationProperties.Name="Posted obligation balances"><DataGrid.Columns>
<DataGridTextColumn Header="Entity" Binding="{Binding EntityId}" Width="240"/><DataGridTextColumn Header="Counterparty" Binding="{Binding CounterpartyEntityId}" Width="240"/><DataGridTextColumn Header="Currency" Binding="{Binding TransactionCurrency}"/><DataGridTextColumn Header="Signed transaction balance" Binding="{Binding TransactionSignedBalance}" Width="200"/><DataGridTextColumn Header="Agreement" Binding="{Binding IntercompanyAgreementId}" Width="240"/><DataGridTextColumn Header="Version" Binding="{Binding IntercompanyAgreementVersion}"/>
</DataGrid.Columns></DataGrid><TextBlock Text="Guarantee disclosure register" FontWeight="SemiBold"/>
<Button Content="Open selected guarantee legal history" Command="{Binding OpenGuaranteeDisclosureCommand}" HorizontalAlignment="Left"/>
