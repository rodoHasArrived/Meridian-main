<Page x:Class="Meridian.Wpf.Views.ProviderHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="clr-namespace:Meridian.Wpf.Views"
      mc:Ignorable="d"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      AutomationProperties.Name="Provider Health">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <DockPanel>
        <!-- Page Action Bar -->
        <views:PageActionBarControl DockPanel.Dock="Top" DataContext="{Binding}"/>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,32">
        <StackPanel MaxWidth="1200">
            <!-- Header -->
            <Border Style="{StaticResource EmbeddedShellHeroCardStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="14"
                                Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                                BorderBrush="{StaticResource InfoColorBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="24" Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Provider Health" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Connection posture, latency, and recent provider events across streaming and backfill surfaces."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastUpdateText}"
                                   VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ConsoleTextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastUpdateStale}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary Stats -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ConnectedCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessColorBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Connected" Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DisconnectedCount}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource ErrorColorBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Disconnected" Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AvgLatency}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource InfoColorBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Avg Latency (ms)" Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalProviders}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Providers" Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Provider posture briefing -->
            <Border x:Name="ProviderPostureBriefingCard"
                    Style="{StaticResource CardStyle}" Margin="0,0,0,24"
                    Background="{Binding ProviderPostureBackgroundBrush}"
                    BorderBrush="{Binding ProviderPostureAccentBrush}"
                    AutomationProperties.AutomationId="ProviderPostureBriefingCard"
                    AutomationProperties.Name="{Binding ProviderPostureTitle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="4" CornerRadius="4"
                            Background="{Binding ProviderPostureAccentBrush}" Margin="0,0,16,0"/>

                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="14"
                            Background="{StaticResource PremiumPanelBrush}"
                            BorderBrush="{Binding ProviderPostureAccentBrush}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding ProviderPostureIcon}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="20"
                                   Foreground="{Binding ProviderPostureAccentBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProviderPostureTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   AutomationProperties.AutomationId="ProviderPostureTitleText"/>
                        <TextBlock Text="{Binding ProviderPostureDetail}"
                                   Margin="0,5,24,0"
                                   Style="{StaticResource CardDescriptionStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ProviderPostureDetailText"/>
                        <TextBlock Text="{Binding ProviderPostureEvidenceText}"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   AutomationProperties.AutomationId="ProviderPostureEvidenceText"/>
                    </StackPanel>

                    <Border Grid.Column="3" CornerRadius="14" Padding="14,10"
                            BorderBrush="{Binding ProviderPostureAccentBrush}" BorderThickness="1"
                            Background="{StaticResource PremiumPanelBrush}"
                            VerticalAlignment="Center"
                            MinWidth="180"
                            MaxWidth="260"
                            AutomationProperties.AutomationId="ProviderPostureHandoffPanel">
                        <StackPanel>
                            <TextBlock Text="Next handoff"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                            <TextBlock Text="{Binding ProviderPostureActionText}"
                                       Margin="0,3,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding ProviderPostureAccentBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ProviderPostureActionText"/>
                            <TextBlock Text="Target"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                            <TextBlock Text="{Binding ProviderPostureTargetText}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ProviderPostureTargetText"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Provider Management Center -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24"
                    AutomationProperties.AutomationId="ProviderManagementCenter"
                    AutomationProperties.Name="Provider Management Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Provider Management"
                                       Style="{StaticResource CardHeaderStyle}"
                                       AutomationProperties.AutomationId="ProviderManagementTitle"/>
                            <TextBlock Text="Configure, verify, monitor, and route market-data and brokerage providers used by Meridian."
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProviderManagementStatusText}"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       AutomationProperties.AutomationId="ProviderManagementStatusText"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Add Provider"
                                    Click="AddProvider_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Refresh Status"
                                    Click="Refresh_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Run Diagnostics"
                                    Click="RunDiagnostics_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Open Settings"
                                    Click="OpenSettings_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Configured Provider"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ProviderManagementRows}"
                                  SelectedItem="{Binding SelectedProviderManagementRow, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  MinHeight="34"
                                  MaxWidth="420"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Configured Provider"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ProviderManagementSummaryCards}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="178"
                                        MinHeight="108"
                                        Margin="0,0,12,12"
                                        Padding="12"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        BorderBrush="{Binding AccentBrush}"
                                        Background="{StaticResource PremiumPanelBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Value}"
                                                   Margin="0,6,0,0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <ListView Grid.Column="0"
                                  ItemsSource="{Binding ProviderManagementRows}"
                                  SelectedItem="{Binding SelectedProviderManagementRow, Mode=TwoWay}"
                                  MinHeight="260"
                                  AutomationProperties.Name="Provider management table">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Provider" Width="150" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Capability" Width="130" DisplayMemberBinding="{Binding CapabilityText}"/>
                                    <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding HealthText}"/>
                                    <GridViewColumn Header="Credential" Width="105" DisplayMemberBinding="{Binding CredentialStateText}"/>
                                    <GridViewColumn Header="Verification" Width="110" DisplayMemberBinding="{Binding VerificationStateText}"/>
                                    <GridViewColumn Header="Last good" Width="130" DisplayMemberBinding="{Binding LastSuccessfulConnectionText}"/>
                                    <GridViewColumn Header="Workflows" Width="190" DisplayMemberBinding="{Binding AffectedWorkflowsText}"/>
                                    <GridViewColumn Header="Action" Width="90" DisplayMemberBinding="{Binding ActionText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="16"
                                AutomationProperties.AutomationId="SelectedProviderManagementDetail">
                            <StackPanel DataContext="{Binding SelectedProviderManagementRow}">
                                <TextBlock Text="Selected Provider"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                <TextBlock Text="{Binding DisplayName, TargetNullValue='No provider selected'}"
                                           Margin="0,4,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CapabilityText}"
                                           Margin="0,2,0,12"
                                           FontSize="12"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}"/>

                                <TabControl>
                                    <TabItem Header="Overview">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="{Binding TrustExplanationText}"
                                                           Style="{StaticResource CardDescriptionStyle}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RecommendedActionText}"
                                                           Margin="0,10,0,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding HealthBrush}"
                                                           TextWrapping="Wrap"/>
                                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Text="Health" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                        <TextBlock Text="{Binding HealthText}" Foreground="{Binding HealthBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Text="Connection" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                        <TextBlock Text="{Binding LastSuccessfulConnectionText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Text="Fallback" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                        <TextBlock Text="{Binding FallbackText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Text="Workflows" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                        <TextBlock Text="{Binding AffectedWorkflowsText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Text="Last failure" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                        <TextBlock Text="{Binding LastFailureText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Text="Last error" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                        <TextBlock Text="{Binding LastErrorText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Credentials">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Raw secrets are never displayed after submit. Use Settings to replace or clear stored values."
                                                       Style="{StaticResource CardDescriptionStyle}"
                                                       TextWrapping="Wrap"/>
                                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="Credential state" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding CredentialStateText}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="Source" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding CredentialSourceText}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="Masked preview" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding MaskedKeyPreviewText}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="Environment" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding EnvironmentText}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="External account" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ExternalAccountIdText}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="Last verified" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}"/>
                                                    <TextBlock Text="{Binding LastVerifiedText}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Diagnostics">
                                        <StackPanel Margin="0,12,0,0">
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DataContext.ProviderVerificationStatusText, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           Style="{StaticResource CardDescriptionStyle}"
                                                           TextWrapping="Wrap"/>
                                                <Button Grid.Column="1"
                                                        Content="Run Verification"
                                                        Click="RunDiagnostics_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="12,0,0,0"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Diagnostics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="0,0,0,1"
                                                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                                                Padding="0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding StatusText}"
                                                                           Foreground="{Binding StatusBrush}"
                                                                           FontWeight="SemiBold"
                                                                           Margin="12,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Provider Status Cards -->
            <TextBlock Text="Streaming Providers" FontWeight="SemiBold" FontSize="16"
                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding StreamingProviders}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,16,16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12"
                                            Background="{Binding SparklineItem.BadgeBackground}"
                                            Visibility="{Binding SparklineItem.ReconnectBadgeAmber, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SparklineItem.ReconnectCount}" FontSize="11" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding LatencyText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding UptimeText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                </StackPanel>

                                <Canvas Grid.Row="2" Background="Transparent" ClipToBounds="True">
                                    <Polyline Points="{Binding SparklineItem.SparklinePoints}" Stroke="{Binding SparklineItem.SparklineStroke}"
                                              StrokeThickness="1.5" Canvas.Left="0" Canvas.Top="0"/>
                                </Canvas>

                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button Content="{Binding ActionText}" Tag="{Binding ProviderId}"
                                            Click="ProviderAction_Click"
                                            Background="{DynamicResource ConsoleBackgroundDarkBrush}"
                                            Foreground="{DynamicResource ConsoleTextBrush}"
                                            BorderThickness="0" Padding="12,4" FontSize="12"/>
                                    <Button Content="Details" Tag="{Binding ProviderId}"
                                            Click="ProviderDetails_Click" Margin="8,0,0,0"
                                            Background="Transparent"
                                            Foreground="{StaticResource InfoColorBrush}"
                                            BorderThickness="0" Padding="8,4" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Backfill Providers -->
            <TextBlock Text="Backfill Providers" FontWeight="SemiBold" FontSize="16"
                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding BackfillProviders}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,16,16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding RateLimitText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding LastUsedText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Connection History -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection History" Style="{StaticResource CardHeaderStyle}"/>
                        <Button Grid.Column="1" Content="Clear" Click="ClearHistory_Click"
                                Background="Transparent" Foreground="{StaticResource ConsoleTextMutedBrush}"
                                BorderThickness="0" Padding="8,4" FontSize="12"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ConnectionHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource ConsoleBorderBrush}"
                                        Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding EventColor}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Provider}"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No connection events recorded."
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
