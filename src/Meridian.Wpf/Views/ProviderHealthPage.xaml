<Page x:Class="Meridian.Wpf.Views.ProviderHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      xmlns:views="clr-namespace:Meridian.Wpf.Views"
      mc:Ignorable="d"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      AutomationProperties.Name="Provider Health">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <DockPanel>
        <!-- Page Action Bar -->
        <views:PageActionBarControl DockPanel.Dock="Top" DataContext="{Binding}"/>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,32">
        <StackPanel MaxWidth="1200">
            <!-- Header -->
            <Border Style="{StaticResource EmbeddedShellHeroCardStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="14"
                                Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                                BorderBrush="{StaticResource InfoColorBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="24" Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Provider Health" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Connection posture, latency, and recent provider events across streaming and backfill surfaces."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastUpdateText}"
                                   VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ConsoleTextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastUpdateStale}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary Stats -->
            <ItemsControl ItemsSource="{Binding ProviderMetricTiles}" Margin="0,0,0,24"
                          AutomationProperties.AutomationId="ProviderMetricTiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <workstation:MetricTileControl Metric="{Binding}" Width="178" Margin="0,0,12,12"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Provider posture briefing -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <workstation:WorkstationStatePanelControl Grid.Column="0"
                                                           State="{Binding ProviderPostureState}"
                                                           AutomationProperties.AutomationId="ProviderPostureBriefingCard" />
                <workstation:HealthBadgeControl Grid.Column="1"
                                                Badge="{Binding ProviderPostureBadge}"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="ProviderPostureBadge" />
            </Grid>

            <!-- Provider Management Center -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24"
                    AutomationProperties.AutomationId="ProviderManagementCenter"
                    AutomationProperties.Name="Provider Management Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Provider Management"
                                       Style="{StaticResource CardHeaderStyle}"
                                       AutomationProperties.AutomationId="ProviderManagementTitle"/>
                            <TextBlock Text="Configure, verify, monitor, and route market-data and brokerage providers used by Meridian."
                                       Margin="0,4,0,0"
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProviderManagementStatusText}"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       AutomationProperties.AutomationId="ProviderManagementStatusText"/>
                        </StackPanel>
                        <workstation:WorkstationCommandBarControl Grid.Column="1"
                                                                  CommandGroup="{Binding ProviderManagementCommandGroup}"
                                                                  CommandInvoked="OnProviderManagementCommandInvoked"
                                                                  VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Configured Provider"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ProviderManagementRows}"
                                  SelectedItem="{Binding SelectedProviderManagementRow, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  MinHeight="34"
                                  MaxWidth="420"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Configured Provider"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ProviderManagementSummaryCards}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="178"
                                        MinHeight="108"
                                        Margin="0,0,12,12"
                                        Padding="12"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        BorderBrush="{Binding AccentBrush}"
                                        Background="{StaticResource PremiumPanelBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Value}"
                                                   Margin="0,6,0,0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <workstation:DenseDataGridControl Grid.Column="0"
                                                          Table="{Binding ProviderManagementTable}"
                                                          SelectedItem="{Binding SelectedProviderManagementRow, Mode=TwoWay}"
                                                          MinHeight="260"
                                                          AutomationProperties.Name="Provider management table"/>

                        <TabControl Grid.Column="2"
                                    AutomationProperties.AutomationId="SelectedProviderManagementDetail">
                            <TabItem Header="Overview">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <workstation:InspectorPanelControl Panel="{Binding SelectedProviderInspector}" Margin="0,12,0,0"/>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Routing">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,12,0,0">
                                        <workstation:RoutingMatrixControl Matrix="{Binding SelectedProviderRoutingMatrix}"/>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Diagnostics">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ProviderVerificationStatusText}"
                                                           Style="{StaticResource CardDescriptionStyle}"
                                                           TextWrapping="Wrap"/>
                                                <Button Grid.Column="1"
                                                        Content="Run Verification"
                                                        Click="RunDiagnostics_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="12,0,0,0"/>
                                            </Grid>
                                            <workstation:DiagnosticsChecklistControl Checklist="{Binding SelectedProviderDiagnostics}"/>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Provider Status Cards -->
            <TextBlock Text="Streaming Providers" FontWeight="SemiBold" FontSize="16"
                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding StreamingProviders}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,16,16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12"
                                            Background="{Binding SparklineItem.BadgeBackground}"
                                            Visibility="{Binding SparklineItem.ReconnectBadgeAmber, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SparklineItem.ReconnectCount}" FontSize="11" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding LatencyText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding UptimeText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                </StackPanel>

                                <Canvas Grid.Row="2" Background="Transparent" ClipToBounds="True">
                                    <Polyline Points="{Binding SparklineItem.SparklinePoints}" Stroke="{Binding SparklineItem.SparklineStroke}"
                                              StrokeThickness="1.5" Canvas.Left="0" Canvas.Top="0"/>
                                </Canvas>

                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button Content="{Binding ActionText}" Tag="{Binding ProviderId}"
                                            Click="ProviderAction_Click"
                                            Background="{DynamicResource ConsoleBackgroundDarkBrush}"
                                            Foreground="{DynamicResource ConsoleTextBrush}"
                                            BorderThickness="0" Padding="12,4" FontSize="12"/>
                                    <Button Content="Details" Tag="{Binding ProviderId}"
                                            Click="ProviderDetails_Click" Margin="8,0,0,0"
                                            Background="Transparent"
                                            Foreground="{StaticResource InfoColorBrush}"
                                            BorderThickness="0" Padding="8,4" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Backfill Providers -->
            <TextBlock Text="Backfill Providers" FontWeight="SemiBold" FontSize="16"
                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding BackfillProviders}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,16,16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding RateLimitText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding LastUsedText}"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Connection History -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection History" Style="{StaticResource CardHeaderStyle}"/>
                        <Button Grid.Column="1" Content="Clear" Click="ClearHistory_Click"
                                Background="Transparent" Foreground="{StaticResource ConsoleTextMutedBrush}"
                                BorderThickness="0" Padding="8,4" FontSize="12"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ConnectionHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource ConsoleBorderBrush}"
                                        Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding EventColor}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Provider}"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No connection events recorded."
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
