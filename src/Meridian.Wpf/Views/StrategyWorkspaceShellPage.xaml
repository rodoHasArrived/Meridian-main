<views:StrategyWorkspaceShellPageBase x:Class="Meridian.Wpf.Views.StrategyWorkspaceShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="clr-namespace:Meridian.Wpf.Views"
      xmlns:controls="clr-namespace:Meridian.Wpf.Controls"
      xmlns:copy="clr-namespace:Meridian.Wpf.Copy"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1400"
      Background="{DynamicResource ConsoleBackgroundDarkBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="{x:Static copy:WorkspaceCopyCatalog.StrategyShellTitle}"
      AutomationProperties.AutomationId="StrategyWorkspaceShellPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="20"
          AutomationProperties.AutomationId="WorkspaceHomeStrategyWorkbenchTemplate">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>

        <views:WorkspaceShellContextStripControl x:Name="ContextStrip"
                                                 ShellContext="{Binding ShellContext}" />

        <controls:WorkspaceAttentionRibbon Grid.Row="1"
                                           DataContext="{Binding AttentionRibbon}"
                                           Margin="0,16,0,0" />

        <ScrollViewer Grid.Row="2"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="8,4,8,16"
                      AutomationProperties.AutomationId="WorkspaceEvidenceStripStrategy">
            <StackPanel MaxWidth="1400">
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="14"
                                        Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                                        BorderBrush="{StaticResource InfoColorBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="&#xE9D9;"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="24"
                                               Foreground="{StaticResource InfoColorBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Strategy" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Market briefing, PlotTool workstation, and paper-promotion review"
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Margin="0,18,0,0"
                                    Padding="14,12"
                                    CornerRadius="12"
                                    Background="#12253A"
                                    BorderBrush="#22486B"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Selected Run"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#7EA3C5" />
                                    <TextBlock x:Name="ActiveRunNameText"
                                               Margin="0,6,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Text="{Binding ActiveRunNameText}" />
                                    <TextBlock x:Name="ActiveRunMetaText"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#A8BED7"
                                               Text="{Binding ActiveRunMetaText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="16,0,0,0">
                            <Border Style="{StaticResource WorkspaceKpiTileStyle}" Margin="0,0,12,0">
                                <StackPanel Style="{StaticResource WorkspaceSummaryTileContentStyle}">
                                    <TextBlock Text="Runs"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TotalRunsText"
                                               Text="{Binding TotalRunsText}"
                                               Margin="0,4,0,0"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="All tracked runs"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource WorkspaceKpiTileStyle}" Margin="0,0,12,0">
                                <StackPanel Style="{StaticResource WorkspaceSummaryTileContentStyle}">
                                    <TextBlock Text="Promoted"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PromotedText"
                                               Text="{Binding PromotedText}"
                                               Margin="0,4,0,0"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SuccessColorBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Ready for next mode"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource WorkspaceKpiTileStyle}">
                                <StackPanel Style="{StaticResource WorkspaceSummaryTileContentStyle}">
                                    <TextBlock Text="Pending"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PendingReviewText"
                                               Text="{Binding PendingReviewText}"
                                               Margin="0,4,0,0"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource WarningColorBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Awaiting review"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <views:WorkspaceCommandBarControl x:Name="CommandBar"
                                                  CommandGroup="{Binding CommandGroup}"
                                                  CommandInvoked="OnCommandBarCommandInvoked"
                                                  Margin="0,0,0,24"
                                                  AutomationProperties.AutomationId="WorkspaceCommandSurfaceStrategy" />

                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Strategy Desk Briefing" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock x:Name="StrategyHeroFocusText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               Text="{Binding StrategyHeroFocusText}" />
                                </StackPanel>

                                <Border x:Name="StrategyHeroBadgeBorder"
                                        Grid.Column="1"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="{StaticResource ConsoleAccentBlueAlpha10Brush}"
                                        BorderBrush="{StaticResource InfoColorBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="StrategyHeroBadgeText"
                                               Text="{Binding StrategyHeroBadgeText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InfoColorBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="StrategyWorkflowStatusText"
                                       Margin="0,10,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Text="{Binding StrategyWorkflowStatusText}" />
                            <TextBlock x:Name="StrategyWorkflowDetailText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding StrategyWorkflowDetailText}" />

                            <ItemsControl x:Name="StrategyWorkflowEvidenceItems"
                                          ItemsSource="{Binding StrategyWorkflowEvidenceItems}"
                                          Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NeutralBadgeStyle}" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <Border Padding="14,12"
                                    CornerRadius="12"
                                    Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Next Handoff"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                    <TextBlock x:Name="StrategyHeroActionTitleText"
                                               Margin="0,8,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               Text="{Binding StrategyHeroActionTitleText}" />
                                    <TextBlock x:Name="StrategyHeroActionDetailText"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding StrategyHeroActionDetailText}" />

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="StrategyHeroPrimaryActionButton"
                                                Content="{Binding StrategyHeroPrimaryActionText}"
                                                Click="OnStrategyHeroPrimaryActionClick"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,10,10" />
                                        <Button x:Name="StrategyHeroSecondaryActionButton"
                                                Content="{Binding StrategyHeroSecondaryActionText}"
                                                Click="OnStrategyHeroSecondaryActionClick"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,10,10"
                                                Visibility="{Binding StrategyHeroSecondaryActionVisibility}" />
                                    </WrapPanel>

                                    <TextBlock x:Name="StrategyWorkflowTargetText"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               Text="{Binding StrategyWorkflowTargetText}" />
                                </StackPanel>
                            </Border>

                            <Border Padding="14,12"
                                    CornerRadius="12"
                                    Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Primary Blocker"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                    <TextBlock x:Name="StrategyWorkflowBlockerLabelText"
                                               Margin="0,8,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               Text="{Binding StrategyWorkflowBlockerLabelText}" />
                                    <TextBlock x:Name="StrategyWorkflowBlockerDetailText"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding StrategyWorkflowBlockerDetailText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Style="{StaticResource WorkspaceCardHeaderGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Market Briefing" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock x:Name="BriefingSummaryText"
                                           Text="{Binding BriefingSummaryText}"
                                           Style="{StaticResource CardDescriptionStyle}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource InfoBadgeInlineStyle}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="BriefingGeneratedText"
                                           Text="{Binding BriefingGeneratedText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BadgeInfoForegroundBrush}" />
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StudioPanelStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Pinned Insights" Style="{StaticResource StudioPanelTitleStyle}" />

                                    <ItemsControl x:Name="BriefingInsightsList"
                                                  ItemsSource="{Binding BriefingInsights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource WorkspaceQueueItemCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Headline}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SuccessColorBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="Open"
                                                                Tag="{Binding RunId}"
                                                                Click="OpenBriefingRun_Click"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoBriefingInsightsText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               Text="Pinned insights will appear here once runs are available."
                                               Visibility="{Binding NoBriefingInsightsVisibility}" />

                                    <Rectangle Margin="0,16,0,14"
                                               Height="1"
                                               Fill="{StaticResource ConsoleBorderBrush}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Watchlists" Style="{StaticResource StudioPanelTitleStyle}" />
                                        <Button Grid.Column="1"
                                                Content="Open Watchlists"
                                                Click="OpenWatchlists_Click"
                                                Style="{StaticResource LinkButtonStyle}" />
                                    </Grid>

                                    <ItemsControl x:Name="BriefingWatchlistsList"
                                                  ItemsSource="{Binding BriefingWatchlists}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource WorkspaceQueueItemCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoBriefingWatchlistsText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               Text="Pinned watchlists will appear here."
                                               Visibility="{Binding NoBriefingWatchlistsVisibility}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource StudioPanelStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="What Changed" Style="{StaticResource StudioPanelTitleStyle}" />

                                    <ItemsControl x:Name="BriefingWhatChangedList"
                                                  ItemsSource="{Binding BriefingWhatChanged}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource WorkspaceQueueItemCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding RelativeTime}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="Open"
                                                                Tag="{Binding RunId}"
                                                                Click="OpenBriefingRun_Click"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoBriefingWhatChangedText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               Text="Recent workflow changes will appear here."
                                               Visibility="{Binding NoBriefingWhatChangedVisibility}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StudioPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Alerts" Style="{StaticResource StudioPanelTitleStyle}" />

                                    <ItemsControl x:Name="BriefingAlertsList"
                                                  ItemsSource="{Binding BriefingAlerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource WorkspaceQueueItemCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="{Binding ActionLabel}"
                                                                Tag="{Binding RunId}"
                                                                Click="OpenBriefingAlert_Click"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoBriefingAlertsText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               Text="Blocking alerts will appear here."
                                               Visibility="{Binding NoBriefingAlertsVisibility}" />

                                    <Rectangle Margin="0,16,0,14"
                                               Height="1"
                                               Fill="{StaticResource ConsoleBorderBrush}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Saved Comparisons" Style="{StaticResource StudioPanelTitleStyle}" />
                                        <Button Grid.Column="1"
                                                Content="Run Browser"
                                                Click="OpenStrategyRuns_Click"
                                                Style="{StaticResource LinkButtonStyle}" />
                                    </Grid>

                                    <ItemsControl x:Name="BriefingComparisonsList"
                                                  ItemsSource="{Binding BriefingComparisons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource WorkspaceQueueItemCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding StrategyName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding ModeSummary}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="Compare"
                                                                Tag="{Binding AnchorRunId}"
                                                                Click="OpenBriefingComparison_Click"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoBriefingComparisonsText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               Text="Saved comparisons will appear here once runs can be staged side by side."
                                               Visibility="{Binding NoBriefingComparisonsVisibility}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Style="{StaticResource WorkspaceCardHeaderGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PlotTool workstation" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="Bring PlotTool selection, compare posture, and run evidence into the desktop Strategy lane."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Content="Run scripts"
                                        Click="OpenRunMat_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,10,10" />
                                <Button Content="Charts"
                                        Click="OpenCharts_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,10,10" />
                                <Button Content="Run Browser"
                                        Click="OpenStrategyRuns_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Margin="0,0,10,10" />
                            </WrapPanel>
                        </Grid>

                        <Border Margin="0,16,0,0"
                                Padding="14,12"
                                CornerRadius="12"
                                Background="{StaticResource ConsoleAccentBlueAlpha10Brush}"
                                BorderBrush="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selection"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                    <TextBlock Text="{Binding ActiveRunNameText}"
                                               Margin="0,6,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ActiveRunMetaText}"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoColorBrush}"
                                           Text="{Binding BriefingGeneratedText}" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StudioPanelStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Selection context" Style="{StaticResource StudioPanelTitleStyle}" />
                                    <TextBlock x:Name="ScenarioStrategyText"
                                               Margin="0,10,0,0"
                                               Style="{StaticResource StudioValueStyle}"
                                               Text="{Binding ScenarioStrategyText}" />
                                    <TextBlock x:Name="ScenarioCoverageText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               Text="{Binding ScenarioCoverageText}" />
                                    <Rectangle Margin="0,14,0,14"
                                               Height="1"
                                               Fill="{StaticResource ConsoleBorderBrush}" />
                                    <TextBlock Text="Workstation structure" Style="{StaticResource StudioPanelTitleStyle}" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               Text="Left rail: selection and coverage. Center: PlotTool console, compare posture, and notebook cues. Right rail: portfolio, ledger, and risk inspectors." />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource StudioPanelStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Console &amp; compare" Style="{StaticResource StudioPanelTitleStyle}" />
                                    <TextBlock x:Name="RunStatusText"
                                               Margin="0,10,0,0"
                                               Style="{StaticResource StudioValueStyle}"
                                               Text="{Binding RunStatusText}" />
                                    <TextBlock x:Name="RunPerformanceText"
                                               Margin="0,8,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               Text="{Binding RunPerformanceText}" />
                                    <TextBlock x:Name="RunCompareText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                               Text="{Binding RunCompareText}" />
                                    <Border Margin="0,16,0,0"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                            BorderBrush="{StaticResource ConsoleBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Expression console"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                            <TextBlock Text="{Binding BriefingSummaryText}"
                                                       Margin="0,8,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Drag pages into the dock below to keep charts, run detail, and inspectors aligned with the same selected run."
                                                       Margin="0,10,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InfoColorBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StudioPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Inspector rail" Style="{StaticResource StudioPanelTitleStyle}" />
                                    <TextBlock Text="Portfolio"
                                               Margin="0,10,0,0"
                                               Style="{StaticResource StudioPanelTitleStyle}" />
                                    <TextBlock x:Name="PortfolioPreviewText"
                                               Margin="0,6,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               Text="{Binding PortfolioPreviewText}" />
                                    <TextBlock Text="Ledger"
                                               Margin="0,14,0,0"
                                               Style="{StaticResource StudioPanelTitleStyle}" />
                                    <TextBlock x:Name="LedgerPreviewText"
                                               Margin="0,6,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               Text="{Binding LedgerPreviewText}" />
                                    <TextBlock Text="Risk snapshot"
                                               Margin="0,14,0,0"
                                               Style="{StaticResource StudioPanelTitleStyle}" />
                                    <TextBlock x:Name="RiskPreviewText"
                                               Margin="0,6,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                               Text="{Binding RiskPreviewText}" />
                                    <WrapPanel Style="{StaticResource WorkspaceCardFooterPanelStyle}">
                                        <Button Content="Accounting Impact"
                                                Click="OpenAccountingImpact_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,10,8" />
                                        <Button Content="Reconciliation"
                                                Click="OpenReconciliationPreview_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,10,8" />
                                        <Button Content="Audit Trail"
                                                Click="OpenAuditTrail_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,10,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StudioPanelStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Run History Rail" Style="{StaticResource StudioPanelTitleStyle}" />
                                <Button Grid.Column="1"
                                        Content="Browse All"
                                        Click="OpenStrategyRuns_Click"
                                        Style="{StaticResource LinkButtonStyle}" />
                            </Grid>

                            <ItemsControl x:Name="RecentRunsList"
                                          ItemsSource="{Binding RecentRuns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource WorkspaceQueueItemCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StrategyName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding NetPnlFormatted}"
                                                               Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Foreground="{Binding NetPnlBrush}" />
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               Margin="0,4,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Open"
                                                        Tag="{Binding RunId}"
                                                        Click="OpenRunFromHistory_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoRunsText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       Text="No strategy runs yet. Start a new backtest to see results here."
                                       Visibility="{Binding NoRunsVisibility}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Promotion Pipeline" Style="{StaticResource CardHeaderStyle}" />
                                <Border Style="{StaticResource InfoBadgeInlineStyle}"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PromotionCountBadge"
                                               Text="{Binding PromotionCountBadgeText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BadgeInfoForegroundBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Strategies that have completed backtesting and are candidates for paper or live promotion."
                                       Style="{StaticResource CardDescriptionStyle}"
                                       Margin="0,0,0,12" />

                            <ItemsControl x:Name="PromotionCandidatesList"
                                          ItemsSource="{Binding PromotionCandidates}"
                                          AutomationProperties.AutomationId="PromotionCandidatesList"
                                          AutomationProperties.Name="Promotion Candidates">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ConsoleBackgroundLightBrush}"
                                                CornerRadius="10"
                                                Padding="16,12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding StrategyName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding PromotionReason}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Border Background="{StaticResource SuccessColorAlpha20Brush}"
                                                            CornerRadius="6"
                                                            Padding="10,4"
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding NextModeLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource SuccessColorBrush}" />
                                                    </Border>
                                                    <Button Content="Review"
                                                            Tag="{Binding RunId}"
                                                            Click="ReviewPromotion_Click"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoPromotionsText"
                                       Text="No promotion candidates. Complete a backtest run to see it here."
                                       FontSize="13"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       Visibility="{Binding NoPromotionsVisibility}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource SectionCardStyle}"
                        Margin="0,24,0,0"
                        AutomationProperties.AutomationId="WorkspaceInspectorHostStrategy">
                    <StackPanel>
                        <TextBlock Text="Workspace Panels"
                                   Style="{StaticResource CardHeaderStyle}"
                                   Margin="4,0,0,6" />
                        <views:MeridianDockingManager x:Name="StrategyDockManager"
                                                      Height="360"
                                                      PaneDropRequested="OnPaneDropRequested"
                                                      AutomationProperties.Name="Strategy Dock Manager" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</views:StrategyWorkspaceShellPageBase>
