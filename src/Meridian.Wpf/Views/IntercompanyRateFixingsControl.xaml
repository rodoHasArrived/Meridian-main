<UserControl x:Class="Meridian.Wpf.Views.IntercompanyRateFixingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Intercompany rate fixings">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0,3,12,10" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="Margin" Value="0,8,0,12" />
        </Style>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Rate fixings" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Index fixings that floating-rate intercompany interest reads. An operator records what the publisher showed; someone else approves it. Only approved values set accrual rates. Nothing is fetched from a market feed, and a missing fixing is never inferred from a nearby date."
                       Margin="0,5,0,12" TextWrapping="Wrap" />
            <WrapPanel>
                <StackPanel><TextBlock Text="Index reference" /><TextBox Text="{Binding IndexReference, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="Fixing index reference" /></StackPanel>
                <StackPanel><TextBlock Text="From (yyyy-MM-dd)" /><TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fixings from date" /></StackPanel>
                <StackPanel><TextBlock Text="To, inclusive (yyyy-MM-dd)" /><TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fixings to date" /></StackPanel>
                <Button Content="Load fixings" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.Name="Rate fixing status" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding PermissionNote}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="Rate fixing permission" />
            <DataGrid ItemsSource="{Binding Fixings}" SelectedItem="{Binding SelectedFixing}" MaxHeight="260" AutomationProperties.Name="Retained rate fixings">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fixing date" Binding="{Binding Date}" Width="110" />
                    <DataGridTextColumn Header="Approved rate" Binding="{Binding Approved}" Width="160" />
                    <DataGridTextColumn Header="Pending value" Binding="{Binding Pending}" Width="240" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="320" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="260" />
                    <DataGridTextColumn Header="History" Binding="{Binding History}" Width="420" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Review the selected pending value" FontWeight="SemiBold" />
            <TextBlock Text="The person who proposed a value cannot approve it. A rejection keeps any previously approved value in force."
                       TextWrapping="Wrap" />
            <WrapPanel>
                <StackPanel><TextBlock Text="Rejection reason" /><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="420" AutomationProperties.Name="Fixing rejection reason" /></StackPanel>
                <Button Content="Approve pending value" Command="{Binding ApproveCommand}" VerticalAlignment="Center" />
                <Button Content="Reject pending value" Command="{Binding RejectCommand}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="Propose a value or a correction" FontWeight="SemiBold" Margin="0,10,0,0" />
            <WrapPanel>
                <StackPanel><TextBlock Text="Fixing date (yyyy-MM-dd)" /><TextBox Text="{Binding FixingDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Proposed fixing date" /></StackPanel>
                <StackPanel><TextBlock Text="Annual rate fraction (0.0425 = 4.25%)" /><TextBox Text="{Binding RateFraction, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Proposed annual rate fraction" /></StackPanel>
                <StackPanel><TextBlock Text="Source (publisher, series, publication)" /><TextBox Text="{Binding SourceReference, UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="Fixing source reference" /></StackPanel>
                <StackPanel><TextBlock Text="Justification" /><TextBox Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="Fixing justification" /></StackPanel>
            </WrapPanel>
            <Button Content="Propose fixing" Command="{Binding ProposeCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
