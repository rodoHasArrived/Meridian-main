<Page x:Class="Meridian.Wpf.Views.WatchlistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Watchlist">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,16,28,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Margin="0,0,0,16"
                    Padding="14,10"
                    AutomationProperties.AutomationId="WatchlistActionStrip"
                    AutomationProperties.Name="Watchlist Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE7B3;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Watchlists"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding VisibleScopeText}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PostureActionText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Width="240"
                                 AutomationProperties.AutomationId="WatchlistSearchBox"
                                 AutomationProperties.Name="Search watchlists"
                                 Background="{DynamicResource ConsoleBackgroundDarkBrush}"
                                 Foreground="{DynamicResource ConsoleTextBrush}"
                                 BorderBrush="{DynamicResource ConsoleBorderBrush}"
                                 Padding="8,6"
                                 Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Clear"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding SearchText.Length, Converter={StaticResource IntToVisibilityConverter}}"
                                AutomationProperties.AutomationId="WatchlistClearSearchButton"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="+ New Watchlist"
                                Command="{Binding CreateWatchlistCommand}"
                                AutomationProperties.AutomationId="WatchlistCreateWatchlistButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="Import"
                                Command="{Binding ImportWatchlistCommand}"
                                AutomationProperties.AutomationId="WatchlistImportButton"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="WatchlistPostureCard"
                    Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16"
                    Padding="16"
                    AutomationProperties.Name="Watchlist posture"
                    AutomationProperties.AutomationId="WatchlistPostureCard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="32" Height="32" CornerRadius="10"
                                    Background="{StaticResource ConsoleAccentBlueAlpha10Brush}"
                                    BorderBrush="{StaticResource InfoColorBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="15"
                                           Foreground="{StaticResource InfoColorBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding PostureTitle}"
                                           AutomationProperties.AutomationId="WatchlistPostureTitle"
                                           Style="{StaticResource CardHeaderStyle}"
                                           Margin="0" />
                                <TextBlock Text="{Binding PostureDetail}"
                                           AutomationProperties.AutomationId="WatchlistPostureDetail"
                                           Style="{StaticResource CardDescriptionStyle}"
                                           Margin="0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1"
                               MaxWidth="560"
                               Margin="24,0,0,0"
                               VerticalAlignment="Center">
                        <Border Background="{StaticResource ConsoleBackgroundLightBrush}"
                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Saved"
                                           FontSize="10"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding TotalWatchlistsText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ConsoleBackgroundLightBrush}"
                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pinned"
                                           FontSize="10"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding PinnedWatchlistsText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ConsoleBackgroundLightBrush}"
                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Symbols"
                                           FontSize="10"
                                           Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding SymbolCoverageText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ConsoleAccentBlueAlpha10Brush}"
                                BorderBrush="{StaticResource InfoColorBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="{Binding VisibleScopeText}"
                                           AutomationProperties.AutomationId="WatchlistVisibleScopeText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoColorBrush}" />
                                <TextBlock Text="{Binding PostureActionText}"
                                           FontSize="10"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <workstation:WorkstationTableInspectorControl x:Name="WatchlistWorkbench"
                                                              Visibility="{Binding ListVisibility}"
                                                              MinHeight="380"
                                                              Table="{Binding WatchlistTable}"
                                                              SelectedItem="{Binding SelectedWatchlist, Mode=TwoWay}"
                                                              Inspector="{Binding SelectedWatchlistInspector}"
                                                              HeaderText="Watchlist Library"
                                                              DetailText="Saved watchlists for monitoring and workspace loading."
                                                              ScopeText="{Binding VisibleScopeText}"
                                                              GridAutomationId="WatchlistLibraryGrid"
                                                              EmptyAutomationId="WatchlistLibraryGridEmpty"
                                                              InspectorAutomationId="WatchlistSelectionInspector"
                                                              ControlAutomationId="WatchlistWorkbench">
                    <workstation:WorkstationTableInspectorControl.InspectorContent>
                        <Border Style="{StaticResource CardStyle}"
                                Padding="16"
                                AutomationProperties.AutomationId="WatchlistActionInspector"
                                AutomationProperties.Name="Watchlist selected actions">
                            <StackPanel>
                                <TextBlock Text="Selected Actions"
                                           Style="{StaticResource CardHeaderStyle}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Actions stay disabled until a watchlist row is selected."
                                           Style="{StaticResource CardDescriptionStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Content="Load"
                                            Command="{Binding LoadSelectedWatchlistCommand}"
                                            ToolTip="{Binding LoadSelectedWatchlistTooltip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.AutomationId="WatchlistLoadSelectedButton"/>
                                    <Button Content="Edit"
                                            Command="{Binding EditSelectedWatchlistCommand}"
                                            ToolTip="{Binding EditSelectedWatchlistTooltip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.AutomationId="WatchlistEditSelectedButton"/>
                                    <Button Content="{Binding SelectedPinActionLabel}"
                                            Command="{Binding PinSelectedWatchlistCommand}"
                                            ToolTip="{Binding PinSelectedWatchlistTooltip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.AutomationId="WatchlistPinSelectedButton"/>
                                    <Button Content="Export"
                                            Command="{Binding ExportSelectedWatchlistCommand}"
                                            ToolTip="{Binding ExportSelectedWatchlistTooltip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.AutomationId="WatchlistExportSelectedButton"/>
                                    <Button Content="Duplicate"
                                            Command="{Binding DuplicateSelectedWatchlistCommand}"
                                            ToolTip="{Binding DuplicateSelectedWatchlistTooltip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.AutomationId="WatchlistDuplicateSelectedButton"/>
                                    <Button Content="Delete"
                                            Command="{Binding DeleteSelectedWatchlistCommand}"
                                            ToolTip="{Binding DeleteSelectedWatchlistTooltip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.AutomationId="WatchlistDeleteSelectedButton"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </workstation:WorkstationTableInspectorControl.InspectorContent>
                </workstation:WorkstationTableInspectorControl>

                <Border x:Name="EmptyState"
                        Visibility="{Binding EmptyStateVisibility}"
                        Style="{StaticResource CardStyle}"
                        Padding="48"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="WatchlistEmptyState">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8F1;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="48"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ConsoleTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding EmptyStateDescription}"
                                   Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Clear Search"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText.Length, Converter={StaticResource IntToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="WatchlistClearSearchEmptyButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Create Watchlist"
                                    Command="{Binding CreateWatchlistCommand}"
                                    AutomationProperties.AutomationId="WatchlistCreateWatchlistEmptyButton"
                                    Background="{StaticResource SuccessColorBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="24,12"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
