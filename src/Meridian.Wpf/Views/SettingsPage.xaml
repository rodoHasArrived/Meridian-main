<Page x:Class="Meridian.Wpf.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1200"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      AutomationProperties.Name="Settings">

    <Grid Background="{DynamicResource ShellWindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="28,20,12,32">
            <StackPanel MaxWidth="800">
                <!-- Header -->
                <Border Style="{StaticResource EmbeddedShellHeroCardStyle}" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="14"
                                Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                                BorderBrush="{StaticResource InfoColorBrush}" BorderThickness="1">
                            <TextBlock Text="{StaticResource IconSettings}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="24"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Settings"
                                       Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Credential posture, storage defaults, profiles, and platform appearance."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,16"
                        BorderBrush="{StaticResource InfoColorBrush}"
                        AutomationProperties.AutomationId="SettingsDemoSampleModeCard">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconData}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="18"
                                           Foreground="{StaticResource InfoColorBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Demo / Sample Mode"
                                           Style="{StaticResource CardHeaderStyle}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding DemoModeStatusText}"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Tour order: Data/provider status → Portfolio records → Accounting reconciliation → Evidence/audit context → Reporting readiness → Settings."
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Start Demo / Sample Tour"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartDemoTourCommand}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                AutomationProperties.AutomationId="SettingsStartDemoTourButton" />
                    </Grid>
                </Border>

                <TabControl Margin="0,0,0,24"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Settings generated tabs">
                    <TabItem Header="Capabilities"
                             AutomationProperties.AutomationId="SettingsCapabilitiesTab">
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="{StaticResource IconSettings}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="20"
                                               Foreground="{StaticResource InfoColorBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Capabilities"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding CapabilityToggles}"
                                              AutomationProperties.AutomationId="SettingsCapabilityToggles">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding CapabilityKey}"
                                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                   FontFamily="Cascadia Code, Consolas, monospace"
                                                                   FontSize="11"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StateText}"
                                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{Binding DisplayName}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </TabItem>
                    <TabItem Header="Operations Control"
                             AutomationProperties.AutomationId="SettingsOperationsControlTab">
                        <StackPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource IconCalendar}"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontSize="20"
                                                       Foreground="{StaticResource InfoColorBrush}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Operations Control"
                                                           Style="{StaticResource CardHeaderStyle}" />
                                                <TextBlock Text="{Binding OperationsControlStatusText}"
                                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="560" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RefreshOperationsControlCommand}"
                                                AutomationProperties.AutomationId="SettingsOperationsControlRefreshButton">
                                            <TextBlock Text="Refresh" />
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OperationsApprovalPolicySummaryText}"
                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OperationsControlGeneratedAtText, StringFormat=Generated {0}}"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                   FontSize="12"
                                                   Margin="12,0,0,0" />
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding OperationsApprovalPolicyRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              MaxHeight="230"
                                              AutomationProperties.AutomationId="SettingsOperationsApprovalPolicyGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Area" Binding="{Binding WorkflowArea}" Width="1.2*" />
                                            <DataGridTextColumn Header="Gate" Binding="{Binding GateLabel}" Width="1*" />
                                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.4*" />
                                            <DataGridTextColumn Header="Approvals" Binding="{Binding ApprovalRuleLabel}" Width="1.2*" />
                                            <DataGridTextColumn Header="Reviewer" Binding="{Binding ReviewerLabel}" Width="1.3*" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceRequirement}" Width="1.6*" />
                                            <DataGridTextColumn Header="Controls" Binding="{Binding ControlLabel}" Width="1.4*" />
                                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="0.9*" />
                                            <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="1.2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource IconCheckmark}"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontSize="18"
                                                       Foreground="{StaticResource InfoColorBrush}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Close Calendar"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding OperationsCloseCalendarSummaryText}"
                                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="560" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding OperationsCloseCalendarReadyCount, StringFormat={}{0} ready}"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding OperationsCloseCalendarBlockedCount, StringFormat={}{0} blocked}"
                                                       Foreground="{StaticResource WarningColorBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding OperationsCloseCalendarRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              MaxHeight="260"
                                              AutomationProperties.AutomationId="SettingsOperationsCloseCalendarGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Period" Binding="{Binding PeriodId}" Width="0.9*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="1.2*" />
                                            <DataGridTextColumn Header="Due" Binding="{Binding DueLabel}" Width="1.7*" />
                                            <DataGridTextColumn Header="Owner" Binding="{Binding OwnerLabel}" Width="1.1*" />
                                            <DataGridTextColumn Header="Readiness" Binding="{Binding ReadinessLabel}" Width="1*" />
                                            <DataGridTextColumn Header="Breaks" Binding="{Binding BlockerLabel}" Width="0.9*" />
                                            <DataGridTextColumn Header="Checklist" Binding="{Binding ChecklistLabel}" Width="1.1*" />
                                            <DataGridTextColumn Header="Approvals" Binding="{Binding ApprovalLabel}" Width="0.9*" />
                                            <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="1.3*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Asset Profiles"
                             AutomationProperties.AutomationId="SettingsAssetProfilesTab">
                        <StackPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource IconDatabase}"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontSize="20"
                                                       Foreground="{StaticResource InfoColorBrush}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Asset Profiles"
                                                           Style="{StaticResource CardHeaderStyle}" />
                                                <TextBlock Text="{Binding SelectedAssetProfileSummaryText}"
                                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="560" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RefreshAssetProfilesCommand}"
                                                AutomationProperties.AutomationId="SettingsAssetProfileRefreshButton">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Refresh" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding AssetProfileStatusText}"
                                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ApprovedAssetProfileCount, StringFormat={}{0} approved}"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding AssetProfileProjectedFieldCount, StringFormat={}{0} projected}"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <ListView ItemsSource="{Binding AssetProfileRows}"
                                              SelectedItem="{Binding SelectedAssetProfileRow, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              MaxHeight="260"
                                              AutomationProperties.AutomationId="SettingsAssetProfileRows">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                                        CornerRadius="8"
                                                        Padding="12"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.1*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding VersionLabel}"
                                                                           Foreground="{StaticResource InfoColorBrush}"
                                                                           FontSize="12"
                                                                           Margin="8,1,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ProfileId}"
                                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding EffectiveLabel}"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding CategoryLabel}"
                                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding FieldCountLabel}"
                                                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                                       FontSize="12"
                                                                       Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding ProjectedFieldCountLabel}"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                       FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource InfoColorBrush}" />
                                                            <TextBlock Text="{Binding RequiredIdentifierKindsLabel}"
                                                                       Foreground="{StaticResource WarningColorBrush}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12"
                                                                       Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding AccountingHintsLabel}"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Draft and approve profile variants"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                            <TextBlock Text="The draft copies the selected approved profile's fields, identifiers, lifecycle states, and accounting hints."
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AssetProfileLineageSummaryText}"
                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                   TextAlignment="Right"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="240" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                            <TextBlock Text="Profile id" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding AssetProfileDraftProfileId, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                            <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding AssetProfileDraftName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                            <TextBlock Text="Category" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding AssetProfileDraftCategory, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                            <TextBlock Text="Subtype" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding AssetProfileDraftSubType, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                            <TextBlock Text="Rationale" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding AssetProfileDraftRationale, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Rollback version" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding AssetProfileRollbackVersion, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DraftAssetProfileCommand}"
                                                Margin="0,18,8,0"
                                                AutomationProperties.AutomationId="SettingsAssetProfileDraftButton"
                                                Content="Save draft" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding ApproveAssetProfileCommand}"
                                                Margin="0,18,8,0"
                                                AutomationProperties.AutomationId="SettingsAssetProfileApproveButton"
                                                Content="Approve" />
                                        <Button Grid.Column="3"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding LoadAssetProfileLineageCommand}"
                                                Margin="0,18,8,0"
                                                AutomationProperties.AutomationId="SettingsAssetProfileLineageButton"
                                                Content="Lineage" />
                                        <Button Grid.Column="4"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding RollbackAssetProfileCommand}"
                                                Margin="0,18,0,0"
                                                AutomationProperties.AutomationId="SettingsAssetProfileRollbackButton"
                                                Content="Rollback" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AssetProfileLineageEvents}"
                                                  Visibility="{Binding HasAssetProfileLineageEvents, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Cascadia Code, Consolas, monospace"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Create profile-backed custom asset"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                    <TextBlock Text="Creates a Security Master CustomAsset pinned to the selected approved profile version."
                                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Display name" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding ProfileBackedSecurityDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,8,10">
                                            <TextBlock Text="Internal code" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding ProfileBackedSecurityInternalCode, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,10">
                                            <TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding ProfileBackedSecurityCurrency, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AssetProfileFieldInputs}" Margin="0,0,0,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="238"
                                                        Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                                        CornerRadius="8"
                                                        Padding="10"
                                                        Margin="0,0,8,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding InputHint}"
                                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                       FontSize="11"
                                                                       Margin="8,0,0,0" />
                                                        </Grid>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBoxStyle}"
                                                                 Margin="0,7,0,0" />
                                                        <TextBlock Text="{Binding AllowedValuesLabel}"
                                                                   Visibility="{Binding AllowedValuesLabel, Converter={StaticResource StringToVisibilityConverter}}"
                                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"
                                                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Rationale" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox Text="{Binding ProfileBackedSecurityRationale, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CreateProfileBackedSecurityCommand}"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.AutomationId="SettingsProfileBackedSecurityCreateButton"
                                                Content="Create security" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Quick Actions -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource IconPlay}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Quick Actions"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Common configuration tasks"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Margin="0,0,0,12" />

                        <WrapPanel>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding AddProviderCommand}"
                                    Margin="0,0,8,8"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconAdd}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Add Provider" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding ConfigureStorageCommand}"
                                    Margin="0,0,8,8"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconDatabase}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Configure Storage" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding ManageCredentialsCommand}"
                                    Margin="0,0,8,8"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconLock}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Credential Vault" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RunSetupWizardCommand}"
                                    Margin="0,0,8,8"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconChartLine}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Setup Wizard" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Credential Vault -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource IconLock}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Credential Vault"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Credential status for all data providers. Green = configured, yellow = partial, red = missing."
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <ListView x:Name="CredentialVaultList"
                                  ItemsSource="{Binding CredentialVaultItems}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="350">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="12" Height="12"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                           FontSize="12" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="Configure"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.ConfigureProviderCredentialCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    Tag="{Binding ProviderId}"
                                                    Visibility="{Binding ConfigureVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Storage Preview -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource IconFolder}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Storage Preview"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Naming Convention" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox x:Name="PreviewNamingCombo"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          SelectionChanged="PreviewSettings_Changed">
                                    <ComboBoxItem Content="By Symbol" Tag="BySymbol" IsSelected="True" />
                                    <ComboBoxItem Content="By Date" Tag="ByDate" />
                                    <ComboBoxItem Content="By Type" Tag="ByType" />
                                    <ComboBoxItem Content="Flat" Tag="Flat" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Compression" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox x:Name="PreviewCompressionCombo"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          SelectionChanged="PreviewSettings_Changed">
                                    <ComboBoxItem Content="Gzip" Tag="gzip" IsSelected="True" />
                                    <ComboBoxItem Content="None" Tag="none" />
                                    <ComboBoxItem Content="LZ4 (Fast)" Tag="lz4" />
                                    <ComboBoxItem Content="ZSTD (Best)" Tag="zstd" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="File structure preview:" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />

                        <Border Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                CornerRadius="12"
                                Padding="12">
                            <TextBlock x:Name="StoragePreviewText"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       Text="{Binding StoragePreviewText}"
                                       TextWrapping="NoWrap" />
                        </Border>

                        <TextBlock x:Name="StorageSizeEstimateText"
                                   Text="{Binding StorageSizeEstimateText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Configuration Profiles -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource IconSave}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Configuration Profiles"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Switch between pre-configured settings for different workflows."
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <ItemsControl x:Name="ProfilesList" ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8"
                                            Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Id}"
                                            Tag="{Binding Id}"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Padding" Value="12,10" />
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16" />

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="App Theme" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                            <ComboBox x:Name="ThemeCombo"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="Use system setting" Tag="Default" IsSelected="True" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Accent Color" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                            <ComboBox x:Name="AccentColorCombo"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      SelectedIndex="{Binding AccentColorIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="System default" Tag="System" IsSelected="True" />
                                <ComboBoxItem Content="Blue" Tag="Blue" />
                                <ComboBoxItem Content="Green" Tag="Green" />
                                <ComboBoxItem Content="Orange" Tag="Orange" />
                                <ComboBoxItem Content="Purple" Tag="Purple" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Shell Density" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                            <ComboBox x:Name="ShellDensityModeCombo"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding ShellDensityModes}"
                                      SelectedItem="{Binding SelectedShellDensityMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding ShellDensityDescriptionText}"
                                       Style="{StaticResource CardDescriptionStyle}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource IconBell}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Notifications"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="NotificationsEnabledToggle"
                                  Content="Enable Windows Notifications"
                                  IsChecked="{Binding IsNotificationsEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                  Margin="0,0,0,16" />

                        <StackPanel x:Name="NotificationSettingsPanel"
                                    Opacity="{Binding NotificationsPanelOpacity}">
                            <TextBlock Text="Notify me about:"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,0,8" />

                            <CheckBox x:Name="NotifyConnectionCheck" Content="Connection status changes" IsChecked="True"
                                      Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,0,0,4" />
                            <CheckBox x:Name="NotifyErrorCheck" Content="Errors and warnings" IsChecked="True"
                                      Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,0,0,4" />
                            <CheckBox x:Name="NotifyBackfillCheck" Content="Backfill completion" IsChecked="True"
                                      Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,0,0,4" />
                            <CheckBox x:Name="NotifyDataGapsCheck" Content="Data gaps detected" IsChecked="True"
                                      Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,0,0,4" />
                            <CheckBox x:Name="NotifyStorageCheck" Content="Storage warnings (low space)" IsChecked="True"
                                      Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,0,0,12" />

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Notification Sound" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox x:Name="NotificationSoundCombo" Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem Content="System default" Tag="Default" IsSelected="True" />
                                    <ComboBoxItem Content="Subtle" Tag="Subtle" />
                                    <ComboBoxItem Content="None" Tag="None" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="Send Test Notification"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SendTestNotificationCommand}" />
                    </StackPanel>
                </Border>

                <!-- API Connection -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="API Connection" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16" />

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Collector API Base URL" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                            <TextBox x:Name="ApiBaseUrlBox"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Status Refresh Interval (seconds)" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                            <TextBox x:Name="StatusRefreshIntervalBox"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding StatusRefreshInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100"
                                     HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestConnectionCommand}" />
                            <TextBlock x:Name="ConnectionTestResult"
                                       Text="{Binding ConnectionTestResult}"
                                       Foreground="{Binding ConnectionTestBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stored Credentials -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource IconKey}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Stored Credentials"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <!-- Info Banner -->
                        <Border Background="{StaticResource InfoColorBrush}"
                                Opacity="0.15"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Windows Credential Manager"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoColorBrush}" />
                                <TextBlock Text="All API keys and credentials are securely stored in Windows Credential Manager, not in config files."
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Stored credentials for this application:"
                                   Style="{StaticResource FormLabelStyle}"
                                   Margin="0,0,0,8" />

                        <ListView x:Name="StoredCredentialsList"
                                  ItemsSource="{Binding StoredCredentials}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="12" Height="12"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding TestStatusColor}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                           FontSize="12" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="Test"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.TestCredentialCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding Resource}"
                                                        Margin="0,0,8,0" />
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding Name}">
                                                    <TextBlock Text="{StaticResource IconDelete}"
                                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                               FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="NoCredentialsText"
                                   Text="No credentials stored."
                                   Visibility="{Binding NoCredentialsVisibility}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Test All Credentials"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestAllCredentialsCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Clear All Credentials"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding ClearAllCredentialsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Configuration File -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Configuration" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16" />

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Configuration File Path" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                            <TextBlock x:Name="ConfigPathText"
                                       Text="{Binding ConfigPath}"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ApplyConfigCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Save"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SaveConfigCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Open in Explorer"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenConfigFolderCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Reload Configuration"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ReloadConfigCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Reset to Defaults"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding ResetToDefaultsCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ConfigValidationErrors}"
                                   Foreground="{StaticResource DangerColorBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Performance -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Performance" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Max Concurrent Downloads" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                                <TextBox x:Name="MaxConcurrentDownloadsBox"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding MaxConcurrentDownloads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Write Buffer Size (KB)" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                                <TextBox x:Name="WriteBufferSizeBox"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding WriteBufferSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="EnableMetricsToggle"
                                  Content="Enable Performance Metrics"
                                  IsChecked="{Binding IsMetricsEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                  Margin="0,0,0,8" />

                        <CheckBox x:Name="EnableDebugLoggingToggle"
                                  Content="Enable Debug Logging (Verbose)"
                                  IsChecked="{Binding IsDebugLoggingEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,16" />

                        <TextBlock Text="Meridian"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                        <TextBlock Text="Version 1.6.1"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="A high-performance market data collection system for real-time and historical market data."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                   Margin="0,0,0,16" />

                        <StackPanel>
                            <Button Content="Documentation"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding OpenDocumentationCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,4" />
                            <Button Content="Report an Issue"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding OpenIssuesCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,4" />
                            <Button Content="Check for Updates"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel - Quick Reference -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12,24,24,24">
            <StackPanel>
                <!-- Help -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource IconHelp}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Quick Reference"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <Expander Header="Keyboard Shortcuts" IsExpanded="True">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+F"
                                           FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Search symbols"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="12,4,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+R"
                                           FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Run backfill"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="12,4,0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+S"
                                           FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Start collector"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="12,4,0,4" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="F5"
                                           FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,4" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Refresh status"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="12,4,0,4" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+,"
                                           FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,4" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Open settings"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="12,4,0,4" />
                            </Grid>
                        </Expander>

                        <Expander Header="Data Providers" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextSecondaryBrush}">
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource ConsoleTextPrimaryBrush}">Interactive Brokers:</Run>
                                    <LineBreak />
                                    <Run>Level 2 depth + tick data. Requires TWS/Gateway.</Run>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,8,0,0">
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource ConsoleTextPrimaryBrush}">Alpaca:</Run>
                                    <LineBreak />
                                    <Run>Real-time trades/quotes via WebSocket. Free tier available.</Run>
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- System Status -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="System Status"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Config Status"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="ConfigStatusDot" Width="8" Height="8"
                                         Fill="{Binding ConfigStatusDot}" Margin="0,0,4,0" />
                                <TextBlock x:Name="ConfigStatusText" Text="{Binding ConfigStatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Credentials"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="CredentialsStatusDot" Width="8" Height="8"
                                         Fill="{Binding CredentialsStatusDot}" Margin="0,0,4,0" />
                                <TextBlock x:Name="CredentialsStatusText" Text="{Binding CredentialsStatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Auth"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LastAuthStatusDot" Width="8" Height="8"
                                         Fill="{StaticResource SuccessColorBrush}" Margin="0,0,4,0" />
                                <TextBlock x:Name="LastAuthText" Text="{Binding LastAuthText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Collector"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="CollectorStatusDot" Width="8" Height="8"
                                         Fill="{Binding CollectorStatusDot}" Margin="0,0,4,0" />
                                <TextBlock x:Name="CollectorStatusText" Text="{Binding CollectorStatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Last Sync"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <TextBlock x:Name="LastSyncText" Grid.Row="4" Grid.Column="1" Text="{Binding LastSyncText}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent Activity -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent Activity"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <ListView x:Name="RecentActivityList"
                                  ItemsSource="{Binding RecentActivity}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   FontSize="14"
                                                   Foreground="{Binding IconColor}"
                                                   Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Time}"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Global Hotkeys -->
                <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="&#xE92E;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       Foreground="{StaticResource InfoColorBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Global Hotkeys"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="System-wide shortcuts that activate even when Meridian is not in focus."
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <CheckBox x:Name="GlobalHotkeysEnabledCheckBox"
                                      Content="Enable global hotkeys"
                                      IsChecked="True"
                                      Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      Click="GlobalHotkeysEnabled_Click" />
                        </StackPanel>

                        <ListView x:Name="GlobalHotkeysList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsHitTestVisible="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource ConsoleBackgroundDarkBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding KeyGesture}"
                                                           FontFamily="Consolas, Courier New, monospace"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource InfoColorBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Description}"
                                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
