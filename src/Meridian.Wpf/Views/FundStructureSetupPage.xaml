<Page x:Class="Meridian.Wpf.Views.FundStructureSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Entity Setup">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1120">
            <TextBlock Text="Entity setup" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Create the organization, business lane, client or fund, legal entity, vehicle, investment portfolio, ownership links, and account handoff through /api/fund-structure shared orchestration."
                       TextWrapping="Wrap" Margin="0,6,0,18" />

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Organization code" />
                    <TextBox Text="{Binding OrganizationCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Organization name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding OrganizationName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Business code" />
                    <TextBox Text="{Binding BusinessCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Business name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Base currency" />
                    <TextBox Text="{Binding BaseCurrency, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Requested by" Margin="0,8,0,0" />
                    <TextBox Text="{Binding RequestedBy, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <StackPanel Margin="0,0,12,12">
                    <CheckBox Content="Create client instead of fund" IsChecked="{Binding CreateClient}" Margin="0,0,0,8" />
                    <TextBlock Text="Client/fund code" />
                    <TextBox Text="{Binding ClientOrFundCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Client/fund name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding ClientOrFundName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Legal entity code" />
                    <TextBox Text="{Binding LegalEntityCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Legal entity name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding LegalEntityName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Jurisdiction" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Jurisdiction, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Vehicle code" />
                    <TextBox Text="{Binding VehicleCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Vehicle name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding VehicleName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,0,0,16">
                <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Portfolio code" />
                    <TextBox Text="{Binding PortfolioCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Portfolio name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding PortfolioName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Account handoff code" />
                    <TextBox Text="{Binding AccountCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Account display name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding AccountDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Institution" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Ledger reference" Margin="0,8,0,0" />
                    <TextBox Text="{Binding LedgerReference, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <WrapPanel Margin="0,0,0,16">
                <Button Content="Validate draft" Command="{Binding ValidateDraftCommand}" Margin="0,0,8,8" Padding="14,8" />
                <Button Content="Review and create" Command="{Binding CreateStructureCommand}" Margin="0,0,8,8" Padding="14,8" />
            </WrapPanel>

            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{Binding ResultSummary}" Margin="0,0,0,18" />

            <TextBlock Text="Validation summary" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,6,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Graph / ownership preview" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding PreviewNodes}" Margin="0,6,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Kind}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Code}" />
                            <Run Text=" / " />
                            <Run Text="{Binding Name}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Operator ownership review" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OwnershipSummaryText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <ListBox ItemsSource="{Binding OwnershipLinks}" SelectedItem="{Binding SelectedOwnershipLink, Mode=TwoWay}" MinHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NodeDisplayLabel}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding PercentLabel}" Margin="12,0,0,0" FontWeight="SemiBold" />
                                        <Border Grid.Column="2" BorderBrush="#64748b" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ValidationState}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Selected-link inspector" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedOwnershipInspectorText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBlock Text="Blocking messages" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding SelectedOwnershipLink.BlockingMessages}" Margin="0,4,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Suggested remediation" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding SelectedOwnershipLink.SuggestedRemediationActions}" Margin="0,4,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Content="Edit" Command="{Binding EditOwnershipLinkCommand}" Margin="0,0,8,8" Padding="12,6" />
                            <Button Content="Expire" Command="{Binding ExpireOwnershipLinkCommand}" Margin="0,0,8,8" Padding="12,6" />
                            <Button Content="Replace" Command="{Binding ReplaceOwnershipLinkCommand}" Margin="0,0,8,8" Padding="12,6" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
