<Page x:Class="Meridian.Wpf.Views.KeyboardShortcutsPage"
        FontFamily="{DynamicResource MeridianBodyFontFamily}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1200"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      AutomationProperties.Name="Keyboard Shortcuts">

    <Page.Resources>
        <Style x:Key="KeyboardShortcutStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PremiumPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleBorderHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="ShortcutKeyTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MeridianDataFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ShortcutDescriptionStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource ConsoleTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InfoColorBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ShortcutRowActionStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource ConsoleTextMutedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One editable shortcut row: chord badge or capture surface, description and inline
             rejection reason, then enable / rebind / reset actions. -->
        <DataTemplate x:Key="ShortcutBindingRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource KeyboardShortcutStyle}"
                        Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="{Binding FormattedShortcut}" Style="{StaticResource ShortcutKeyTextStyle}" />
                </Border>

                <!-- Focused while capturing; key presses are routed to the ViewModel. -->
                <Border x:Name="CaptureSurface"
                        Grid.Column="0"
                        Style="{StaticResource KeyboardShortcutStyle}"
                        BorderBrush="{StaticResource InfoColorBrush}"
                        BorderThickness="2"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}"
                        Tag="{Binding ElementName=RebindButton}"
                        Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="{Binding ActionId, StringFormat='KeyboardShortcutCapture_{0}'}"
                        AutomationProperties.Name="{Binding Description, StringFormat='Press the new key combination for {0}'}"
                        PreviewKeyDown="OnCaptureSurfacePreviewKeyDown"
                        LostKeyboardFocus="OnCaptureSurfaceLostKeyboardFocus"
                        IsVisibleChanged="OnCaptureSurfaceIsVisibleChanged">
                    <TextBlock Text="{Binding ChordDisplayText}"
                               Style="{StaticResource ShortcutKeyTextStyle}"
                               Foreground="{StaticResource InfoColorBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ShortcutDescriptionStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShortcutEnabled}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource ConsoleTextMutedBrush}" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ValidationMessage}"
                               Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{StaticResource ErrorColorBrush}"
                               FontSize="12"
                               Margin="12,2,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="{Binding ActionId, StringFormat='KeyboardShortcutValidation_{0}'}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="On"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsShortcutEnabled, Mode=TwoWay}"
                              ToolTip="Turn this shortcut on or off."
                              AutomationProperties.AutomationId="{Binding ActionId, StringFormat='KeyboardShortcutEnabled_{0}'}"
                              AutomationProperties.Name="{Binding Description, StringFormat='Enable {0} shortcut'}" />
                    <Button x:Name="RebindButton"
                            Content="Rebind"
                            Style="{StaticResource ShortcutRowActionStyle}"
                            Command="{Binding BeginCaptureCommand}"
                            Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                            ToolTip="Capture a new key combination for this shortcut."
                            AutomationProperties.AutomationId="{Binding ActionId, StringFormat='KeyboardShortcutRebind_{0}'}"
                            AutomationProperties.Name="{Binding Description, StringFormat='Rebind {0}'}" />
                    <Button Content="Cancel"
                            Style="{StaticResource ShortcutRowActionStyle}"
                            Command="{Binding CancelCaptureCommand}"
                            Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="{Binding ActionId, StringFormat='KeyboardShortcutCancelCapture_{0}'}"
                            AutomationProperties.Name="{Binding Description, StringFormat='Cancel rebinding {0}'}" />
                    <Button Content="Reset"
                            Style="{StaticResource ShortcutRowActionStyle}"
                            Command="{Binding ResetCommand}"
                            ToolTip="Restore this shortcut's default key combination and turn it back on."
                            AutomationProperties.AutomationId="{Binding ActionId, StringFormat='KeyboardShortcutReset_{0}'}"
                            AutomationProperties.Name="{Binding Description, StringFormat='Reset {0} to default'}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One shortcut category card. -->
        <DataTemplate x:Key="ShortcutCategoryCardTemplate">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="18"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}"
                                   Style="{StaticResource CardHeaderStyle}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  ItemTemplate="{StaticResource ShortcutBindingRowTemplate}"
                                  Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,32">
        <StackPanel MaxWidth="1200">
            <!-- Header -->
            <Border Style="{StaticResource EmbeddedShellHeroCardStyle}" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="24" Foreground="{StaticResource InfoColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Operator keymaps, dynamic command bindings, and quick-reference guidance for fast navigation."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Saved shortcut overrides: status and reset -->
            <DockPanel Margin="0,0,0,16" LastChildFill="True">
                <Button x:Name="ResetShortcutsButton"
                        DockPanel.Dock="Right"
                        Content="Reset to defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="KeyboardShortcutsResetButton"
                        AutomationProperties.Name="Reset keyboard shortcuts to defaults"
                        ToolTip="Restore every shortcut's default key binding and re-enable disabled shortcuts."
                        Command="{Binding ResetAllCommand}" />
                <TextBlock x:Name="ShortcutOverrideStatusText"
                           Text="{Binding OverrideStatusText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource CardDescriptionStyle}"
                           AutomationProperties.AutomationId="KeyboardShortcutsOverrideStatus" />
            </DockPanel>

            <TextBlock Style="{StaticResource CardDescriptionStyle}"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"
                       Text="Choose Rebind, then press the new key combination. Collector start/stop, Toggle Connection, and Delete Selected must keep Ctrl or Alt, and a combination another shortcut already uses is refused. Changes are saved for this machine." />

            <!-- Dynamically populated shortcuts panel -->
            <StackPanel x:Name="DynamicShortcutsPanel" />

            <!-- Tip footer -->
            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource IconInfo}"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="16"
                               Foreground="{StaticResource InfoColorBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Tip:" />
                        <Run Text=" Press" />
                        <Run FontFamily="{DynamicResource MeridianDataFontFamily}" FontWeight="SemiBold" Text=" Ctrl + ? " />
                        <Run Text="from any page to open this shortcut reference." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
