<UserControl x:Class="Meridian.Wpf.Views.SecurityPassportEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Security Passport Editor"
             AutomationProperties.AutomationId="SecurityPassportEditorView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,32" MaxWidth="900">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Symbol}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AssetClass}" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding RevisionState}" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding TrustPosture}" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
            <TextBlock Text="Governed passport edit — changes are staged as a draft and published through the approval gate."
                       Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" Opacity="0.7" />

            <!-- Recovery banner -->
            <Border Margin="0,8,0,0" Padding="10,8" BorderThickness="1"
                    BorderBrush="{StaticResource RecoveryBannerBorderBrush}"
                    Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibility}}"
                    AutomationProperties.Name="Passport edit banner">
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" />
            </Border>

            <!-- Field edit -->
            <TextBlock Text="Field edit" FontWeight="SemiBold" Margin="0,18,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                            Visibility="{Binding HasSchemaFields, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="Asset-class term" Opacity="0.8" />
                    <ComboBox ItemsSource="{Binding SchemaFields}"
                              SelectedItem="{Binding SelectedSchemaField}"
                              AutomationProperties.Name="Asset-class term">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Group, Mode=OneWay}" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                    <Run Text=" · " Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Field path" Opacity="0.8" />
                    <TextBox Text="{Binding FieldPath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="New value" Opacity="0.8" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding SchemaValueChoices}"
                              Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="New value choices"
                              Visibility="{Binding HasSchemaValueChoices, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="New value">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSchemaValueChoices}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="{Binding SchemaValueError}" Foreground="{StaticResource ErrorColorBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Effective from" Opacity="0.8" />
                    <DatePicker SelectedDate="{Binding EffectiveFrom}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Justification (required)" Opacity="0.8" />
                    <TextBox Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!-- Source conflict resolution -->
            <TextBlock Text="Source conflict" FontWeight="SemiBold" Margin="0,18,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Conflict id" Opacity="0.8" />
                    <TextBox Text="{Binding ConflictId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Chosen winner source" Opacity="0.8" />
                    <TextBox Text="{Binding ChosenWinnerSource, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Reason (required)" Opacity="0.8" />
                    <TextBox Text="{Binding ConflictReason, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                    <CheckBox Content="Acknowledge policy deviation"
                              IsChecked="{Binding AcknowledgePolicyDeviation}" Margin="0,0,0,2" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Resolve conflict" Command="{Binding ResolveConflictCommand}" Padding="12,6" />
            </StackPanel>

            <!-- Approval context -->
            <TextBlock Text="Approval context" FontWeight="SemiBold" Margin="0,18,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Approval workflow id" Opacity="0.8" />
                    <TextBox Text="{Binding WorkflowId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Expected workflow version" Opacity="0.8" />
                    <TextBox Text="{Binding ExpectedWorkflowVersion, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Independent reviewer" Opacity="0.8" />
                    <TextBox Text="{Binding Reviewer, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Report pack id" Opacity="0.8" />
                    <TextBox Text="{Binding ReportPackId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!-- Action bar -->
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Save draft" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Submit for approval" Command="{Binding SubmitCommand}" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Approve" Command="{Binding ApproveCommand}" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Publish" Command="{Binding PublishCommand}" Padding="12,6" />
            </StackPanel>


            <StackPanel Visibility="{Binding HasCashFlowScenarios, Converter={StaticResource BooleanToVisibility}}">
                <!-- Cash-flow scenarios (shared contractual cash-flow routes; hypothetical, never posts) -->
                <Expander Header="Cash-flow scenarios" Margin="0,16,0,0" DataContext="{Binding CashFlowScenarios}"
                          AutomationProperties.Name="Security cash-flow scenarios">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Hypothetical projections over current terms, calendars and pinned curves. Nothing here changes terms or posts; retained runs are complete replay packets under a client-generated identity."
                                   Opacity="0.7" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="150" Margin="0,0,8,8">
                                <TextBlock Text="Valuation date (UTC)" Opacity="0.8" />
                                <DatePicker SelectedDate="{Binding ValuationDate}" AutomationProperties.Name="Scenario valuation date" />
                            </StackPanel>
                            <StackPanel Width="230" Margin="0,0,8,8">
                                <TextBlock Text="Knowledge cutoff (ISO-8601 instant)" Opacity="0.8" />
                                <TextBox Text="{Binding KnowledgeCutoff, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scenario knowledge cutoff" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,8,8">
                                <TextBlock Text="Horizon (optional)" Opacity="0.8" />
                                <DatePicker SelectedDate="{Binding Horizon}" AutomationProperties.Name="Scenario horizon" />
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,8,8">
                                <TextBlock Text="Rate scenario" Opacity="0.8" />
                                <ComboBox ItemsSource="{Binding RateScenarios}" SelectedItem="{Binding RateScenario}" AutomationProperties.Name="Scenario rate shock" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Prepayment assumption" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <WrapPanel>
                            <CheckBox IsChecked="{Binding PrepaymentEnabled}" Content="Apply" VerticalAlignment="Center" Margin="0,0,8,8" AutomationProperties.Name="Apply a prepayment assumption" />
                            <TextBox Text="{Binding PrepaymentStreamId, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment stream id" />
                            <DatePicker SelectedDate="{Binding PrepaymentStart}" Width="140" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment start date" />
                            <DatePicker SelectedDate="{Binding PrepaymentEnd}" Width="140" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment end date" />
                            <ComboBox ItemsSource="{Binding PrepaymentMethods}" SelectedItem="{Binding PrepaymentMethod}" Width="90" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment method" />
                            <TextBox Text="{Binding PrepaymentValue, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment value" />
                            <ComboBox ItemsSource="{Binding PrepaymentPolicies}" SelectedItem="{Binding PrepaymentPolicy}" Width="150" Margin="0,0,0,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment recast policy" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Exercises}" AutomationProperties.Name="Exercise selections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,0,0,4">
                                        <CheckBox IsChecked="{Binding Include}" Content="{Binding Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding Dates}" SelectedItem="{Binding ExerciseDate}" IsEditable="True" Text="{Binding ExerciseDate, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0" IsEnabled="{Binding Include}" />
                                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0" IsEnabled="{Binding Include}" />
                                        <TextBox Text="{Binding NoticeDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,8,0" IsEnabled="{Binding Include}" AutomationProperties.Name="Notice date" ToolTip="Notice date (yyyy-MM-dd); blank notices on the exercise date" />
                                        <TextBox Text="{Binding NoticeEvidenceId, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,0" IsEnabled="{Binding Include}" AutomationProperties.Name="Notice evidence" ToolTip="Approved notice id (optional); when set the exercise is retained rather than hypothetical" />
                                        <TextBlock Text="{Binding CalendarText}" Opacity="0.7" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Preview scenario" Command="{Binding PreviewCommand}" Padding="12,6" Margin="0,0,8,0" />
                            <Button Content="Retain run" Command="{Binding RetainRunCommand}" Padding="12,6" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Blockers}" Visibility="{Binding IsBlocked, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0" AutomationProperties.Name="Calculation blockers" />
                        <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="320" Margin="0,8,0,0"
                                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="Projected cash flows">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
                                <DataGridTextColumn Header="Stream" Binding="{Binding StreamId}" />
                                <DataGridTextColumn Header="Opening balance" Binding="{Binding OpeningBalance}" />
                                <DataGridTextColumn Header="Cash interest" Binding="{Binding CashInterest}" />
                                <DataGridTextColumn Header="Scheduled principal" Binding="{Binding ScheduledPrincipal}" />
                                <DataGridTextColumn Header="Forecast prepayment" Binding="{Binding ForecastPrepayment}" />
                                <DataGridTextColumn Header="Redeemed principal" Binding="{Binding RedeemedPrincipal}" />
                                <DataGridTextColumn Header="Premium / penalty" Binding="{Binding PremiumAndPenalty}" />
                                <DataGridTextColumn Header="Closing balance" Binding="{Binding ClosingBalance}" />
                                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ItemsControl ItemsSource="{Binding ExerciseCalculations}" Margin="0,4,0,0" AutomationProperties.Name="Exercise calculations" />
                        <TextBlock Text="{Binding EvidenceText}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RunText}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel Width="320" Margin="0,0,8,0">
                                <TextBlock Text="Retained run identity" Opacity="0.8" />
                                <TextBox Text="{Binding RunIdText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retained run identity" />
                            </StackPanel>
                            <Button Content="Load retained run" Command="{Binding LoadRunCommand}" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Bottom" />
                            <Button Content="Verify replay" Command="{Binding VerifyReplayCommand}" Padding="12,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding LoadedRunText}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReplayStatusText}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.Name="Replay verification" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel Width="320" Margin="0,0,8,0">
                                <TextBlock Text="Compare with retained run" Opacity="0.8" />
                                <TextBox Text="{Binding CompareRunIdText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Comparison run identity" />
                            </StackPanel>
                            <Button Content="Compare runs" Command="{Binding CompareRunsCommand}" Padding="12,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding ComparisonText}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.Name="Retained run comparison" />
                        <ItemsControl ItemsSource="{Binding BlockerDeltas}" Margin="0,4,0,0" AutomationProperties.Name="Blocker differences" />
                        <DataGrid ItemsSource="{Binding CashDeltas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="240" Margin="0,4,0,0" AutomationProperties.Name="Net cash deltas by date">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" />
                                <DataGridTextColumn Header="Stream" Binding="{Binding StreamId}" />
                                <DataGridTextColumn Header="First run" Binding="{Binding LeftNetCash}" />
                                <DataGridTextColumn Header="Second run" Binding="{Binding RightNetCash}" />
                                <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            <!-- Bond analytics (Bond/CD passports only; shared contracts with the browser Evidence tab) -->
            <StackPanel Visibility="{Binding HasBondTools, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.Name="Bond analytics">
                <TextBlock Text="Bond analytics" FontWeight="SemiBold" Margin="0,24,0,2" />
                <TextBlock Text="Settlement-aware values calculated by the server from retained bond terms. Imported pricing fields remain separate; this analysis grants no posting or trading authority."
                           Opacity="0.7" TextWrapping="Wrap" />
                <Grid DataContext="{Binding BondAnalytics}" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                        <TextBlock Text="Calculation date (UTC)" Opacity="0.8" />
                        <DatePicker SelectedDate="{Binding AsOf}" AutomationProperties.Name="Calculation date" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,8">
                        <TextBlock Text="Settlement date" Opacity="0.8" />
                        <DatePicker SelectedDate="{Binding SettlementDate}" AutomationProperties.Name="Settlement date" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,8">
                        <TextBlock Text="Recorded cutoff (UTC ISO 8601, optional)" Opacity="0.8" />
                        <TextBox Text="{Binding KnownAt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recorded cutoff" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Bottom">
                        <CheckBox Content="Price from annual yield instead of clean price" IsChecked="{Binding UseYield}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,8">
                        <TextBlock Text="{Binding ValueLabel}" Opacity="0.8" />
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Price or yield" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,8">
                        <TextBlock Text="Yield convention" Opacity="0.8" />
                        <ComboBox ItemsSource="{Binding YieldConventions}" SelectedItem="{Binding Convention}" AutomationProperties.Name="Yield convention" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Button Content="Calculate bond analytics" Command="{Binding CalculateCommand}" Padding="12,6" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProvenanceText}" Opacity="0.7" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Blockers}" Visibility="{Binding IsBlocked, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="Calculation blockers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorColorBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Metrics}" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="Bond analytics metrics">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,18,4" MinWidth="160">
                                        <TextBlock Text="{Binding Label}" Opacity="0.7" FontSize="11" />
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="Projected contractual payments (per 100 face; not observed payments or posted journals)"
                                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}" Margin="0,6,0,0">
                            <DataGrid ItemsSource="{Binding CashFlows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260"
                                      AutomationProperties.Name="Projected bond payments">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Payment date" Binding="{Binding PaymentDate}" />
                                    <DataGridTextColumn Header="Accrual period" Binding="{Binding AccrualPeriod}" />
                                    <DataGridTextColumn Header="Interest / 100" Binding="{Binding Interest}" />
                                    <DataGridTextColumn Header="Principal / 100" Binding="{Binding Principal}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <ItemsControl ItemsSource="{Binding ExerciseScenarios}" Margin="0,6,0,0" AutomationProperties.Name="Contractual exercise scenarios">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0" AutomationProperties.Name="Calculation diagnostics">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Convention migration preview -->
                <Expander Header="Review bond convention migration" Margin="0,16,0,0" DataContext="{Binding BondMigration}"
                          AutomationProperties.Name="Bond convention migration">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Compare legacy and candidate payments before proposing a governed terms change. This preview does not change terms, posted journals, or published reports."
                                   Opacity="0.7" TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Preview date (UTC)" Opacity="0.8" />
                                <DatePicker SelectedDate="{Binding AsOf}" AutomationProperties.Name="Preview date" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,8">
                                <TextBlock Text="Settlement date (blank = preview date)" Opacity="0.8" />
                                <DatePicker SelectedDate="{Binding SettlementDate}" AutomationProperties.Name="Migration settlement date" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,8">
                                <TextBlock Text="Retained coupon unit" Opacity="0.8" />
                                <ComboBox ItemsSource="{Binding CouponRateUnits}" SelectedItem="{Binding CouponRateUnit}" AutomationProperties.Name="Retained coupon unit" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Coupon cash basis" Opacity="0.8" />
                                <ComboBox ItemsSource="{Binding CouponCashBases}" SelectedItem="{Binding CouponCashBasis}" AutomationProperties.Name="Coupon cash basis" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,8">
                                <TextBlock Text="Business-day adjustment" Opacity="0.8" />
                                <ComboBox ItemsSource="{Binding BusinessDayConventions}" SelectedItem="{Binding BusinessDayConvention}" AutomationProperties.Name="Business-day adjustment" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,8">
                                <TextBlock Text="Retained payment calendar IDs (comma-separated)" Opacity="0.8" />
                                <TextBox Text="{Binding PaymentCalendars, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payment calendars" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                <CheckBox Content="Adjust accrual dates" IsChecked="{Binding AccrualAdjusted}" Margin="0,0,16,0" />
                                <CheckBox Content="Keep end-of-month anchor" IsChecked="{Binding EndOfMonthRule}" Margin="0,0,16,0" />
                                <Button Content="Preview convention migration" Command="{Binding PreviewCommand}" Padding="12,6" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Gaps}" AutomationProperties.Name="Migration gaps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorColorBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DataGrid ItemsSource="{Binding Differences}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260" Margin="0,6,0,0"
                                  Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibility}}"
                                  AutomationProperties.Name="Bond migration payment comparison">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Payment date" Binding="{Binding PaymentDate}" />
                                <DataGridTextColumn Header="Prior principal" Binding="{Binding PreviousPrincipal}" />
                                <DataGridTextColumn Header="Candidate principal" Binding="{Binding CandidatePrincipal}" />
                                <DataGridTextColumn Header="Prior interest" Binding="{Binding PreviousInterest}" />
                                <DataGridTextColumn Header="Candidate interest" Binding="{Binding CandidateInterest}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding FingerprintText}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0">
                            <TextBlock Text="Review justification (required; creates a draft only)" Opacity="0.8" />
                            <TextBox Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AutomationProperties.Name="Review justification" />
                            <Button Content="Stage governed draft" Command="{Binding StageCommand}" Padding="12,6" Margin="0,6,0,0" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding StagedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
