<Page x:Class="Meridian.Wpf.Views.LifecycleControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Lifecycle control"
      AutomationProperties.AutomationId="LifecycleControlPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource WorkspaceContextStripStyle}" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Lifecycle control plane" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Inspect host readiness and request supervisor-owned restart or shutdown."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RefreshButton"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="LifecycleRefreshButton" />
                        <Button x:Name="RestartButton"
                                Content="Restart Meridian"
                                Command="{Binding BeginRestartCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="LifecycleRestartButton" />
                        <Button x:Name="ShutdownButton"
                                Content="Shut down Meridian"
                                Command="{Binding BeginShutdownCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                AutomationProperties.AutomationId="LifecycleShutdownButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                    <StackPanel><TextBlock Text="Readiness" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding ReadinessText}" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                    <StackPanel><TextBlock Text="State" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding StateText}" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}">
                    <StackPanel><TextBlock Text="Uptime" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding UptimeText}" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource SectionCardStyle}">
                    <StackPanel><TextBlock Text="Session" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding SessionText}" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13" /></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource WorkspaceWorkbenchCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Readiness checks" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="{Binding PhaseText}" Margin="0,6,0,0" Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Checks}" Margin="0,12,0,0" AutomationProperties.AutomationId="LifecycleReadinessChecks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Message}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource ConsoleTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Requirement}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource ConsoleTextMutedBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WorkspaceWorkbenchCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Runtime evidence" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="{Binding AcceptingWorkText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Last shutdown receipt" Margin="0,18,0,0" Style="{StaticResource FormLabelStyle}" />
                        <TextBlock Text="{Binding LatestReceiptText}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        <Border Margin="0,18,0,0" Padding="12" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding StatusVisibility}">
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ConfirmationPanel"
                    Grid.Row="3"
                    Margin="0,14,0,0"
                    Padding="16"
                    Style="{StaticResource SectionCardStyle}"
                    Visibility="{Binding ConfirmationVisibility}"
                    AutomationProperties.AutomationId="LifecycleConfirmationPanel">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmationTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConfirmationDetail}" Margin="0,6,20,0" TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Cancel" Command="{Binding CancelActionCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="{Binding ConfirmActionLabel}" Command="{Binding ConfirmActionCommand}" Style="{StaticResource DangerButtonStyle}" AutomationProperties.AutomationId="LifecycleConfirmActionButton" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
