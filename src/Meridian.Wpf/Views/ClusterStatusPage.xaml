<UserControl x:Class="Meridian.Wpf.Views.ClusterStatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
             Background="{DynamicResource ShellWindowBackgroundBrush}"
             AutomationProperties.Name="Cluster Status">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="ClusterStatusActionStrip"
                    AutomationProperties.Name="Cluster Status Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE968;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cluster Status"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding LocalNodeId, StringFormat=Local: {0}}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="ClusterStatusSummaryText" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                MaxWidth="440"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ClusterStatusActionStatePanel"
                                AutomationProperties.Name="{Binding ClusterActionStateTitle}">
                        <Button Command="{Binding RefreshCommand}"
                                ToolTip="{Binding RefreshTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,6"
                                AutomationProperties.AutomationId="ClusterStatusRefreshButton"
                                AutomationProperties.Name="Refresh Cluster Status">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconRefresh}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="13"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ClusterActionStateTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ClusterStatusActionStateTitle" />
                        <TextBlock Text="{Binding ClusterActionStateDetail}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="ClusterStatusActionStateDetail" />
                    </StackPanel>
                </Grid>
            </Border>

            <workstation:WorkstationStatePanelControl Grid.Row="1"
                                                       State="{Binding ClusterPostureState}"
                                                       Margin="0,0,0,14"
                                                       AutomationProperties.AutomationId="ClusterStatusPostureCard"
                                                       TitleAutomationId="ClusterStatusPostureTitle"
                                                       DetailAutomationId="ClusterStatusPostureDetail"
                                                       EvidenceAutomationId="ClusterStatusPostureEvidence" />

            <workstation:WorkstationTableInspectorControl Grid.Row="2"
                                                          Table="{Binding NodesTable}"
                                                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                                          Inspector="{Binding SelectedNodeInspector}"
                                                          HeaderText="Ownership Nodes"
                                                          DetailText="Select a collector node to inspect lease freshness and symbol ownership."
                                                          GridAutomationId="ClusterStatusNodesGrid"
                                                          EmptyAutomationId="ClusterStatusNodesEmptyState"
                                                          InspectorAutomationId="ClusterStatusSelectionInspector"
                                                          ControlAutomationId="ClusterStatusWorkbench">
                <workstation:WorkstationTableInspectorControl.InspectorHeaderContent>
                    <workstation:InspectorPanelControl Panel="{Binding ClusterSummaryInspector}"
                                                       AutomationProperties.AutomationId="ClusterStatusSummaryInspector" />
                </workstation:WorkstationTableInspectorControl.InspectorHeaderContent>

                <workstation:WorkstationTableInspectorControl.InspectorContent>
                    <workstation:InspectorPanelControl Panel="{Binding ClusterActionInspector}"
                                                       AutomationProperties.AutomationId="ClusterStatusActionInspector" />
                </workstation:WorkstationTableInspectorControl.InspectorContent>
            </workstation:WorkstationTableInspectorControl>
        </Grid>
    </ScrollViewer>
</UserControl>
