<Page x:Class="Meridian.Wpf.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="clr-namespace:Meridian.Wpf.Views"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1400"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Main"
      AutomationProperties.AutomationId="MainPage">

    <Page.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding ShowCommandPaletteCommand}" />
    </Page.InputBindings>

    <views:InstitutionalShellFrameControl Background="{DynamicResource ShellWindowBackgroundBrush}"
                                          ShellPosture="{Binding CurrentShellPosture}">
        <Grid Background="{DynamicResource ShellWindowBackgroundBrush}">
            <TextBlock x:Name="ShellAutomationStateText"
                       Text="{Binding CurrentPageTag}"
                       Width="1"
                       Height="1"
                       Opacity="0"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       AutomationProperties.AutomationId="ShellAutomationState"
                       AutomationProperties.Name="{Binding CurrentPageTag}" />

            <views:InstitutionalCommandPaletteControl x:Name="CommandPaletteControl"
                                                      Panel.ZIndex="100" />

            <DockPanel LastChildFill="True">
                <views:ShellMastheadControl DockPanel.Dock="Top" />
                <views:ShellRailControl DockPanel.Dock="Left" />

                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <views:WorkspaceCommandSurfaceControl Grid.Row="0" />
                    <views:WorkspaceEvidenceStripControl Grid.Row="1" />

                    <views:WorkspaceShellContextStripControl x:Name="WorkspaceShellContextStrip"
                                                            Grid.Row="2"
                                                            Margin="24,0,24,16"
                                                            Visibility="{Binding ShellContextVisibility}"
                                                            ShellContext="{Binding ShellContext}"
                                                            AutomationProperties.AutomationId="WorkspaceShellContextStrip"
                                                            AutomationProperties.Name="Workspace Shell Context Strip" />

                    <DockPanel Grid.Row="3">
                        <Border x:Name="SplitPaneLayoutChrome"
                                DockPanel.Dock="Top"
                                Height="32"
                                Background="{StaticResource CommandBarBackground}"
                                BorderBrush="{StaticResource CommandBarBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Visibility="{Binding DataWorkspaceHomeChromeVisibility}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="Layout:"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Margin="0,0,8,0"
                                           Opacity="0.7" />
                                <ItemsControl ItemsSource="{Binding SplitPane.Layouts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SplitPane.SelectLayoutCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Label}"
                                                    Padding="6,2"
                                                    Margin="0,0,2,0"
                                                    FontSize="13"
                                                    Content="{Binding Icon}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Frame x:Name="ContentFrame"
                               Visibility="Collapsed"
                               NavigationUIVisibility="Hidden"
                               Background="Transparent"
                               AutomationProperties.AutomationId="ContentFrame"
                               AutomationProperties.Name="Main Content Frame"
                               Navigated="OnContentFrameNavigated" />

                        <Grid>
                            <views:SplitPaneHostControl x:Name="SplitPaneHost"
                                                       Layout="{Binding SplitPane.SelectedLayout}"
                                                       Loaded="OnSplitPaneHostLoaded" />
                            <views:WorkspaceInspectorHostControl x:Name="WorkspaceInspectorHost"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Stretch"
                                                                 Margin="0,8,8,8"
                                                                 Width="300"
                                                                 Visibility="Collapsed"
                                                                 InspectorState="Empty" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </views:InstitutionalShellFrameControl>
</Page>

