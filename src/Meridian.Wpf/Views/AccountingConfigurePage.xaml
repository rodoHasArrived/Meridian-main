                                        <TextBlock Text="Meridian dimensions" Style="{StaticResource CardDescriptionStyle}" />
                                        <TextBox Text="{Binding ExternalGlMappingMeridianDimensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="96"
                                                 AcceptsReturn="True"
                                                 AutomationProperties.Name="External GL Meridian dimensions"
                                                 AutomationProperties.AutomationId="ExternalGlMappingMeridianDimensionsTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="External dimensions" Style="{StaticResource CardDescriptionStyle}" />
                                        <TextBox Text="{Binding ExternalGlMappingExternalDimensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="96"
                                                 AcceptsReturn="True"
                                                 AutomationProperties.Name="External GL provider dimensions"
                                                 AutomationProperties.AutomationId="ExternalGlMappingExternalDimensionsTextBox" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Certify mapping profile for guarded export readiness"
                                          IsChecked="{Binding ExternalGlMappingProfileCertified, Mode=TwoWay}"
                                          Margin="0,8,0,0"
                                          AutomationProperties.AutomationId="ExternalGlMappingCertifiedCheckBox" />
                                <Button Content="Save Provider Mapping"
                                        Command="{Binding SaveExternalGlMappingProfileCommand}"
                                        IsEnabled="{Binding CanSaveExternalGlMappingProfile}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        ToolTip="{Binding ExternalGlMappingProfileStatusText}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ExternalGlMappingProfileStatusText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <DataGrid ItemsSource="{Binding ExternalGlMappingProfileRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,0" AutomationProperties.AutomationId="ExternalGlMappingProfileGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="220" />
                                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="120" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="220" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid ItemsSource="{Binding ProviderRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,0" AutomationProperties.AutomationId="AccountingSystemProviderGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Name}" Width="170" />
                                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="100" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="External GL Evidence Packages" Style="{StaticResource CardHeaderStyle}" />
                                <DataGrid ItemsSource="{Binding ExternalGlEvidencePackageRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,0" AutomationProperties.AutomationId="ExternalGlEvidencePackageGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="190" />
                                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="105" />
                                        <DataGridTextColumn Header="Required Action" Binding="{Binding Detail}" Width="*" />
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="External GL Reconciliation" Style="{StaticResource CardHeaderStyle}" />
                                <DataGrid ItemsSource="{Binding ExternalGlRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,0" AutomationProperties.AutomationId="ExternalGlEvidenceGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountCode}" Width="130" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding AccountName}" Width="180" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                        <DataGridTextColumn Header="External Dr" Binding="{Binding ExternalDebit}" Width="100" />
                                        <DataGridTextColumn Header="External Cr" Binding="{Binding ExternalCredit}" Width="100" />
                                        <DataGridTextColumn Header="Meridian Dr" Binding="{Binding MeridianDebit}" Width="105" />
                                        <DataGridTextColumn Header="Meridian Cr" Binding="{Binding MeridianCredit}" Width="105" />
                                        <DataGridTextColumn Header="Variance" Binding="{Binding Variance}" Width="95" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Close, Evidence, Reconciliation">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Accounting Record Evidence" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding EvidencePostureText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding EvidenceRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,0" AutomationProperties.AutomationId="AccountingRecordEvidenceGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="100" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Route" Binding="{Binding Evidence}" Width="190" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Reconciliation Triage" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding ReconciliationPostureText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                        <TextBlock Text="View" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Width="190" ItemsSource="{Binding ReconciliationViewOptions}" SelectedItem="{Binding SelectedReconciliationView, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BatchReconciliationActionText}" Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding ReconciliationRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,0" AutomationProperties.AutomationId="AccountingReconciliationTriageGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Break" Binding="{Binding Name}" Width="150" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                                            <DataGridTextColumn Header="Owner" Binding="{Binding Detail}" Width="120" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Policies">
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Fund and Book Accounting Policies" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="{Binding PolicyPostureText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                                <ComboBox Width="180" ItemsSource="{Binding AccountingBasisOptions}" SelectedItem="{Binding SelectedAccountingBasis, Mode=TwoWay}" Margin="0,0,8,0" />
                                <Button Content="Create Fund Policy" Command="{Binding CreateFundScopedPolicyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding PolicyRows}" Style="{StaticResource ConfigureGridStyle}" AutomationProperties.AutomationId="AccountingPolicyGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Policy" Binding="{Binding Name}" Width="260" />
                                    <DataGridTextColumn Header="Basis" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="Default" Binding="{Binding Detail}" Width="110" />
                                    <DataGridTextColumn Header="Scope" Binding="{Binding Evidence}" Width="160" />
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
