<Page x:Class="Meridian.Wpf.Views.AccountingConfigurePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Accounting Configure"
      AutomationProperties.AutomationId="AccountingConfigurePage">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ConfigureMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="MetricValueMonoStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MeridianDataFontFamily}" />
        </Style>
        <Style x:Key="ConfigureGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="MinHeight" Value="160" />
            <Setter Property="Background" Value="{StaticResource ConsoleBackgroundLightBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ConsoleBackgroundMediumBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,32" MaxWidth="1320">
            <Border Background="{StaticResource PremiumPanelBrush}"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,14"
                    Padding="14,10"
                    AutomationProperties.AutomationId="AccountingConfigureActionStrip"
                    AutomationProperties.Name="Accounting Configure Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{StaticResource IconAccounting}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Accounting Configure"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding ActiveFundText}"
                                       FontSize="12"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="AccountingConfigureStatusText" />
                        <TextBlock Text="{Binding StoragePostureText}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="AccountingConfigureStoragePostureText" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2" MaxWidth="520" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button AutomationProperties.AutomationId="AccountingConfigureRefreshButton"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="{Binding StatusText}"
                                ToolTipService.ShowOnDisabled="True"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconRefresh}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="AccountingConfigureSeedBaselineButton"
                                Command="{Binding SeedBaselineConfigurationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="{Binding ConfigurationDetailText}"
                                ToolTipService.ShowOnDisabled="True"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconSave}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Seed" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="AccountingConfigureActivateButton"
                                Command="{Binding ActivateConfigurationCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="{Binding CloseDetailText}"
                                ToolTipService.ShowOnDisabled="True"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconCheckmark}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Activate" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.AutomationId="AccountingPostingCandidateButton"
                                Command="{Binding BuildPostingCandidateCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="{Binding PostingCandidateDetailText}"
                                ToolTipService.ShowOnDisabled="True"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconCheckmark}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Candidate" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource ConfigureMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Configuration" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding ConfigurationStatusText}" Style="{StaticResource CardHeaderStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ConfigurationDetailText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ConfigureMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Manual Journals" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding ManualJournalStatusText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ConfigureMetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="External GL" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding ExternalGlStatusText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ConfigureMetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Close" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding CloseReadinessText}" Style="{StaticResource CardHeaderStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CloseDetailText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TabControl AutomationProperties.AutomationId="AccountingConfigureTabs">
                <TabItem Header="Configuration">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Production Readiness" Style="{StaticResource CardHeaderStyle}" />
                                    <UniformGrid Columns="2" Margin="0,12,0,12">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Status" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding ProductionReadinessStatusText}" Style="{StaticResource CardHeaderStyle}" Margin="0,6,0,0" AutomationProperties.AutomationId="AccountingProductionReadinessStatusText" />
                                            <TextBlock Text="{Binding ProductionReadinessDetailText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Rollout" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding ProductionReadinessLedgerBookText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ProductionReadinessExternalGlText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ProductionReadinessDimensionalReportingText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="AccountingProductionReadinessDimensionalReportingText" />
                                            <TextBlock Text="{Binding ProductionReadinessTenantAdminText}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="AccountingProductionReadinessTenantAdminText" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <DataGrid ItemsSource="{Binding ProductionReadinessComponentRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,0,0,12" AutomationProperties.AutomationId="AccountingProductionReadinessComponentGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Area" Binding="{Binding Name}" Width="160" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
                                            <DataGridTextColumn Header="Summary" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="220" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid ItemsSource="{Binding ProductionReadinessIssueRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,0,0,18" AutomationProperties.AutomationId="AccountingProductionReadinessIssueGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Issue" Binding="{Binding Name}" Width="210" />
                                            <DataGridTextColumn Header="Severity" Binding="{Binding Status}" Width="100" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Action" Binding="{Binding Evidence}" Width="220" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Production Gap Checklist" Style="{StaticResource CardHeaderStyle}" />
                                    <DataGrid ItemsSource="{Binding ProductionReadinessGapRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,18" AutomationProperties.AutomationId="AccountingProductionReadinessGapGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Gap" Binding="{Binding Name}" Width="220" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                                            <DataGridTextColumn Header="Summary / Areas" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Required Action" Binding="{Binding Evidence}" Width="300" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Ledger-Book Workflow Controls" Style="{StaticResource CardHeaderStyle}" />
                                    <DataGrid ItemsSource="{Binding ProductionReadinessWorkflowRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,18" AutomationProperties.AutomationId="AccountingProductionReadinessWorkflowGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Workflow" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                            <DataGridTextColumn Header="Control Evidence" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Retained Evidence" Binding="{Binding Evidence}" Width="300" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Dimensional Reporting Controls" Style="{StaticResource CardHeaderStyle}" />
                                    <DataGrid ItemsSource="{Binding ProductionReadinessDimensionalControlRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,18" AutomationProperties.AutomationId="AccountingProductionReadinessDimensionalControlGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Dimension Lane" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                            <DataGridTextColumn Header="Control Evidence" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Retained Evidence" Binding="{Binding Evidence}" Width="300" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Migration Rollout Plan" Style="{StaticResource CardHeaderStyle}" />
                                    <DataGrid ItemsSource="{Binding ProductionReadinessMigrationPlanRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,18" AutomationProperties.AutomationId="AccountingProductionReadinessMigrationPlanGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Lane" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                                            <DataGridTextColumn Header="Scope / Run" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Required Action" Binding="{Binding Evidence}" Width="300" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Migration Run Evidence" Style="{StaticResource CardHeaderStyle}" />
                                    <DataGrid ItemsSource="{Binding ProductionReadinessMigrationArtifactRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,18" AutomationProperties.AutomationId="AccountingProductionReadinessMigrationArtifactGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Run" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                            <DataGridTextColumn Header="Scope / Dimensions" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Migration Worker Plans" Style="{StaticResource CardHeaderStyle}" />
                                    <DataGrid ItemsSource="{Binding ProductionReadinessMigrationWorkerPlanRows}" Style="{StaticResource ConfigureGridStyle}" Margin="0,12,0,18" AutomationProperties.AutomationId="AccountingProductionReadinessMigrationWorkerPlanGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Plan" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                            <DataGridTextColumn Header="Scope / Counts" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Production Certification Profile" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding ProductionCertificationProfileScopeText}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="AccountingProductionCertificationProfileScopeText" />
                                    <TextBlock Text="{Binding ProductionCertificationProfileUpdatedText}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               Margin="0,4,0,10"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="AccountingProductionCertificationProfileUpdatedText" />
                                    <UniformGrid Columns="4"
                                                 Margin="0,0,0,12"
                                                 IsEnabled="False"
                                                 AutomationProperties.AutomationId="AccountingProductionCertificationProfileControlPanel">
                                        <CheckBox Content="Rules by book"
                                                  IsChecked="{Binding PostingRulesLedgerBookNativeCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationRulesBookCheckBox" />
                                        <CheckBox Content="JE by book"
                                                  IsChecked="{Binding JournalLifecycleLedgerBookNativeCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationJournalBookCheckBox" />
                                        <CheckBox Content="Close by book"
                                                  IsChecked="{Binding CloseReportingLedgerBookNativeCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationCloseBookCheckBox" />
                                        <CheckBox Content="External GL by book"
                                                  IsChecked="{Binding ExternalGlLedgerBookNativeCertified, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationExternalGlBookCheckBox" />
                                        <CheckBox Content="Reconciliation by book"
                                                  IsChecked="{Binding ReconciliationLedgerBookNativeCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationReconciliationBookCheckBox" />
                                        <CheckBox Content="Direct lending by book"
                                                  IsChecked="{Binding DirectLendingLedgerBookNativeCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationDirectLendingBookCheckBox" />
                                        <CheckBox Content="Strategy reads by book"
                                                  IsChecked="{Binding StrategyLedgerReadLedgerBookNativeCertified, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationStrategyLedgerReadsBookCheckBox" />
                                        <CheckBox Content="Period dimensions"
                                                  IsChecked="{Binding PeriodReportDimensionQueriesCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationPeriodDimensionsCheckBox" />
                                        <CheckBox Content="Cross-period dimensions"
                                                  IsChecked="{Binding CrossPeriodReportDimensionQueriesCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationCrossPeriodDimensionsCheckBox" />
                                        <CheckBox Content="JE dimensions"
                                                  IsChecked="{Binding JournalQueryDimensionFiltersCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationJournalDimensionsCheckBox" />
                                        <CheckBox Content="Export dimensions"
                                                  IsChecked="{Binding ExternalExportDimensionMappingCertified, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationExportDimensionsCheckBox" />
                                        <CheckBox Content="Line dimensions"
                                                  IsChecked="{Binding LedgerLineDimensionsPersistedCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationLedgerLineDimensionsCheckBox" />
                                        <CheckBox Content="Trial balance filters"
                                                  IsChecked="{Binding TrialBalanceDimensionFiltersCertified, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationTrialBalanceDimensionsCheckBox" />
                                        <CheckBox Content="Package provenance"
                                                  IsChecked="{Binding ReportPackageDimensionProvenanceCertified, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="AccountingProductionCertificationReportPackageDimensionsCheckBox" />
                                    </UniformGrid>
                                    <TextBlock Text="Diagnostic evidence references"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,4" />
                                    <TextBlock Text="This editor cannot create, change, or revoke production certification. URI and reference text helps operators locate retained support but is not certification authority; an authorized server-side operation with complete typed retained evidence is required."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"
                                               AutomationProperties.AutomationId="AccountingProductionCertificationEvidenceGuidanceText" />
                                    <TextBox Text="{Binding ProductionCertificationEvidenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Margin="0,0,0,6"
                                             IsReadOnly="True"
                                             AutomationProperties.Name="Diagnostic production certification evidence references; not certification authority"
                                             AutomationProperties.AutomationId="AccountingProductionCertificationEvidenceTextBox" />
                                    <TextBlock Text="{Binding ProductionCertificationSaveGuidanceText}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               AutomationProperties.AutomationId="AccountingProductionCertificationSaveGuidanceText" />
                                    <Button AutomationProperties.AutomationId="AccountingProductionCertificationSaveButton"
                                            Content="Save Certification"
                                            Command="{Binding SaveProductionCertificationProfileCommand}"
                                            IsEnabled="{Binding CanSaveProductionCertificationProfile}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            ToolTip="{Binding ProductionCertificationSaveGuidanceText}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProductionCertificationProfileStatusText}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               Margin="0,0,0,18"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="AccountingProductionCertificationProfileStatusText" />
                                    <TextBlock Text="Tenant Administration Setup" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding TenantAdministrationProfileScopeText}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="AccountingTenantAdministrationProfileScopeText" />
                                    <TextBlock Text="{Binding TenantAdministrationProfileUpdatedText}"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               Margin="0,4,0,10"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="AccountingTenantAdministrationProfileUpdatedText" />
                                    <UniformGrid Columns="5" Margin="0,0,0,12" AutomationProperties.AutomationId="AccountingTenantAdministrationProfileControlPanel">
                                        <CheckBox Content="Tenant config"
                                                  IsChecked="{Binding TenantScopeConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminTenantScopeCheckBox" />
                                        <CheckBox Content="Admin roles"
                                                  IsChecked="{Binding AdminRoleProfileConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminRoleProfileCheckBox" />
                                        <CheckBox Content="Scoped access"
                                                  IsChecked="{Binding ScopedAccessPoliciesConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminScopedAccessCheckBox" />
                                        <CheckBox Content="Reporting groups"
                                                  IsChecked="{Binding ReportingGroupsConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminReportingGroupsCheckBox" />
                                        <CheckBox Content="Operator surface"
                                                  IsChecked="{Binding AccountingAdminSurfaceConfigured, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminSurfaceCheckBox" />
                                        <CheckBox Content="WPF admin"
                                                  IsChecked="{Binding WpfAccountingAdminSurfaceConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminWpfAdminStudioCheckBox" />
                                        <CheckBox Content="Chart admin"
                                                  IsChecked="{Binding ChartAdministrationStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminChartAdministrationCheckBox" />
                                        <CheckBox Content="Rule tests"
                                                  IsChecked="{Binding RuleTestPromotionStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminRuleTestPromotionCheckBox" />
                                        <CheckBox Content="Close setup"
                                                  IsChecked="{Binding CloseSetupStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminCloseSetupCheckBox" />
                                        <CheckBox Content="Provider maps"
                                                  IsChecked="{Binding ProviderMappingStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminProviderMappingCheckBox" />
                                        <CheckBox Content="Tenant/report setup"
                                                  IsChecked="{Binding TenantCompanyReportGroupSetupStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminReportGroupSetupCheckBox" />
                                        <CheckBox Content="Audit review"
                                                  IsChecked="{Binding AuditReviewToolingConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminAuditReviewCheckBox" />
                                        <CheckBox Content="Bulk safeguards"
                                                  IsChecked="{Binding BulkImportExportSafeguardsConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminBulkSafeguardsCheckBox" />
                                        <CheckBox Content="Performance proof"
                                                  IsChecked="{Binding PerformanceValidationConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminPerformanceValidationCheckBox" />
                                        <CheckBox Content="Recovery runbook"
                                                  IsChecked="{Binding DisasterRecoveryRunbookConfigured, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminRecoveryRunbookCheckBox" />
                                        <CheckBox Content="Book admin"
                                                  IsChecked="{Binding LedgerBookAdministrationStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminLedgerBookAdministrationCheckBox" />
                                        <CheckBox Content="Rule authoring"
                                                  IsChecked="{Binding PostingRuleAuthoringStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminPostingRuleAuthoringCheckBox" />
                                        <CheckBox Content="Approvals"
                                                  IsChecked="{Binding ApprovalQueueStudioConfigured, Mode=TwoWay}"
                                                  Margin="0,0,10,6"
                                                  AutomationProperties.AutomationId="AccountingTenantAdminApprovalQueueCheckBox" />
                                        <CheckBox Content="Dimension maps"
                                                  IsChecked="{Binding DimensionMappingStudioConfigured, Mode=TwoWay}"
