<Page x:Class="Meridian.Wpf.Views.AddProviderWizardPage"
        FontFamily="{DynamicResource MeridianBodyFontFamily}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Add Provider Wizard">

    <Grid Background="{DynamicResource ShellWindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="28,20,12,32">
            <StackPanel MaxWidth="800">
                <!-- Header -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Click="BackButton_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            ToolTip="Back to Settings">
                        <TextBlock Text="{StaticResource IconBack}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16" />
                    </Button>
                    <Border Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}" BorderThickness="1">
                        <TextBlock Text="{StaticResource IconPlugin}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="24"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Add Provider"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Start from a connection template or manage credentials for an existing connection."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Connection templates" Style="{StaticResource CardHeaderStyle}" />
                        <StackPanel x:Name="TemplatePickerPanel" Margin="0,8,0,0">
                            <ComboBox x:Name="TemplatePicker" DisplayMemberPath="Template.Name"
                                      SelectionChanged="TemplateSelectionChanged" AutomationProperties.Name="Connection template" />
                            <WrapPanel Margin="0,8,0,8">
                                <Button x:Name="UseTemplateButton" Content="Use template" IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="UseTemplate_Click" Margin="0,0,8,0" />
                                <Button Content="Reload templates" Style="{StaticResource SecondaryButtonStyle}" Click="ReloadTemplates_Click" />
                            </WrapPanel>
                            <Expander Header="Manage connection templates">
                                <StackPanel Margin="0,8,0,0">
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button x:Name="ExportTemplateButton" Content="Export selected template" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" Click="ExportTemplate_Click" Margin="0,0,8,0" />
                                        <Button x:Name="ImportTemplatesButton" Content="Import template JSON" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" Click="ImportTemplates_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="Source connection" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox x:Name="SourceTemplateConnection" AutomationProperties.Name="Source connection" SelectionChanged="TemplateSelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock><Run Text="{Binding DisplayName}" /><Run Text=" · " /><Run Text="{Binding ConnectionId}" /></TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="New template name" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,4" />
                                    <TextBox x:Name="TemplateNameInput" MaxLength="64" Style="{StaticResource FormTextBoxStyle}"
                                             AutomationProperties.Name="New template name" TextChanged="TemplateIdentityChanged" />
                                    <Button x:Name="SaveSourceTemplateButton" Content="Save connection as template" IsEnabled="False"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="SaveSourceTemplate_Click" Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="TemplateReviewPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock x:Name="TemplateReviewTitle" Style="{StaticResource CardHeaderStyle}" Focusable="True" />
                            <TextBlock Text="Values to create" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,4" />
                            <ItemsControl x:Name="TemplateReviewRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Field}" FontWeight="SemiBold" Margin="0,0,10,0" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"><Run Text="+ " /><Run Text="{Binding Value}" /></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Verification checklist" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,4" />
                            <ItemsControl x:Name="TemplateVerificationChecks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5"><Run Text="• " /><Run Text="{Binding}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="TemplateAccountPanel" Margin="0,8,0,0">
                                <TextBlock Text="Provider account ID" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="TemplateAccountInput" MaxLength="512" AutomationProperties.Name="Provider account ID"
                                         Style="{StaticResource FormTextBoxStyle}" TextChanged="TemplateIdentityChanged" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ContinueTemplateButton" Content="Continue to vault" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ContinueTemplate_Click" Margin="0,0,8,0" />
                                <Button x:Name="DiscardTemplateButton" Content="Back to templates" Style="{StaticResource SecondaryButtonStyle}" Click="DiscardTemplate_Click" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="TemplateMessage" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- Step 1: Pick Provider -->
                <Border x:Name="ManualProviderPanel" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource InfoColorBrush}" Margin="0,0,10,0">
                                <TextBlock Text="1" FontWeight="Bold" FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Choose a Provider" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Filter Buttons -->
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="FilterAllBtn"
                                    Content="All"
                                    Command="{Binding SelectProviderFilterCommand}"
                                    CommandParameter="all"
                                    AutomationProperties.AutomationId="AddProviderFilterAllButton"
                                    Margin="0,0,8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllProviderFilterActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ConsoleAccentBlueAlpha20Brush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource InfoColorBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="FilterFreeBtn"
                                    Content="Free"
                                    Command="{Binding SelectProviderFilterCommand}"
                                    CommandParameter="free"
                                    AutomationProperties.AutomationId="AddProviderFilterFreeButton"
                                    Margin="0,0,8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFreeProviderFilterActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ConsoleAccentBlueAlpha20Brush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource InfoColorBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="FilterStreamingBtn"
                                    Content="Streaming"
                                    Command="{Binding SelectProviderFilterCommand}"
                                    CommandParameter="streaming"
                                    AutomationProperties.AutomationId="AddProviderFilterStreamingButton"
                                    Margin="0,0,8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStreamingProviderFilterActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ConsoleAccentBlueAlpha20Brush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource InfoColorBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="FilterHistoricalBtn"
                                    Content="Historical"
                                    Command="{Binding SelectProviderFilterCommand}"
                                    CommandParameter="historical"
                                    AutomationProperties.AutomationId="AddProviderFilterHistoricalButton"
                                    Margin="0,0,8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHistoricalProviderFilterActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ConsoleAccentBlueAlpha20Brush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource InfoColorBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource ConsoleTextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="{Binding ProviderCatalogScopeText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,12"
                                   AutomationProperties.AutomationId="AddProviderCatalogScopeText" />

                        <!-- Provider Cards -->
                        <ItemsControl x:Name="ProviderCatalogList"
                                      ItemsSource="{Binding ProviderCatalog}"
                                      Visibility="{Binding ProviderCatalogVisibility}"
                                      AutomationProperties.AutomationId="AddProviderCatalogList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8"
                                            Click="ProviderCard_Click"
                                            Tag="{Binding Id}"
                                            AutomationProperties.AutomationId="{Binding Id, StringFormat=ProviderCard_{0}}"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Provider {0}}"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Padding" Value="14,10" />
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{Binding CredentialStatusBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>

                                            <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                                                <Border CornerRadius="3" Padding="4,1" Margin="0,0,4,2"
                                                        Background="{Binding TierBrush}">
                                                    <TextBlock Text="{Binding TierLabel}" FontSize="10"
                                                               Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                                                </Border>
                                                <Border CornerRadius="3" Padding="4,1" Margin="0,0,4,2"
                                                        Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                                        Visibility="{Binding StreamingVisibility}">
                                                    <TextBlock Text="Streaming" FontSize="10"
                                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                                </Border>
                                                <Border CornerRadius="3" Padding="4,1" Margin="0,0,4,2"
                                                        Background="{StaticResource ConsoleBackgroundMediumBrush}"
                                                        Visibility="{Binding HistoricalVisibility}">
                                                    <TextBlock Text="Historical" FontSize="10"
                                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Grid.Row="2" Text="{Binding Description}"
                                                       TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="ProviderCatalogEmptyStatePanel"
                                    Visibility="{Binding ProviderCatalogEmptyVisibility}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,4"
                                    AutomationProperties.AutomationId="AddProviderCatalogEmptyStatePanel">
                            <TextBlock Text="{Binding ProviderCatalogEmptyTitle}"
                                       Style="{StaticResource EmptyStateTitleStyle}"
                                       HorizontalAlignment="Center"
                                       AutomationProperties.AutomationId="AddProviderCatalogEmptyStateTitle" />
                            <TextBlock Text="{Binding ProviderCatalogEmptyDetail}"
                                       Style="{StaticResource EmptyStateDescriptionStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,4,0,12"
                                       AutomationProperties.AutomationId="AddProviderCatalogEmptyStateDetail" />
                            <Button Content="Show All"
                                    Command="{Binding SelectProviderFilterCommand}"
                                    CommandParameter="all"
                                    Visibility="{Binding ProviderCatalogRecoveryVisibility}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="AddProviderCatalogShowAllButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2: Credentials -->
                <Border x:Name="Step2Panel" Style="{StaticResource CardStyle}" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource InfoColorBrush}" Margin="0,0,10,0">
                                <TextBlock Text="2" FontWeight="Bold" FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="CredentialStepHeading" Text="Enter Credentials" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" Focusable="True" />
                        </StackPanel>

                        <StackPanel x:Name="ExistingOwnedConnectionPanel">
                        <TextBlock Text="Existing owned connection" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding OwnedConnections}" SelectedItem="{Binding SelectedOwnedConnection}" SelectionChanged="OwnedConnectionSelectionChanged" IsSynchronizedWithCurrentItem="False"
                                  AutomationProperties.Name="Existing owned provider connection" AutomationProperties.AutomationId="AddProviderOwnedConnectionSelector">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock><Run Text="{Binding ConnectionId}" /><Run Text=" · " /><Run Text="{Binding CredentialEnvironment}" /><Run Text=" · " /><Run Text="{Binding ExternalAccountId}" /></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding OwnedConnectionStatusText}" TextWrapping="Wrap" Margin="0,8,0,8" />
                        <Button Content="Reload existing connections" Click="ReloadOwnedConnections_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        </StackPanel>
                        <TextBlock x:Name="CredentialsInfoText"
                                   Text="{Binding CredentialsInfoText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                   Margin="0,0,0,16" />

                        <StackPanel x:Name="CredentialFieldsPanel" />

                        <TextBlock x:Name="NoCredentialsNeededText"
                                   Text="This provider does not require API credentials."
                                   Foreground="{StaticResource SuccessColorBrush}"
                                   Visibility="{Binding NoCredentialsVisibility}"
                                   Margin="0,0,0,8" />
                        <StackPanel x:Name="TemplateVaultActions" Visibility="Collapsed" Margin="0,8,0,0">
                            <CheckBox x:Name="TemplateLiveAcknowledgement" Content="I am using credentials for a live provider account."
                                      Checked="TemplateAcknowledgementChanged" Unchecked="TemplateAcknowledgementChanged" Margin="0,0,0,8" />
                            <TextBlock x:Name="TemplateVaultMessage" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel>
                                <Button x:Name="TestTemplateButton" Content="Test connection" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="TestTemplate_Click" Margin="0,0,8,0" />
                                <Button x:Name="SaveTemplateButton" Content="Save connection" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveTemplateConnection_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 3: Test Connection -->
                <Border x:Name="Step3Panel" Style="{StaticResource CardStyle}" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource InfoColorBrush}" Margin="0,0,10,0">
                                <TextBlock Text="3" FontWeight="Bold" FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Test Connection" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse x:Name="ConnectionTestDot" Width="12" Height="12"
                                     Fill="{Binding ConnectionTestDotBrush}" Margin="0,0,10,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionTestStatusText"
                                       Text="{Binding ConnectionTestStatusText}"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Content="Test Connection"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="TestProviderConnection_Click" IsEnabled="{Binding CanUseOwnedCredentials}" />
                    </StackPanel>
                </Border>

                <!-- Step 4: Configure -->
                <Border x:Name="Step4Panel" Style="{StaticResource CardStyle}" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource InfoColorBrush}" Margin="0,0,10,0">
                                <TextBlock Text="4" FontWeight="Bold" FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Save Selected Connection Credentials" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="This action saves credentials for the selected existing connection. Connection creation, subscriptions and runtime activation are managed separately."
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <Button Content="Save selected connection credentials"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveProvider_Click" IsEnabled="{Binding CanUseOwnedCredentials}"
                                Margin="0,16,0,0" />

                        <CheckBox Content="Remove saved credentials from this selected owned connection." IsChecked="{Binding RemoveCredentialsConfirmed}"
                                  IsEnabled="{Binding CanUseOwnedCredentials}" Margin="0,12,0,8" />
                        <Button Content="Remove selected connection credentials" Click="RemoveOwnedCredentials_Click" IsEnabled="{Binding CanRemoveOwnedCredentials}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />

                        <TextBlock x:Name="SaveStatusText"
                                   Text="{Binding SaveStatusText}"
                                   Foreground="{Binding SaveStatusBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel - Selected Provider Summary -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12,20,28,32">
            <StackPanel>
                <!-- Selected Provider Info -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Selected Provider"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <TextBlock x:Name="SelectedProviderName"
                                   Text="{Binding SelectedProviderName}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource InfoColorBrush}" />
                        <TextBlock x:Name="SelectedProviderDescription"
                                   Text="{Binding SelectedProviderDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                   Margin="0,4,0,12" />

                        <Grid x:Name="ProviderDetailsGrid" Visibility="{Binding DetailsVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Streaming"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <TextBlock x:Name="DetailStreamingText" Grid.Row="0" Grid.Column="1"
                                       Text="{Binding DetailStreamingText}"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Historical"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <TextBlock x:Name="DetailHistoricalText" Grid.Row="1" Grid.Column="1"
                                       Text="{Binding DetailHistoricalText}"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Symbol Search"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <TextBlock x:Name="DetailSearchText" Grid.Row="2" Grid.Column="1"
                                       Text="{Binding DetailSearchText}"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Rate Limit"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <TextBlock x:Name="DetailRateLimitText" Grid.Row="3" Grid.Column="1"
                                       Text="{Binding DetailRateLimitText}"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Credentials"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4" />
                            <TextBlock x:Name="DetailCredentialsText" Grid.Row="4" Grid.Column="1"
                                       Text="{Binding DetailCredentialsText}"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Setup Progress -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Setup Progress"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Step1Dot" Width="10" Height="10"
                                     Fill="{Binding Step1Fill}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Step1Label" Text="Choose provider"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Step2Dot" Width="10" Height="10"
                                     Fill="{Binding Step2Fill}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Step2Label" Text="Enter credentials"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Step3Dot" Width="10" Height="10"
                                     Fill="{Binding Step3Fill}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Step3Label" Text="Test connection"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Step4Dot" Width="10" Height="10"
                                     Fill="{Binding Step4Fill}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Step4Label" Text="Save selected credentials"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
