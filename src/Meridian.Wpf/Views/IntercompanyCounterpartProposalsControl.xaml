<UserControl x:Class="Meridian.Wpf.Views.IntercompanyCounterpartProposalsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Counterpart proposals and intercompany breaks">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0,3,12,10" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="Margin" Value="0,8,0,12" />
        </Style>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Counterpart proposals and intercompany breaks" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Source posting retains a delivery record. The other entity reviews its own draft; source preparers gain no target-book edit rights. Records, permissions and amounts are shared with the browser workstation and nothing posts automatically."
                       Margin="0,5,0,12" TextWrapping="Wrap" />
            <WrapPanel>
                <StackPanel><TextBlock Text="Source ledger book ID" /><TextBox Text="{Binding SourceBook, UpdateSourceTrigger=PropertyChanged}" Width="300" AutomationProperties.Name="Counterpart source ledger book" /></StackPanel>
                <StackPanel><TextBlock Text="Break as-of date" /><TextBox Text="{Binding AsOf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Counterpart break as-of date" /></StackPanel>
                <Button Content="Load counterpart evidence" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.Name="Counterpart proposal status" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding PermissionNote}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="Counterpart proposal permission" />
            <DataGrid ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}" MinHeight="130" MaxHeight="280" AutomationProperties.Name="Counterpart delivery records">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source transaction" Binding="{Binding TransactionId}" Width="200" />
                    <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveDate}" Width="110" />
                    <DataGridTextColumn Header="Delivery" Binding="{Binding Delivery}" Width="100" />
                    <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="80" />
                    <DataGridTextColumn Header="Delivery detail" Binding="{Binding DeliveryDetail}" Width="320" />
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="420" />
                    <DataGridTextColumn Header="Counterparty entity" Binding="{Binding CounterpartyEntityId}" Width="240" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Booking breaks" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BreakStatus}" TextWrapping="Wrap" AutomationProperties.Name="Counterpart booking break status" AutomationProperties.LiveSetting="Polite" />
            <DataGrid ItemsSource="{Binding Breaks}" MaxHeight="220" AutomationProperties.Name="Counterpart booking breaks">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="200" />
                    <DataGridTextColumn Header="Age (days)" Binding="{Binding AgeDays}" Width="90" />
                    <DataGridTextColumn Header="Aging basis" Binding="{Binding Aging}" Width="260" />
                    <DataGridTextColumn Header="Transaction" Binding="{Binding TransactionId}" Width="200" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="420" />
                    <DataGridTextColumn Header="Accounting profile" Binding="{Binding AccountingArrangementId}" Width="240" />
                    <DataGridTextColumn Header="Source journal" Binding="{Binding SourceJournalId}" Width="240" />
                    <DataGridTextColumn Header="Target journal" Binding="{Binding TargetJournal}" Width="240" />
                </DataGrid.Columns>
            </DataGrid>
            <Expander Header="Selected counterpart delivery record" IsExpanded="True" Margin="0,8,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedGuidance}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.Name="Selected counterpart guidance" />
                    <TextBlock Text="Retained source lines (exact transaction and functional amounts)" FontWeight="SemiBold" />
                    <DataGrid ItemsSource="{Binding SelectedProposal.Lines}" MaxHeight="180" AutomationProperties.Name="Counterpart source lines">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="240" />
                            <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="110" />
                            <DataGridTextColumn Header="Transaction debit" Binding="{Binding TransactionDebit}" Width="160" />
                            <DataGridTextColumn Header="Transaction credit" Binding="{Binding TransactionCredit}" Width="160" />
                            <DataGridTextColumn Header="Functional currency" Binding="{Binding Currency}" Width="130" />
                            <DataGridTextColumn Header="Functional debit" Binding="{Binding FunctionalDebit}" Width="160" />
                            <DataGridTextColumn Header="Functional credit" Binding="{Binding FunctionalCredit}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Expander Header="Provenance">
                        <TextBox Text="{Binding SelectedProposal.Provenance, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Counterpart proposal provenance" />
                    </Expander>
                    <TextBlock Text="Retry counterpart delivery" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <WrapPanel>
                        <StackPanel><TextBlock Text="Delivery retry reason" /><TextBox Text="{Binding RetryReason, UpdateSourceTrigger=PropertyChanged}" Width="420" AutomationProperties.Name="Delivery retry reason" /></StackPanel>
                        <Button Content="Retry counterpart delivery" Command="{Binding RetryCommand}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="Explicit foreign-currency draft repricing" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="Preview the existing counterpart against a newly approved FX policy. The server preserves its accounts and sides and reprices its original retained source amount. Applying requires access to both books and clears prior draft review."
                               TextWrapping="Wrap" />
                    <Button Content="Preview counterpart FX repricing" Command="{Binding PreviewRepricingCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding RepricingStatus}" TextWrapping="Wrap" AutomationProperties.Name="Counterpart repricing status" AutomationProperties.LiveSetting="Polite" />
                    <DataGrid ItemsSource="{Binding RepricingRows}" MaxHeight="180" AutomationProperties.Name="Counterpart repricing before and after">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="240" />
                            <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="120" />
                            <DataGridTextColumn Header="Current functional amount" Binding="{Binding CurrentAmount}" Width="200" />
                            <DataGridTextColumn Header="Proposed functional amount" Binding="{Binding ProposedAmount}" Width="200" />
                            <DataGridTextColumn Header="Original transaction evidence" Binding="{Binding OriginalEvidence}" Width="320" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel>
                        <StackPanel><TextBlock Text="Counterpart FX repricing reason" /><TextBox Text="{Binding RepricingReason, UpdateSourceTrigger=PropertyChanged}" Width="420" AutomationProperties.Name="Counterpart FX repricing reason" /></StackPanel>
                        <Button Content="Apply repricing and renew review" Command="{Binding ApplyRepricingCommand}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="Link an existing counterpart journal" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <WrapPanel>
                        <StackPanel><TextBlock Text="Existing counterpart book ID" /><TextBox Text="{Binding TargetBook, UpdateSourceTrigger=PropertyChanged}" Width="300" AutomationProperties.Name="Existing counterpart book" /></StackPanel>
                        <StackPanel><TextBlock Text="Existing counterpart journal ID" /><TextBox Text="{Binding TargetJournal, UpdateSourceTrigger=PropertyChanged}" Width="300" AutomationProperties.Name="Existing counterpart journal ID" /></StackPanel>
                        <StackPanel><TextBlock Text="Counterpart linking reason" /><TextBox Text="{Binding LinkReason, UpdateSourceTrigger=PropertyChanged}" Width="420" AutomationProperties.Name="Counterpart linking reason" /></StackPanel>
                        <Button Content="Validate and link existing counterpart" Command="{Binding LinkCommand}" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
