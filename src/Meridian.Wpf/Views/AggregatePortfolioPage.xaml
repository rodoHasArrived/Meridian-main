<Page x:Class="Meridian.Wpf.Views.AggregatePortfolioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Aggregate Portfolio">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="AggregatePortfolioActionStrip"
                    AutomationProperties.Name="Aggregate Portfolio Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE821;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="Cross-Strategy Portfolio"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                AutomationProperties.AutomationId="AggregatePortfolioActionStatePanel"
                                AutomationProperties.Name="{Binding PortfolioActionStateTitle}">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Refresh Portfolio"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="{Binding RefreshTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="AggregatePortfolioRefreshButton"
                                    Margin="0,0,8,8" />
                            <Button Content="Security Master"
                                    Command="{Binding OpenSelectedSecurityCommand}"
                                    ToolTip="{Binding SelectedSecurityTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="AggregatePortfolioOpenSelectedSecurityButton"
                                    Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding PortfolioActionStateTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AggregatePortfolioActionStateTitle" />
                        <TextBlock Text="{Binding PortfolioActionStateDetail}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="AggregatePortfolioActionStateDetail" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Gross Exposure" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding GrossExposure, StringFormat=C2}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Net Exposure" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding NetExposure, StringFormat=C2}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="As Of" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding AsOf, StringFormat='{}{0:HH:mm:ss}'}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <workstation:WorkstationTableInspectorControl Grid.Row="2"
                                                          Table="{Binding PositionsTable}"
                                                          SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                                                          Inspector="{Binding SelectedPositionInspector}"
                                                          HeaderText="Netted Positions"
                                                          DetailText="Cross-strategy position rows aggregated by symbol."
                                                          GridAutomationId="AggregatePortfolioPositionsGrid"
                                                          EmptyAutomationId="AggregatePortfolioPositionsTableEmptyState"
                                                          InspectorAutomationId="AggregatePortfolioSelectionInspector"
                                                          ControlAutomationId="AggregatePortfolioWorkbench">
                <workstation:WorkstationTableInspectorControl.TableHeaderContent>
                    <ItemsControl ItemsSource="{Binding Top5Concentrations}"
                                  AutomationProperties.AutomationId="AggregatePortfolioConcentrationStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,6"
                                        Padding="8,3"
                                        Background="{DynamicResource ConsoleAccentBlueAlpha20Brush}"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource InfoColorBrush}">
                                    <TextBlock Text="{Binding}"
                                               FontSize="11"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </workstation:WorkstationTableInspectorControl.TableHeaderContent>

                <workstation:WorkstationTableInspectorControl.EmptyContent>
                    <Border MinHeight="300"
                            Padding="28"
                            Background="{StaticResource ConsoleBackgroundLightBrush}"
                            BorderBrush="{StaticResource ConsoleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsPositionsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="AggregatePositionsEmptyStatePanel"
                            AutomationProperties.Name="{Binding PositionsEmptyStateTitle}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="480">
                            <TextBlock Text="{Binding PositionsEmptyStateTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       AutomationProperties.AutomationId="AggregatePositionsEmptyStateTitle" />
                            <TextBlock Margin="0,8,0,16"
                                       Text="{Binding PositionsEmptyStateDetail}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       AutomationProperties.AutomationId="AggregatePositionsEmptyStateDetail" />
                            <Button Content="Refresh Portfolio"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="{Binding RefreshTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    HorizontalAlignment="Center"
                                    MinWidth="140"
                                    AutomationProperties.AutomationId="AggregatePositionsEmptyStateRefreshButton" />
                        </StackPanel>
                    </Border>
                </workstation:WorkstationTableInspectorControl.EmptyContent>

                <workstation:WorkstationTableInspectorControl.InspectorContent>
                    <Border Style="{StaticResource CardStyle}"
                            Padding="16"
                            AutomationProperties.AutomationId="AggregatePortfolioActionInspector"
                            AutomationProperties.Name="Aggregate Portfolio Actions">
                        <StackPanel>
                            <TextBlock Text="Selected Actions"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PortfolioActionStateDetail}"
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Security Master"
                                        Command="{Binding OpenSelectedSecurityCommand}"
                                        ToolTip="{Binding SelectedSecurityTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="AggregatePortfolioInspectorOpenSecurityButton"
                                        Margin="0,0,8,8" />
                                <Button Content="Refresh"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="{Binding RefreshTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="AggregatePortfolioInspectorRefreshButton"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </workstation:WorkstationTableInspectorControl.InspectorContent>
            </workstation:WorkstationTableInspectorControl>
        </Grid>
    </ScrollViewer>
</Page>
