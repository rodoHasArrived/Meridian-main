<Page x:Class="Meridian.Wpf.Views.AccountPortfolioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      xmlns:controls="clr-namespace:Meridian.Wpf.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="Account Portfolio">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="AccountPortfolioActionStrip"
                    AutomationProperties.Name="Account Portfolio Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE821;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName, TargetNullValue='Account Portfolio', FallbackValue='Account Portfolio'}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                AutomationProperties.AutomationId="AccountPortfolioActionStatePanel"
                                AutomationProperties.Name="{Binding PositionActionStateTitle}">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Refresh Account"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding CanRefreshAccount}"
                                    ToolTip="{Binding RefreshTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="AccountPortfolioRefreshButton"
                                    Margin="0,0,8,8" />
                            <Button Content="Security Master"
                                    Command="{Binding OpenSelectedSecurityCommand}"
                                    ToolTip="{Binding SelectedSecurityTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="AccountPortfolioOpenSelectedSecurityButton"
                                    Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding PositionActionStateTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AccountPortfolioActionStateTitle" />
                        <TextBlock Text="{Binding PositionActionStateDetail}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="AccountPortfolioActionStateDetail" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Kind" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding Kind, TargetNullValue=-}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Cash" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding Cash, StringFormat=C2}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Gross Exposure" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding GrossExposure, StringFormat=C2}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Net Exposure" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding NetExposure, StringFormat=C2}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Unrealized P&amp;L" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding UnrealisedPnl, StringFormat=C2}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Realized P&amp;L" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding RealisedPnl, StringFormat=C2}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <workstation:WorkstationTableInspectorControl Grid.Row="2"
                                                          Table="{Binding PositionsTable}"
                                                          SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                                                          Inspector="{Binding SelectedPositionInspector}"
                                                          HeaderText="Account Positions"
                                                          DetailText="Current retained brokerage position rows for the selected account."
                                                          GridAutomationId="AccountPortfolioPositionsGrid"
                                                          EmptyAutomationId="AccountPortfolioPositionsTableEmptyState"
                                                          InspectorAutomationId="AccountPortfolioSelectionInspector"
                                                          ControlAutomationId="AccountPortfolioWorkbench">
                <workstation:WorkstationTableInspectorControl.EmptyContent>
                    <controls:EmptyStatePanel MinHeight="300"
                                              Visibility="{Binding IsPositionsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Title="{Binding PositionsEmptyStateTitle}"
                                              Description="{Binding PositionsEmptyStateDetail}"
                                              Severity="Selection needed"
                                              SeverityTone="Warning"
                                              IconGlyph="&#xE946;"
                                              ActionText="Refresh Account"
                                              ActionCommand="{Binding RefreshCommand}"
                                              PanelAutomationId="AccountPositionsEmptyStatePanel"
                                              TitleAutomationId="AccountPositionsEmptyStateTitle"
                                              DescriptionAutomationId="AccountPositionsEmptyStateDetail"
                                              ActionButtonAutomationId="AccountPositionsEmptyStateRefreshButton" />
                </workstation:WorkstationTableInspectorControl.EmptyContent>

                <workstation:WorkstationTableInspectorControl.InspectorContent>
                    <Border Style="{StaticResource CardStyle}"
                            Padding="16"
                            AutomationProperties.AutomationId="AccountPortfolioActionInspector"
                            AutomationProperties.Name="Account Portfolio Actions">
                        <StackPanel>
                            <TextBlock Text="Selected Actions"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PositionActionStateDetail}"
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Security Master"
                                        Command="{Binding OpenSelectedSecurityCommand}"
                                        ToolTip="{Binding SelectedSecurityTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="AccountPortfolioInspectorOpenSecurityButton"
                                        Margin="0,0,8,8" />
                                <Button Content="Refresh"
                                        Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding CanRefreshAccount}"
                                        ToolTip="{Binding RefreshTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="AccountPortfolioInspectorRefreshButton"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </workstation:WorkstationTableInspectorControl.InspectorContent>
            </workstation:WorkstationTableInspectorControl>
        </Grid>
    </ScrollViewer>
</Page>
