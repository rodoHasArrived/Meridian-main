<UserControl x:Class="Meridian.Wpf.Views.WorkspaceInspectorHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="260"
             AutomationProperties.AutomationId="{Binding HostAutomationId, RelativeSource={RelativeSource Self}}"
             AutomationProperties.Name="Workspace inspector">
    <Border Padding="12"
            Background="{StaticResource ConsoleBackgroundLightBrush}"
            BorderBrush="{StaticResource ConsoleBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <StackPanel x:Name="EmptyStatePanel"
                        AutomationProperties.AutomationId="{Binding ElementName=Root, Path=EmptyAutomationId}"
                        AutomationProperties.Name="Workspace Inspector Empty State">
                <TextBlock Text="{Binding EmptyTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource CardHeaderStyle}" />
                <TextBlock Text="{Binding EmptyDetail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0,6,0,0"
                           Style="{StaticResource CardDescriptionStyle}" />
            </StackPanel>

            <StackPanel x:Name="SelectedStatePanel"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="{Binding ElementName=Root, Path=SelectedAutomationId}"
                        AutomationProperties.Name="Workspace Inspector Selected State">
                <TextBlock Text="{Binding SelectedTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource CardHeaderStyle}" />
                <TabControl x:Name="WorkspaceInspectorTabs"
                            Margin="0,10,0,0"
                            AutomationProperties.AutomationId="WorkspaceInspectorTabs"
                            AutomationProperties.Name="Workspace Inspector Tabs">
                    <TabItem Header="{Binding ElementName=Root, Path=SelectedEvidenceTabHeader}"
                             AutomationProperties.AutomationId="WorkspaceInspectorEvidenceTab"
                             AutomationProperties.Name="{Binding ElementName=Root, Path=SelectedEvidenceTabHeader}">
                        <TextBlock Text="{Binding SelectedDetail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Margin="8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </TabItem>
                    <TabItem Header="{Binding ElementName=Root, Path=SelectedActionsTabHeader}"
                             AutomationProperties.AutomationId="WorkspaceInspectorActionsTab"
                             AutomationProperties.Name="{Binding ElementName=Root, Path=SelectedActionsTabHeader}">
                        <TextBlock Text="{Binding SelectedActionDetail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Margin="8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </TabItem>
                </TabControl>
            </StackPanel>

            <StackPanel x:Name="LoadingStatePanel"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="{Binding ElementName=Root, Path=LoadingAutomationId}"
                        AutomationProperties.Name="Workspace Inspector Loading State">
                <TextBlock Text="{Binding ElementName=Root, Path=LoadingTitle}"
                           Style="{StaticResource CardHeaderStyle}" />
                <TextBlock Text="{Binding LoadingDetail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0,6,0,0"
                           Style="{StaticResource CardDescriptionStyle}" />
            </StackPanel>

            <StackPanel x:Name="ErrorStatePanel"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="{Binding ElementName=Root, Path=ErrorAutomationId}"
                        AutomationProperties.Name="Workspace Inspector Error State">
                <TextBlock Text="{Binding ErrorTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{StaticResource ErrorColorBrush}"
                           Style="{StaticResource CardHeaderStyle}" />
                <TextBlock Text="{Binding ErrorDetail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0,6,0,0"
                           Style="{StaticResource CardDescriptionStyle}" />
                <Button x:Name="ErrorActionButton"
                        Content="{Binding ElementName=Root, Path=ErrorActionLabel}"
                        Click="OnErrorActionClick"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="{Binding ElementName=Root, Path=ErrorActionId}"
                        AutomationProperties.Name="{Binding ElementName=Root, Path=ErrorActionLabel}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
