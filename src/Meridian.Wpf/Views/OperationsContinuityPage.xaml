<Page x:Class="Meridian.Wpf.Views.OperationsContinuityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="{Binding Title}"
      AutomationProperties.AutomationId="OperationsContinuityPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="ContinuityPanelRowTemplate">
            <Border Style="{StaticResource WorkspaceToneQueueCardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Value}"
                                   Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Detail}"
                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Meta}"
                               Foreground="{StaticResource ConsoleTextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="OperationsContinuityActionStrip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource CardHeaderStyle}"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Style="{StaticResource CardDescriptionStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource WorkstationFilterChipStyle}">
                                <TextBlock Text="{Binding QueueRollup.StatusLabel}"
                                           FontSize="11"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                           AutomationProperties.AutomationId="OperationsContinuityQueueChip" />
                            </Border>
                            <Border Style="{StaticResource WorkstationFilterChipStyle}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding CalendarSummaryText}"
                                           FontSize="11"
                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="OperationsContinuityRefreshButton"
                                    Margin="0,0,8,8" />
                            <Button Content="Open record release"
                                    Command="{Binding OpenPageCommand}"
                                    CommandParameter="OperationsRecordRelease"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="OperationsContinuityOpenRecordReleaseButton"
                                    Margin="0,0,8,8" />
                            <Button Content="Open fund operations"
                                    Command="{Binding OpenPageCommand}"
                                    CommandParameter="FundLedger"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="OperationsContinuityOpenFundLedgerButton"
                                    Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="OperationsContinuityStatusText" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityWorkflowPanel">
                        <StackPanel>
                            <TextBlock Text="Continuity workflows" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="Server-owned close workflows ordered by most recent update; select one to load its detail."
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding WorkflowsErrorText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasWorkflowsError, Converter={StaticResource BoolToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="OperationsContinuityWorkflowsError" />
                            <ItemsControl ItemsSource="{Binding WorkflowRows}"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="OperationsContinuityWorkflowList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource WorkspaceToneQueueCardStyle}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding GatesText}"
                                                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding UpdatedText}"
                                                           Foreground="{StaticResource ConsoleTextMutedBrush}"
                                                           Margin="0,2,0,0" />
                                                <Button Content="Load workflow detail"
                                                        Command="{Binding DataContext.SelectWorkflowCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="150"
                                                        Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityQueuePanel">
                        <StackPanel>
                            <TextBlock Text="Operator queue" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="Open breaks, lanes, blockers, checklist tasks, and close-calendar items for the selected workflow."
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding DetailErrorText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="OperationsContinuityDetailError" />
                            <ItemsControl ItemsSource="{Binding QueueRows}"
                                          ItemTemplate="{StaticResource ContinuityPanelRowTemplate}"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="OperationsContinuityQueueList" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityPolicyPanel">
                        <StackPanel>
                            <TextBlock Text="Approval policy matrix" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="{Binding PolicySummaryText}"
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding PolicyErrorText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasPolicyError, Converter={StaticResource BoolToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="OperationsContinuityPolicyError" />
                            <DataGrid ItemsSource="{Binding ApprovalPolicyRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      MaxHeight="320"
                                      Margin="0,10,0,0"
                                      AutomationProperties.AutomationId="OperationsContinuityPolicyGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Area" Binding="{Binding WorkflowArea}" Width="Auto" />
                                    <DataGridTextColumn Header="Gate" Binding="{Binding GateLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                                    <DataGridTextColumn Header="Approvals" Binding="{Binding ApprovalRuleLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="Reviewer" Binding="{Binding ReviewerLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="Controls" Binding="{Binding ControlLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityNextActionPanel">
                        <StackPanel>
                            <TextBlock Text="Next action" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="{Binding NextAction.Label}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="OperationsContinuityNextActionLabel" />
                            <TextBlock Text="{Binding NextAction.StatusText}"
                                       Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding NextAction.RouteText}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding NextAction.DisabledReason}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap"
                                       FontStyle="Italic"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityGatePanel">
                        <StackPanel>
                            <TextBlock Text="Gates" Style="{StaticResource CardHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding GateRows}"
                                          ItemTemplate="{StaticResource ContinuityPanelRowTemplate}"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="OperationsContinuityGateList" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityBlockerPanel">
                        <StackPanel>
                            <TextBlock Text="Blockers" Style="{StaticResource CardHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding BlockerRows}"
                                          ItemTemplate="{StaticResource ContinuityPanelRowTemplate}"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="OperationsContinuityBlockerList" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityChecklistPanel">
                        <StackPanel>
                            <TextBlock Text="Close checklist" Style="{StaticResource CardHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding ChecklistRows}"
                                          ItemTemplate="{StaticResource ContinuityPanelRowTemplate}"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="OperationsContinuityChecklistList" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            AutomationProperties.AutomationId="OperationsContinuityCalendarPanel">
                        <StackPanel>
                            <TextBlock Text="Close calendar" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="{Binding CalendarErrorText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasCalendarError, Converter={StaticResource BoolToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="OperationsContinuityCalendarError" />
                            <ItemsControl ItemsSource="{Binding CloseCalendarRows}"
                                          ItemTemplate="{StaticResource ContinuityPanelRowTemplate}"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="OperationsContinuityCalendarList" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
