<Page x:Class="Meridian.Wpf.Views.DirectLendingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      AutomationProperties.Name="Direct Lending">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="DirectLendingActionStrip"
                    AutomationProperties.Name="Direct Lending Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE8C1;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Direct Lending"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding SelectedStatusFilter, StringFormat=Scope: {0}}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2"
                               MaxWidth="420"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button Content="Post Accrual"
                                Command="{Binding PostAccrualCommand}"
                                ToolTip="{Binding PostAccrualTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="DirectLendingPostAccrualButton"
                                Margin="0,0,8,8" />
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                ToolTip="{Binding RefreshTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="DirectLendingRefreshButton"
                                Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource WorkstationFilterBarStyle}"
                    Padding="12"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="DirectLendingFilterBar">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Search"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 AutomationProperties.AutomationId="DirectLendingSearchBox" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Status"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="DirectLendingStatusFilter" />
                    </StackPanel>

                    <Border Grid.Column="4"
                            Style="{StaticResource CardStyle}"
                            Padding="10,8"
                            VerticalAlignment="Stretch"
                            AutomationProperties.AutomationId="DirectLendingActionStateCard">
                        <StackPanel>
                            <TextBlock Text="{Binding LoanActionStateTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                            <TextBlock Text="{Binding LoanActionStateDetail}"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,14">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Visible Loans" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding Loans.Count}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Selected Status" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding SelectedLoan.Status, TargetNullValue=-}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Accrual Rows" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding Accruals.Count}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Cash Rows" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding CashTransactions.Count}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Close Blockers" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding CloseBlockers.Count}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="3"
                  AutomationProperties.AutomationId="DirectLendingWorkbench"
                  AutomationProperties.Name="Direct Lending Workbench">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <TabControl AutomationProperties.AutomationId="DirectLendingTablesTabs">
                        <TabItem Header="Loans"
                                 AutomationProperties.AutomationId="DirectLendingLoansTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Loan Portfolio"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Select a retained loan to inspect servicing evidence and unlock accrual posting."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding LoansTable}"
                                                                  SelectedItem="{Binding SelectedLoan, Mode=TwoWay}"
                                                                  Height="420"
                                                                  GridAutomationId="DirectLendingLoansGrid"
                                                                  EmptyAutomationId="DirectLendingLoansEmptyState"
                                                                  AutomationProperties.Name="Direct lending loans table" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Accruals"
                                 AutomationProperties.AutomationId="DirectLendingAccrualsTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Accrual Evidence"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Daily accrual rows for the selected retained loan."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding AccrualsTable}"
                                                                  Height="320"
                                                                  GridAutomationId="DirectLendingAccrualsGrid"
                                                                  EmptyAutomationId="DirectLendingAccrualsEmptyState"
                                                                  AutomationProperties.Name="Direct lending accrual evidence table" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Cash"
                                 AutomationProperties.AutomationId="DirectLendingCashTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Cash Transactions"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Cash activity retained for the selected loan."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding CashTransactionsTable}"
                                                                  Height="320"
                                                                  GridAutomationId="DirectLendingCashTransactionsGrid"
                                                                  EmptyAutomationId="DirectLendingCashTransactionsEmptyState"
                                                                  AutomationProperties.Name="Direct lending cash transactions table" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Collateral"
                                 AutomationProperties.AutomationId="DirectLendingCollateralTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Collateral Coverage"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Shared operations coverage by loan, principal, retained collateral value, and blocker state."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding CollateralCoverageTable}"
                                                                  Height="320"
                                                                  GridAutomationId="DirectLendingCollateralGrid"
                                                                  EmptyAutomationId="DirectLendingCollateralEmptyState"
                                                                  AutomationProperties.Name="Direct lending collateral coverage table" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Status"
                                 AutomationProperties.AutomationId="DirectLendingStatusPostureTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Covenant / Status Posture"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Loan status, covenant retention, PIK, restructure, and amortization posture from the shared read model."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding StatusPostureTable}"
                                                                  Height="320"
                                                                  GridAutomationId="DirectLendingStatusPostureGrid"
                                                                  EmptyAutomationId="DirectLendingStatusPostureEmptyState"
                                                                  AutomationProperties.Name="Direct lending status posture table" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Exceptions"
                                 AutomationProperties.AutomationId="DirectLendingExceptionsTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Exceptions and Close Blockers"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Open reconciliation exceptions and blockers that prevent operations close."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <workstation:DenseDataGridControl Grid.Row="0"
                                                                      Table="{Binding ExceptionsTable}"
                                                                      Height="190"
                                                                      GridAutomationId="DirectLendingExceptionsGrid"
                                                                      EmptyAutomationId="DirectLendingExceptionsEmptyState"
                                                                      AutomationProperties.Name="Direct lending exceptions table" />
                                    <workstation:DenseDataGridControl Grid.Row="2"
                                                                      Table="{Binding CloseBlockersTable}"
                                                                      Height="190"
                                                                      GridAutomationId="DirectLendingCloseBlockersGrid"
                                                                      EmptyAutomationId="DirectLendingCloseBlockersEmptyState"
                                                                      AutomationProperties.Name="Direct lending close blockers table" />
                                </Grid>
                            </Grid>
                         </TabItem>

                        <TabItem Header="Statements"
                                  AutomationProperties.AutomationId="DirectLendingServicerStatementsTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Servicer statement batches"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="Imported position and remittance evidence from the shared Direct Lending operations read model."
                                               Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding ServicerStatementsTable}"
                                                                  Height="320"
                                                                  GridAutomationId="DirectLendingServicerStatementsGrid"
                                                                  EmptyAutomationId="DirectLendingServicerStatementsEmptyState"
                                                                  AutomationProperties.Name="Direct lending servicer statement batches table" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Evidence"
                                  AutomationProperties.AutomationId="DirectLendingEvidenceTab">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Evidence and Journals"
                                               Style="{StaticResource CardHeaderStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Contract, collateral, journal, reconciliation, and projection evidence routes from the shared operations read model."
                                               Style="{StaticResource CardDescriptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <workstation:DenseDataGridControl Grid.Row="1"
                                                                  Table="{Binding EvidenceTable}"
                                                                  Height="320"
                                                                  GridAutomationId="DirectLendingEvidenceGrid"
                                                                  EmptyAutomationId="DirectLendingEvidenceEmptyState"
                                                                  AutomationProperties.Name="Direct lending operations evidence table" />

                                <StackPanel Grid.Row="2" Visibility="{Binding HasLoanScenarios, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Cash-flow scenarios (shared contractual cash-flow routes; hypothetical, never posts) -->
                <Expander Header="Cash-flow scenarios" Margin="0,16,0,0" DataContext="{Binding LoanScenarios}"
                          AutomationProperties.Name="Loan cash-flow scenarios">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Hypothetical projections over current terms, calendars and pinned curves. Nothing here changes terms or posts; retained runs are complete replay packets under a client-generated identity."
                                   Opacity="0.7" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Width="150" Margin="0,0,8,8">
                                <TextBlock Text="Valuation date (UTC)" Opacity="0.8" />
                                <DatePicker SelectedDate="{Binding ValuationDate}" AutomationProperties.Name="Scenario valuation date" />
                            </StackPanel>
                            <StackPanel Width="230" Margin="0,0,8,8">
                                <TextBlock Text="Knowledge cutoff (ISO-8601 instant)" Opacity="0.8" />
                                <TextBox Text="{Binding KnowledgeCutoff, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scenario knowledge cutoff" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,8,8">
                                <TextBlock Text="Horizon (optional)" Opacity="0.8" />
                                <DatePicker SelectedDate="{Binding Horizon}" AutomationProperties.Name="Scenario horizon" />
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,8,8">
                                <TextBlock Text="Rate scenario" Opacity="0.8" />
                                <ComboBox ItemsSource="{Binding RateScenarios}" SelectedItem="{Binding RateScenario}" AutomationProperties.Name="Scenario rate shock" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Prepayment assumption" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <WrapPanel>
                            <CheckBox IsChecked="{Binding PrepaymentEnabled}" Content="Apply" VerticalAlignment="Center" Margin="0,0,8,8" AutomationProperties.Name="Apply a prepayment assumption" />
                            <TextBox Text="{Binding PrepaymentStreamId, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment stream id" />
                            <DatePicker SelectedDate="{Binding PrepaymentStart}" Width="140" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment start date" />
                            <DatePicker SelectedDate="{Binding PrepaymentEnd}" Width="140" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment end date" />
                            <ComboBox ItemsSource="{Binding PrepaymentMethods}" SelectedItem="{Binding PrepaymentMethod}" Width="90" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment method" />
                            <TextBox Text="{Binding PrepaymentValue, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment value" />
                            <ComboBox ItemsSource="{Binding PrepaymentPolicies}" SelectedItem="{Binding PrepaymentPolicy}" Width="150" Margin="0,0,0,8" IsEnabled="{Binding PrepaymentEnabled}" AutomationProperties.Name="Prepayment recast policy" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Exercises}" AutomationProperties.Name="Exercise selections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,0,0,4">
                                        <CheckBox IsChecked="{Binding Include}" Content="{Binding Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding Dates}" SelectedItem="{Binding ExerciseDate}" IsEditable="True" Text="{Binding ExerciseDate, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0" IsEnabled="{Binding Include}" />
                                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0" IsEnabled="{Binding Include}" />
                                        <TextBlock Text="{Binding CalendarText}" Opacity="0.7" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Preview scenario" Command="{Binding PreviewCommand}" Padding="12,6" Margin="0,0,8,0" />
                            <Button Content="Retain run" Command="{Binding RetainRunCommand}" Padding="12,6" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Blockers}" Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,8,0,0" AutomationProperties.Name="Calculation blockers" />
                        <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="320" Margin="0,8,0,0"
                                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.Name="Projected cash flows">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
                                <DataGridTextColumn Header="Stream" Binding="{Binding StreamId}" />
                                <DataGridTextColumn Header="Opening balance" Binding="{Binding OpeningBalance}" />
                                <DataGridTextColumn Header="Cash interest" Binding="{Binding CashInterest}" />
                                <DataGridTextColumn Header="Scheduled principal" Binding="{Binding ScheduledPrincipal}" />
                                <DataGridTextColumn Header="Forecast prepayment" Binding="{Binding ForecastPrepayment}" />
                                <DataGridTextColumn Header="Redeemed principal" Binding="{Binding RedeemedPrincipal}" />
                                <DataGridTextColumn Header="Premium / penalty" Binding="{Binding PremiumAndPenalty}" />
                                <DataGridTextColumn Header="Closing balance" Binding="{Binding ClosingBalance}" />
                                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ItemsControl ItemsSource="{Binding ExerciseCalculations}" Margin="0,4,0,0" AutomationProperties.Name="Exercise calculations" />
                        <TextBlock Text="{Binding EvidenceText}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RunText}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel Width="320" Margin="0,0,8,0">
                                <TextBlock Text="Retained run identity" Opacity="0.8" />
                                <TextBox Text="{Binding RunIdText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retained run identity" />
                            </StackPanel>
                            <Button Content="Load retained run" Command="{Binding LoadRunCommand}" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Bottom" />
                            <Button Content="Verify replay" Command="{Binding VerifyReplayCommand}" Padding="12,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding LoadedRunText}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReplayStatusText}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.Name="Replay verification" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <StackPanel Grid.Column="2">
                    <workstation:InspectorPanelControl Panel="{Binding SelectedLoanInspector}"
                                                       AutomationProperties.AutomationId="DirectLendingLoanInspector" />

                    <workstation:InspectorPanelControl Panel="{Binding LoanActionInspector}"
                                                       Margin="0,12,0,0"
                                                       AutomationProperties.AutomationId="DirectLendingLoanActionInspector" />

                    <Border Visibility="{Binding AccrualResultVisibility}"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0,12,0,0"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            AutomationProperties.AutomationId="DirectLendingAccrualResultPanel">
                        <TextBlock Text="{Binding AccrualResultText}"
                                   Style="{StaticResource CardDescriptionStyle}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
