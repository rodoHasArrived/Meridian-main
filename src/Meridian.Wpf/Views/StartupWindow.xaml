<Window x:Class="Meridian.Wpf.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Meridian.Wpf.Views"
        mc:Ignorable="d"
        Title="Meridian Startup"
        Width="1040"
        Height="640"
        MinWidth="920"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellWindowBackgroundBrush}"
        AutomationProperties.AutomationId="MeridianStartupWindow"
        AutomationProperties.Name="Meridian startup and login">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource TopBarBackgroundBrush}"
                BorderBrush="{StaticResource TopBarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Image Source="pack://application:,,,/Meridian.Desktop;component/Assets/Brand/meridian-tile-256.png"
                           Width="56"
                           Height="56"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="StartupBrandTile"
                           AutomationProperties.Name="Meridian brand" />
                    <TextBlock Text="Meridian"
                               Margin="0,24,0,0"
                               FontFamily="{StaticResource MeridianDisplayFontFamily}"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TopBarTextBrush}" />
                    <TextBlock Text="Desktop workstation startup"
                               Margin="0,8,0,0"
                               FontSize="15"
                               Foreground="{StaticResource StartupSubtitleTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border Padding="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{StaticResource IconHome}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="18"
                                       Foreground="{StaticResource TopBarIconAccentBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding LifecycleHeadingText}"
                                           Foreground="{StaticResource TopBarTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LifecycleDetailText}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource StartupBodyTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{StaticResource IconLock}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="18"
                                       Foreground="{StaticResource TopBarIconAccentBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding AuthenticationModeText}"
                                           Foreground="{StaticResource TopBarTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AuthenticationDetailText}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource StartupBodyTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource IconInfo}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="18"
                                   Foreground="{StaticResource TopBarIconAccentBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,1,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding EnvironmentText}"
                                       Foreground="{StaticResource TopBarTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OperatingModeText}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource StartupBodyTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="{Binding CredentialSourceText}"
                           Foreground="{StaticResource StartupFootnoteTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="52"
                        Height="52"
                        CornerRadius="8"
                        Background="{StaticResource ConsoleAccentBlueAlpha10Brush}"
                        BorderBrush="{StaticResource InfoColorBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{StaticResource IconLock}"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="25"
                               Foreground="{StaticResource InfoColorBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Sign in"
                           Margin="0,22,0,0"
                           FontFamily="{StaticResource MeridianDisplayFontFamily}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                <TextBlock Text="Authenticate the operator before opening the desktop shell."
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Margin="0,26,0,0"
                            Visibility="{Binding LoginFormVisibility}">
                    <TextBlock Text="Username"
                               Style="{StaticResource FormLabelStyle}" />
                    <TextBox x:Name="UsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             AutomationProperties.AutomationId="StartupUsernameInput"
                             AutomationProperties.Name="Username" />

                    <TextBlock Text="Password"
                               Margin="0,16,0,6"
                               Style="{StaticResource FormLabelStyle}" />
                    <views:SecretInputControl x:Name="StartupPasswordInput"
                                              Secret="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              InputAutomationId="StartupPasswordInput"
                                              RevealAutomationId="StartupPasswordRevealButton"
                                              InputAutomationName="Password"
                                              RevealAutomationName="Show or hide password"
                                              RevealToolTip="Show or hide password" />

                    <Button Content="Sign in"
                            Margin="0,24,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SignInCommand}"
                            IsDefault="True"
                            AutomationProperties.AutomationId="StartupSignInButton"
                            AutomationProperties.Name="Sign in" />
                </StackPanel>

                <Border Margin="0,26,0,0"
                        Padding="14"
                        CornerRadius="8"
                        Background="{StaticResource ConsoleAccentOrangeAlpha10Brush}"
                        BorderBrush="{StaticResource WarningColorBrush}"
                        BorderThickness="1"
                        Visibility="{Binding MissingConfigurationVisibility}">
                    <TextBlock Text="{Binding AuthenticationDetailText}"
                               FontSize="12"
                               Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Button Content="Continue without credentials"
                        Margin="0,18,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ContinueWithoutCredentialsCommand}"
                        Visibility="{Binding ContinueWithoutCredentialsVisibility}"
                        AutomationProperties.AutomationId="StartupContinueWithoutCredentialsButton"
                        AutomationProperties.Name="Continue without credentials" />

                <Border Margin="0,18,0,0"
                        Padding="12"
                        CornerRadius="8"
                        Background="{StaticResource ConsoleBackgroundLightBrush}"
                        BorderBrush="{Binding StatusBrush}"
                        BorderThickness="1"
                        Visibility="{Binding StatusVisibility}"
                        AutomationProperties.AutomationId="StartupStatusPanel">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Exit"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding CancelCommand}"
                        MinWidth="96"
                        IsCancel="True"
                        AutomationProperties.AutomationId="StartupExitButton"
                        AutomationProperties.Name="Exit Meridian" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
