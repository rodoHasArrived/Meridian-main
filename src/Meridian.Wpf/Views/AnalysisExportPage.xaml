<Page x:Class="Meridian.Wpf.Views.AnalysisExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      AutomationProperties.Name="Analysis Export">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="AnalysisExportActionStrip"
                    AutomationProperties.Name="Analysis Export Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE898;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Analysis Export"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding SelectedFormat, StringFormat=Format: {0}}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ExportActionStateDetail}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                AutomationProperties.AutomationId="AnalysisExportActionStatePanel"
                                AutomationProperties.Name="{Binding ExportActionStateTitle}">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button AutomationProperties.AutomationId="AnalysisExportRunButton"
                                    Content="Run Export"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RunExportCommand}"
                                    ToolTip="{Binding RunExportTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="0,0,8,8" />
                            <Button AutomationProperties.AutomationId="AnalysisExportSavePresetButton"
                                    Content="Save Preset"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SavePresetCommand}"
                                    ToolTip="{Binding SavePresetTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ExportActionStateTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AnalysisExportActionStateTitle" />
                        <TextBlock Text="{Binding ExportActionStateDetail}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="AnalysisExportActionStateDetail" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  AutomationProperties.AutomationId="AnalysisExportWorkbench"
                  AutomationProperties.Name="Analysis Export Workbench">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="AnalysisExportConfigurationPanel">
                        <StackPanel>
                            <TextBlock Text="Export Configuration"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Export Name" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding ExportName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             AutomationProperties.AutomationId="AnalysisExportNameBox" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Format" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                              ItemsSource="{Binding Formats}"
                                              SelectedItem="{Binding SelectedFormat}"
                                              AutomationProperties.AutomationId="AnalysisExportFormatCombo" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="Destination" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             AutomationProperties.AutomationId="AnalysisExportDestinationBox" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="From" Style="{StaticResource FormLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                AutomationProperties.AutomationId="AnalysisExportFromDatePicker" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="To" Style="{StaticResource FormLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                AutomationProperties.AutomationId="AnalysisExportToDatePicker" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="4">
                                    <TextBlock Text="Symbols" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding SymbolFilter, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="AnalysisExportSymbolFilterBox" />
                                    <ListBox ItemsSource="{Binding SelectedSymbols}"
                                             Height="72"
                                             Margin="0,8,0,0"
                                             AutomationProperties.AutomationId="AnalysisExportSelectedSymbolsList" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Metrics" Style="{StaticResource FormLabelStyle}" />
                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,16,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="4">
                                    <TextBlock Text="Include" Style="{StaticResource FormLabelStyle}" />
                                    <CheckBox Content="Charts" IsChecked="{Binding IncludeCharts}" Margin="0,4,0,0" />
                                    <CheckBox Content="Summary PDF" IsChecked="{Binding IncludeSummary}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,14,0,0"
                            AutomationProperties.AutomationId="AnalysisExportRecentExportsPanel">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Recent Exports"
                                           Style="{StaticResource CardHeaderStyle}"
                                           Margin="0,0,0,4" />
                                <TextBlock AutomationProperties.AutomationId="AnalysisExportRecentExportsState"
                                           Text="{Binding RecentExportsStateText}"
                                           Style="{StaticResource CardDescriptionStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <workstation:DenseDataGridControl Grid.Row="1"
                                                              Table="{Binding RecentExportsTable}"
                                                              SelectedItem="{Binding SelectedRecentExport, Mode=TwoWay}"
                                                              Height="300"
                                                              GridAutomationId="AnalysisExportRecentExportsGrid"
                                                              EmptyAutomationId="AnalysisExportRecentExportsEmptyState"
                                                              AutomationProperties.Name="Analysis export recent exports table" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ValidationSummary}"
                               Foreground="{StaticResource ErrorColorBrush}"
                               Margin="0,12,0,0"
                               Visibility="{Binding ValidationSummary, Converter={StaticResource StringToVisibilityConverter}}"
                               AutomationProperties.AutomationId="AnalysisExportValidationText" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <workstation:InspectorPanelControl Panel="{Binding ExportReadinessInspector}"
                                                       AutomationProperties.AutomationId="AnalysisExportReadinessCard" />

                    <workstation:InspectorPanelControl Panel="{Binding SelectedExportInspector}"
                                                       Margin="0,12,0,0"
                                                       AutomationProperties.AutomationId="AnalysisExportRecentExportInspector" />

                    <workstation:InspectorPanelControl Panel="{Binding ExportActionInspector}"
                                                       Margin="0,12,0,0"
                                                       AutomationProperties.AutomationId="AnalysisExportActionInspector" />

                    <Border Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0,12,0,0"
                            AutomationProperties.AutomationId="AnalysisExportStatusPanel">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CardDescriptionStyle}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
