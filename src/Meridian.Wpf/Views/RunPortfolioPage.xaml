<Page x:Class="Meridian.Wpf.Views.RunPortfolioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      AutomationProperties.Name="Run Portfolio">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="RunPortfolioActionStrip"
                    AutomationProperties.Name="Run Portfolio Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE8D2;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AsOfText, StringFormat=As of {0}}"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2"
                               MaxWidth="520"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button Content="Run Browser"
                                Command="{Binding OpenBrowserCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                AutomationProperties.AutomationId="RunPortfolioOpenBrowserButton"
                                Margin="0,0,8,8" />
                        <Button Content="Run Detail"
                                Command="{Binding OpenRunDetailCommand}"
                                ToolTip="{Binding RunDrillInTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="RunPortfolioOpenDetailButton"
                                Margin="0,0,8,8" />
                        <Button Content="Ledger"
                                Command="{Binding OpenLedgerCommand}"
                                ToolTip="{Binding RunDrillInTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="RunPortfolioOpenLedgerButton"
                                Margin="0,0,8,8" />
                        <Button Content="Security Master"
                                Command="{Binding OpenSelectedSecurityCommand}"
                                ToolTip="{Binding SelectedSecurityTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="RunPortfolioOpenSelectedSecurityButton"
                                Margin="0,0,8,8" />
                        <Button Content="Cash Flow"
                                Command="{Binding OpenCashFlowCommand}"
                                ToolTip="{Binding RunDrillInTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="RunPortfolioOpenCashFlowButton"
                                Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="As Of" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding AsOfText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Total Equity" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding EquityText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Cash" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding CashText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Gross Exposure" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding GrossExposureText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Net Exposure" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding NetExposureText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Realized PnL" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding RealizedPnlText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Unrealized PnL" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding UnrealizedPnlText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Commissions" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding CommissionsText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Grid.Row="2" Columns="2">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Security Resolved" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding SecurityResolvedText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Security Missing" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding SecurityMissingText}" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <workstation:WorkstationTableInspectorControl Grid.Row="2"
                                                          Table="{Binding PositionsTable}"
                                                          SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                                                          Inspector="{Binding SelectedPositionInspector}"
                                                          HeaderText="Positions"
                                                          DetailText="Select a retained position to inspect Security Master coverage and open mapped drill-ins."
                                                          GridAutomationId="RunPortfolioPositionsGrid"
                                                          EmptyAutomationId="RunPortfolioPositionsEmptyState"
                                                          InspectorAutomationId="RunPortfolioSelectionInspector"
                                                          ControlAutomationId="RunPortfolioWorkbench">
                <workstation:WorkstationTableInspectorControl.InspectorContent>
                    <Border Style="{StaticResource CardStyle}"
                            Padding="16"
                            AutomationProperties.AutomationId="RunPortfolioActionInspector"
                            AutomationProperties.Name="Run Portfolio Selected Actions">
                        <StackPanel>
                            <TextBlock Text="Selected Actions"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Security Master opens only after a position row is selected; unresolved rows use symbol lookup."
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Security Master"
                                        Command="{Binding OpenSelectedSecurityCommand}"
                                        ToolTip="{Binding SelectedSecurityTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="RunPortfolioInspectorOpenSecurityButton"
                                        Margin="0,0,8,8" />
                                <Button Content="Run Detail"
                                        Command="{Binding OpenRunDetailCommand}"
                                        ToolTip="{Binding RunDrillInTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="RunPortfolioInspectorOpenDetailButton"
                                        Margin="0,0,8,8" />
                                <Button Content="Ledger"
                                        Command="{Binding OpenLedgerCommand}"
                                        ToolTip="{Binding RunDrillInTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource GhostButtonStyle}"
                                        AutomationProperties.AutomationId="RunPortfolioInspectorOpenLedgerButton"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </workstation:WorkstationTableInspectorControl.InspectorContent>
            </workstation:WorkstationTableInspectorControl>
        </Grid>
    </ScrollViewer>
</Page>
