<Page x:Class="Meridian.Wpf.Views.StrategyRunsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      AutomationProperties.Name="Strategy Runs">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource EmbeddedShellHeroCardStyle}" Margin="0,0,0,20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="14"
                            Background="{DynamicResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{DynamicResource InfoColorBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="&#xE8B0;" FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   FontSize="24" Foreground="{DynamicResource InfoColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Strategy Run Workstation" Style="{DynamicResource PageTitleStyle}" />
                        <TextBlock Text="{Binding StatusText}" Style="{DynamicResource CardDescriptionStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Open Detail"
                        Command="{Binding OpenDetailCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Search" FontSize="11" Foreground="{DynamicResource ConsoleTextMutedBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource FormTextBoxStyle}"
                             AutomationProperties.AutomationId="StrategyRunsSearchBox" />
                    <TextBlock Text="{Binding RunScopeText}"
                               FontSize="11"
                               Foreground="{DynamicResource ConsoleTextMutedBrush}"
                               Margin="0,6,0,0"
                               AutomationProperties.AutomationId="StrategyRunsScopeText" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mode" FontSize="11" Foreground="{DynamicResource ConsoleTextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ModeFilters}"
                              SelectedItem="{Binding SelectedModeFilter, Mode=TwoWay}"
                              AutomationProperties.AutomationId="StrategyRunsModeFilter" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Portfolio"
                            Command="{Binding OpenPortfolioCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="Ledger"
                            Command="{Binding OpenLedgerCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="Reset Filters"
                            Command="{Binding ClearRunFiltersCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="StrategyRunsResetFiltersButton"
                            Margin="0,0,8,0" />
                    <Button Content="Compare"
                            Command="{Binding CompareRunsCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            ToolTip="Select a Comparison Run then click Compare to diff the two runs"
                            Margin="0,0,8,0" />
                    <Button Content="Clear"
                            Command="{Binding ClearComparisonCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Visibility="{Binding IsComparisonVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Border Grid.Row="1"
                        Grid.ColumnSpan="5"
                        Margin="0,16,0,0"
                        Padding="14,12"
                        CornerRadius="10"
                        Background="{DynamicResource ConsoleAccentBlueAlpha20Brush}"
                        BorderBrush="{DynamicResource InfoColorBrush}"
                        BorderThickness="1"
                        AutomationProperties.AutomationId="StrategyRunsSelectionPanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Selection"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ConsoleTextMutedBrush}" />
                            <TextBlock Text="{Binding SelectionText}"
                                       Margin="0,6,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectionDetail}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource ConsoleTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectionContextText}"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="StrategyRunsSelectionContextText" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Content="Open Detail"
                                    Command="{Binding OpenDetailCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8" />
                            <Button Content="Compare 2 runs"
                                    Command="{Binding CompareRunsCommand}"
                                    Style="{DynamicResource GhostButtonStyle}"
                                    Margin="0,0,8,8" />
                            <Button Content="Open Portfolio"
                                    Command="{Binding OpenPortfolioCommand}"
                                    Style="{DynamicResource GhostButtonStyle}"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <workstation:DenseDataGridControl Grid.Row="0"
                                                      Table="{Binding RunsTable}"
                                                      SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                                                      GridAutomationId="StrategyRunsGrid"
                                                      EmptyAutomationId="StrategyRunsSharedEmptyState"
                                                      MinHeight="280"
                                                      AutomationProperties.Name="Strategy runs workbench table" />

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="460"
                                Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="StrategyRunsEmptyStatePanel"
                                AutomationProperties.Name="{Binding EmptyStateTitle}">
                        <TextBlock Text="&#xE8B0;"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   FontSize="40"
                                   Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   Style="{DynamicResource EmptyStateTitleStyle}"
                                   Margin="0,0,0,8"
                                   AutomationProperties.AutomationId="StrategyRunsEmptyStateTitle" />
                        <TextBlock Text="{Binding EmptyStateDetail}"
                                   Style="{DynamicResource EmptyStateDescriptionStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="StrategyRunsEmptyStateDetail" />
                        <Button Content="Reset Filters"
                                Command="{Binding ClearRunFiltersCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Visibility="{Binding HasFilterRecoveryAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="StrategyRunsEmptyStateResetFiltersButton" />
                    </StackPanel>

                    <!-- Comparison run picker -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="10,8"
                            Background="{DynamicResource ConsoleAccentBlueAlpha20Brush}"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource InfoColorBrush}"
                            BorderThickness="1"
                            AutomationProperties.AutomationId="StrategyRunsComparisonPickerPanel">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Compare with:" FontSize="11"
                                           Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Runs}"
                                          SelectedItem="{Binding ComparisonRun, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChooseComparisonRun}"
                                          ToolTip="{Binding ComparisonGuidanceText}"
                                          AutomationProperties.AutomationId="StrategyRunsComparisonPicker">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding StrategyName}" />
                                                <Run Text=" (" /><Run Text="{Binding Mode}" /><Run Text=")" />
                                                <Run Text=" " />
                                                <Run Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd}}" Foreground="{DynamicResource ConsoleTextMutedBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="2" FontSize="11"
                                           Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="{Binding ComparisonRun.Mode, StringFormat='({0})'}" />
                            </Grid>
                            <TextBlock Text="{Binding ComparisonGuidanceText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="StrategyRunsComparisonGuidanceText" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Selection and comparison detail rail -->
            <Border Grid.Column="1"
                    Width="400"
                    Margin="16,0,0,0"
                    Style="{DynamicResource CardStyle}">
                <TabControl AutomationProperties.AutomationId="StrategyRunsInspectorTabs">
                    <TabItem Header="Overview"
                             AutomationProperties.AutomationId="StrategyRunsOverviewTab">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Selection detail"
                                           Style="{DynamicResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding SelectionText}"
                                           Margin="0,10,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ConsoleTextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectionDetail}"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ConsoleTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectionContextText}"
                                           Margin="0,12,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource InfoColorBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Performance"
                                           Margin="0,16,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedRunPerformanceText}"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ConsoleTextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="StrategyRunsSelectionPerformanceText" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Evidence"
                             AutomationProperties.AutomationId="StrategyRunsEvidenceTab">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Run evidence"
                                           Style="{DynamicResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding SelectedRunEvidenceText}"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ConsoleTextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="StrategyRunsSelectionEvidenceText" />
                                <UniformGrid Columns="1" Margin="0,16,0,0">
                                    <Button Content="Open Detail"
                                            Command="{Binding OpenDetailCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            AutomationProperties.AutomationId="StrategyRunsEvidenceOpenDetailButton"
                                            Margin="0,0,0,8" />
                                    <Button Content="Open Portfolio"
                                            Command="{Binding OpenPortfolioCommand}"
                                            Style="{DynamicResource GhostButtonStyle}"
                                            AutomationProperties.AutomationId="StrategyRunsEvidenceOpenPortfolioButton"
                                            Margin="0,0,0,8" />
                                    <Button Content="Open Ledger"
                                            Command="{Binding OpenLedgerCommand}"
                                            Style="{DynamicResource GhostButtonStyle}"
                                            AutomationProperties.AutomationId="StrategyRunsEvidenceOpenLedgerButton"
                                            Margin="0,0,0,8" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Compare"
                             AutomationProperties.AutomationId="StrategyRunsCompareTab">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Run comparison" Style="{DynamicResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding ComparisonPanelDetail}"
                                           Margin="0,8,0,14"
                                           FontSize="12"
                                           Foreground="{DynamicResource ConsoleTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="StrategyRunsComparisonPanelDetail" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Metric" FontSize="11"
                                               Foreground="{DynamicResource ConsoleTextMutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InfoColorBrush}"
                                               Text="{Binding ComparisonHeaderAText}" />
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessColorBrush}"
                                               Text="{Binding ComparisonHeaderBText}" />
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource ConsoleTextMutedBrush}" Margin="0,0,0,8" Opacity="0.2" />

                                <ItemsControl ItemsSource="{Binding ComparisonRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                           Foreground="{DynamicResource ConsoleTextMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ValueA}" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding ValueB}" FontSize="11" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding ComparisonPlaceholderText}"
                                           Margin="0,12,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="StrategyRunsComparisonPlaceholderText" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Artifacts"
                             AutomationProperties.AutomationId="StrategyRunsArtifactsTab">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Strategy artifacts"
                                           Style="{DynamicResource CardHeaderStyle}" />
                                <TextBlock Text="Notebook, result packet, promotion notes, and audit links stay attached to the selected run as evidence is produced."
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ConsoleTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="StrategyRunsArtifactsDetailText" />
                                <TextBlock Text="{Binding SelectionContextText}"
                                           Margin="0,14,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource ConsoleTextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Page>
