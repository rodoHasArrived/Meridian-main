<Page x:Class="Meridian.Wpf.Views.OperationalExceptionTriagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:Meridian.Wpf.Models"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      AutomationProperties.Name="Operational Exception Triage">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource WorkspaceInspectorCardStyle}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Operational Exception Triage" Style="{StaticResource CardHeaderStyle}" />
                    <TextBlock Text="Reconciliation and provider/data-quality exception queue for fund operations. This is scoped to Meridian operational exceptions, not general ticketing."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding QueueSummary}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource ConsoleTextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Workspace" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" />
                    <ComboBox Width="190" ItemsSource="{Binding WorkspaceFilters}" SelectedItem="{Binding WorkspaceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Exception type" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" />
                    <ComboBox Width="210" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Exceptions}"
                      SelectedItem="{Binding SelectedException, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      AutomationProperties.AutomationId="OperationalExceptionQueueGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceWorkspace}" Width="110" />
                    <DataGridTextColumn Header="Type" Binding="{Binding SourceCategory}" Width="150" />
                    <DataGridTextColumn Header="Portfolio" Binding="{Binding AffectedPortfolio}" Width="180" />
                    <DataGridTextColumn Header="Instrument" Binding="{Binding AffectedInstrument}" Width="170" />
                    <DataGridTextColumn Header="Report" Binding="{Binding AffectedReport}" Width="170" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource WorkspaceInspectorCardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedException}">
                        <TextBlock Text="Exception detail" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="{Binding Id}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource ConsoleTextPrimaryBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="Recommended action" Foreground="{StaticResource ConsoleTextMutedBrush}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding RecommendedAction}" TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Evidence link" Foreground="{StaticResource ConsoleTextMutedBrush}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding EvidenceLink}" TextWrapping="Wrap" Foreground="{StaticResource InfoColorBrush}" Margin="0,4,0,0" />

                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Account" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding AffectedAccount}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Portfolio" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding AffectedPortfolio}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Instrument" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding AffectedInstrument}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Report" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                                <TextBlock Text="{Binding AffectedReport}" TextWrapping="Wrap" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Audit history" Style="{StaticResource CardHeaderStyle}" Margin="0,18,0,8" />
                        <ItemsControl ItemsSource="{Binding DataContext.SelectedAuditHistory, RelativeSource={RelativeSource AncestorType=Page}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:OperationalExceptionAuditEntry}">
                                    <Border BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextSecondaryBrush}" />
                                            <TextBlock Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11">
                                                <Run Text="{Binding Actor}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Timestamp}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
