<Page x:Class="Meridian.Wpf.Views.SystemHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:workstation="clr-namespace:Meridian.Wpf.Workstation.Controls"
      Background="{DynamicResource ShellWindowBackgroundBrush}"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded"
      AutomationProperties.Name="System Health">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <Grid MaxWidth="1260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource WorkspaceContextStripStyle}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    AutomationProperties.AutomationId="SystemHealthActionStrip"
                    AutomationProperties.Name="System Health Action Strip">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource ConsoleAccentBlueAlpha20Brush}"
                            BorderBrush="{StaticResource InfoColorBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE9F5;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="16"
                                   Foreground="{StaticResource InfoColorBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="System Health"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border CornerRadius="999"
                                    Padding="8,3"
                                    Margin="10,0,0,0"
                                    Background="{Binding OverallStatusBackground}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding OverallStatusText}"
                                           FontSize="11"
                                           Foreground="White"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SystemTriageEvidenceText}"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="SystemHealthTriageEvidenceText" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                MaxWidth="560"
                                AutomationProperties.AutomationId="SystemHealthActionStatePanel"
                                AutomationProperties.Name="{Binding HealthActionStateTitle}">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Command="{Binding RefreshCommand}"
                                    ToolTip="{Binding RefreshTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="SystemHealthRefreshButton"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding GenerateDiagnosticsCommand}"
                                    ToolTip="{Binding DiagnosticsTooltip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="SystemHealthDiagnosticsButton"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="14"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="Diagnostics" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding HealthActionStateTitle}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SystemHealthActionStateTitle" />
                        <TextBlock Text="{Binding HealthActionStateDetail}"
                                   FontSize="11"
                                   Foreground="{StaticResource ConsoleTextMutedBrush}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="SystemHealthActionStateDetail" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CPU Usage" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding CpuText}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{Binding CpuForeground}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Memory" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Threads" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding ThreadsText}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Uptime" FontSize="11" Foreground="{StaticResource ConsoleTextMutedBrush}" />
                        <TextBlock Text="{Binding UptimeText}" Style="{StaticResource CardHeaderStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2"
                  AutomationProperties.AutomationId="SystemHealthWorkbench"
                  AutomationProperties.Name="System Health Workbench">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}"
                            AutomationProperties.Name="Provider Health">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Provider Health"
                                           Style="{StaticResource CardHeaderStyle}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SystemTriageProviderSummaryText}"
                                           Style="{StaticResource CardDescriptionStyle}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="SystemHealthProviderSummaryChip" />
                            </StackPanel>

                            <workstation:DenseDataGridControl Grid.Row="1"
                                                              Table="{Binding ProvidersTable}"
                                                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                                              Height="260"
                                                              GridAutomationId="SystemHealthProviderHealthGrid"
                                                              EmptyAutomationId="SystemHealthProviderTableEmptyState"
                                                              Visibility="{Binding HasProviders, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              AutomationProperties.Name="System health providers table" />

                            <Border Grid.Row="1"
                                    MinHeight="220"
                                    Padding="24"
                                    Background="{StaticResource ConsoleBackgroundLightBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding HasNoProviders, Converter={StaticResource BoolToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="SystemHealthProviderEmptyStatePanel"
                                    AutomationProperties.Name="{Binding ProviderEmptyStateTitle}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="520">
                                    <TextBlock Text="{Binding ProviderEmptyStateTitle}"
                                               Style="{StaticResource EmptyStateTitleStyle}"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="SystemHealthProviderEmptyStateTitle" />
                                    <TextBlock Text="{Binding ProviderEmptyStateDetail}"
                                               Style="{StaticResource EmptyStateDescriptionStyle}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="SystemHealthProviderEmptyStateDetail" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,12,0,0"
                            AutomationProperties.Name="Storage Health">
                        <StackPanel>
                            <TextBlock Text="Storage Health"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SystemTriageStorageSummaryText}"
                                       Style="{StaticResource CardDescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       AutomationProperties.AutomationId="SystemHealthStorageSummaryChip" />
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Total Size" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding StorageTotalText}" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="File Count" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding StorageFilesText}" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Disk Usage" Foreground="{StaticResource ConsoleTextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding DiskUsageText}" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                            </UniformGrid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DiskUsageValue, Mode=OneWay}"
                                         Height="8"
                                         Margin="0,12,0,0"
                                         Foreground="{Binding DiskUsageForeground}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,12,0,0"
                            AutomationProperties.Name="Recent Events">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Recent Events"
                                           Style="{StaticResource CardHeaderStyle}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SystemTriageEventSummaryText}"
                                           Style="{StaticResource CardDescriptionStyle}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="SystemHealthEventSummaryChip" />
                            </StackPanel>

                            <workstation:DenseDataGridControl Grid.Row="1"
                                                              Table="{Binding EventsTable}"
                                                              SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                                                              Height="280"
                                                              GridAutomationId="SystemHealthEventsGrid"
                                                              EmptyAutomationId="SystemHealthEventsTableEmptyState"
                                                              Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              AutomationProperties.Name="System health recent events table" />

                            <Border Grid.Row="1"
                                    MinHeight="220"
                                    Padding="24"
                                    Background="{StaticResource ConsoleBackgroundLightBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="SystemHealthEventEmptyStatePanel"
                                    AutomationProperties.Name="{Binding EventEmptyStateTitle}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="520">
                                    <TextBlock Text="{Binding EventEmptyStateTitle}"
                                               Style="{StaticResource EmptyStateTitleStyle}"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="SystemHealthEventEmptyStateTitle" />
                                    <TextBlock Text="{Binding EventEmptyStateDetail}"
                                               Style="{StaticResource EmptyStateDescriptionStyle}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="SystemHealthEventEmptyStateDetail" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <workstation:InspectorPanelControl Panel="{Binding SystemTriageInspector}"
                                                       AutomationProperties.AutomationId="SystemHealthTriageBriefingCard" />

                    <Border Style="{StaticResource CardStyle}"
                            Padding="16"
                            Margin="0,12,0,0"
                            AutomationProperties.AutomationId="SystemHealthTriageHandoffPanel"
                            AutomationProperties.Name="System Health Actions">
                        <StackPanel>
                            <TextBlock Text="Next Handoff"
                                       Style="{StaticResource CardHeaderStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SystemTriageActionText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ConsoleTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SystemHealthTriageActionText" />
                            <TextBlock Text="{Binding SystemTriageTargetText}"
                                       FontSize="11"
                                       Foreground="{StaticResource ConsoleTextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,12"
                                       AutomationProperties.AutomationId="SystemHealthTriageTargetText" />
                            <WrapPanel>
                                <Button Command="{Binding RefreshCommand}"
                                        Content="Refresh"
                                        ToolTip="{Binding RefreshTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="SystemHealthInspectorRefreshButton"
                                        Margin="0,0,8,8" />
                                <Button Command="{Binding GenerateDiagnosticsCommand}"
                                        Content="Diagnostics"
                                        ToolTip="{Binding DiagnosticsTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="SystemHealthInspectorDiagnosticsButton"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <workstation:InspectorPanelControl Panel="{Binding SelectedProviderInspector}"
                                                       Margin="0,12,0,0"
                                                       AutomationProperties.AutomationId="SystemHealthProviderInspector" />

                    <workstation:InspectorPanelControl Panel="{Binding SelectedEventInspector}"
                                                       Margin="0,12,0,0"
                                                       AutomationProperties.AutomationId="SystemHealthEventInspector" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
