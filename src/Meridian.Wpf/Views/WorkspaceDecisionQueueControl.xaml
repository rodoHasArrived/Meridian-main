<UserControl x:Class="Meridian.Wpf.Views.WorkspaceDecisionQueueControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Meridian.Wpf.Models"
             xmlns:views="clr-namespace:Meridian.Wpf.Views"
             x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="DecisionCardTemplate" DataType="{x:Type models:WorkspaceQueueItem}">
            <Border Style="{StaticResource WorkspaceToneQueueCardStyle}"
                    Margin="0,0,10,10"
                    AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ConsoleTextPrimaryBrush}" />
                        <Border Style="{StaticResource WorkspaceToneBadgeStyle}" Margin="10,0,0,0">
                            <TextBlock Text="{Binding CountLabel}"
                                       FontSize="10"
                                       Style="{StaticResource WorkspaceToneBadgeTextStyle}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Style="{StaticResource WorkspaceToneBadgeTextStyle}" />
                    <TextBlock Text="{Binding Detail}"
                               Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource ConsoleTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{Binding PrimaryActionLabel}"
                                Tag="{Binding}"
                                Click="OnPrimaryActionClick"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="{Binding PrimaryActionLabel}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrimaryActionId}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrimaryActionLabel}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding SecondaryActionLabel}"
                                Tag="{Binding}"
                                Click="OnSecondaryActionClick"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,8"
                                AutomationProperties.Name="{Binding SecondaryActionLabel}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SecondaryActionLabel}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SecondaryActionId}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding ElementName=Root, Path=ItemsSource}"
                  ItemTemplate="{StaticResource DecisionCardTemplate}"
                  Tag="{Binding ElementName=Root}"
                  AutomationProperties.AutomationId="{Binding ElementName=Root, Path=QueueAutomationId}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Tag.Columns, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
