<Window x:Class="Meridian.Wpf.Views.EditScheduledJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:Meridian.Wpf.Views"
        mc:Ignorable="d"
        Title="Edit Scheduled Job"
        Width="500" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ConsoleBackgroundDarkBrush}"
        ShowInTaskbar="False">

    <views:WorkspaceDialogChromeControl Margin="16"
                                        DialogAutomationId="EditScheduledJobDialogChrome"
                                        TitleAutomationId="EditScheduledJobDialogTitle"
                                        SubtitleAutomationId="EditScheduledJobDialogSubtitle"
                                        BodyAutomationId="EditScheduledJobDialogBody"
                                        TitleText="Edit Scheduled Job"
                                        SubtitleText="Adjust backfill schedule cadence and next-run timing.">
        <views:WorkspaceDialogChromeControl.Body>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Job Name" Style="{StaticResource ShellSectionLabelStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox"
                         Grid.Row="1"
                         Style="{StaticResource FormTextBoxStyle}"
                         Margin="0,4,0,12"
                         AutomationProperties.AutomationId="EditScheduledJobNameInput"
                         AutomationProperties.Name="Scheduled job name" />

                <TextBlock Grid.Row="2" Text="Frequency" Style="{StaticResource ShellSectionLabelStyle}" Margin="0,0,0,4" />
                <ComboBox x:Name="FrequencyCombo"
                          Grid.Row="3"
                          Style="{StaticResource FormComboBoxStyle}"
                          Margin="0,4,0,12"
                          SelectionChanged="FrequencyCombo_SelectionChanged"
                          AutomationProperties.AutomationId="EditScheduledJobFrequencyCombo"
                          AutomationProperties.Name="Scheduled job frequency">
                    <ComboBoxItem Content="Daily" IsSelected="True" />
                    <ComboBoxItem Content="Weekly" />
                    <ComboBoxItem Content="Monthly" />
                </ComboBox>

                <TextBlock Grid.Row="4" Text="Time" Style="{StaticResource ShellSectionLabelStyle}" Margin="0,0,0,4" />
                <ComboBox x:Name="TimeCombo"
                          Grid.Row="5"
                          Style="{StaticResource FormComboBoxStyle}"
                          Margin="0,4,0,12"
                          AutomationProperties.AutomationId="EditScheduledJobTimeCombo"
                          AutomationProperties.Name="Scheduled job time" />

                <ComboBox x:Name="DayCombo"
                          Grid.Row="6"
                          Style="{StaticResource FormComboBoxStyle}"
                          Margin="0,4,0,12"
                          Visibility="Collapsed"
                          AutomationProperties.AutomationId="EditScheduledJobDayCombo"
                          AutomationProperties.Name="Scheduled job day">
                    <ComboBoxItem Content="Monday" />
                    <ComboBoxItem Content="Tuesday" />
                    <ComboBoxItem Content="Wednesday" />
                    <ComboBoxItem Content="Thursday" />
                    <ComboBoxItem Content="Friday" />
                    <ComboBoxItem Content="Saturday" />
                    <ComboBoxItem Content="Sunday" IsSelected="True" />
                </ComboBox>

                <Grid Grid.Row="7" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Delete"
                            MinWidth="96"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="Delete_Click"
                            AutomationProperties.AutomationId="EditScheduledJobDeleteButton"
                            AutomationProperties.Name="Delete scheduled job" />

                    <Button Grid.Column="2"
                            Content="Cancel"
                            MinWidth="96"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="Cancel_Click"
                            AutomationProperties.AutomationId="EditScheduledJobCancelButton"
                            AutomationProperties.Name="Cancel scheduled job edit" />

                    <Button Grid.Column="3"
                            Content="Save"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"
                            IsDefault="True"
                            AutomationProperties.AutomationId="EditScheduledJobSaveButton"
                            AutomationProperties.Name="Save scheduled job" />
                </Grid>
            </Grid>
        </views:WorkspaceDialogChromeControl.Body>
    </views:WorkspaceDialogChromeControl>
</Window>
