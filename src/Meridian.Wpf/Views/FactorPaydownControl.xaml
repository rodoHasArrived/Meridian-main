<UserControl x:Class="Meridian.Wpf.Views.FactorPaydownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="FactorPaydownReview">
    <StackPanel>
        <TextBlock Text="Factor paydown" Style="{StaticResource CardHeaderStyle}" />
        <TextBlock Text="Prepare principal and basis relief from retained lots. Approval and atomic lot posting require current server authorization and retained independent review."
                   TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <Expander Header="Factor observation and retained support" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Accounting basis" Margin="0,8,0,4" />
                <ComboBox ItemsSource="{Binding AccountingBases}" SelectedItem="{Binding AccountingBasis}"
                          AutomationProperties.Name="Factor paydown accounting basis" />
                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="340" Margin="0,0,14,12">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="32"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         AutomationProperties.Name="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Paste exact retained evidence identities from the governed source; this form cannot grant evidence review authority."
                           TextWrapping="Wrap" Margin="0,0,0,10" />
                <Button Content="Prepare paydown" Command="{Binding PrepareCommand}" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="PrepareFactorPaydownButton" />
            </StackPanel>
        </Expander>
        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,12,0,0"
                   AutomationProperties.AutomationId="FactorPaydownPreview" />
        <CheckBox Content="I reviewed the factors, calculated amounts and retained support."
                  IsChecked="{Binding Confirmed}" Margin="0,12,0,8" />
        <Button Content="Create governed draft" Command="{Binding CreateDraftCommand}" HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="CreateFactorPaydownDraftButton" />
        <TextBlock Text="Retained server drafts" Style="{StaticResource CardHeaderStyle}" Margin="0,16,0,0" />
        <Button Content="Reload retained drafts" Command="{Binding ReloadRetainedDraftsCommand}" HorizontalAlignment="Left" Margin="0,8,0,8"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="ReloadFactorPaydownDraftsButton" />
        <ComboBox ItemsSource="{Binding RetainedDrafts}" SelectedItem="{Binding SelectedRetainedDraft}" DisplayMemberPath="JournalEntryId" IsEnabled="{Binding CanSelectRetainedDraft}"
                  AutomationProperties.Name="Retained server factor-paydown draft" />
        <TextBlock Text="{Binding RetainedDraftStatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <DataGrid ItemsSource="{Binding RetainedDraftLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Margin="0,8,0,8" AutomationProperties.AutomationId="RetainedFactorPaydownDraftLines">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountPath}" Width="*" />
                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="80" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="120" />
                <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Submit selected draft for review" Command="{Binding SubmitRetainedDraftCommand}" HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="SubmitFactorPaydownDraftButton" />
        <TextBlock Text="Independent approval and atomic posting" Style="{StaticResource CardHeaderStyle}" Margin="0,16,0,0" />
        <Button Content="Reload approval and posting status" Command="{Binding ReloadApprovalStateCommand}" HorizontalAlignment="Left" Margin="0,8,0,8"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="ReloadFactorPaydownApprovalButton" />
        <TextBlock Text="{Binding ApprovalStateText}" TextWrapping="Wrap" />
        <TextBlock Text="Review rationale" Margin="0,10,0,4" />
        <TextBox Text="{Binding ApprovalNotes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditApprovalNotes}" AcceptsReturn="True" TextWrapping="Wrap"
                 AutomationProperties.Name="Factor paydown independent review rationale" />
        <CheckBox Content="I independently reviewed the retained draft lines and source evidence." IsChecked="{Binding ApprovalConfirmed}" Margin="0,8,0,8" />
        <Button Content="Retain independent approval" Command="{Binding ApproveRetainedDraftCommand}" HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="ApproveFactorPaydownDraftButton" />
        <Expander Header="Retained approval proof" Margin="0,10,0,8">
            <TextBox Text="{Binding ApprovalProofText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     AutomationProperties.Name="Retained factor paydown approval receipt" />
        </Expander>
        <CheckBox Content="Post the approved paydown and update its retained lots atomically." IsChecked="{Binding PostingConfirmed}" Margin="0,8,0,8" />
        <Button Content="Post approved paydown" Command="{Binding PostRetainedDraftCommand}" HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="PostFactorPaydownDraftButton" />
        <TextBlock Text="{Binding PendingCommandText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Text="{Binding CanonicalPostingText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="FactorPaydownCanonicalPosting" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,10,0,0"
                   AutomationProperties.AutomationId="FactorPaydownStatus" />
    </StackPanel>
</UserControl>
