<UserControl x:Class="Meridian.Wpf.Views.IntercompanyManagementFeeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Management fee accrual">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0,3,12,10" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ConsoleButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="Margin" Value="0,8,0,12" />
        </Style>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Charge management fee" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="A fixed management fee is calculated by the server from the approved legal terms (the declared amount, whether it covers each schedule period or one year, and the schedule) and the management-fee profile's approved revisions. Whether this book is the service provider or the recipient comes from the agreement's declared roles. No amount or direction is entered here, percentage fees are not calculated, and nothing posts automatically."
                       Margin="0,5,0,12" TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="Load books" Command="{Binding LoadChoicesCommand}" VerticalAlignment="Center" AutomationProperties.Name="Load fee books" />
                <TextBlock Text="{Binding ChoicesStatus}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="640"
                           AutomationProperties.Name="Fee selection status" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
            <WrapPanel>
                <StackPanel><TextBlock Text="Source ledger book" />
                    <ComboBox ItemsSource="{Binding BookChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SourceBook}"
                              Style="{StaticResource FormComboBoxStyle}" Width="360" Margin="0,3,12,10" AutomationProperties.Name="Fee source ledger book" /></StackPanel>
                <StackPanel><TextBlock Text="Management-fee accounting profile" />
                    <ComboBox ItemsSource="{Binding FeeProfileChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding FeeProfile}"
                              Style="{StaticResource FormComboBoxStyle}" Width="360" Margin="0,3,12,10" AutomationProperties.Name="Management-fee accounting profile" /></StackPanel>
            </WrapPanel>
            <WrapPanel>
                <StackPanel><TextBlock Text="First charged day (yyyy-MM-dd)" /><TextBox Text="{Binding AccrualFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="First charged day" /></StackPanel>
                <StackPanel><TextBlock Text="Charge up to, not including (yyyy-MM-dd)" /><TextBox Text="{Binding AccrualTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Charge up to date" /></StackPanel>
                <Button Content="Preview management fee" Command="{Binding PreviewCommand}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.Name="Fee status" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding PermissionNote}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="Fee permission" />
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.Name="Fee summary" AutomationProperties.LiveSetting="Polite" />
            <ItemsControl ItemsSource="{Binding Refusals}" AutomationProperties.Name="Fee refusals">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Fee periods (exact server amounts)" FontWeight="SemiBold" Margin="0,10,0,0" />
            <DataGrid ItemsSource="{Binding Slices}" MaxHeight="220" AutomationProperties.Name="Fee periods">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="220" />
                    <DataGridTextColumn Header="Schedule period" Binding="{Binding Period}" Width="260" />
                    <DataGridTextColumn Header="Declared fee" Binding="{Binding DeclaredFee}" Width="200" />
                    <DataGridTextColumn Header="Share earned" Binding="{Binding Fraction}" Width="300" />
                    <DataGridTextColumn Header="Unrounded fee" Binding="{Binding UnroundedAmount}" Width="260" />
                    <DataGridTextColumn Header="Authority" Binding="{Binding Authority}" Width="420" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Proposed fee journal lines" FontWeight="SemiBold" />
            <DataGrid ItemsSource="{Binding Lines}" MaxHeight="160" AutomationProperties.Name="Proposed fee journal lines">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="300" />
                    <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="90" />
                    <DataGridTextColumn Header="Functional amount" Binding="{Binding Amount}" Width="200" />
                    <DataGridTextColumn Header="Original transaction evidence" Binding="{Binding Original}" Width="320" />
                </DataGrid.Columns>
            </DataGrid>
            <Expander Header="Fee calculation evidence">
                <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Fee evidence" />
            </Expander>
            <Button Content="Create fee draft for review" Command="{Binding CreateDraftCommand}" HorizontalAlignment="Left" Margin="0,10,0,4" />
            <TextBlock Text="The draft enters ordinary journal review in the source book. It is refused if the approved terms, profile, or FX inputs changed after this preview."
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding DraftStatus}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="Fee draft" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
