<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Meridian.ReferenceData</AssemblyName>
    <RootNamespace>Meridian.ReferenceData</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meridian.Contracts\Meridian.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Data-driven reference taxonomies (allowed-value code lists) shared by both Security Master
         validation engines. Embedded so the vocabularies load from data at runtime. -->
    <None Remove="SecurityMaster/Data/security-reference-taxonomies.json" />
    <EmbeddedResource Include="SecurityMaster/Data/security-reference-taxonomies.json" />
  </ItemGroup>
</Project>
