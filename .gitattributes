# Auto detect text files and perform LF normalization
* text=auto

# C# formatting is enforced with LF by .editorconfig and dotnet format.
*.cs text eol=lf

# Vite embeds SVG bytes and transforms HTML; keep generated bundles identical on Windows.
*.svg text eol=lf
src/Meridian.Ui/dashboard/index.html text eol=lf
src/Meridian.Ui/wwwroot/workstation/*.html text eol=lf
src/Meridian.Ui/wwwroot/workstation/assets/*.js text eol=lf
src/Meridian.Ui/wwwroot/workstation/assets/*.css text eol=lf

# Reviewed generated snapshots must be regenerated from merged inputs, not text-merged.
# The built-in binary driver leaves concurrent changes conflicted for the explicit
# generated merge resolver; it never accepts one parent's stale output silently.
docs/roadmap/generated/* merge=binary
docs/source/generated/* merge=binary
docs/generated/repository-structure.md merge=binary
docs/generated/workflow-command-reference.md merge=binary
docs/generated/workflows-overview.md merge=binary
# This is accepted source/README review evidence, not a disposable hash cache.
docs/source/generated/source-hash-manifest.json merge=binary

# Retained visual evidence is stored outside ordinary Git blobs for new revisions.
# Source diagrams (.mmd/.dot/.svg), Markdown and machine-readable manifests remain inspectable.
docs/diagrams/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/testing/evidence/**/*.png filter=lfs diff=lfs merge=lfs -text
