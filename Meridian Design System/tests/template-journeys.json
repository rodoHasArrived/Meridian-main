    "templates/field-formula/FieldFormula.dc.html": {
      "description": "Validate an incomplete formula as an error, then recover a valid AMX field expression without applying a financial change.",
      "steps": [
        {
          "action": "fill",
          "target": {
            "label": "Formula for the selected statement",
            "exact": true
          },
          "value": "NOT_A_REAL_FIELD("
        },
        {
          "action": "assertVisible",
          "target": {
            "text": "error",
            "exact": true
          }
        },
        {
          "action": "fill",
          "target": {
            "label": "Formula for the selected statement",
            "exact": true
          },
          "value": "Let audit_yield = YTM(cusip)"
        },
        {
          "action": "assertVisible",
          "target": {
            "text": "valid",
            "exact": true,
            "index": 0
          }
        }
      ],
      "failureStates": [
        "loading",
        "empty",
        "error"
      ]
    },
