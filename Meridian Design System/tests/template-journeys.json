{
  "schemaVersion": 1,
  "note": "Concrete primary journeys run against authored synthetic DC entries. Read-only reports/walls assert meaningful financial and failure disclosures; no recipe certifies a live backend. Loading/empty/error/retry, appearance, keyboard and accessibility checks are executed separately by the browser harness.",
  "entries": {
    "templates/accounting-workstation/AccountingWorkstation.dc.html": {
      "description": "Read trial balance, switch to the General Ledger and retain explicit view state without posting.",
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "tab",
            "name": "Trial Balance",
            "exact": true
          }
        },
        {
          "action": "assertAttribute",
          "target": {
            "role": "tab",
            "name": "Trial Balance",
            "exact": true
          },
          "attribute": "aria-selected",
          "value": "true"
        },
        {
          "action": "click",
          "target": {
            "role": "tab",
            "name": "General Ledger",
            "exact": true
          }
        },
        {
          "action": "assertAttribute",
          "target": {
            "role": "tab",
            "name": "General Ledger",
            "exact": true
          },
          "attribute": "aria-selected",
          "value": "true"
        },
        {
          "action": "assertText",
          "target": {
            "css": "body"
          },
          "contains": "JE-1042"
        }
      ],
      "failureStates": [
        "loading",
        "empty",
        "error"
      ]
    },
    "templates/adapter-operations/AdapterOperations.dc.html": {
      "description": "Select the exhausted posting adapter and inspect its verbatim authentication failure and missing retry schedule.",
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "button",
          "name": "Posting export",
            "exact": false
          }
        },
        {
          "action": "assertVisible",
          "target": {
            "role": "group",
            "name": "Posting export \u2014 diagnostics",
            "exact": true
          }
        },
        {
          "action": "assertText",
          "target": {
            "css": "body"
          },
          "contains": "AUTH-401"
        },
        {
          "action": "assertText",
          "target": {
            "css": "body"
          },
          "contains": "no next attempt scheduled"
        }
      ],
      "failureStates": [
        "loading",
        "empty",
        "error"
      ]
    },
    "templates/alerting-workstation/AlertingWorkstation.dc.html": {
      "description": "Search the alert queue to an actual empty result, then clear filters and recover the populated queue.",
      "steps": [
        {
          "action": "fill",
          "target": {
            "css": "input[placeholder=\"Search rule, scope, id\u2026\"]"
          },
          "value": "no-such-alert-3501"
        },
        {
          "action": "assertVisible",
          "target": {
            "text": "No alerts match",
            "exact": true
          }
        },
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "Clear filters",
            "exact": true
          }
        },
        {
          "action": "assertValue",
          "target": {
            "css": "input[placeholder=\"Search rule, scope, id\u2026\"]"
          },
          "value": ""
        },
        {
          "action": "assertVisible",
          "target": {
            "role": "heading",
            "name": "Alerts",
            "exact": true
          }
        }
      ],
      "failureStates": [
        "loading",
        "empty",
        "error"
      ]
    },
    "templates/alm-review/AlmReview.dc.html": {
