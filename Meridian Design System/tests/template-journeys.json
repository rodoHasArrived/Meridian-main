        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "Open resolution",
            "exact": true
          }
        },
        {
          "action": "assertCount",
          "target": {
            "css": ".cm-overlay:visible"
          },
          "count": 1
        },
        {
          "action": "assertText",
          "target": {
            "css": ".cm-overlay:visible"
          },
          "contains": "Price approval C-118 failed validation"
        },
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "Back to close",
            "exact": true
          }
        },
        {
          "action": "assertCount",
          "target": {
            "css": ".cm-overlay:visible"
          },
          "count": 0
        }
      ],
      "failureStates": [
        "loading",
        "empty",
        "error"
      ]
