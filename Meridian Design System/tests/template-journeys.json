    "templates/close-management/CloseManagement.dc.html": {
      "description": "Inspect task owners and downstream blocked controls without inventing an assignment transport.",
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "Owners",
            "exact": true
