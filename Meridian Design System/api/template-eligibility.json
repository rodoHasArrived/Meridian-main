  },
  "exemptionReasons": {
    "no-analytical-context": "No entity, book, basis, period, scenario or currency scope changes the data or its meaning on this screen.",
    "filters-not-context": "The controls here are query filters over a fixed corpus, not an analytical context that changes what a value means.",
    "single-surface": "Selection stays inside one isolated widget; no second plane responds to it.",
    "static-content": "Content is first-load-only or local; there is no remote evidence with a useful last-known-good state.",
    "no-visualization": "No visualization on this screen supports interpretation, comparison, export or a decision.",
    "no-reference-line": "No zero, target, prior period, tolerance or parity reference carries analytical meaning here.",
    "single-time-role": "One unambiguous timestamp; no two time roles can disagree.",
    "no-active-object": "A list, wall or form with no single identifiable financial object in play.",
    "unguarded-edit": "No consequential action with ordered prerequisites.",
    "cannot-fail": "No action here can be blocked by policy, period, authority or evidence.",
    "not-configurable": "Modules are permanent sections, not genuinely movable, resizable or replaceable."
  },
