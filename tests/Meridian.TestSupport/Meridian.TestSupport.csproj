<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test-support library. Hosts the container-or-external-connection PostgreSQL
    bootstrap that individual Meridian test assemblies previously hand-rolled. Referenced
    by both Meridian.Tests and Meridian.DirectLending.Tests. Not a test project itself.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
