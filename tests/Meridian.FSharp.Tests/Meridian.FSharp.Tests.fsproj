<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AssemblyName>Meridian.FSharp.Tests</AssemblyName>
    <RootNamespace>Meridian.FSharp.Tests</RootNamespace>
    <FSharpTestSlice Condition="'$(FSharpTestSlice)' == ''">All</FSharpTestSlice>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DomainTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Domain'" />
    <Compile Include="ValidationTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Domain'" />
    <Compile Include="CalculationTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'MarketData'" />
    <Compile Include="CanonicalizationTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Domain'" />
    <Compile Include="PipelineTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'MarketData'" />
    <Compile Include="RiskPolicyTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Domain'" />
    <Compile Include="PromotionPolicyTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Domain'" />
    <Compile Include="OperationsContinuityRulesTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Operations'" />
    <Compile Include="ReportPackValidationRulesTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Operations'" />
    <Compile Include="SensitiveActionPolicyTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Operations'" />
    <Compile Include="TradingReadinessRulesTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Operations' Or '$(FSharpTestSlice)' == 'Trading'" />
    <Compile Include="TradingTransitionTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Operations' Or '$(FSharpTestSlice)' == 'Trading'" />
    <Compile Include="LedgerKernelTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Ledger'" />
    <Compile Include="ReconciliationCaseWorkflowTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Ledger'" />
    <Compile Include="PeriodManagementTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Ledger'" />
    <Compile Include="DeterministicInvariantTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'Ledger' Or '$(FSharpTestSlice)' == 'Operations'" />
    <Compile Include="DirectLendingInteropTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'DirectLending'" />
    <Compile Include="CashFlowProjectorTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'DirectLending'" />
    <Compile Include="SettlementInstructionCommandsTests.fs" Condition="'$(FSharpTestSlice)' == 'All' Or '$(FSharpTestSlice)' == 'DirectLending'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsCheck.Xunit" />
    <!-- FsUnit.xUnit brings xunit.v3; keep the central pin aligned with the VS adapter. -->
    <PackageReference Include="FsUnit.xUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meridian.Backtesting.Sdk\Meridian.Backtesting.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Contracts\Meridian.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Execution.Sdk\Meridian.Execution.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Meridian.FSharp\Meridian.FSharp.fsproj" />
    <ProjectReference Include="..\..\src\Meridian.Identity\Meridian.Identity.csproj" />
    <ProjectReference Include="..\..\src\Meridian.FSharp.DirectLending.Aggregates\Meridian.FSharp.DirectLending.Aggregates.fsproj" />
    <ProjectReference Include="..\..\src\Meridian.FSharp.Trading\Meridian.FSharp.Trading.fsproj" />
    <ProjectReference Include="..\..\src\Meridian.FSharp.Ledger\Meridian.FSharp.Ledger.fsproj" />
    <ProjectReference Include="..\..\src\Meridian.Ledger\Meridian.Ledger.csproj" />
  </ItemGroup>
</Project>
