  "partialCatchUpWaterfall": {
    "id": "european-waterfall-80-percent-catchup",
    "narrative": "Single 12,000,000 distribution on a 10,000,000 fund with an 800,000 pref, 20% carry, and an 80% catch-up: the catch-up pool solves to 0.2 x 800,000 / (0.8 - 0.2) = 266,666.67, of which the GP takes 80% (213,333.34) and LPs 20% (53,333.33); the 933,333.33 residual splits 20/80 (186,666.67 GP / 746,666.66 LP). The one-cent GP overshoot against the ideal 400,000.00 is the documented pool-rounding drift.",
    "carryRate": 0.20,
    "catchUpRate": 0.80,
    "contributedCapital": 10000000,
    "preferredReturnAccrued": 800000,
    "amountToDistribute": 12000000,
    "expected": {
      "returnOfCapital": 10000000,
      "preferredReturn": 800000,
      "gpCatchUp": 213333.34,
      "lpCatchUp": 53333.33,
      "lpCarry": 746666.66,
      "gpCarry": 186666.67,
      "lpTotal": 11599999.99,
      "gpTotal": 400000.01
    }
  },
