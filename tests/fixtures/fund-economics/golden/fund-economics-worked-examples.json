    "openingHighWaterMark": 10000000,
    "periods": [
      {
        "id": "p1-accrue-only",
        "endingNavBeforeFee": 11000000,
        "hurdleAmount": 200000,
        "crystallize": false,
        "expected": {
          "grossProfit": 1000000,
          "feeBase": 800000,
          "performanceFee": 160000.00,
          "crystallizedFee": 0.00,
          "newHighWaterMark": 10000000
        }
      },
      {
        "id": "p2-crystallize-lower-nav",
        "endingNavBeforeFee": 10500000,
        "hurdleAmount": 200000,
        "crystallize": true,
        "expected": {
          "grossProfit": 500000,
          "feeBase": 300000,
          "performanceFee": 60000.00,
          "crystallizedFee": 60000.00,
          "newHighWaterMark": 10440000
        }
      },
      {
        "id": "p3-under-water",
        "endingNavBeforeFee": 10400000,
        "hurdleAmount": 200000,
        "crystallize": true,
        "expected": {
          "grossProfit": 0,
          "feeBase": 0,
          "performanceFee": 0.00,
          "crystallizedFee": 0.00,
          "newHighWaterMark": 10440000
        }
      },
      {
        "id": "p4-recover-and-crystallize",
        "endingNavBeforeFee": 11240000,
        "hurdleAmount": 200000,
        "crystallize": true,
        "expected": {
          "grossProfit": 800000,
          "feeBase": 600000,
          "performanceFee": 120000.00,
          "crystallizedFee": 120000.00,
          "newHighWaterMark": 11120000
        }
      }
    ]
  },
  "waterfallSeries": {
    "id": "european-waterfall-8-pref-20-carry-full-catchup",
    "narrative": "A 10,000,000 fund distributing 14,000,000 across three distributions under a European waterfall with an 800,000 accrued preferred return, 20% carry, and a 100% GP catch-up. Distribution 1 is a partial return of capital; distribution 2 completes capital, pays the full pref, solves the catch-up pool (0.2 x 800,000 / 0.8 = 200,000), and splits residual carry; distribution 3 is pure carried interest. Cumulatively the GP receives exactly 20% of the 4,000,000 profit above contributed capital.",
