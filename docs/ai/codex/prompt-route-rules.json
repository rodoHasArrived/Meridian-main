{
  "schemaVersion": 2,
  "confidenceThreshold": 0.55,
  "defaultRoute": {
    "lane": "orient",
    "skill": "meridian-repo-navigation",
    "fallbackSkill": "meridian-repo-navigation",
    "mode": "Lightweight",
    "modelRouteId": "analysis-economy",
    "rationale": "Default to orientation when the prompt does not strongly match a specialist lane.",
    "validationFloor": [
      "python build/scripts/docs/check-ai-navigation-freshness.py --max-age-days 14"
    ],
    "validationScripts": [
      "prompt-route-linter"
    ],
    "requiredTelemetry": [
      "route_id",
      "handoff_path"
    ],
    "escalationTriggers": [
      "matched route confidence below confidenceThreshold",
      "task expands beyond orientation"
    ]
  },
  "rules": [
    {
      "id": "review-findings-first",
      "description": "Route review and audit requests to findings-first review lane.",
      "matchWeighted": {
        "review": 2.5,
        "audit": 2.0,
        "regression": 2.0,
        "risk scan": 1.5,
        "code review": 2.5
      },
      "route": {
        "lane": "review",
        "skill": "meridian-code-review",
        "mode": "Standard",
        "modelRouteId": "implementation-balanced",
        "rationale": "Review requests should prioritize bug/risk findings and architecture drift.",
        "validationFloor": [
          "git diff --check"
        ],
        "validationScripts": [
          "prompt-route-linter"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "handoff_path"
        ],
        "escalationTriggers": [
          "review spans multiple lanes",
          "validation failure changes risk assessment"
        ]
      }
    },
    {
      "id": "architecture-boundary",
      "description": "Route architecture conformance, module-boundary, and dependency-map requests to the code architecture lane.",
      "matchWeighted": {
        "architecture": 2.5,
        "module architecture": 2.5,
        "module boundary": 2.5,
        "boundary drift": 3.0,
        "dependency map": 2.0,
        "adr": 1.5,
        "source-doc": 1.5,
        "layer violation": 2.0
      },
      "route": {
        "lane": "architecture",
        "skill": "meridian-code-architecture",
        "mode": "Standard",
        "modelRouteId": "implementation-balanced",
        "rationale": "Architecture prompts need module-map, source-doc, ADR, and dependency evidence before implementation or review.",
        "validationFloor": [
          "python .codex/skills/meridian-code-architecture/scripts/architecture_surface.py --path <path> --summary",
          "python build/scripts/docs/check-codex-skills.py --summary"
        ],
        "validationScripts": [
          "prompt-route-linter",
          "architecture-surface",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "handoff_path"
        ],
        "escalationTriggers": [
          "architecture assessment changes shared contracts",
          "dependency evidence shows layer violation",
          "source-doc or ADR alignment is missing"
        ]
      }
    },
    {
      "id": "contract-governance",
      "description": "Route DTO, API route, provider interface, and shared read-model impact requests to contract governance.",
      "matchWeighted": {
        "contract": 2.5,
        "dto": 2.0,
        "api route": 2.0,
        "read model": 2.0,
        "provider interface": 2.0,
        "contract impact": 3.0,
        "shared payload": 2.0,
        "compatibility": 1.5
      },
      "route": {
        "lane": "contract-governance",
        "skill": "meridian-contract-governance",
        "mode": "Standard",
        "modelRouteId": "implementation-balanced",
        "rationale": "Shared contract prompts must trace services, browser, WPF, tests, docs, and compatibility before implementation.",
        "validationFloor": [
          "python .codex/skills/meridian-contract-governance/scripts/contract_impact.py --path <path> --summary",
          "python build/scripts/docs/check-codex-skills.py --summary"
        ],
        "validationScripts": [
          "prompt-route-linter",
          "contract-impact",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "handoff_path"
        ],
        "escalationTriggers": [
          "contract change is breaking or removal",
          "browser and WPF consumers diverge",
          "consumer tests or docs are missing"
        ]
      }
    },
    {
      "id": "brainstorm-ideation",
      "description": "Route open-ended ideas, quick wins, product bets, and opportunity exploration to the brainstorm lane.",
      "matchWeighted": {
        "brainstorm": 3.0,
        "ideas": 2.0,
        "quick wins": 2.5,
        "product bets": 2.0,
        "what should we build": 2.5,
        "opportunities": 1.5,
        "ux improvements": 1.5,
        "technical debt ideas": 1.5
      },
      "route": {
        "lane": "ideate",
        "skill": "meridian-brainstorm",
        "mode": "Lightweight",
        "modelRouteId": "analysis-economy",
        "rationale": "Ideation prompts should produce Meridian-grounded options, not implementation specs.",
        "validationFloor": [
          "python .codex/skills/meridian-brainstorm/scripts/brainstorm_output_check.py --sample receipt-table --summary"
        ],
        "validationScripts": [
          "prompt-route-linter",
          "brainstorm-output-check",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "handoff_path"
        ],
        "escalationTriggers": [
          "user selects one idea for implementation design",
          "ideas need committed roadmap sequencing",
          "persona critique is required before selection"
        ]
      }
    },
    {
      "id": "codex-skill-builder",
      "description": "Route Codex skill package, eval, script, metadata, profile, and route coverage work to the skill builder lane.",
      "matchWeighted": {
        "codex skill": 3.0,
        "skill package": 2.5,
        "openai.yaml": 2.0,
        "skill eval": 2.5,
        "run_evals.py": 2.0,
        "agent profile": 1.5,
        "prompt-route": 1.5,
        "skill_script_advisor": 2.0
      },
      "route": {
        "lane": "codex-skill-builder",
        "skill": "meridian-codex-skill-builder",
        "mode": "Standard",
        "modelRouteId": "implementation-balanced",
        "rationale": "Codex skill package work must keep SKILL.md, metadata, scripts, evals, profiles, catalogs, and route rules aligned.",
        "validationFloor": [
          "python .codex/skills/meridian-codex-skill-builder/scripts/skill_package_audit.py --skill <skill> --summary",
          "python build/scripts/docs/check-codex-skills.py --summary",
          "python build/scripts/docs/check-ai-inventory.py --summary"
        ],
        "validationScripts": [
          "prompt-route-linter",
          "skill-package-audit",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "handoff_path"
        ],
        "escalationTriggers": [
          "skill behavior is shared across hosts",
          "eval or script helper changes deterministic validation",
          "catalog or route coverage is incomplete"
        ]
      }
    },
    {
      "id": "docs-maintenance",
      "description": "Route docs/index updates to the docs lane.",
      "matchWeighted": {
        "docs": 1.2,
        "documentation": 2.0,
        "readme": 2.0,
        "guide": 1.5,
        "index": 1.1
      },
      "route": {
        "lane": "docs",
        "skill": "meridian-docs",
        "mode": "Lightweight",
        "modelRouteId": "analysis-economy",
        "rationale": "Docs updates should stay in canonical audience paths with minimal proof.",
        "validationFloor": [
          "git diff --check",
          "python build/scripts/docs/check-ai-inventory.py --summary",
          "python build/scripts/docs/check-ai-handoff.py --strict"
        ],
        "validationScripts": [
          "check-ai-handoff-strict",
          "prompt-route-linter",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "handoff_path"
        ],
        "escalationTriggers": [
          "docs change touches shared AI policy",
          "docs change spans Codex and shared host guidance",
          "required validation script fails"
        ]
      }
    },
    {
      "id": "browser-workstation",
      "description": "Route TypeScript/React workstation work to browser lane.",
      "matchWeighted": {
        "dashboard": 2.0,
        "react": 2.0,
        "typescript": 2.0,
        "browser workstation": 2.5,
        "workstation ui": 1.5
      },
      "route": {
        "lane": "browser",
        "skill": "meridian-browser-workstation",
        "mode": "Standard",
        "modelRouteId": "implementation-balanced",
        "rationale": "Browser workstation requests should use dashboard-specific skill and tests.",
        "validationFloor": [
          "npm --prefix src/Meridian.Ui/dashboard run test",
          "npm --prefix src/Meridian.Ui/dashboard run build"
        ],
        "validationScripts": [
          "prompt-route-linter",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "handoff_path"
        ],
        "escalationTriggers": [
          "browser change touches shared API contracts",
          "dashboard test or build fails"
        ]
      }
    },
    {
      "id": "desktop-wpf",
      "description": "Route WPF MVVM and desktop shell requests to desktop lane.",
      "matchWeighted": {
        "wpf": 2.5,
        "desktop": 1.5,
        "xaml": 2.0,
        "viewmodel": 1.5,
        "shell route": 1.5
      },
      "route": {
        "lane": "desktop",
        "skill": "modular-desktop-mvvm",
        "mode": "Standard",
        "modelRouteId": "implementation-balanced",
        "rationale": "Desktop tasks should respect MVVM boundaries and focused WPF proof.",
        "validationFloor": [
          "dotnet test tests/Meridian.Wpf.Tests/Meridian.Wpf.Tests.csproj --filter \"FullyQualifiedName~<TouchedViewModelOrRoute>\" /p:EnableWindowsTargeting=true /p:EnableFullWpfBuild=true"
        ],
        "validationScripts": [
          "prompt-route-linter",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "handoff_path"
        ],
        "escalationTriggers": [
          "desktop change touches shared service contracts",
          "focused WPF validation fails"
        ]
      }
    },
    {
      "id": "provider-integration",
      "description": "Route provider adapter/integration requests to provider lane.",
      "matchWeighted": {
        "provider": 2.0,
        "adapter": 1.5,
        "alpaca": 2.0,
        "interactive brokers": 2.0,
        "market data client": 2.0
      },
      "route": {
        "lane": "provider",
        "skill": "meridian-provider-builder",
        "mode": "Deep Review",
        "modelRouteId": "governance-research",
        "rationale": "Provider changes need adapter-specific validation, telemetry capture, and readiness evidence.",
        "validationFloor": [
          "dotnet test tests/Meridian.Tests/Meridian.Tests.csproj --filter \"FullyQualifiedName~Provider\""
        ],
        "validationScripts": [
          "prompt-route-linter",
          "handoff-packet-generator",
          "check-handoff-packet-schema"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "input_tokens",
          "output_tokens",
          "estimated_cost_usd",
          "latency_ms",
          "handoff_path"
        ],
        "escalationTriggers": [
          "provider credentials or failover behavior changes",
          "provider validation fails",
          "policy exception requires wider context"
        ]
      }
    },
    {
      "id": "tests-and-coverage",
      "description": "Route requests focused on new tests or coverage to test lane.",
      "matchWeighted": {
        "write tests": 2.5,
        "unit test": 2.0,
        "coverage": 1.5,
        "regression test": 2.0,
        "test gap": 1.5
      },
      "route": {
        "lane": "test",
        "skill": "meridian-test-writer",
        "mode": "Standard",
        "modelRouteId": "implementation-balanced",
        "rationale": "Test-specific requests should use scenario-first test authoring lane.",
        "validationFloor": [
          "dotnet test <touched test project>"
        ],
        "validationScripts": [
          "prompt-route-linter",
          "handoff-packet-generator"
        ],
        "requiredTelemetry": [
          "route_id",
          "selected_model",
          "handoff_path"
        ],
        "escalationTriggers": [
          "test coverage crosses multiple source modules",
          "focused test validation fails"
        ]
      }
    }
  ]
}
