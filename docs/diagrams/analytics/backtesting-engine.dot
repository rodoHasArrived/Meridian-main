// Backtesting Engine Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Backtesting is a supporting evidence workflow. Backtesting Studio is planned
// and should follow current source and roadmap evidence.

digraph BacktestingEngine {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Backtesting Engine\nEvidence-linked replay support";

  subgraph cluster_inputs {
    label="Replay inputs";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    DATA [shape=cylinder, fillcolor="#93c5fd",
      label="Retained market data\nJSONL / Parquet,\nsource lineage,\nquality posture"];
    STRATEGY [fillcolor="#bfdbfe",
      label="Strategy assembly and parameters\nSDK lifecycle,\nassumptions, universe"];
    LEDGER_CONTEXT [fillcolor="#bfdbfe",
      label="Portfolio and ledger context\nstarting state,\nfees, cash assumptions"];
  }

  subgraph cluster_engine {
    label="Replay engine";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    UNIVERSE [fillcolor="#ddd6fe",
      label="Universe discovery\ncoverage and gap checks"];
    MERGE [fillcolor="#ddd6fe",
      label="Chronological merge\nper-symbol streams,\nsimulation clock"];
    ENGINE [fillcolor="#c4b5fd",
      label="BacktestEngine\nstrategy callbacks,\nfill simulation,\nday-end processing"];
    METRICS [fillcolor="#c4b5fd",
      label="Metrics engine\nreturns, drawdown,\nrisk, trade evidence"];
  }

  subgraph cluster_outputs {
    label="Operational evidence outputs";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    RUN_RECORD [shape=cylinder, fillcolor="#9ae6b4",
      label="Run evidence\ninputs, code version,\nmetrics, fills, lineage"];
    PAPER_CANDIDATE [fillcolor="#38a169", fontcolor="white",
      label="Paper-session candidate\nrequires operator review\nand approval"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed report evidence\nstrategy summary,\nreadiness package"];
  }

  subgraph cluster_deferred {
    label="Deferred productization";
    color="#718096";
    style="dashed";
    bgcolor="#edf2f7";

    STUDIO [fillcolor="#e2e8f0",
      label="Backtesting Studio\nplanned;\nroadmap-evidence guided"];
    LIVE [fillcolor="#e2e8f0",
      label="Live promotion\nfuture gated path,\nnot direct output"];
  }

  DATA -> UNIVERSE;
  STRATEGY -> ENGINE;
  LEDGER_CONTEXT -> ENGINE;
  UNIVERSE -> MERGE;
  MERGE -> ENGINE;
  ENGINE -> METRICS;
  METRICS -> RUN_RECORD;
  RUN_RECORD -> PAPER_CANDIDATE;
  RUN_RECORD -> REPORTS;
  STUDIO -> ENGINE [style=dashed];
  LIVE -> PAPER_CANDIDATE [style=dashed, label="requires governance"];
}
