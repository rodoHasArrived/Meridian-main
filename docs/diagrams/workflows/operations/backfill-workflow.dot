// Backfill Workflow Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Backfill is provider-backed evidence acquisition for trusted operational
// records, not a standalone data-export workflow.

digraph BackfillWorkflow {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Backfill Workflow\nProvider-backed historical evidence acquisition";

  subgraph cluster_request {
    label="Operator request";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    WORKSTATION [fillcolor="#c4b5fd",
      label="Data / Settings workstation\nprovider, symbols,\ndate range, purpose"];
    CLI [fillcolor="#ddd6fe",
      label="CLI command\n--backfill, provider,\nsymbols, from/to"];
    VALIDATE [fillcolor="#ddd6fe",
      label="Request validation\nscope, credentials,\nprovider readiness"];
  }

  subgraph cluster_provider {
    label="Provider acquisition";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    COORD [fillcolor="#93c5fd",
      label="BackfillCoordinator\ncoverage check,\npartitioning, checkpoints"];
    COMPOSITE [fillcolor="#93c5fd",
      label="CompositeHistoricalDataProvider\npriority order,\nfallback, health exclusion"];
    RATE [fillcolor="#bfdbfe",
      label="Rate-limit and retry controls\nprovider pacing,\n429 backoff,\ncircuit breaker"];
    RAW [shape=cylinder, fillcolor="#bfdbfe",
      label="Raw provider response\nretained source payload\nand request metadata"];
  }

  subgraph cluster_quality {
    label="Trust checks";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    NORMALIZE [fillcolor="#a7f3d0",
      label="Normalize bars/events\ncanonical time,\nsymbol mapping,\nsource attribution"];
    GAP [fillcolor="#9ae6b4",
      label="Gap and quality detection\ncoverage, stale data,\nprice/volume checks"];
    REVIEW [fillcolor="#fecaca",
      label="Review-required state\nunsupported source,\nmissing range, failed quality"];
  }

  subgraph cluster_record {
    label="Record handoff";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    STORAGE [shape=cylinder, fillcolor="#fc8181",
      label="WAL + JSONL + Parquet\nretained evidence,\nlineage, replay"];
    CATALOG [fillcolor="#fecaca",
      label="StorageCatalogService\ncoverage and gap inventory"];
    RECON [fillcolor="#38a169", fontcolor="white",
      label="Data confidence / reconciliation\ntrusted input to operational records"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed publication\ncoverage evidence,\nreport-pack lineage"];
  }

  WORKSTATION -> VALIDATE;
  CLI -> VALIDATE;
  VALIDATE -> COORD;
  COORD -> COMPOSITE;
  COMPOSITE -> RATE;
  RATE -> RAW;
  RAW -> NORMALIZE;
  NORMALIZE -> GAP;
  GAP -> STORAGE [label="accepted"];
  GAP -> REVIEW [label="blocked"];
  REVIEW -> COORD [style=dashed, label="operator repair"];
  STORAGE -> CATALOG;
  CATALOG -> RECON;
  RECON -> REPORTS;
}
