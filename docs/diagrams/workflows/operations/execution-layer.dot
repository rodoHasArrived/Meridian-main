// Execution Layer Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Execution is represented as paper-first order evidence. Live execution is
// not the active product stance.

digraph ExecutionLayer {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Execution Layer\nPaper-first order evidence and governance";

  subgraph cluster_request {
    label="Order intent";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    WORKSTATION [fillcolor="#c4b5fd",
      label="Trading / Strategy workstation\noperator intent,\npaper readiness workflow"];
    ORDER_MODEL [fillcolor="#ddd6fe",
      label="Order model\nsymbol, side, quantity,\norder type, time in force"];
    RISK [fillcolor="#ddd6fe",
      label="Risk validation\nlimits, portfolio state,\nmateriality"];
  }

  subgraph cluster_paper {
    label="Paper execution";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    GATEWAY [fillcolor="#38a169", fontcolor="white",
      label="PaperTradingGateway\nsimulated fills,\nno capital movement"];
    LIFECYCLE [fillcolor="#9ae6b4",
      label="Order lifecycle\nsubmitted, acknowledged,\nfilled, cancelled, rejected"];
    SESSION [shape=cylinder, fillcolor="#a7f3d0",
      label="Paper session evidence\norders, fills, continuity,\noperator decisions"];
  }

  subgraph cluster_record {
    label="Operational record handoff";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    LEDGER [fillcolor="#e53e3e", fontcolor="white",
      label="Ledger impact review\npositions, cash, P&L,\naccounting evidence"];
    RECON [fillcolor="#fecaca",
      label="Reconciliation\nexpected vs actual,\nsource-backed status"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed reports\nreadiness and trading evidence"];
  }

  subgraph cluster_deferred {
    label="Deferred live path";
    color="#718096";
    style="dashed";
    bgcolor="#edf2f7";

    LIVE_GATEWAY [fillcolor="#e2e8f0",
      label="Brokerage gateways\nlive execution support remains\ngated by governance,\nreadiness, and approvals"];
  }

  WORKSTATION -> ORDER_MODEL;
  ORDER_MODEL -> RISK;
  RISK -> GATEWAY [label="approved for paper"];
  GATEWAY -> LIFECYCLE;
  LIFECYCLE -> SESSION;
  SESSION -> LEDGER;
  SESSION -> RECON;
  LEDGER -> REPORTS;
  RECON -> REPORTS;
  LIVE_GATEWAY -> RISK [style=dashed, label="future gated"];
}
