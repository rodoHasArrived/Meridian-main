// Event Pipeline Sequence Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// The pipeline is shown as durable source-evidence movement into trusted
// operational records.

digraph EventPipelineSequence {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", splines=ortho, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Event Pipeline Sequence\nDurable evidence flow for operational records";

  subgraph cluster_source {
    label="1. Source evidence";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    SOURCE [fillcolor="#93c5fd",
      label="Provider or import source\nmarket data, bank/custody,\nfund-admin files, documents"];
    RAW [shape=note, fillcolor="#bfdbfe",
      label="Raw source payload\nrequest metadata,\nprovider identity,\nchecksum candidate"];
  }

  subgraph cluster_normalize {
    label="2. Normalize and validate";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    ADAPTER [fillcolor="#a7f3d0",
      label="Adapter/client\nmaps provider shape\nto Meridian contracts"];
    VALIDATOR [fillcolor="#9ae6b4",
      label="Validation and confidence\nschema, freshness,\nsequence, quality checks"];
    BLOCKED [fillcolor="#fecaca",
      label="Review-required state\nmissing/stale/invalid evidence"];
  }

  subgraph cluster_pipeline {
    label="3. Durable pipeline";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    CHANNEL [fillcolor="#ddd6fe",
      label="EventPipeline\nbounded channel,\nbackpressure,\nproducer/consumer flow"];
    DEDUP [fillcolor="#c4b5fd",
      label="Dedup and integrity\nsequence checks,\nidempotency, gap events"];
    WAL [shape=cylinder, fillcolor="#fc8181",
      label="WriteAheadLog\ncrash-safe append,\nchecksum validation"];
    STORAGE [shape=cylinder, fillcolor="#fbd38d",
      label="JSONL / Parquet storage\nretained evidence,\nreplay and lineage"];
  }

  subgraph cluster_consumers {
    label="4. Operational consumers";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    RECON [fillcolor="#fecaca",
      label="Reconciliation and investigation\nbreak queues,\nsource-to-source checks"];
    LEDGER [fillcolor="#e53e3e", fontcolor="white",
      label="Accounting records\njournals, adjustments,\nledger evidence"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed reports\nfrozen snapshots,\npublication lineage"];
    AUDIT [shape=cylinder, fillcolor="#fc8181",
      label="Audit trail\npayload -> event -> record -> report"];
  }

  SOURCE -> RAW;
  RAW -> ADAPTER;
  ADAPTER -> VALIDATOR;
  VALIDATOR -> BLOCKED [label="not trusted"];
  VALIDATOR -> CHANNEL [label="trusted"];
  CHANNEL -> DEDUP;
  DEDUP -> WAL;
  WAL -> STORAGE;
  STORAGE -> RECON;
  RECON -> LEDGER;
  LEDGER -> REPORTS;
  RAW -> AUDIT [style=dashed];
  WAL -> AUDIT [style=dashed];
  RECON -> AUDIT [style=dashed];
  REPORTS -> AUDIT [style=dashed];
}
