// Strategy Lifecycle Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Strategy work remains useful when it feeds retained evidence, paper
// readiness, approvals, accounting records, or governed reports.

digraph StrategyLifecycle {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Strategy Lifecycle\nPaper-first, evidence-linked strategy governance";

  subgraph cluster_inputs {
    label="Evidence inputs";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    DATA [fillcolor="#93c5fd",
      label="Trusted data baseline\nretained source evidence,\nquality posture, lineage"];
    STRATEGY [fillcolor="#bfdbfe",
      label="Strategy definition\nSDK, QuantScript,\nparameters, assumptions"];
    RISK [fillcolor="#bfdbfe",
      label="Risk and accounting context\nlimits, portfolio state,\nledger impact"];
  }

  subgraph cluster_validation {
    label="Validation path";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    BACKTEST [fillcolor="#ddd6fe",
      label="Backtest support\nreplay and metrics\nsupporting evidence only"];
    PAPER [fillcolor="#c4b5fd",
      label="Paper session\nsimulated fills,\ncontinuity evidence,\noperator review"];
    READINESS [fillcolor="#c4b5fd",
      label="Readiness decision\nquality, risk, reconciliation,\napproval gates"];
  }

  subgraph cluster_record {
    label="Operational record handoff";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    EVIDENCE [shape=cylinder, fillcolor="#9ae6b4",
      label="Strategy evidence package\nrun lineage, assumptions,\nmetrics, paper orders"];
    APPROVAL [fillcolor="#38a169", fontcolor="white",
      label="Approval workflow\npromotion candidate,\noperator sign-off"];
    LEDGER [fillcolor="#2c7a7b", fontcolor="white",
      label="Accounting and ledger handoff\nfills, positions,\nP&L evidence"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed reporting\nstrategy summaries,\nreadiness evidence"];
  }

  subgraph cluster_deferred {
    label="Deferred";
    color="#718096";
    style="dashed";
    bgcolor="#edf2f7";

    LIVE [fillcolor="#e2e8f0",
      label="Broker-connected execution productization\nplanned;\nrequires explicit governance\nand supporting evidence"];
    STUDIO [fillcolor="#e2e8f0",
      label="Backtesting Studio\nplanned;\nroadmap-evidence guided"];
  }

  DATA -> BACKTEST;
  STRATEGY -> BACKTEST;
  RISK -> BACKTEST;
  BACKTEST -> PAPER [label="candidate"];
  PAPER -> READINESS;
  READINESS -> EVIDENCE;
  EVIDENCE -> APPROVAL;
  APPROVAL -> LEDGER;
  APPROVAL -> REPORTS;
  LIVE -> APPROVAL [style=dashed, label="future gated"];
  STUDIO -> BACKTEST [style=dashed, label="future surface"];
}
