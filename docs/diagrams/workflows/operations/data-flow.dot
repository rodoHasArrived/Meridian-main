// Operational Record Data Flow Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram shows the W1-W5 flow from source evidence to governed reports.

digraph DataFlow {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Operational Record Data Flow\nImport -> Validate -> Reconcile -> Investigate -> Approve -> Report";

  subgraph cluster_sources {
    label="Source evidence";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    PROVIDERS [fillcolor="#93c5fd",
      label="Provider feeds\ncustodian, broker, bank,\nmarket data, fund admin"];
    DOCUMENTS [fillcolor="#bfdbfe",
      label="Documents and uploads\nstatements, contracts,\nPDFs, source manifests"];
    ACCOUNTING [fillcolor="#bfdbfe",
      label="External GL/accounting systems\nread-only evidence and\nreconciliation signals"];
  }

  subgraph cluster_acquisition {
    label="Acquisition and retention";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    IMPORT_RUN [fillcolor="#ddd6fe",
      label="Provider-backed import run\nconnection, dataset,\noperator evidence"];
    RAW_EVIDENCE [shape=cylinder, fillcolor="#c4b5fd",
      label="Raw source evidence\npreserved exactly as received"];
    LINEAGE [fillcolor="#e9d5ff",
      label="Lineage manifest\nsource payload, checksum,\noperator, time, route"];
  }

  subgraph cluster_validation {
    label="Trust and review gates";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    NORMALIZE [fillcolor="#a7f3d0",
      label="Normalize records\ntransactions, positions,\ncash, prices, terms"];
    CONFIDENCE [fillcolor="#9ae6b4",
      label="Data confidence\nfreshness, completeness,\nvalidity, mapping"];
    BLOCKED [fillcolor="#fecaca",
      label="Review-required state\nmissing, stale, unsupported,\nor conflicting evidence"];
    RECON [fillcolor="#38a169", fontcolor="white",
      label="Reconciliation cases\nsource-to-source,\nexpected-to-actual,\ninternal-to-official"];
    APPROVAL [fillcolor="#38a169", fontcolor="white",
      label="Approval workflow\nmateriality, sign-off,\noverride evidence"];
  }

  subgraph cluster_records {
    label="Approved operational record";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    SYSTEM_RECORD [shape=cylinder, fillcolor="#e53e3e", fontcolor="white",
      label="Approved Meridian system of record\nvalidated business records,\nledger truth, lineage"];
    LEDGER [fillcolor="#fecaca",
      label="Accounting records\njournals, close support,\nadjustments, capital accounts"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed report packs\nfrozen snapshots, exports,\nrestatement lineage"];
    AUDIT [shape=cylinder, fillcolor="#fc8181",
      label="Audit trail\nsource -> record -> case -> ledger -> report"];
  }

  PROVIDERS -> IMPORT_RUN;
  DOCUMENTS -> IMPORT_RUN;
  ACCOUNTING -> IMPORT_RUN;
  IMPORT_RUN -> RAW_EVIDENCE;
  RAW_EVIDENCE -> LINEAGE;
  RAW_EVIDENCE -> NORMALIZE;
  NORMALIZE -> CONFIDENCE;
  CONFIDENCE -> RECON [label="trusted"];
  CONFIDENCE -> BLOCKED [label="not trusted"];
  BLOCKED -> RECON [label="resolved with evidence"];
  RECON -> APPROVAL;
  APPROVAL -> SYSTEM_RECORD;
  SYSTEM_RECORD -> LEDGER;
  SYSTEM_RECORD -> REPORTS;

  LINEAGE -> AUDIT [style=dashed];
  CONFIDENCE -> AUDIT [style=dashed];
  RECON -> AUDIT [style=dashed];
  APPROVAL -> AUDIT [style=dashed];
  LEDGER -> AUDIT [style=dashed];
  REPORTS -> AUDIT [style=dashed];
}
