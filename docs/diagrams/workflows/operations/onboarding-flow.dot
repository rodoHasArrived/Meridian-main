// Onboarding Flow Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Onboarding gets an operator from local setup to trusted evidence workflows.

digraph OnboardingFlow {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Onboarding Flow\nLocal setup for trusted operational records";

  START [shape=oval, fillcolor="#08427b", fontcolor="white",
    label="Operator starts Meridian\nbrowser or WPF workstation"];

  subgraph cluster_setup {
    label="Setup choices";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    CONFIG [fillcolor="#ddd6fe",
      label="Config path review\nrepo config for dev,\nLocalAppData for installed desktop"];
    PROVIDERS [fillcolor="#c4b5fd",
      label="Provider setup\nmetadata-driven fields,\ncredential validation,\nhealth check"];
    SCOPE [fillcolor="#c4b5fd",
      label="Company and access scope\nroles, fund/account context,\nvisible workspaces"];
    DATA_ROOT [fillcolor="#ddd6fe",
      label="DataRoot setup\nstorage, credentials,\nworkspace state,\nretained evidence"];
  }

  subgraph cluster_validation {
    label="Readiness checks";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    CONNECTION [fillcolor="#a7f3d0",
      label="Connectivity and credentials\nprovider health,\nmasked diagnostics"];
    EVIDENCE [fillcolor="#9ae6b4",
      label="Evidence posture\nsource availability,\nquality checks,\nfail-closed state"];
    WORKSPACE [fillcolor="#38a169", fontcolor="white",
      label="Workspace readiness\nTrading, Portfolio, Accounting,\nReporting, Strategy, Data, Settings"];
  }

  subgraph cluster_output {
    label="Operational workflow";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    IMPORT [fillcolor="#fecaca",
      label="Import and validate\nsource evidence"];
    RECON [fillcolor="#fecaca",
      label="Reconcile and investigate\nbreaks and blockers"];
    APPROVE [fillcolor="#fecaca",
      label="Approve and record\nledger/accounting evidence"];
    REPORT [fillcolor="#fbd38d",
      label="Governed reports\nreport packs and audit packages"];
  }

  START -> CONFIG;
  CONFIG -> DATA_ROOT;
  CONFIG -> PROVIDERS;
  PROVIDERS -> CONNECTION;
  DATA_ROOT -> EVIDENCE;
  SCOPE -> WORKSPACE;
  CONNECTION -> EVIDENCE;
  EVIDENCE -> WORKSPACE;
  WORKSPACE -> IMPORT;
  IMPORT -> RECON;
  RECON -> APPROVE;
  APPROVE -> REPORT;
}
