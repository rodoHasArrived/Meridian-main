// C4 Level 1: System Context Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram shows Meridian as the W1-W5 operational record system:
// retained evidence, reconciliation, approvals, accounting records, and
// governed reports across browser and WPF workstation surfaces.

digraph C4_Context {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", splines=ortho, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - System Context (C4 Level 1)\nW1-W5 operational record baseline";

  subgraph cluster_people {
    label="Users and governance";
    color="#4a5568";
    style="rounded";
    bgcolor="#f7fafc";

    OPERATIONS [shape=oval, fillcolor="#08427b", fontcolor="white",
      label="Financial operations\nfund admin, accounting,\nreconciliation, data ops"];
    INVESTMENT [shape=oval, fillcolor="#08427b", fontcolor="white",
      label="Investment users\nportfolio managers,\nanalysts, paper readiness"];
    GOVERNANCE [shape=oval, fillcolor="#08427b", fontcolor="white",
      label="Governance stakeholders\nCFO, controller,\ncompliance, auditors"];
    ADMIN [shape=oval, fillcolor="#08427b", fontcolor="white",
      label="Security and integration admins\nproviders, permissions,\nscoped access"];
  }

  MERIDIAN [shape=box, width=4.3, fillcolor="#438dd5", fontcolor="white",
    label="Meridian\n[.NET 10 fund-management platform]\n\nScope is evidence-led\nUse current source, roadmap status,\nand design charter direction\n\nExpansion lanes can proceed when\nsource, roadmap, or user direction supports them."];

  subgraph cluster_surfaces {
    label="Active operator surfaces";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    BROWSER [fillcolor="#805ad5", fontcolor="white",
      label="Browser workstation\nsrc/Meridian.Ui/dashboard\n\nTrading, Portfolio, Accounting,\nReporting, Strategy, Data, Settings"];
    WPF [fillcolor="#805ad5", fontcolor="white",
      label="WPF desktop workstation\nsrc/Meridian.Wpf\n\nNative Windows operator shell,\nlaunch automation, desktop validation"];
    SHARED_UI [fillcolor="#c4b5fd",
      label="Shared UI contract layer\nMeridian.Ui.Shared + Ui.Services\n\nEndpoints, read models, auth,\nworkstation services"];
  }

  subgraph cluster_sources {
    label="External evidence sources";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    PROVIDERS [fillcolor="#4a90d9", fontcolor="white",
      label="Provider feeds\ncustodian, broker, bank,\nmarket data, fund admin"];
    DOCUMENTS [fillcolor="#bfdbfe",
      label="Documents and uploads\nstatements, contracts,\nPDF evidence"];
    ACCOUNTING_SYSTEMS [fillcolor="#bfdbfe",
      label="External GL/accounting systems\nread-only evidence and\nreconciliation signals"];
    IDENTITY [fillcolor="#bfdbfe",
      label="Identity and scoped access\nusers, roles, company scope"];
  }

  subgraph cluster_record {
    label="Operational record outputs";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    STORE [shape=cylinder, fillcolor="#e53e3e", fontcolor="white",
      label="Approved record store\nvalidated records, ledger truth,\nlineage, frozen snapshots"];
    AUDIT [fillcolor="#fecaca",
      label="Audit and evidence trail\nsource payload -> case -> ledger -> report"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed report delivery\nreport packs, audit packages,\nstatements, exports"];
  }

  subgraph cluster_deferred {
    label="Deferred expansion lanes";
    color="#718096";
    style="dashed";
    bgcolor="#edf2f7";

    EXPANSION [fillcolor="#e2e8f0",
      label="Backtesting Studio, live-readiness,\npayments, forecasting, enterprise risk,\nclient portal, no-code workflow, mobile\n\nDo not lead diagrams unless the work\ndirectly strengthens W1-W5 evidence."];
  }

  OPERATIONS -> BROWSER [label="import, validate,\nreconcile, approve, report"];
  OPERATIONS -> WPF [label="desktop workflows"];
  INVESTMENT -> BROWSER [label="portfolio, strategy,\npaper-readiness review"];
  GOVERNANCE -> BROWSER [label="approvals and\nevidence review"];
  ADMIN -> BROWSER [label="setup and scoped access"];

  BROWSER -> SHARED_UI;
  WPF -> SHARED_UI;
  SHARED_UI -> MERIDIAN;

  PROVIDERS -> MERIDIAN [label="raw source records"];
  DOCUMENTS -> MERIDIAN [label="retained source evidence"];
  ACCOUNTING_SYSTEMS -> MERIDIAN [label="read-only evidence"];
  IDENTITY -> SHARED_UI [label="roles and scopes"];

  MERIDIAN -> STORE [label="approved system of record"];
  MERIDIAN -> AUDIT [label="evidence lineage"];
  STORE -> REPORTS [label="frozen reports"];
  AUDIT -> GOVERNANCE [label="review trail"];
  EXPANSION -> MERIDIAN [style=dashed, label="only when gated\nby W1-W5"];

  subgraph cluster_legend {
    label="Legend";
    style="rounded";
    color="#666666";
    bgcolor="#fafafa";

    L1 [shape=oval, fillcolor="#08427b", fontcolor="white", label="User"];
    L2 [fillcolor="#438dd5", fontcolor="white", label="Meridian boundary"];
    L3 [fillcolor="#805ad5", fontcolor="white", label="Active UI surface"];
    L4 [shape=cylinder, fillcolor="#e53e3e", fontcolor="white", label="Record store"];
    L5 [fillcolor="#e2e8f0", label="Deferred lane"];
  }
}
