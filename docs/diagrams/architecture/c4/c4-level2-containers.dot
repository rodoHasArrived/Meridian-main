// C4 Level 2: Container Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram shows the deployable and shared containers that support the
// W1-W5 operational record baseline.

digraph C4_Containers {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Container Diagram (C4 Level 2)\nOperational record baseline";

  OPERATOR [shape=oval, fillcolor="#08427b", fontcolor="white",
    label="Operator\nfinance ops, accounting,\nreconciliation, data ops"];
  GOVERNANCE [shape=oval, fillcolor="#08427b", fontcolor="white",
    label="Governance user\ncontroller, compliance,\nauditor, trustee"];

  subgraph cluster_meridian {
    label="Meridian system boundary";
    color="#438dd5";
    style="rounded";
    bgcolor="#f0f8ff";

    subgraph cluster_surfaces {
      label="Active workstation surfaces";
      color="#805ad5";
      style="rounded";
      bgcolor="#faf5ff";

      BROWSER [fillcolor="#805ad5", fontcolor="white",
        label="Browser workstation\nsrc/Meridian.Ui/dashboard\n\nSeven root workspaces:\nTrading, Portfolio, Accounting,\nReporting, Strategy, Data, Settings"];
      STATIC_ASSETS [fillcolor="#c4b5fd",
        label="Built workstation assets\nsrc/Meridian.Ui/wwwroot/workstation\n\nServed by local Meridian host"];
      WPF [fillcolor="#805ad5", fontcolor="white",
        label="WPF desktop workstation\nsrc/Meridian.Wpf\n\nNative shell, dense workbenches,\noperator launch workflows"];
    }

    subgraph cluster_shared_ui {
      label="Shared UI and API support";
      color="#6b46c1";
      style="rounded";
      bgcolor="#f3e8ff";

      UI_SHARED [fillcolor="#ddd6fe",
        label="Meridian.Ui.Shared\n\nEndpoint catalog, DTOs,\nauth/scoped access,\nworkstation routes"];
      UI_SERVICES [fillcolor="#ddd6fe",
        label="Meridian.Ui.Services\n\nRead models and orchestration\nfor browser and WPF surfaces"];
      LOCAL_HOST [fillcolor="#c4b5fd",
        label="Local ASP.NET host\nsrc/Meridian\n\nDesktop mode, workstation API,\nhealth, Swagger, fixtures"];
    }

    subgraph cluster_operational_core {
      label="Operational record core";
      color="#2c7a7b";
      style="rounded";
      bgcolor="#e6fffa";

      APPLICATION [fillcolor="#38a169", fontcolor="white",
        label="Meridian.Application\n\nImport/backfill orchestration,\nvalidation, reconciliation jobs,\nworkflow command handlers"];
      PROVIDER_SDK [fillcolor="#9ae6b4",
        label="Meridian.ProviderSdk\n\nProvider contracts for\nsource-backed evidence"];
      INFRA [fillcolor="#9ae6b4",
        label="Meridian.Infrastructure\n\nProvider adapters, credential-aware\nHTTP integration, resilience"];
      LEDGER [fillcolor="#2c7a7b", fontcolor="white",
        label="Meridian.Ledger + FSharp.Ledger\n\nMeridian-owned ledger truth,\naccounting records, close evidence"];
      REPORTING [fillcolor="#2c7a7b", fontcolor="white",
        label="Reporting and evidence services\n\nReport packs, provenance,\nrestatement lineage"];
      STORAGE [shape=cylinder, fillcolor="#e53e3e", fontcolor="white",
        label="Storage layer\n\nWAL, JSONL, Parquet,\nlineage, retained evidence"];
    }

    subgraph cluster_supporting {
      label="Supporting foundations";
      color="#718096";
      style="rounded";
      bgcolor="#edf2f7";

      CORE [fillcolor="#e2e8f0",
        label="Meridian.Core + Contracts\n\nConfiguration, serialization,\nshared DTOs, diagnostics"];
      DOMAIN [fillcolor="#e2e8f0",
        label="Meridian.Domain + FSharp\n\nMarket events, validation,\ncalculations, interop"];
      MCP [fillcolor="#e2e8f0",
        label="Meridian.Mcp\n\nRepo-scoped developer co-pilot\nstdio MCP host"];
    }
  }

  subgraph cluster_external {
    label="External systems";
    color="#999999";
    style="dashed";
    bgcolor="#fafafa";

    PROVIDERS [fillcolor="#bfdbfe",
      label="Providers\ncustodian, broker, bank,\nmarket data, fund admin"];
    ACCOUNTING [fillcolor="#bfdbfe",
      label="External GL/accounting systems\nread-only reconciliation evidence"];
    DOCUMENTS [fillcolor="#bfdbfe",
      label="Documents and uploads\nPDFs, contracts, statements"];
    IDENTITY [fillcolor="#bfdbfe",
      label="Identity provider\nusers, roles, company scope"];
  }

  subgraph cluster_deferred {
    label="Gated expansion";
    color="#718096";
    style="dashed";
    bgcolor="#edf2f7";

    BACKTESTING [fillcolor="#e2e8f0",
      label="Backtesting Studio and live-readiness\nplanned/deferred behind W1-W5\npaper-first governance only"];
    SCALEOUT [fillcolor="#e2e8f0",
      label="Payments, forecasting,\nenterprise risk, portal,\nworkflow designer, mobile\nnot an active container lane"];
  }

  OPERATOR -> BROWSER;
  OPERATOR -> WPF;
  GOVERNANCE -> BROWSER [label="review evidence"];

  BROWSER -> UI_SHARED;
  WPF -> UI_SHARED;
  STATIC_ASSETS -> LOCAL_HOST [label="served by"];
  UI_SHARED -> UI_SERVICES;
  UI_SERVICES -> APPLICATION;
  LOCAL_HOST -> UI_SHARED [label="maps endpoints"];
  LOCAL_HOST -> APPLICATION;

  PROVIDERS -> INFRA [label="raw records"];
  INFRA -> PROVIDER_SDK;
  PROVIDER_SDK -> APPLICATION;
  DOCUMENTS -> APPLICATION [label="attachments"];
  ACCOUNTING -> APPLICATION [label="read-only signals"];
  IDENTITY -> UI_SHARED [label="auth and scope"];

  APPLICATION -> DOMAIN;
  APPLICATION -> LEDGER [label="approved accounting records"];
  APPLICATION -> REPORTING [label="governed reports"];
  APPLICATION -> STORAGE [label="retained evidence"];
  LEDGER -> STORAGE;
  REPORTING -> STORAGE;
  CORE -> APPLICATION;
  CORE -> UI_SHARED;
  MCP -> CORE [style=dashed, label="repo guidance"];

  BACKTESTING -> APPLICATION [style=dashed, label="only when evidence-linked"];
  SCALEOUT -> APPLICATION [style=dashed, label="deferred"];
}
