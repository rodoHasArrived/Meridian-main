// C4 Level 3: Component Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram focuses on the operational-record core behind the shared
// workstation APIs, not on a standalone market-data collector.

digraph C4_Components {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Component Diagram (C4 Level 3)\nOperational record core";

  subgraph cluster_ui {
    label="Shared workstation entry points";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    DASHBOARD [fillcolor="#805ad5", fontcolor="white",
      label="Browser workstation\nReact/TypeScript dashboard"];
    WPF [fillcolor="#805ad5", fontcolor="white",
      label="WPF desktop workstation\nMVVM shell and dense workbenches"];
    ENDPOINTS [fillcolor="#c4b5fd",
      label="Meridian.Ui.Shared endpoints\nWorkstation, portfolio, ledger,\nreporting, evidence, provider routes"];
    READ_SERVICES [fillcolor="#ddd6fe",
      label="Meridian.Ui.Services read models\nShared projections for browser and WPF"];
  }

  subgraph cluster_ingest {
    label="Source evidence acquisition";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    PROVIDER_CATALOG [fillcolor="#bfdbfe",
      label="Provider catalog and credentials\nmetadata-driven setup,\nhealth, scoped secrets"];
    PROVIDER_ADAPTERS [fillcolor="#93c5fd",
      label="Provider adapters\nmarket, broker, bank,\ncustodian, fund-admin inputs"];
    DOCUMENT_IMPORT [fillcolor="#93c5fd",
      label="Document and upload intake\nstatements, PDFs, contracts,\nsource payload manifests"];
    RAW_EVIDENCE [shape=cylinder, fillcolor="#bfdbfe",
      label="Raw evidence store\npayloads preserved as received"];
  }

  subgraph cluster_validation {
    label="Validation and operational review";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    NORMALIZATION [fillcolor="#9ae6b4",
      label="Normalization services\ncanonical records, mappings,\nsource lineage"];
    CONFIDENCE [fillcolor="#9ae6b4",
      label="Data confidence checks\nfreshness, completeness,\nunsupported-source gates"];
    RECON [fillcolor="#38a169", fontcolor="white",
      label="Reconciliation services\ncase queues, break review,\nsource-to-source checks"];
    APPROVALS [fillcolor="#38a169", fontcolor="white",
      label="Approval workflow\noperator sign-off,\nmateriality, override evidence"];
  }

  subgraph cluster_record {
    label="Approved record and publication";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    LEDGER [fillcolor="#e53e3e", fontcolor="white",
      label="Meridian ledger authority\njournals, adjustments,\ncapital accounts, close support"];
    SECURITY_MASTER [fillcolor="#fecaca",
      label="Security Master and reference data\nprofiles, conflicts,\nprojection cache"];
    REPORTING [fillcolor="#fbd38d",
      label="Governed reporting\nreport packs, frozen snapshots,\nrestatement lineage"];
    AUDIT [shape=cylinder, fillcolor="#fc8181",
      label="Audit and lineage store\nsource -> record -> case -> ledger -> report"];
  }

  subgraph cluster_support {
    label="Runtime support";
    color="#718096";
    style="rounded";
    bgcolor="#edf2f7";

    PIPELINE [fillcolor="#e2e8f0",
      label="EventPipeline + WAL\nbounded channels, durable append,\nreplay/backfill evidence"];
    CONFIG [fillcolor="#e2e8f0",
      label="Options and local config\nfail-closed defaults,\nno tracked secrets"];
    MCP [fillcolor="#e2e8f0",
      label="src/Meridian.Mcp\nrepo-scoped AI tools and resources"];
  }

  DASHBOARD -> ENDPOINTS;
  WPF -> ENDPOINTS;
  ENDPOINTS -> READ_SERVICES;
  READ_SERVICES -> RECON;
  READ_SERVICES -> LEDGER;
  READ_SERVICES -> REPORTING;

  PROVIDER_CATALOG -> PROVIDER_ADAPTERS;
  PROVIDER_ADAPTERS -> RAW_EVIDENCE;
  DOCUMENT_IMPORT -> RAW_EVIDENCE;
  RAW_EVIDENCE -> NORMALIZATION;
  NORMALIZATION -> CONFIDENCE;
  CONFIDENCE -> RECON [label="trusted"];
  CONFIDENCE -> APPROVALS [style=dashed, label="manual review"];
  RECON -> APPROVALS;
  APPROVALS -> LEDGER;
  APPROVALS -> REPORTING;
  NORMALIZATION -> SECURITY_MASTER;

  LEDGER -> AUDIT;
  SECURITY_MASTER -> AUDIT;
  REPORTING -> AUDIT;
  PIPELINE -> RAW_EVIDENCE [label="durable ingest"];
  PIPELINE -> AUDIT [label="replay evidence"];
  CONFIG -> PROVIDER_CATALOG [style=dashed];
  MCP -> CONFIG [style=dashed];
}
