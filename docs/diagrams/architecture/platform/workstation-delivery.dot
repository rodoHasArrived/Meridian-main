// Workstation Delivery Diagram
// Meridian current project stance
// Last Updated: 2026-06-16
//
// This diagram shows how the browser workstation, WPF workstation, and
// desktop-local API seams converge on shared read models and operational
// record services.

digraph WorkstationDelivery {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Workstation Delivery\nShared read models and W1-W5 evidence across browser, WPF, and local API surfaces";

  subgraph cluster_surfaces {
    label="Operator Surfaces";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    BROWSER_SURFACE [fillcolor="#805ad5", fontcolor="white",
                  label="src/Meridian.Ui/dashboard\nBrowser workstation\nTrading, Portfolio, Accounting,\nReporting, Strategy, Data, Settings"];
    WPF_SURFACES [fillcolor="#805ad5", fontcolor="white",
                  label="Meridian.Wpf\nStrategyWorkspaceShellPage\nTradingWorkspaceShellPage\nAccountingWorkspaceShellPage\nSecurityMasterPage\n(queue + action inspector)"];
    WEB_SHELL [fillcolor="#805ad5", fontcolor="white",
               label="Desktop-local API host\nlocalhost-only /api/*\nSwagger + retained workstation routes"];
    API_SURFACE [fillcolor="#c4b5fd",
                 label="Shared workstation + portfolio routes\n/api/workstation/*\n/api/portfolio/*\n/api/strategies/*\n/api/security-master/*\n/api/reporting/*"];
    PROVIDER_INTEGRATION_API [fillcolor="#c4b5fd",
                              label="Provider integration routes\nsync history, staging review,\nidentity resolution,\nreconciliation handoff,\nquarantine replay"];
  }

  subgraph cluster_delivery {
    label="Shared Delivery Services";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    WPF_WORKSPACE [fillcolor="#bfdbfe",
                   label="StrategyRunWorkspaceService\nactive run context\npaper evidence + accounting handoff"];
    WORKSTATION_ENDPOINTS [fillcolor="#93c5fd",
                           label="WorkstationEndpoints\nruns / ledger / cash-flow\nsecurity master / reconciliation\nbreak queue + retained evidence APIs"];
    RUN_READ [fillcolor="#bfdbfe",
              label="StrategyRunReadService\nsummary, detail, equity curve,\nfills, attribution"];
    PORTFOLIO_READ [fillcolor="#dbeafe",
                    label="PortfolioReadService\npositions, exposure,\nsecurity enrichment"];
    LEDGER_READ [fillcolor="#dbeafe",
                 label="LedgerReadService\ntrial balance,\njournal, ledger rollups"];
    CASH_FLOW [fillcolor="#dbeafe",
               label="CashFlowProjectionService\ncash ladder / bucketed flows"];
    SECURITY_LOOKUP [fillcolor="#dbeafe",
                     label="SecurityMasterSecurityReferenceLookup\nenrich symbols with authoritative\nasset-class + identifier data"];
    SECURITY_QUERY [fillcolor="#d1fae5",
                    label="ISecurityMasterQueryService\nsecurity detail / history / identity\neconomic definition"];
    RECONCILIATION_NOTE [shape=note, fillcolor="#feebc8",
                         label="Reconciliation + break-queue review\nunder /api/workstation/reconciliation/*\n(see fund-ops-reconciliation.dot)"];
    PROVIDER_HANDOFF [fillcolor="#bfdbfe",
                      label="ProviderIntegrationReconciliationHandoffService\npersist approved staging rows\nfor reconciliation-staging"];
  }

  subgraph cluster_state {
    label="Shared State";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    RUN_STORE [shape=cylinder, fillcolor="#fecaca",
               label="StrategyRunStore\nbacktest / paper / live runs"];
    SECURITY_STATE [shape=cylinder, fillcolor="#fecaca",
                    label="Security Master projections\ncache + backing store"];
    INTEGRATION_STATE [shape=cylinder, fillcolor="#fecaca",
                       label="Provider integration store\nsync runs, staging records,\nquarantine, handoff history"];
  }

  BROWSER_SURFACE -> API_SURFACE [label="browser API calls"];
  WPF_SURFACES -> WPF_WORKSPACE [label="desktop pages"];
  WEB_SHELL -> API_SURFACE [label="localhost requests"];
  API_SURFACE -> WORKSTATION_ENDPOINTS [label="route groups"];
  API_SURFACE -> PROVIDER_INTEGRATION_API [label="provider integration group"];
  WPF_SURFACES -> SECURITY_QUERY [style=dashed, color="#2b6cb0",
                                  label="security assurance cards"];

  WPF_WORKSPACE -> RUN_READ [label="desktop drill-ins"];
  WPF_WORKSPACE -> CASH_FLOW [label="cash flow panels"];

  WORKSTATION_ENDPOINTS -> RUN_READ [label="runs / ledger / fills"];
  WORKSTATION_ENDPOINTS -> CASH_FLOW [label="cash-flow projections"];
  WORKSTATION_ENDPOINTS -> SECURITY_QUERY [label="security master detail"];
  WORKSTATION_ENDPOINTS -> RECONCILIATION_NOTE [style=dashed, color="#ed8936"];
  PROVIDER_INTEGRATION_API -> PROVIDER_HANDOFF [label="POST handoff / GET history"];
  PROVIDER_INTEGRATION_API -> INTEGRATION_STATE [label="monitor + sync-run history"];
  PROVIDER_HANDOFF -> RECONCILIATION_NOTE [style=dashed, color="#ed8936",
                                           label="approved staging evidence"];

  RUN_READ -> PORTFOLIO_READ [label="portfolio summaries"];
  RUN_READ -> LEDGER_READ [label="ledger summaries"];
  PORTFOLIO_READ -> SECURITY_LOOKUP [label="enrich positions"];
  LEDGER_READ -> SECURITY_LOOKUP [label="enrich trial balance"];
  SECURITY_LOOKUP -> SECURITY_QUERY [label="lookup by symbol / identifier"];

  RUN_READ -> RUN_STORE [label="read run entries"];
  CASH_FLOW -> RUN_STORE [label="iterate cash-flow metrics"];
  SECURITY_QUERY -> SECURITY_STATE [label="query projections"];
  PROVIDER_HANDOFF -> INTEGRATION_STATE [label="save retained evidence"];

  subgraph cluster_legend {
    label="Legend";
    style="rounded";
    color="#666666";
    bgcolor="#fafafa";

    LEG_UI [fillcolor="#805ad5", fontcolor="white", label="Operator surface"];
    LEG_APP [fillcolor="#bfdbfe", label="Application service"];
    LEG_SUPPORT [fillcolor="#dbeafe", label="Supporting read model"];
    LEG_STORE [shape=cylinder, fillcolor="#fecaca", label="Shared persisted state"];
  }
}
