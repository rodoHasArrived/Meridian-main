// Storage Architecture Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram shows storage as retained source evidence and lineage for the
// W1-W5 operational record baseline.

digraph StorageArchitecture {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Storage Architecture\nRetained evidence, lineage, and governed publication";

  subgraph cluster_input {
    label="Inputs to retained evidence";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    SOURCE_PAYLOADS [fillcolor="#ddd6fe",
      label="Raw source payloads\nprovider responses, files,\nstatements, document manifests"];
    MARKET_EVENTS [fillcolor="#ddd6fe",
      label="Market and operational events\ntrades, quotes, bars,\nactivity, integrity events"];
    WORKFLOW_EVENTS [fillcolor="#ddd6fe",
      label="Review and workflow events\nreconciliation cases,\napprovals, overrides"];
  }

  subgraph cluster_durability {
    label="Durable write path";
    color="#c53030";
    style="rounded";
    bgcolor="#fee2e2";

    WAL [shape=cylinder, fillcolor="#fc8181", fontcolor="white",
      label="WriteAheadLog\ncrash-safe append,\nchecksums, replay"];
    JSONL [shape=cylinder, fillcolor="#fbd38d",
      label="JSONL hot store\nappend-only source evidence,\ndaily/provider partitions"];
    PARQUET [shape=cylinder, fillcolor="#6ee7b7",
      label="Parquet archive\ncolumnar operational records,\nanalytics-friendly snapshots"];
    DOC_STORE [shape=cylinder, fillcolor="#fecaca",
      label="Evidence and document store\nattachments, manifests,\nchecksums, retention metadata"];
  }

  subgraph cluster_governance {
    label="Lifecycle and controls";
    color="#38a169";
    style="rounded";
    bgcolor="#f0fff4";

    CATALOG [fillcolor="#9ae6b4",
      label="StorageCatalogService\nsymbol/date/type inventory,\ngaps, lineage, coverage"];
    POLICY [fillcolor="#9ae6b4",
      label="Storage policy engine\nhot/warm/cold/archive tiers,\nretention, migration"];
    QUALITY [fillcolor="#9ae6b4",
      label="Data confidence evidence\ncompleteness, timeliness,\nvalidity, exception flags"];
    FAIL_CLOSED [fillcolor="#fecaca",
      label="Fail-closed reads\nmissing evidence surfaces as\nblocked/untrusted state"];
  }

  subgraph cluster_record {
    label="Operational record stores";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    SECURITY_MASTER [fillcolor="#a7f3d0",
      label="Security Master event store\nidentity, profile, conflicts,\nprojection cache"];
    LEDGER_STORE [shape=cylinder, fillcolor="#2c7a7b", fontcolor="white",
      label="Ledger and accounting records\njournals, adjustments,\ncapital account evidence"];
    RECON_STORE [shape=cylinder, fillcolor="#2c7a7b", fontcolor="white",
      label="Reconciliation state\nruns, breaks, approvals,\ncase history"];
    REPORT_STORE [shape=cylinder, fillcolor="#fbd38d",
      label="Report-pack snapshots\npublication, restatement,\nexport lineage"];
  }

  subgraph cluster_publication {
    label="Governed publication";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    PACKAGE [fillcolor="#bfdbfe",
      label="Portable packages\nmanifest, checksums,\nsource-to-output trace"];
    EXPORTS [fillcolor="#bfdbfe",
      label="Governed exports\nreport files, audit packages,\nreview support"];
    OPTIONAL_ANALYTICS [fillcolor="#e2e8f0",
      label="Optional analytics exports\nPython/R/SQL/Lean formats\nsupport only, not product center"];
  }

  SOURCE_PAYLOADS -> WAL;
  MARKET_EVENTS -> WAL;
  WORKFLOW_EVENTS -> WAL;
  WAL -> JSONL [label="durable append"];
  JSONL -> PARQUET [label="archive and summarize"];
  SOURCE_PAYLOADS -> DOC_STORE [label="document evidence"];

  JSONL -> CATALOG;
  PARQUET -> CATALOG;
  DOC_STORE -> CATALOG;
  CATALOG -> QUALITY;
  CATALOG -> POLICY;
  POLICY -> JSONL [style=dashed, label="tier"];
  POLICY -> PARQUET [style=dashed, label="archive"];
  QUALITY -> FAIL_CLOSED;

  JSONL -> SECURITY_MASTER;
  PARQUET -> LEDGER_STORE;
  WORKFLOW_EVENTS -> RECON_STORE;
  LEDGER_STORE -> REPORT_STORE;
  RECON_STORE -> REPORT_STORE;
  SECURITY_MASTER -> LEDGER_STORE [label="reference enrichment"];

  FAIL_CLOSED -> RECON_STORE [style=dashed, label="blocks trust"];
  CATALOG -> PACKAGE [label="manifest"];
  REPORT_STORE -> EXPORTS;
  PACKAGE -> EXPORTS;
  PARQUET -> OPTIONAL_ANALYTICS [style=dashed];
}
