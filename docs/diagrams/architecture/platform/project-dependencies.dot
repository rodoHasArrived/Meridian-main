// Project Dependency Diagram - Meridian
// Generated from current .csproj and .fsproj ProjectReference entries.
// Last Updated: 2026-05-28
// Render with: npm run generate-diagrams -- --all or Graphviz dot.

digraph ProjectDependencies {
    rankdir=TB;
    fontname="Segoe UI, Helvetica, Arial, sans-serif";
    fontsize=14;
    label="Meridian - Project Dependencies\n(26 source projects | 8 test projects | 1 benchmark project)";
    labelloc=t;
    labeljust=c;
    compound=true;
    nodesep=0.5;
    ranksep=0.9;
    splines=ortho;

    node [shape=box, style="rounded,filled", fontname="Segoe UI, Helvetica, Arial, sans-serif", fontsize=10, margin="0.15,0.08"];
    edge [color="#666666", arrowsize=0.7];

    subgraph cluster_layer0 {
        label="Layer 0: Foundation - contracts and F# domain primitives";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        Contracts [label="Contracts\n(API models, DTOs, domain events)", fillcolor="#E8F5E9", style="rounded,filled"];
        FSharp [label="FSharp\n(validation, calculations, DUs)", fillcolor="#E8F5E9", style="rounded,filled"];
        FSharpLedger [label="FSharp.Ledger\n(journal, reconciliation)", fillcolor="#E8F5E9", style="rounded,filled"];
        FSharpTrading [label="FSharp.Trading\n(strategy lifecycle F# types)", fillcolor="#E8F5E9", style="rounded,filled"];
        FSharpDL [label="FSharp.DirectLending.Aggregates\n(contract and servicing aggregates)", fillcolor="#E8F5E9", style="rounded,filled"];
    }

    subgraph cluster_layer1 {
        label="Layer 1: SDK and core interfaces";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        ProviderSdk [label="ProviderSdk\n(provider contracts, registry\n[DataSource] metadata)", fillcolor="#E3F2FD", style="rounded,filled"];
        ExecutionSdk [label="Execution.Sdk\n(order gateway and broker seams\norders, positions, lifecycle)", fillcolor="#E3F2FD", style="rounded,filled"];
        IbApiStub [label="IbApi.SmokeStub\n(IB API smoke-test stub)", fillcolor="#E3F2FD", style="rounded,filled,dashed"];
    }

    subgraph cluster_layer2 {
        label="Layer 2: Core domain";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        Domain [label="Domain\n(collectors, events, models\nMarketEvent hierarchy)", fillcolor="#E1F5FE", style="rounded,filled"];
        Core [label="Core\n(config, logging, serialization\nschedules, performance)", fillcolor="#E1F5FE", style="rounded,filled"];
        Ledger [label="Ledger\n(double-entry journal\nfund and project books)", fillcolor="#E1F5FE", style="rounded,filled"];
    }

    subgraph cluster_layer3 {
        label="Layer 3: Infrastructure and storage";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        Infrastructure [label="Infrastructure\n(streaming/historical providers\nresilience, HTTP integration)", fillcolor="#FFF3E0", style="rounded,filled"];
        CppTrader [label="Infrastructure.CppTrader\n(native matching bridge\nITCH ingestion, replay)", fillcolor="#FFF3E0", style="rounded,filled,dashed"];
        Storage [label="Storage\n(WAL, JSONL/Parquet sinks\nsecurity master, packaging)", fillcolor="#FFF3E0", style="rounded,filled"];
    }

    subgraph cluster_layer4 {
        label="Layer 4: Application and backtesting SDK";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        Application [label="Application\n(workflows, pipeline, backfill\nsecurity master, config)", fillcolor="#FCE4EC", style="rounded,filled"];
        BacktestSdk [label="Backtesting.Sdk\n(strategy/context contracts\norders, fills, snapshots)", fillcolor="#FCE4EC", style="rounded,filled"];
    }

    subgraph cluster_layer5 {
        label="Layer 5: Execution, backtesting, risk, strategies, QuantScript";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        Execution [label="Execution\n(paper gateway, OMS\nbrokerage adapters, risk gateway)", fillcolor="#F3E5F5", style="rounded,filled"];
        Backtesting [label="Backtesting\n(BacktestEngine, fill models\nmetrics engine, replay)", fillcolor="#F3E5F5", style="rounded,filled"];
        Risk [label="Risk\n(pre-trade validation\nlimits, drawdown, throttles)", fillcolor="#F3E5F5", style="rounded,filled"];
        Strategies [label="Strategies\n(strategy lifecycle, promotion\nportfolio/read-model services)", fillcolor="#F3E5F5", style="rounded,filled"];
        QuantScript [label="QuantScript\n(Roslyn scripting, price series\nportfolio/statistics tooling)", fillcolor="#F3E5F5", style="rounded,filled"];
    }

    subgraph cluster_layer6 {
        label="Layer 6: UI and presentation";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        UiShared [label="Ui.Shared\n(shared endpoints, auth\nworkstation APIs)", fillcolor="#EDE7F6", style="rounded,filled"];
        UiServices [label="Ui.Services\n(workstation read models\ndesktop/browser service seams)", fillcolor="#EDE7F6", style="rounded,filled,dashed"];
        Wpf [label="Wpf\n(active Windows desktop shell\noperator workflow views)", fillcolor="#EDE7F6", style="rounded,filled,dashed"];
        Mcp [label="Mcp\n(repo-navigation MCP tools\nADR and convention resources)", fillcolor="#EDE7F6", style="rounded,filled"];
    }

    subgraph cluster_layer7 {
        label="Layer 7: Entry point";
        style="rounded,dashed";
        color="#aaaaaa";
        fontsize=11;
        MainApp [label="Meridian\n(CLI entry point, startup orchestration\ncollector/backfill/desktop/workstation modes)", fillcolor="#FFEBEE", style="rounded,filled"];
    }

    subgraph cluster_tests {
        label="Test Projects (8 projects)";
        style="rounded,dashed";
        color="#888888";
        fontsize=11;
        BacktestingTests [label="Backtesting.Tests\n(21 test files)", fillcolor="#ECEFF1"];
        DirectLendingTests [label="DirectLending.Tests\n(8 test files)", fillcolor="#ECEFF1"];
        FSharpTests [label="FSharp.Tests\n(19 test files)", fillcolor="#ECEFF1"];
        FundStructureTests [label="FundStructure.Tests\n(4 test files)", fillcolor="#ECEFF1"];
        QuantScriptTests [label="QuantScript.Tests\n(12 test files)", fillcolor="#ECEFF1"];
        Tests [label="Tests\n(485 test files)", fillcolor="#ECEFF1"];
        UiTests [label="Ui.Tests\n(60 test files)", fillcolor="#ECEFF1"];
        WpfTests [label="Wpf.Tests\n(148 test files)", fillcolor="#ECEFF1"];
    }

    subgraph cluster_benchmarks {
        label="Benchmarks";
        style="rounded,dashed";
        color="#888888";
        fontsize=11;
        Benchmarks [label="Benchmarks\n(17 benchmark files)", fillcolor="#ECEFF1"];
    }

    Application -> Contracts;
    Application -> Core;
    Application -> Domain;
    Application -> FSharp;
    Application -> FSharpDL;
    Application -> FSharpLedger;
    Application -> Infrastructure;
    Application -> Ledger;
    Application -> ProviderSdk;
    Application -> Storage;
    BacktestSdk -> Contracts;
    BacktestSdk -> Ledger;
    Backtesting -> Application;
    Backtesting -> BacktestSdk;
    Backtesting -> Storage;
    Backtesting -> Strategies;
    Core -> Contracts;
    Core -> Domain;
