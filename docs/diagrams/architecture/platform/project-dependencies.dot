    MainApp -> ProviderSdk;
    MainApp -> QuantScript;
    MainApp -> Storage;
    MainApp -> UiShared;

    BacktestingTests -> Backtesting [style=dotted, color="#999999"];
    BacktestingTests -> BacktestSdk [style=dotted, color="#999999"];
    BacktestingTests -> Infrastructure [style=dotted, color="#999999"];
    DirectLendingTests -> Application [style=dotted, color="#999999"];
    DirectLendingTests -> Contracts [style=dotted, color="#999999"];
    DirectLendingTests -> Storage [style=dotted, color="#999999"];
    FSharpTests -> BacktestSdk [style=dotted, color="#999999"];
    FSharpTests -> Contracts [style=dotted, color="#999999"];
    FSharpTests -> ExecutionSdk [style=dotted, color="#999999"];
    FSharpTests -> FSharp [style=dotted, color="#999999"];
    FSharpTests -> FSharpDL [style=dotted, color="#999999"];
    FSharpTests -> FSharpLedger [style=dotted, color="#999999"];
    FSharpTests -> FSharpTrading [style=dotted, color="#999999"];
