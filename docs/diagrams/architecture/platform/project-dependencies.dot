    subgraph cluster_legend {
        label="Legend";
        style="rounded";
        color="#888888";
        bgcolor="#fafafa";
        fontsize=10;
        L_SOLID [shape=plaintext, label="solid edge = project reference (compile dependency)"];
        L_DOT [shape=plaintext, label="dotted edge = test / benchmark reference"];
        L_NATIVE [shape=box, fillcolor="#FFF3E0", style="rounded,filled,dashed", label="Dashed border = Windows-only, conditional, or source-link adjacent project"];
    }
}
