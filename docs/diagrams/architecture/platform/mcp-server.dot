// MCP Server Architecture Diagram
// Meridian current project state
// Last Updated: 2026-05-28
//
// This diagram reflects the active src/Meridian.Mcp host.
// Render with: npm run generate-diagrams -- --all or Graphviz dot.

digraph McpServer {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - MCP Server Architecture\nsrc/Meridian.Mcp developer co-pilot host";

  subgraph cluster_clients {
    label="MCP Clients";
    color="#4a5568";
    style="rounded";
    bgcolor="#f7fafc";

    CLAUDE_CLIENT [fillcolor="#e2e8f0",
                   label="Claude Desktop / Claude.ai\nAI assistant context\nTool invocation\nResource reads"];

    OTHER_CLIENT [fillcolor="#e2e8f0",
                  label="Other MCP Clients\nCopilot, Cursor, Codex, etc.\nMCP-compatible hosts"];
  }

  subgraph cluster_server {
    label="src/Meridian.Mcp (.NET 10 / ModelContextProtocol SDK)";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    MCP_HOST [fillcolor="#ddd6fe",
              label="mdc-mcp executable\nHost.CreateApplicationBuilder\nstdio transport\nJSON-RPC MCP protocol"];

    DISCOVERY [fillcolor="#e9d5ff",
               label="Assembly discovery\nWithToolsFromAssembly()\nWithPromptsFromAssembly()\nWithResourcesFromAssembly()"];

    REPO_PATH [fillcolor="#e9d5ff",
               label="RepoPathService\nResolves repo-root paths\nKeeps file access repo-scoped"];
  }

  subgraph cluster_tools {
    label="Tools";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    ADR_TOOLS [fillcolor="#bfdbfe",
               label="AdrTools\nADR lookup and creation helpers"];
    AUDIT_TOOLS [fillcolor="#bfdbfe",
                 label="AuditTools\nRepository audit helpers"];
    CONVENTION_TOOLS [fillcolor="#bfdbfe",
                      label="ConventionTools\nCoding and documentation conventions"];
    KNOWN_ERROR_TOOLS [fillcolor="#bfdbfe",
                       label="KnownErrorTools\nKnown build/test error lookup"];
    PROVIDER_TOOLS [fillcolor="#bfdbfe",
                    label="ProviderTools\nProvider integration guidance"];
  }

  subgraph cluster_resources {
    label="Resources";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#d1fae5";

    ADR_RESOURCES [fillcolor="#6ee7b7",
                   label="AdrResources\nArchitecture decision records"];
    CONVENTION_RESOURCES [fillcolor="#6ee7b7",
                          label="ConventionResources\nRepo conventions and standards"];
    TEMPLATE_RESOURCES [fillcolor="#6ee7b7",
                        label="TemplateResources\nReusable implementation templates"];
  }

  subgraph cluster_prompts {
    label="Prompts";
    color="#ed8936";
    style="rounded";
    bgcolor="#fffaf0";

    CODE_REVIEW_PROMPTS [fillcolor="#fbd38d",
                         label="CodeReviewPrompts\nReview and audit workflows"];
    PROVIDER_PROMPTS [fillcolor="#fbd38d",
                      label="ProviderPrompts\nProvider implementation guidance"];
    TEST_WRITER_PROMPTS [fillcolor="#fbd38d",
                         label="TestWriterPrompts\nScenario-first test guidance"];
  }

  CLAUDE_CLIENT -> MCP_HOST [color="#805ad5", penwidth=2, label="stdio / JSON-RPC"];
  OTHER_CLIENT -> MCP_HOST [color="#805ad5", penwidth=1, style=dashed];

  MCP_HOST -> DISCOVERY [style=dashed, label="registers"];
  MCP_HOST -> REPO_PATH [style=dashed, label="DI singleton"];

  DISCOVERY -> ADR_TOOLS [color="#2b6cb0", label="tools"];
  DISCOVERY -> AUDIT_TOOLS [color="#2b6cb0"];
  DISCOVERY -> CONVENTION_TOOLS [color="#2b6cb0"];
  DISCOVERY -> KNOWN_ERROR_TOOLS [color="#2b6cb0"];
  DISCOVERY -> PROVIDER_TOOLS [color="#2b6cb0"];

  DISCOVERY -> ADR_RESOURCES [color="#2c7a7b", label="resources"];
  DISCOVERY -> CONVENTION_RESOURCES [color="#2c7a7b"];
  DISCOVERY -> TEMPLATE_RESOURCES [color="#2c7a7b"];

  DISCOVERY -> CODE_REVIEW_PROMPTS [color="#ed8936", label="prompts"];
  DISCOVERY -> PROVIDER_PROMPTS [color="#ed8936"];
  DISCOVERY -> TEST_WRITER_PROMPTS [color="#ed8936"];

  ADR_TOOLS -> REPO_PATH [style=dashed, color="#805ad5"];
  AUDIT_TOOLS -> REPO_PATH [style=dashed, color="#805ad5"];
  CONVENTION_TOOLS -> REPO_PATH [style=dashed, color="#805ad5"];
  KNOWN_ERROR_TOOLS -> REPO_PATH [style=dashed, color="#805ad5"];
  PROVIDER_TOOLS -> REPO_PATH [style=dashed, color="#805ad5"];
  ADR_RESOURCES -> REPO_PATH [style=dashed, color="#805ad5"];
  CONVENTION_RESOURCES -> REPO_PATH [style=dashed, color="#805ad5"];
  TEMPLATE_RESOURCES -> REPO_PATH [style=dashed, color="#805ad5"];

  subgraph cluster_legend {
    label="Legend";
    style="rounded";
    color="#666666";
    bgcolor="#fafafa";

    LEG [shape=plaintext,
         label="solid edge = MCP protocol or discovered capability\n dashed edge = DI/service dependency\n blue = tools, green = resources, orange = prompts"];
  }
}
