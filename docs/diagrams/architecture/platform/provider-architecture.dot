// Provider Architecture Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram shows provider integrations as source-evidence inputs to the
// W1-W5 operational record baseline. Providers do not own ledger truth.

digraph ProviderArchitecture {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Provider Architecture\nSource evidence for operational records";

  subgraph cluster_operator {
    label="Operator setup and governance";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    SETTINGS [fillcolor="#c4b5fd",
      label="Provider setup surfaces\nBrowser Settings + WPF setup\nmetadata-driven fields"];
    CREDENTIALS [fillcolor="#ddd6fe",
      label="Credential handling\nlocal encrypted store,\nread-only env fallback,\nno tracked secrets"];
    HEALTH [fillcolor="#ddd6fe",
      label="Provider readiness\nhealth, degradation,\nfallback, operator recovery"];
  }

  subgraph cluster_contracts {
    label="Provider contracts";
    color="#6b46c1";
    style="rounded";
    bgcolor="#f3e8ff";

    MARKET [shape=ellipse, fillcolor="#ddd6fe",
      label="IMarketDataClient\nstreaming market events"];
    HIST [shape=ellipse, fillcolor="#ddd6fe",
      label="IHistoricalDataProvider\nprovider-backed backfill"];
    SEARCH [shape=ellipse, fillcolor="#ddd6fe",
      label="ISymbolSearchProvider\nsymbol and identifier search"];
    CATALOG [fillcolor="#e9d5ff",
      label="Provider catalog metadata\nfields, capabilities,\nsource posture, setup evidence"];
  }

  subgraph cluster_sources {
    label="Implemented evidence sources";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    MARKET_PROVIDERS [fillcolor="#93c5fd",
      label="Market and broker adapters\nInteractive Brokers, Alpaca,\nPolygon, NYSE, StockSharp,\nsynthetic/dev sources"];
    HIST_PROVIDERS [fillcolor="#93c5fd",
      label="Historical providers\nAlpaca, Yahoo, Stooq, Polygon,\nTiingo, Finnhub, Alpha Vantage,\nNasdaq Data Link, Twelve Data, FRED"];
    BANK_CUSTODY [fillcolor="#bfdbfe",
      label="Bank, custodian, and fund-admin inputs\nstatement files, external ledgers,\naccount activity evidence"];
    SYMBOL_PROVIDERS [fillcolor="#bfdbfe",
      label="Symbol and identifier services\nOpenFIGI, Alpaca, Finnhub,\nPolygon, StockSharp"];
  }

  subgraph cluster_resilience {
    label="Evidence acquisition controls";
    color="#c53030";
    style="rounded";
    bgcolor="#fee2e2";

    RATE [fillcolor="#fecaca",
      label="Rate limits and retries\nper-provider pacing,\nbackoff, circuit breaker"];
    FAILOVER [fillcolor="#fecaca",
      label="Provider fallback\npriority order,\nhealth exclusion,\noperator-visible degradation"];
    FAIL_CLOSED [fillcolor="#fecaca",
      label="Fail-closed posture\nmissing or stale source evidence\nblocks trusted records"];
  }

  subgraph cluster_record {
    label="Operational record consumers";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    RAW_EVIDENCE [shape=cylinder, fillcolor="#9ae6b4",
      label="Raw source evidence\npayloads retained exactly\nas received"];
    NORMALIZED [fillcolor="#a7f3d0",
      label="Normalized operational records\ntransactions, positions,\nprices, cash, terms"];
    SECURITY_MASTER [fillcolor="#a7f3d0",
      label="Security Master\ncanonical identifiers,\nasset profiles, conflicts"];
    RECON [fillcolor="#38a169", fontcolor="white",
      label="Reconciliation and approvals\ncase queues, materiality,\nreview evidence"];
    LEDGER [fillcolor="#2c7a7b", fontcolor="white",
      label="Meridian-owned ledger truth\njournals, adjustments,\ncapital accounts"];
    REPORTING [fillcolor="#fbd38d",
      label="Governed reports\nreport-pack lineage,\nexports, audit packages"];
  }

  subgraph cluster_deferred {
    label="Gated use";
    color="#718096";
    style="dashed";
    bgcolor="#edf2f7";

    RESEARCH [fillcolor="#e2e8f0",
      label="Backtesting and live-readiness\nconsume provider data only when\nlinked to retained evidence,\npaper validation, or approvals"];
  }

  SETTINGS -> CATALOG;
  SETTINGS -> CREDENTIALS;
  CREDENTIALS -> HEALTH;
  HEALTH -> FAILOVER;

  CATALOG -> MARKET;
  CATALOG -> HIST;
  CATALOG -> SEARCH;

  MARKET -> MARKET_PROVIDERS;
  HIST -> HIST_PROVIDERS;
  SEARCH -> SYMBOL_PROVIDERS;
  BANK_CUSTODY -> RAW_EVIDENCE;
  MARKET_PROVIDERS -> RATE;
  HIST_PROVIDERS -> RATE;
  RATE -> FAILOVER;
  FAILOVER -> RAW_EVIDENCE;
  FAIL_CLOSED -> RECON [style=dashed, label="blocks trust"];

  SYMBOL_PROVIDERS -> SECURITY_MASTER;
  RAW_EVIDENCE -> NORMALIZED;
  NORMALIZED -> SECURITY_MASTER;
  NORMALIZED -> RECON;
  SECURITY_MASTER -> RECON;
  RECON -> LEDGER;
  LEDGER -> REPORTING;
  RAW_EVIDENCE -> REPORTING [style=dashed, label="lineage"];
  RESEARCH -> RAW_EVIDENCE [style=dashed, label="evidence-linked only"];
}
