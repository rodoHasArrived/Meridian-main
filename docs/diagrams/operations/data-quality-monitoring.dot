// Data Quality and Monitoring Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Data quality is framed as confidence evidence for operational records.

digraph DataQualityMonitoring {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Data Quality and Monitoring\nConfidence evidence for operational records";

  subgraph cluster_sources {
    label="Observed inputs";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    PROVIDERS [fillcolor="#93c5fd",
      label="Provider health\nlatency, errors,\ncredential state"];
    STORAGE [shape=cylinder, fillcolor="#bfdbfe",
      label="Storage coverage\nsymbol/date/type,\ngaps, lineage"];
    WORKFLOW [fillcolor="#bfdbfe",
      label="Workflow state\nreconciliation breaks,\nblocked approvals,\nreport readiness"];
  }

  subgraph cluster_confidence {
    label="Confidence checks";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    COMPLETENESS [fillcolor="#a7f3d0",
      label="Completeness\nexpected vs present\nsource coverage"];
    ACCURACY [fillcolor="#a7f3d0",
      label="Accuracy and validity\noutliers, mappings,\nprice/volume checks"];
    TIMELINESS [fillcolor="#a7f3d0",
      label="Timeliness\nfreshness, stale source,\nSLA posture"];
    CONFIDENCE [fillcolor="#38a169", fontcolor="white",
      label="Data confidence posture\ntrusted, review-required,\nblocked"];
  }

  subgraph cluster_operator {
    label="Operator surfaces";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    DASHBOARD [fillcolor="#c4b5fd",
      label="Browser/WPF diagnostics\nprovider readiness,\nquality panels,\nevidence strips"];
    ALERTS [fillcolor="#ddd6fe",
      label="Operator alerts\nsource missing,\nquality regression,\nreconciliation blocker"];
    STATUS [fillcolor="#ddd6fe",
      label="Status snapshots\nhealth endpoints,\nlocal files,\nreport-pack evidence"];
  }

  subgraph cluster_record {
    label="Record impact";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    FAIL_CLOSED [fillcolor="#fecaca",
      label="Fail-closed behavior\nuntrusted data does not\nbecome approved record"];
    RECON [fillcolor="#fecaca",
      label="Reconciliation case\ninvestigate and resolve\nwith retained evidence"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed reports\nquality posture included\nin lineage"];
  }

  PROVIDERS -> COMPLETENESS;
  STORAGE -> COMPLETENESS;
  STORAGE -> ACCURACY;
  PROVIDERS -> TIMELINESS;
  WORKFLOW -> CONFIDENCE;
  COMPLETENESS -> CONFIDENCE;
  ACCURACY -> CONFIDENCE;
  TIMELINESS -> CONFIDENCE;
  CONFIDENCE -> DASHBOARD;
  CONFIDENCE -> ALERTS;
  DASHBOARD -> STATUS;
  CONFIDENCE -> FAIL_CLOSED [label="not trusted"];
  FAIL_CLOSED -> RECON;
  CONFIDENCE -> REPORTS [label="trusted"];
  RECON -> REPORTS [label="resolved"];
}
