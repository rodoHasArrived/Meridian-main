// Deployment Options Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram shows current deployment emphasis: local developer and operator
// workstation paths first. Enterprise scale-out is not an active product lane.

digraph DeploymentOptions {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Deployment Options\nLocal workstation first; scale-out deferred";

  subgraph cluster_current {
    label="Current supported paths";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    DEV [fillcolor="#a7f3d0",
      label="Developer checkout\nD:/Meridian-main\n\nBuild, test, docs,\nfixture workflows"];
    LOCAL_HOST [fillcolor="#38a169", fontcolor="white",
      label="src/Meridian host\nCLI + desktop mode\nlocal ASP.NET API"];
    WPF [fillcolor="#38a169", fontcolor="white",
      label="WPF desktop workstation\nsrc/Meridian.Wpf\nnative operator shell"];
    BROWSER [fillcolor="#38a169", fontcolor="white",
      label="Browser workstation\nsrc/Meridian.Ui/dashboard\nserved from /workstation/"];
  }

  subgraph cluster_runtime_state {
    label="Local runtime state";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    CONFIG [fillcolor="#fecaca",
      label="Config root\nrepo config for dev,\nLocalAppData for installed desktop"];
    DATA_ROOT [shape=cylinder, fillcolor="#fc8181",
      label="DataRoot\nWAL, JSONL, Parquet,\ncredentials, evidence,\nworkspace state"];
    HEALTH [fillcolor="#fecaca",
      label="Health and diagnostics\nstatus snapshots,\nprovider readiness,\noperator recovery"];
  }

  subgraph cluster_packaging {
    label="Packaging and validation";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    TESTS [fillcolor="#ddd6fe",
      label="Narrow validation\nWPF, dashboard, shared services,\ndocs and source checks"];
    INSTALLER [fillcolor="#ddd6fe",
      label="Desktop packaging\ninstalled WPF app,\nexternal config/data roots"];
    DOCS [fillcolor="#ddd6fe",
      label="Docs and diagram generation\ntracked artifacts,\nreviewable regeneration"];
  }

  subgraph cluster_deferred {
    label="Deferred expansion";
    color="#718096";
    style="dashed";
    bgcolor="#edf2f7";

    SCALE_OUT [fillcolor="#e2e8f0",
      label="Docker, Kubernetes,\nmulti-region, enterprise scale-out\n\nNot the active stance unless a later\nroadmap item reopens it."];
    LIVE [fillcolor="#e2e8f0",
      label="Live-readiness and payments\npaper-first governance only;\nno broad live execution lane"];
  }

  DEV -> LOCAL_HOST;
  DEV -> TESTS;
  LOCAL_HOST -> BROWSER [label="serves assets + APIs"];
  LOCAL_HOST -> WPF [label="desktop mode support"];
  WPF -> CONFIG;
  BROWSER -> LOCAL_HOST;
  LOCAL_HOST -> DATA_ROOT;
  LOCAL_HOST -> HEALTH;
  TESTS -> DOCS;
  TESTS -> INSTALLER [style=dashed];
  INSTALLER -> CONFIG;
  INSTALLER -> DATA_ROOT;
  SCALE_OUT -> LOCAL_HOST [style=dashed, label="future only"];
  LIVE -> LOCAL_HOST [style=dashed, label="gated"];
}
