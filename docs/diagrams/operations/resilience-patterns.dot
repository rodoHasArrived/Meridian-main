// Resilience Patterns Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Resilience protects source evidence and operator trust, not uninterrupted
// live trading.

digraph ResiliencePatterns {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Resilience Patterns\nFail-closed evidence and operator recovery";

  subgraph cluster_failures {
    label="Failure signals";
    color="#c53030";
    style="rounded";
    bgcolor="#fee2e2";

    PROVIDER_DOWN [fillcolor="#fecaca",
      label="Provider unavailable\nnetwork, auth, throttling"];
    STALE_DATA [fillcolor="#fecaca",
      label="Stale or incomplete source\nmissing range, gaps,\nout-of-order data"];
    STORAGE_ERROR [fillcolor="#fecaca",
      label="Storage or replay issue\nWAL, checksum,\nwrite failure"];
  }

  subgraph cluster_controls {
    label="Controls";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    RETRY [fillcolor="#93c5fd",
      label="Retry with backoff\nbounded attempts,\nrate-limit aware"];
    CIRCUIT [fillcolor="#93c5fd",
      label="Circuit breaker\nopen/half-open/closed,\nhealth exclusion"];
    FALLBACK [fillcolor="#93c5fd",
      label="Provider fallback\npriority order,\ncapability match,\noperator-visible source"];
    WAL [shape=cylinder, fillcolor="#bfdbfe",
      label="WAL and replay\nrecover unflushed evidence,\nchecksum validation"];
  }

  subgraph cluster_operator {
    label="Operator recovery";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    STATUS [fillcolor="#c4b5fd",
      label="Status surface\nhealth, source posture,\nlast successful evidence"];
    ACTIONS [fillcolor="#ddd6fe",
      label="Recovery actions\nreconfigure provider,\nrerun backfill,\nattach evidence"];
    AUDIT [fillcolor="#ddd6fe",
      label="Audit trail\nfailure, fallback,\noperator action"];
  }

  subgraph cluster_record {
    label="Record protection";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    BLOCKED [fillcolor="#fecaca",
      label="Blocked trust state\nno silent synthetic values"];
    APPROVED [fillcolor="#38a169", fontcolor="white",
      label="Approved record\nonly after source evidence\nand review pass"];
  }

  PROVIDER_DOWN -> RETRY;
  RETRY -> CIRCUIT;
  CIRCUIT -> FALLBACK;
  STALE_DATA -> BLOCKED;
  STORAGE_ERROR -> WAL;
  WAL -> STATUS;
  FALLBACK -> STATUS;
  BLOCKED -> STATUS;
  STATUS -> ACTIONS;
  ACTIONS -> AUDIT;
  AUDIT -> APPROVED [label="resolved"];
}
