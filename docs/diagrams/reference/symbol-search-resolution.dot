// Symbol Search and Resolution Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Symbol resolution supports Security Master identity and operational-record
// evidence. Provider symbols are mappings, not Meridian-owned record truth.

digraph SymbolSearchResolution {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Symbol Search and Resolution\nSecurity Master identity for operational records";

  subgraph cluster_entry {
    label="Entry points";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    WORKSTATION [fillcolor="#c4b5fd",
      label="Browser/WPF workstations\nsymbol setup,\nportfolio/accounting review,\nprovider mapping"];
    API [fillcolor="#ddd6fe",
      label="Shared endpoints\nsearch, resolve,\nreference lookup,\nsecurity detail"];
  }

  subgraph cluster_search {
    label="Search providers";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    SEARCH_CONTRACT [shape=ellipse, fillcolor="#93c5fd",
      label="ISymbolSearchProvider\nprovider-neutral search"];
    PROVIDERS [fillcolor="#bfdbfe",
      label="Search adapters\nAlpaca, Finnhub,\nPolygon, StockSharp"];
    FIGI [fillcolor="#bfdbfe",
      label="OpenFIGI resolution\nFIGI, CUSIP, SEDOL,\nISIN mapping"];
    AGGREGATE [fillcolor="#93c5fd",
      label="Aggregator\nrank, deduplicate,\nconfidence and source posture"];
  }

  subgraph cluster_security_master {
    label="Security Master authority";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    CANDIDATE [fillcolor="#a7f3d0",
      label="Security candidate\nsymbol, exchange,\nidentifiers, source evidence"];
    REVIEW [fillcolor="#fecaca",
      label="Conflict/review queue\nambiguous match,\nmissing identifier,\nprofile mismatch"];
    MASTER [shape=cylinder, fillcolor="#38a169", fontcolor="white",
      label="Security Master record\ncanonical identity,\nasset profile,\nprojection cache"];
    MAPPER [fillcolor="#a7f3d0",
      label="Provider symbol mapper\nprovider-specific ticker,\nexchange suffix,\ncontract format"];
  }

  subgraph cluster_consumers {
    label="Operational consumers";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    PORTFOLIO [fillcolor="#fecaca",
      label="Portfolio records\nholdings, transactions,\nvaluation posture"];
    LEDGER [fillcolor="#e53e3e", fontcolor="white",
      label="Ledger and accounting\nclassification,\nreconciliation evidence"];
    REPORTS [fillcolor="#fbd38d",
      label="Governed reports\ninstrument lineage,\nidentifier evidence"];
  }

  WORKSTATION -> API;
  API -> SEARCH_CONTRACT;
  SEARCH_CONTRACT -> PROVIDERS;
  SEARCH_CONTRACT -> FIGI;
  PROVIDERS -> AGGREGATE;
  FIGI -> AGGREGATE;
  AGGREGATE -> CANDIDATE;
  CANDIDATE -> REVIEW [label="ambiguous"];
  CANDIDATE -> MASTER [label="accepted"];
  REVIEW -> MASTER [label="resolved"];
  MASTER -> MAPPER;
  MASTER -> PORTFOLIO;
  MASTER -> LEDGER;
  MASTER -> REPORTS;
  MAPPER -> PROVIDERS [style=dashed, label="provider formats"];
}
