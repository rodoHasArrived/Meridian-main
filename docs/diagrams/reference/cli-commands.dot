// CLI Commands Reference Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// This diagram groups CLI commands by their role in local workstation,
// evidence acquisition, diagnostics, and governed record maintenance.

digraph CLICommands {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - CLI Command Map\nLocal operational-record workflows";

  ENTRY [fillcolor="#438dd5", fontcolor="white",
    label="dotnet run --project src/Meridian\n\nLocal host, commands,\ndesktop mode, backfill"];

  subgraph cluster_setup {
    label="Setup and diagnostics";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    CONFIG [fillcolor="#ddd6fe",
      label="Configuration\n--generate-config\n--show-config\n--validate-config\n--watch-config"];
    PROVIDERS [fillcolor="#c4b5fd",
      label="Provider readiness\n--detect-providers\n--validate-credentials\n--test-connectivity\n--quick-check"];
    HELP [fillcolor="#ddd6fe",
      label="Help and reference\n--help\n--version\n--error-codes\n--selftest"];
  }

  subgraph cluster_runtime {
    label="Local runtime";
    color="#2b6cb0";
    style="rounded";
    bgcolor="#dbeafe";

    DESKTOP [fillcolor="#93c5fd",
      label="Desktop mode\n--mode desktop\n--http-port\nserves workstation APIs"];
    COLLECTION [fillcolor="#bfdbfe",
      label="Collection mode\n--symbols\n--symbols-add/remove\n--symbol-status"];
    BACKFILL [fillcolor="#bfdbfe",
      label="Backfill evidence\n--backfill\n--backfill-provider\n--backfill-symbols\n--backfill-from/to"];
  }

  subgraph cluster_records {
    label="Record and evidence maintenance";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    PACKAGE [fillcolor="#a7f3d0",
      label="Packages\n--package\n--import-package\n--list-package\n--validate-package"];
    STATUS [fillcolor="#9ae6b4",
      label="Operational evidence\nstatus snapshots,\nstorage coverage,\nprovider health"];
    GUARDRAIL [fillcolor="#fecaca",
      label="Current stance guardrail\ncommands support W1-W5:\ndata confidence, evidence,\nreconciliation, accounting,\ngoverned reports"];
  }

  ENTRY -> CONFIG;
  ENTRY -> PROVIDERS;
  ENTRY -> HELP;
  ENTRY -> DESKTOP;
  ENTRY -> COLLECTION;
  ENTRY -> BACKFILL;
  BACKFILL -> STATUS;
  COLLECTION -> STATUS;
  PACKAGE -> STATUS;
  STATUS -> GUARDRAIL;
}
