// Configuration Management Diagram
// Meridian current project stance
// Last Updated: 2026-06-10
//
// Configuration is local-first, fail-closed, and secret-safe for browser and
// WPF operational-record workflows.

digraph ConfigurationManagement {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", compound=true, pad=0.5];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a5568"];

  labelloc="t";
  label="Meridian - Configuration Management\nLocal config, DataRoot, and fail-closed provider setup";

  subgraph cluster_sources {
    label="Configuration sources";
    color="#4a5568";
    style="rounded";
    bgcolor="#f7fafc";

    DEFAULTS [fillcolor="#e2e8f0",
      label="Built-in defaults\nsafe minimal settings"];
    REPO_CONFIG [fillcolor="#e2e8f0",
      label="Repo config/appsettings.json\ndevelopment host and CLI"];
    DESKTOP_CONFIG [fillcolor="#e2e8f0",
      label="%LocalAppData%/Meridian/appsettings.json\ninstalled WPF desktop"];
    ENV [fillcolor="#fbd38d",
      label="Environment variables\nread-only legacy fallback\nfor secrets"];
    CLI [fillcolor="#fbd38d",
      label="CLI arguments\nlaunch-time overrides"];
  }

  subgraph cluster_resolution {
    label="Resolution and persistence";
    color="#805ad5";
    style="rounded";
    bgcolor="#faf5ff";

    OPTIONS [fillcolor="#ddd6fe",
      label="Options binding\nIOptionsMonitor,\nvalidation, reload"];
    DATA_ROOT [shape=cylinder, fillcolor="#c4b5fd",
      label="Resolved DataRoot\nstorage, WAL, credentials,\nworkspace state, evidence"];
    CONFIG_STORE [fillcolor="#ddd6fe",
      label="ConfigStore\npreview/save flows,\nserializer consistency"];
    CREDENTIAL_STORE [shape=cylinder, fillcolor="#c4b5fd",
      label="Encrypted credential store\nprovider secrets stay local\nand outside tracked files"];
  }

  subgraph cluster_consumers {
    label="Consumers";
    color="#2c7a7b";
    style="rounded";
    bgcolor="#e6fffa";

    LOCAL_HOST [fillcolor="#38a169", fontcolor="white",
      label="src/Meridian local host\nCLI, desktop mode,\nworkstation APIs"];
    WPF [fillcolor="#38a169", fontcolor="white",
      label="WPF desktop workstation\nsetup, launch,\noperator recovery"];
    BROWSER [fillcolor="#38a169", fontcolor="white",
      label="Browser workstation\nprovider setup,\nData/Accounting/Reporting"];
    PROVIDERS [fillcolor="#a7f3d0",
      label="Provider adapters\nhealth, credentials,\ncapability checks"];
  }

  subgraph cluster_guardrails {
    label="Operational guardrails";
    color="#c53030";
    style="rounded";
    bgcolor="#fff5f5";

    FAIL_CLOSED [fillcolor="#fecaca",
      label="Fail-closed behavior\nmissing config/evidence\nblocks trusted record state"];
    MASKING [fillcolor="#fecaca",
      label="Masked diagnostics\nno secret leakage\nin logs or docs"];
    LOCAL_ONLY [fillcolor="#fecaca",
      label="Local persistence boundary\ninstalled upgrades do not\ndepend on install directory"];
  }

  DEFAULTS -> OPTIONS;
  REPO_CONFIG -> OPTIONS;
  DESKTOP_CONFIG -> OPTIONS;
  ENV -> OPTIONS;
  CLI -> OPTIONS;
  OPTIONS -> DATA_ROOT;
  OPTIONS -> CONFIG_STORE;
  DATA_ROOT -> CREDENTIAL_STORE;
  CONFIG_STORE -> LOCAL_HOST;
  OPTIONS -> LOCAL_HOST;
  OPTIONS -> WPF;
  OPTIONS -> BROWSER;
  CREDENTIAL_STORE -> PROVIDERS;
  LOCAL_HOST -> PROVIDERS;
  PROVIDERS -> FAIL_CLOSED [label="not ready"];
  OPTIONS -> MASKING;
  DATA_ROOT -> LOCAL_ONLY;
}
