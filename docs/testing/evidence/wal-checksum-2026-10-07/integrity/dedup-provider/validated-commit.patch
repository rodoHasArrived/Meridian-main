+
+        Assert.Equal("destination", exception.ParamName);
+        Assert.All(destination, value => Assert.Equal((byte)0xA5, value));
+        Sha256Digest.ComputeBytes("next input"u8, digest);
+        Assert.Equal(SHA256.HashData("next input"u8), digest);
+    }
