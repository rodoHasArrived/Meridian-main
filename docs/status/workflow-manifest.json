{
  "schemaVersion": 1,
  "workflows": [
    {
      "id": "docs-automation-core",
      "owners": [
        "@platform-docs",
        "@developer-experience"
      ],
      "requiredPrerequisites": [
        "Python 3.11+ available on PATH",
        "Repository dependencies installed via make install"
      ],
      "executionCommands": [
        {
          "shell": "bash",
          "command": "python3 build/scripts/docs/run-docs-automation.py --profile core --summary-output docs/status/docs-automation-summary.md --json-output docs/status/docs-automation-summary.json"
        },
        {
          "shell": "bash",
          "command": "python3 build/scripts/docs/generate-workflow-manifest.py"
        }
      ],
      "expectedArtifacts": [
        "docs/status/docs-automation-summary.md",
        "docs/status/docs-automation-summary.json",
        "docs/status/workflow-validation-summary.json",
        "docs/status/workflow-drift-report.md",
        "docs/generated/workflow-command-reference.md",
        "docs/HELP.md",
        "docs/development/documentation-automation.md"
      ],
      "validationChecks": [
        {
          "name": "docs automation summary exists",
          "command": "test -f docs/status/docs-automation-summary.json"
        },
        {
          "name": "workflow drift report exists",
          "command": "test -f docs/status/workflow-drift-report.md"
        }
      ],
      "artifactPolicy": {
        "ownerLane": "Documentation Automation",
        "refreshTrigger": "docs automation profile run (core/full)",
        "retention": {
          "policy": "replace-in-place",
          "maxAgeDays": 30,
          "retainLatest": 1
        },
        "canonicalOutputRoots": [
          "docs/status",
          "docs/generated",
          "docs"
        ],
        "driftChecks": {
          "enforceMissing": true,
          "enforceFreshness": true,
          "enforceCanonicalPaths": true
        }
      }
    },
    {
      "id": "desktop-screenshot-catalog",
      "owners": [
        "@desktop-shell",
        "@operator-experience"
      ],
      "requiredPrerequisites": [
        "Windows build host with PowerShell",
        "Release WPF build available when using -SkipBuild"
      ],
      "executionCommands": [
        {
          "shell": "pwsh",
          "command": "pwsh -File ./scripts/dev/run-desktop-workflow.ps1 -Workflow screenshot-catalog -ScreenshotDirectory docs/screenshots/desktop"
        },
        {
          "shell": "pwsh",
          "command": "pwsh -File ./scripts/dev/capture-desktop-screenshots.ps1 -SkipBuild -ProjectPath src/Meridian.Wpf/Meridian.Wpf.csproj -Configuration Release -Framework net10.0-windows10.0.19041.0"
        }
      ],
      "expectedArtifacts": [
        "docs/screenshots/desktop",
        "artifacts/desktop-workflows",
        "artifacts/desktop-screenshot-capture/all-screenshots"
      ],
      "validationChecks": [
        {
          "name": "screenshot workflow artifacts produced",
          "command": "test -d artifacts/desktop-workflows"
        }
      ],
      "artifactPolicy": {
        "ownerLane": "Workstation Shell and UX",
        "refreshTrigger": "desktop screenshot capture workflow or manual screenshot refresh",
        "retention": {
          "policy": "timestamped-run-retention",
          "maxAgeDays": 14,
          "retainLatest": 10
        },
        "canonicalOutputRoots": [
          "docs/screenshots/desktop",
          "artifacts/desktop-workflows",
          "artifacts/desktop-screenshot-capture/all-screenshots"
        ],
        "driftChecks": {
          "enforceMissing": false,
          "enforceFreshness": false,
          "enforceCanonicalPaths": true
        }
      }
    },
